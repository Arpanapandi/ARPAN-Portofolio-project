@model SistemPacking.Web.Models.DashboardKpiDto
@{
    ViewData["Title"] = "Dashboard";
}

@section Breadcrumb {
    <li class="breadcrumb-item active">Dashboard</li>
}

<div class="page-header">
    <h2 class="page-title">
        <i class="bi bi-speedometer2"></i>
        Dashboard Packing System
    </h2>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="refreshDashboard">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
        <span class="badge bg-success py-2 px-3 fs-6">
            <i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>Live
        </span>
    </div>
</div>

<!-- KPI Cards Row 1 -->
<div class="row g-3 mb-4">
    <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
        <div class="kpi-card" style="--kpi-color:#4f6ef7">
            <i class="bi bi-clipboard-data kpi-icon"></i>
            <div class="kpi-value" id="kpi-total">@Model.TotalOrders</div>
            <div class="kpi-label">Total Order</div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
        <div class="kpi-card" style="--kpi-color:#f59e0b">
            <i class="bi bi-hourglass-split kpi-icon"></i>
            <div class="kpi-value" id="kpi-waiting">@Model.WaitingShopping</div>
            <div class="kpi-label">Waiting Shopping</div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
        <div class="kpi-card" style="--kpi-color:#06b6d4">
            <i class="bi bi-cart3 kpi-icon"></i>
            <div class="kpi-value" id="kpi-shopping">@Model.InShopping</div>
            <div class="kpi-label">In Shopping</div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
        <div class="kpi-card" style="--kpi-color:#8b5cf6">
            <i class="bi bi-box-seam kpi-icon"></i>
            <div class="kpi-value" id="kpi-packing">@Model.InPacking</div>
            <div class="kpi-label">In Packing</div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
        <div class="kpi-card" style="--kpi-color:#f97316">
            <i class="bi bi-patch-check kpi-icon"></i>
            <div class="kpi-value" id="kpi-verification">@Model.WaitingVerification</div>
            <div class="kpi-label">Waiting Verif</div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6">
        <div class="kpi-card" style="--kpi-color:#22c55e">
            <i class="bi bi-check-circle kpi-icon"></i>
            <div class="kpi-value" id="kpi-finished">@Model.Finished</div>
            <div class="kpi-label">Finished</div>
        </div>
    </div>
</div>

<!-- Order Table + Detail Panel -->
<div class="row g-3 mb-4">
    <!-- Order List -->
    <div class="col-xl-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title">
                    <i class="bi bi-list-ul me-2 text-primary"></i>Order List
                </span>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" id="statusFilter" style="width:160px;">
                        <option value="">Semua Status</option>
                        <option value="WaitingShopping">Waiting Shopping</option>
                        <option value="Shopping">Shopping</option>
                        <option value="ReadyPacking">Ready Packing</option>
                        <option value="Packing">Packing</option>
                        <option value="WaitingVerification">Waiting Verif</option>
                        <option value="Finished">Finished</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="orderTable">
                        <thead>
                            <tr>
                                <th>Order No</th>
                                <th>Customer</th>
                                <th>Target</th>
                                <th>Shopping</th>
                                <th>Packing</th>
                                <th>Progress</th>
                                <th>Status Order</th>
                            </tr>
                        </thead>
                        <tbody id="orderTableBody">
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr class="order-row" data-id="@order.Id" style="cursor:pointer;"
                                    title="Klik untuk detail">
                                    <td>
                                        <span class="fw-semibold text-primary">@order.OrderNo</span>
                                    </td>
                                    <td>@order.CustomerName</td>
                                    <td class="text-end fw-semibold">@order.TargetQty.ToString("N0")</td>
                                    <td class="text-end">@order.ShoppingQty.ToString("N0")</td>
                                    <td class="text-end">@order.ActualQty.ToString("N0")</td>
                                    <td style="min-width:100px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:6px;">
                                                <div class="progress-bar bg-primary" style="width:@(order.Progress)%"></div>
                                            </div>
                                            <small class="text-muted" style="min-width:30px;">@order.Progress.ToString("N0")%</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge status-@(order.StatusColor)">@order.StatusLabel</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Detail Panel -->
    <div class="col-xl-5">
        <div class="card h-100" id="detailPanel">
            <div class="card-header">
                <span class="card-title">
                    <i class="bi bi-info-circle me-2 text-primary"></i>
                    Detail Order <span id="selectedOrderNo" class="text-muted fw-normal"></span>
                </span>
            </div>
            <div class="card-body" id="detailContent">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-mouse2 fs-1 mb-3 d-block" style="opacity:0.3;"></i>
                    <p>Klik salah satu order untuk melihat detail</p>
                    <small>Data berubah secara <strong>real-time</strong> menggunakan SignalR</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-bar-chart me-2 text-primary"></i>Order Harian (7 Hari)</span>
            </div>
            <div class="card-body">
                <canvas id="dailyOrderChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <span class="card-title"><i class="bi bi-pie-chart me-2 text-primary"></i>Status Distribution</span>
            </div>
            <div class="card-body">
                <canvas id="statusChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
// SignalR Dashboard Connection
const dashboardConnection = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/dashboard')
    .withAutomaticReconnect()
    .build();

let orderConnection = null;
let selectedOrderId = null;

dashboardConnection.on('KPIRefreshed', function (kpi) {
    updateKpiCards(kpi);
});

dashboardConnection.start().then(() => {
    dashboardConnection.invoke('JoinDashboard');
}).catch(err => console.error('Dashboard Hub error:', err));

// KPI Update
function updateKpiCards(kpi) {
    animateCounter('kpi-total', kpi.totalOrders);
    animateCounter('kpi-waiting', kpi.waitingShopping);
    animateCounter('kpi-shopping', kpi.inShopping);
    animateCounter('kpi-packing', kpi.inPacking);
    animateCounter('kpi-verification', kpi.waitingVerification);
    animateCounter('kpi-finished', kpi.finished);
}

function animateCounter(id, newVal) {
    const el = document.getElementById(id);
    if (!el) return;
    const start = parseInt(el.textContent) || 0;
    const duration = 600;
    const startTime = performance.now();
    function update(time) {
        const elapsed = time - startTime;
        const progress = Math.min(elapsed / duration, 1);
        el.textContent = Math.round(start + (newVal - start) * progress);
        if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
}

// Order row click -> load detail
document.querySelectorAll('.order-row').forEach(row => {
    row.addEventListener('click', function () {
        document.querySelectorAll('.order-row').forEach(r => r.classList.remove('table-primary'));
        this.classList.add('table-primary');
        loadOrderDetail(this.dataset.id);
    });
});

function loadOrderDetail(orderId) {
    if (selectedOrderId !== orderId) {
        // Join SignalR order group
        connectToOrderHub(orderId);
        selectedOrderId = orderId;
    }

    fetch(`/Order/GetDetail/${orderId}`)
        .then(r => r.json())
        .then(order => renderDetailPanel(order));
}

function connectToOrderHub(orderId) {
    if (orderConnection) {
        orderConnection.stop();
    }
    orderConnection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/order')
        .withAutomaticReconnect()
        .build();

    orderConnection.on('PackingProgressUpdated', function (data) {
        if (data.orderId == selectedOrderId) {
            updateDetailProgress(data);
        }
    });

    orderConnection.on('OrderStatusChanged', function (data) {
        if (data.orderId == selectedOrderId) {
            loadOrderDetail(orderId);
        }
    });

    orderConnection.start().then(() => {
        orderConnection.invoke('JoinOrderGroup', orderId.toString());
    });
}

function renderDetailPanel(order) {
    document.getElementById('selectedOrderNo').textContent = '— ' + order.orderNo;
    let html = `
        <div class="mb-3">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Customer</span>
                <strong>${order.customerName}</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Status</span>
                <span class="badge bg-${order.statusColor}">${order.statusLabel}</span>
            </div>
            <div class="d-flex justify-content-between mb-3">
                <span class="text-muted">Progress Packing</span>
                <strong>${order.packingProgress?.toFixed(1) ?? 0}%</strong>
            </div>
            <div class="progress mb-4" style="height:10px;">
                <div class="progress-bar bg-primary" style="width:${order.packingProgress ?? 0}%"
                     id="overall-progress-bar"></div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th class="text-end">Target</th>
                        <th class="text-end">Shopping</th>
                        <th class="text-end">Actual</th>
                        <th style="width:80px;">%</th>
                    </tr>
                </thead>
                <tbody id="detail-tbody">`;

    order.details?.forEach(d => {
        const prog = Math.min(100, d.targetQty > 0 ? (d.actualQty / d.targetQty * 100) : 0);
        const color = prog >= 100 ? 'success' : prog > 0 ? 'primary' : 'secondary';
        html += `
            <tr id="detail-row-${d.id}">
                <td>
                    <div class="fw-semibold" style="font-size:12px;">${d.itemName}</div>
                    <div class="text-muted" style="font-size:11px;">${d.itemCode}</div>
                </td>
                <td class="text-end">${d.targetQty}</td>
                <td class="text-end">${d.shoppingQty}</td>
                <td class="text-end fw-semibold" id="actual-${d.id}">${d.actualQty}</td>
                <td>
                    <div class="d-flex align-items-center gap-1">
                        <div class="progress flex-grow-1" style="height:5px;">
                            <div class="progress-bar bg-${color}" style="width:${prog}%" id="prog-${d.id}"></div>
                        </div>
                    </div>
                </td>
            </tr>`;
    });

    html += `</tbody></table></div>`;
    document.getElementById('detailContent').innerHTML = html;
}

function updateDetailProgress(data) {
    const actualEl = document.getElementById(`actual-${data.detailId}`);
    const progEl = document.getElementById(`prog-${data.detailId}`);
    const overallEl = document.getElementById('overall-progress-bar');
    if (actualEl) actualEl.textContent = data.actual;
    const pct = data.target > 0 ? Math.min(100, data.actual / data.target * 100) : 0;
    if (progEl) progEl.style.width = pct + '%';
    if (overallEl) overallEl.style.width = data.progress + '%';
}

// Charts
const dailyCtx = document.getElementById('dailyOrderChart').getContext('2d');
const dailyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyOrderChart));

new Chart(dailyCtx, {
    type: 'bar',
    data: {
        labels: dailyData.map(d => d.label),
        datasets: [{
            label: 'Jumlah Order',
            data: dailyData.map(d => d.value),
            backgroundColor: 'rgba(79, 110, 247, 0.7)',
            borderColor: '#4f6ef7',
            borderWidth: 2,
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(0,0,0,0.05)' } },
            x: { grid: { display: false } }
        }
    }
});

const statusCtx = document.getElementById('statusChart').getContext('2d');
new Chart(statusCtx, {
    type: 'doughnut',
    data: {
        labels: ['Waiting', 'Shopping', 'Packing', 'Verifikasi', 'Finished'],
        datasets: [{
            data: [
                @Model.WaitingShopping,
                @(Model.InShopping + Model.ShoppingComplete),
                @(Model.InPacking + Model.PackingComplete),
                @Model.WaitingVerification,
                @Model.Finished
            ],
            backgroundColor: ['#f59e0b','#06b6d4','#4f6ef7','#f97316','#22c55e'],
            borderWidth: 0,
            hoverOffset: 8
        }]
    },
    options: {
        responsive: true,
        cutout: '65%',
        plugins: {
            legend: { position: 'bottom', labels: { padding: 16, font: { size: 12 } } }
        }
    }
});

// Refresh button
document.getElementById('refreshDashboard').addEventListener('click', function () {
    fetch('/Dashboard/GetKpi')
        .then(r => r.json())
        .then(kpi => updateKpiCards(kpi));
});
</script>
}

