@{
    ViewData["Title"] = "Log Scan NG Shopping";
    var user = ViewBag.User as UserSessionDto;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-0">Log Scan NG (Shopping)</h2>
            <p class="text-muted">Daftar transaksi scan yang gagal atau tidak valid pada tahap Shopping.</p>
        </div>
    </div>

    <div class="card bg-dark text-white shadow-sm border-0">
        <div class="card-header bg-primary border-0 d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 text-white"><i class="bi bi-cart-x me-2"></i>Data Scan NG Shopping</h5>
            <button class="btn btn-sm btn-light" onclick="tableShopping.ajax.reload()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tableShopping" class="table table-dark table-hover table-striped mb-0 align-middle w-100">
                    <thead>
                        <tr>
                            <th class="text-center" width="5%">No</th>
                            <th>Waktu Scan</th>
                            <th>Module</th>
                            <th>Kategori</th>
                            <th>Barcode</th>
                            <th>Item Code</th>
                            <th>Alasan</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var tableShopping;
        $(document).ready(function () {
            tableShopping = $('#tableShopping').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("GetScanNgLogs", "TransactionLog")',
                    type: 'GET',
                    data: { category: 'Shopping' }
                },
                columns: [
                    { 
                        data: null,
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    { data: 'waktu' },
                    { data: 'module' },
                    { data: 'category' },
                    { data: 'barcode' },
                    { data: 'itemCode' },
                    { data: 'alasan', render: function(data) { return `<span class="text-primary">${data}</span>`; } },
                    { data: 'operatorName' }
                ],
                order: [[1, 'desc']],
                pageLength: 25,
                language: { url: '/js/id.json' },
                dom: '<"row p-3"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row p-3"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
            });
            
            setInterval(function() {
                tableShopping.ajax.reload(null, false);
            }, 30000);
        });
    </script>
}
