@{
    ViewData["Title"] = "Shopping Log";
}

@section Breadcrumb {
    <li class="breadcrumb-item">Log Transaksi</li>
    <li class="breadcrumb-item active">Shopping Log</li>
}

<div class="page-header">
    <h2 class="page-title"><i class="bi bi-cart3"></i> Shopping Log</h2>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped" id="shoppingLogTable" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th>No</th>
                        <th>Vin</th>
                        <th>Label</th>
                        <th>Kanban</th>
                        <th>Qty</th>
                        <th>Waktu Scan</th>
                        <th>Operator</th>
                        <th>Status Order</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#shoppingLogTable').DataTable({
                ajax: '/TransactionLog/GetShoppingLogs',
                order: [[5, 'desc']],
                columns: [
                    { 
                        data: null, 
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: 'vin', className: 'fw-semibold text-primary' },
                    { data: 'label', render: data => `<code>${data}</code>` },
                    { data: 'kanban' },
                    { data: 'qty', className: 'text-end' },
                    { data: 'waktu' },
                    { data: 'operatorName' },
                    { 
                        data: 'isValid', 
                        render: function (data, type, row) {
                            if (data) return '<span class="badge bg-success-subtle text-success">Valid</span>';
                            return `<span class="badge bg-danger-subtle text-danger" title="${row.invalidReason}">${row.invalidReason || 'Invalid'}</span>`;
                        }
                    }
                ]
            });
        });
    </script>
}

