@{
    ViewData["Title"] = "Packing Module";
}

@section Breadcrumb {
    <li class="breadcrumb-item">Operasional</li>
    <li class="breadcrumb-item active">Packing Export</li>
}

<style>
    .point-input {
        background-color: #e9ecef !important;
        font-weight: bold;
    }
    .custom-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
    }
    .img-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        min-height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .info-label {
        font-size: 0.75rem;
        font-weight: bold;
        color: #6c757d;
        margin-bottom: 0.2rem;
    }
</style>

<div class="container-fluid p-0">
    <!-- Top Row -->
    <div class="row align-items-center bg-dark text-white p-2 mb-3 rounded shadow-sm mx-0">
        <div class="col-md-3">
            <div class="d-flex align-items-center mb-1">
                <div class="bg-primary text-white fw-bold px-2 py-1 rounded me-2" style="font-size:0.9rem;">
                    <i class="bi bi-box-seam me-1"></i> VELASTO
                </div>
                <div class="text-white fw-bold">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </div>
            </div>
            <div class="d-flex align-items-center">
                <div class="text-warning fw-bold me-3">
                    <i class="bi bi-person-badge me-1"></i> @(ViewBag.User?.FullName ?? "Operator")
                </div>
                <div>
                    <select id="shiftSelect" class="form-select form-select-sm bg-white text-dark fw-bold border-0" style="width: auto;">
                        <option value="">-- Shift --</option>
                        @if(ViewBag.Shifts != null) {
                            foreach(var s in ViewBag.Shifts) {
                                <option value="@s.Id">@s.ShiftName</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="col-md-5 text-center">
            <h4 class="m-0 text-info fw-bold" style="letter-spacing: 1px;">POINT KRITIKAL PART</h4>
            @if(ViewBag.User?.RoleName == "Super Admin")
            {
                <div class="form-check form-switch mt-2 d-flex justify-content-center align-items-center">
                    <input class="form-check-input me-2" type="checkbox" id="manualModeToggle">
                    <label class="form-check-label text-white-50 fw-bold" for="manualModeToggle" style="font-size: 0.8rem;">Manual Mode (Ketik)</label>
                </div>
            }
        </div>
        <div class="col-md-4">
            <div class="row g-2 align-items-center mb-2">
                <div class="col-3 text-end"><span class="badge bg-secondary w-100 py-2">KANBAN</span></div>
                <div class="col-7"><input type="text" id="scanKanban" class="form-control form-control-sm border-success text-center fw-bold" autofocus autocomplete="off" placeholder="Scan Kanban" /></div>
                <div class="col-2"><button class="btn btn-sm btn-outline-light w-100"><i class="bi bi-upc-scan"></i></button></div>
            </div>
            <div class="row g-2 align-items-center mb-2">
                <div class="col-3 text-end"><span class="badge bg-primary w-100 py-2">LABEL</span></div>
                <div class="col-7"><input type="text" id="scanLabel" class="form-control form-control-sm border-primary text-center fw-bold" disabled placeholder="Scan Label" /></div>
                <div class="col-2"><button class="btn btn-sm btn-outline-light w-100"><i class="bi bi-upc-scan"></i></button></div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-1">
                <button class="btn btn-sm btn-success fw-bold px-3">PASS</button>
                <div class="bg-white text-dark rounded px-3 py-1 text-center" style="min-width: 120px;">
                    <div class="info-label text-primary">DOCK CODE</div>
                    <div id="valDock" class="fw-bold" style="min-height: 20px;">-</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Middle Row -->
    <div class="row mb-3 g-3">
        <!-- Left Column -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-2">
                        <div class="info-label">PART NUM</div>
                        <input type="text" id="valPartNum" class="form-control form-control-sm bg-light fw-bold" readonly />
                    </div>
                    <div class="mb-2">
                        <div class="info-label">PART NAME</div>
                        <input type="text" id="valPartName" class="form-control form-control-sm bg-light fw-bold" readonly />
                    </div>
                    <div class="mb-2">
                        <div class="info-label">UNIQ NUM</div>
                        <input type="text" id="valUniqNum" class="form-control form-control-sm bg-light fw-bold" readonly />
                    </div>
                    <div class="mb-3">
                        <div class="info-label">P/N VIN</div>
                        <input type="text" id="valVin" class="form-control form-control-sm bg-light fw-bold text-primary" readonly />
                    </div>
                    
                    <hr class="text-muted">
                    
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger me-2" style="width: 25px;">1</span>
                        <input type="text" id="point1" class="form-control form-control-sm point-input" readonly />
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger me-2" style="width: 25px;">2</span>
                        <input type="text" id="point2" class="form-control form-control-sm point-input" readonly />
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger me-2" style="width: 25px;">3</span>
                        <input type="text" id="point3" class="form-control form-control-sm point-input" readonly />
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger me-2" style="width: 25px;">4</span>
                        <input type="text" id="point4" class="form-control form-control-sm point-input" readonly />
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger me-2" style="width: 25px;">5</span>
                        <input type="text" id="point5" class="form-control form-control-sm point-input" readonly />
                    </div>
                    <div class="text-end mt-2">
                        <button class="btn btn-outline-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> OK</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Center Image SPIS -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <h6 class="text-muted fw-bold m-0"><i class="bi bi-image text-primary me-2"></i>SPIS VISUALIZATION</h6>
                </div>
                <div class="card-body">
                    <div class="img-box w-100 h-100 p-2">
                        <img id="imgSpis" src="" class="img-fluid d-none" style="max-height:350px; object-fit:contain;" />
                        <div id="noSpis" class="text-muted text-center">
                            <i class="bi bi-image" style="font-size:3rem; opacity:0.3;"></i>
                            <p class="mt-2 small">No Image</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-md-2">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body d-flex flex-column">
                    <div class="small opacity-75 mb-3 border-bottom border-light pb-2" style="font-size:0.65rem;">
                        Dept: PPIC/VIN/2019/FEB/OKT/2023 MATERIAL
                    </div>
                    
                    <div class="mb-3">
                        <div class="info-label text-white opacity-75">TYPE KARTON :</div>
                        <input type="text" class="form-control form-control-sm bg-white text-dark fw-bold border-0" readonly />
                    </div>
                    <div class="mb-4">
                        <div class="info-label text-white opacity-75">TYPE PLASTIK :</div>
                        <input type="text" class="form-control form-control-sm bg-white text-dark fw-bold border-0" readonly />
                    </div>

                    <div class="mt-auto bg-white text-dark rounded p-2 text-center shadow-sm">
                        <div class="fw-bold border-bottom pb-1 mb-2 text-primary" style="font-size:0.8rem;">PROGRESS PACKING</div>
                        <div class="row text-center g-1">
                            <div class="col-12 mb-2">
                                <div style="font-size:0.7rem;" class="text-muted fw-bold">KANBAN</div>
                                <div id="indTarget" class="text-primary fw-bold" style="font-size:1.5rem;">0</div>
                            </div>
                            <div class="col-6">
                                <div style="font-size:0.7rem;" class="text-muted fw-bold">PACKING</div>
                                <div id="indActual" class="text-success fw-bold" style="font-size:1.5rem;">0</div>
                            </div>
                            <div class="col-6 border-start">
                                <div style="font-size:0.7rem;" class="text-muted fw-bold">BALANCE</div>
                                <div id="indBalance" class="text-danger fw-bold" style="font-size:1.5rem;">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row -->
    <div class="row g-3">
        <!-- Label Print Box -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-warning text-dark text-center py-2">
                    <h6 class="m-0 fw-bold">- LABEL PRINT -</h6>
                    <small class="fw-bold">PT VELASTO INDONESIA</small>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered m-0" style="font-size:0.8rem;">
                        <tbody>
                            <tr><td width="30%" class="bg-light fw-bold text-muted">CUST.</td><td id="lblCust" class="fw-bold"></td></tr>
                            <tr><td class="bg-light fw-bold text-muted">P/N</td><td id="lblPn" class="fw-bold"></td></tr>
                            <tr><td class="bg-light fw-bold text-muted">P/N VIN</td><td id="lblPnVin" class="fw-bold"></td></tr>
                            <tr><td class="bg-light fw-bold text-muted">PNA</td><td class="fw-bold"></td></tr>
                            <tr><td colspan="2" class="text-center text-muted">* *</td></tr>
                        </tbody>
                    </table>
                    <table class="table table-sm table-bordered m-0" style="font-size:0.8rem; border-top: 0;">
                        <thead class="bg-light text-center text-muted">
                            <tr>
                                <th width="40%">INSPECTOR</th>
                                <th width="40%">CHECK DATE</th>
                                <th width="20%">QTY</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            <tr>
                                <td class="fw-bold">@(ViewBag.User?.FullName ?? "-")</td>
                                <td class="fw-bold">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-danger fw-bold">Pcs</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Packing Visualisasi SPPS -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 text-center">
                    <h6 class="text-muted fw-bold m-0"><i class="bi bi-box-seam text-success me-2"></i>PACKING VISUALISASI</h6>
                </div>
                <div class="card-body p-2">
                    <div class="img-box w-100 h-100 p-2" style="min-height: 150px;">
                        <img id="imgSpps" src="" class="img-fluid d-none" style="max-height:160px; object-fit:contain;" />
                        <div id="noSpps" class="text-muted text-center">
                            <i class="bi bi-box-seam" style="font-size:2rem; opacity:0.3;"></i>
                            <p class="mt-1 small m-0">No Image</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Packing QTY -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <h5 class="fw-bold text-uppercase opacity-75 mb-3">Packing Qty</h5>
                    <h1 id="qtyPacked" class="display-1 fw-bold m-0" style="font-size: 5rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.2);">0</h1>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {
    let lastKeyTimeLabel = Date.now();
    let lastKeyTimeKanban = Date.now();

    function setupScanner(inputId, lastKeyTimeVar, onEnter) {
        $(inputId).on('keypress', function(e) {
            let currentTime = Date.now();
            let isManual = $('#manualModeToggle').length > 0 && $('#manualModeToggle').is(':checked');
            
            if (!isManual && currentTime - lastKeyTimeVar > 50) {
                $(this).val('');
            }
            lastKeyTimeVar = currentTime;
            
            if (e.which === 13) {
                e.preventDefault();
                if ($(this).val().length > 0) {
                    onEnter($(this).val().trim());
                }
            }
        });
        $(inputId).on('paste', function(e) { 
            let isManual = $('#manualModeToggle').length > 0 && $('#manualModeToggle').is(':checked');
            if (!isManual) {
                e.preventDefault(); 
            }
        });
    }

    setupScanner('#scanKanban', lastKeyTimeKanban, function(val) {
        $('#scanKanban').prop('disabled', true);
        $('#scanLabel').prop('disabled', false).val('').focus();
    });

    setupScanner('#scanLabel', lastKeyTimeLabel, function(labelVal) {
        const kanbanVal = $('#scanKanban').val().trim();
        doScan(kanbanVal, labelVal);
    });

    function resetScanners() {
        $('#scanKanban').prop('disabled', false).val('').focus();
        $('#scanLabel').prop('disabled', true).val('');
    }

    function doScan(kanban, label) {
        const shiftId = $('#shiftSelect').val();
        if (!shiftId) {
            Swal.fire({
                icon: 'warning', title: 'Pilih Shift', text: 'Harap pilih shift operasional terlebih dahulu sebelum melakukan scan.',
                allowOutsideClick: false, confirmButtonColor: '#3085d6'
            }).then(() => { $('#shiftSelect').focus(); resetScanners(); });
            return;
        }

        $('#scanKanban').prop('disabled', true);

        $.post('/Packing_Ex/Scan', {
            kanban: kanban, 
            label: label,
            shiftId: shiftId,
            __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val()
        })
        .done(function (result) {
            resetScanners();
            
            if (result.success && !result.isOverQty) {
                updateIndicators(result.targetQty, result.actualQty, result.remaining);
                updateImages(result.spisImagePath, result.sppsImagePath);
                updatePoints(result.point1, result.point2, result.point3, result.point4, result.point5);
                
                // Update new UI mappings
                $('#valPartNum').val(result.itemCode || '-');
                $('#valPartName').val(result.itemName || '-');
                $('#valUniqNum').val(result.barcode || '-');
                $('#valVin').val(result.vin || '-');
                $('#valDock').text(result.dock || '-');
                
                $('#lblCust').text(result.customerName || '-');
                $('#lblPn').text(result.itemCode || '-');
                $('#lblPnVin').text(result.vin || '-');
                $('#qtyPacked').text(result.actualQty || 0);

                if (result.isComplete) {
                    Swal.fire({ icon: 'success', title: '🎉 Packing Selesai!', text: 'Semua item pada order ini telah dipacking.', timer: 3000, showConfirmButton: false });
                } else {
                    const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 1500, timerProgressBar: true });
                    Toast.fire({ icon: 'success', title: 'Scan OK: ' + result.itemName });
                }
            } else {
                showStrictError(result.message);
            }
        })
        .fail(() => { 
            resetScanners();
            showStrictError('Gagal terhubung ke server.'); 
        });
    }

    function updateIndicators(target, actual, balance) {
        $('#indTarget').text(target || 0);
        $('#indActual').text(actual || 0);
        $('#indBalance').text(balance || 0);
    }

    function updateImages(spis, spps) {
        if (spis) { $('#imgSpis').attr('src', spis).removeClass('d-none'); $('#noSpis').addClass('d-none'); } 
        else { $('#imgSpis').addClass('d-none'); $('#noSpis').removeClass('d-none'); }
        if (spps) { $('#imgSpps').attr('src', spps).removeClass('d-none'); $('#noSpps').addClass('d-none'); } 
        else { $('#imgSpps').addClass('d-none'); $('#noSpps').removeClass('d-none'); }
    }

    function updatePoints(p1, p2, p3, p4, p5) {
        $('#point1').val(p1 || '-');
        $('#point2').val(p2 || '-');
        $('#point3').val(p3 || '-');
        $('#point4').val(p4 || '-');
        $('#point5').val(p5 || '-');
    }

    function showStrictError(msg) {
        Swal.fire({
            icon: 'error', title: '❌ GAGAL SCAN!', text: msg, allowOutsideClick: false, allowEscapeKey: false,
            confirmButtonText: 'Tutup & Scan Ulang', confirmButtonColor: '#d33', backdrop: `rgba(220, 38, 38, 0.4)`
        }).then(() => { resetScanners(); });
    }
});
</script>
}
