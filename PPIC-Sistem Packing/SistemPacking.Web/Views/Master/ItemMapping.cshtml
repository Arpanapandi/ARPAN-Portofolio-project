@model IEnumerable<SistemPacking.Web.Models.ItemMapping>
@{
    ViewData["Title"] = "Master Item Mapping";
    var items = ViewBag.Items as IEnumerable<SistemPacking.Web.Models.Item> ?? Enumerable.Empty<SistemPacking.Web.Models.Item>();
}

@section Breadcrumb {
    <li class="breadcrumb-item">Master Data</li>
    <li class="breadcrumb-item active">Item Mapping</li>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-2 text-primary"></i>Master Item Mapping</h4>
    <div>
        <a href="/Master/DownloadTemplateItemMapping" class="btn btn-outline-info me-2">
            <i class="bi bi-download me-1"></i>Template
        </a>
        <button class="btn btn-outline-success me-2" onclick="$('#importModal').modal('show')">
            <i class="bi bi-file-earmark-arrow-up me-1"></i>Import
        </button>
        <a href="/Master/ExportItemMappings" class="btn btn-outline-secondary me-2">
            <i class="bi bi-file-earmark-arrow-down me-1"></i>Export
        </a>
        <button class="btn btn-danger me-2 d-none" id="btnBulkDelete" onclick="bulkDelete()">
            <i class="bi bi-trash me-1"></i>Hapus Terpilih (<span id="selectedCount">0</span>)
        </button>
        <button class="btn btn-primary" onclick="showModal()">
            <i class="bi bi-plus-circle me-1"></i> Tambah Mapping
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="mappingTable" style="width: 100%;">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 40px;">
                        <input class="form-check-input" type="checkbox" id="checkAll">
                    </th>
                    <th style="width: 50px;">No</th>
                    <th>VIN</th>
                    <th>Part No</th>
                    <th>Item Name</th>
                    <th>Kanban</th>
                    <th class="text-center" style="width: 100px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int no = 1; }
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="text-center">
                            <input class="form-check-input chk-item" type="checkbox" value="@m.Id">
                        </td>
                        <td>@(no++)</td>
                        <td>@(string.IsNullOrWhiteSpace(m.Item?.VIN) ? "-" : m.Item.VIN)</td>
                        <td class="fw-semibold text-primary">@(string.IsNullOrWhiteSpace(m.Item?.ItemCode) ? "-" : m.Item.ItemCode)</td>
                        <td>@(string.IsNullOrWhiteSpace(m.Item?.ItemName) ? "-" : m.Item.ItemName)</td>
                        <td><code>@m.KanbanCode</code></td>
                        <td class="text-center">
                            <button class="btn btn-xs btn-outline-primary" onclick="editMapping(@m.Id, @m.ItemId, '@m.KanbanCode', '@(m.Description?.Replace("'", "\\'") ?? "")')">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-xs btn-outline-danger" onclick="deleteMapping(@m.Id, '@(m.Item?.ItemCode ?? m.KanbanCode)')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Tambah/Edit -->
<div class="modal fade" id="mappingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Tambah Mapping</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="mappingForm">
                    <input type="hidden" id="MappingId" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item <span class="text-danger">*</span></label>
                        <select id="ItemId" class="form-select" required>
                            <option value="">-- Pilih Item --</option>
                            @foreach (var item in items)
                            {
                                <option value="@item.Id">[@(string.IsNullOrWhiteSpace(item.VIN) ? "-" : item.VIN)] @item.ItemCode - @item.ItemName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kanban Code <span class="text-danger">*</span></label>
                        <input type="text" id="KanbanCode" class="form-control" placeholder="Masukkan kode kanban..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Keterangan</label>
                        <input type="text" id="Description" class="form-control" placeholder="Keterangan (opsional)..." />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-primary" id="saveBtn">Simpan</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import Data Item Mapping</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Pilih File Excel (.xlsx) <span class="text-danger">*</span></label>
                    <input class="form-control" type="file" id="importFile" accept=".xlsx" />
                    <small class="text-muted mt-1 d-block">Gunakan format file dari tombol Template.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-success" id="btnUploadImport" onclick="uploadImport()">
                    <i class="bi bi-upload me-1"></i> Upload
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#mappingTable').DataTable({
            pageLength: 20,
            scrollY: 'calc(100vh - 350px)',
            scrollCollapse: true,
            language: { url: '/js/id.json' },
            columnDefs: [
                { orderable: false, targets: [0, -1] },
                { className: 'text-center', targets: [0, -1] }
            ]
        });

        // Check All logic
        $('#checkAll').change(function () {
            $('.chk-item').prop('checked', $(this).prop('checked'));
            toggleBulkDeleteBtn();
        });

        $('#mappingTable tbody').on('change', '.chk-item', function () {
            if (!$(this).prop('checked')) {
                $('#checkAll').prop('checked', false);
            }
            toggleBulkDeleteBtn();
        });

        function toggleBulkDeleteBtn() {
            var selected = $('.chk-item:checked').length;
            if (selected > 0) {
                $('#selectedCount').text(selected);
                $('#btnBulkDelete').removeClass('d-none');
            } else {
                $('#btnBulkDelete').addClass('d-none');
            }
        }

        $('#saveBtn').click(function () {
            if (!$('#ItemId').val() || !$('#KanbanCode').val()) {
                Swal.fire('Peringatan', 'Item dan Kanban Code wajib diisi!', 'warning');
                return;
            }

            var data = {
                Id: $('#MappingId').val(),
                ItemId: $('#ItemId').val(),
                KanbanCode: $('#KanbanCode').val(),
                Description: $('#Description').val(),
                __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val()
            };

            $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Menyimpan...');

            $.post('/Master/SaveItemMapping', data, function (res) {
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Berhasil', text: res.message, timer: 1500, showConfirmButton: false })
                        .then(() => location.reload());
                } else {
                    Swal.fire('Error', res.message || 'Gagal menyimpan', 'error');
                    $('#saveBtn').prop('disabled', false).text('Simpan');
                }
            });
        });
    });

    const modal = new bootstrap.Modal(document.getElementById('mappingModal'));

    function showModal() {
        $('#modalTitle').text('Tambah Mapping');
        $('#mappingForm')[0].reset();
        $('#MappingId').val(0);
        modal.show();
    }

    function editMapping(id, itemId, kanban, desc) {
        $('#modalTitle').text('Edit Mapping');
        $('#MappingId').val(id);
        $('#ItemId').val(itemId);
        $('#KanbanCode').val(kanban);
        $('#Description').val(desc || '');
        modal.show();
    }

    function deleteMapping(id, label) {
        Swal.fire({
            title: 'Hapus Mapping?',
            text: `Anda yakin ingin menghapus mapping untuk '${label}'?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            confirmButtonText: 'Ya, hapus!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Master/DeleteItemMapping', { id: id, __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val() }, function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Terhapus!', timer: 1500, showConfirmButton: false }).then(() => location.reload());
                    } else {
                        Swal.fire('Error', 'Gagal menghapus', 'error');
                    }
                });
            }
        });
    }

    function bulkDelete() {
        var selected = [];
        $('.chk-item:checked').each(function () {
            selected.push(parseInt($(this).val()));
        });

        if (selected.length === 0) return;

        Swal.fire({
            title: 'Hapus ' + selected.length + ' data?',
            text: "Data yang dihapus tidak dapat dikembalikan!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            confirmButtonText: 'Ya, Hapus!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Master/BulkDeleteItemMappings',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(selected),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Terhapus!', res.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    }
                });
            }
        });
    }

    function uploadImport() {
        var fileInput = document.getElementById('importFile');
        if (!fileInput.files.length) {
            Swal.fire('Peringatan', 'Pilih file Excel terlebih dahulu!', 'warning');
            return;
        }

        var formData = new FormData();
        formData.append('file', fileInput.files[0]);
        formData.append('__RequestVerificationToken', $('[name="__RequestVerificationToken"]').val());

        $('#btnUploadImport').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Uploading...');

        $.ajax({
            url: '/Master/ImportItemMappings',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.success) {
                    var detail = res.errors && res.errors.length > 0 ? '<br><small class="text-danger">' + res.errors[0] + '</small>' : '';
                    Swal.fire('Berhasil', res.message + detail, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Error', 'Gagal mengupload file', 'error');
            },
            complete: function () {
                $('#btnUploadImport').prop('disabled', false).html('<i class="bi bi-upload me-1"></i> Upload');
            }
        });
    }
</script>
}
@Html.AntiForgeryToken()
