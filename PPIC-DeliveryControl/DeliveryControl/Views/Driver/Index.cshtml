@section Scripts {
    <script src="~/lib/signalr.min.js"></script>
    <script>
        let daTargetFullTime = '';
        let ddTargetFullTime = '';

        function openDriverArrivalModal(id, customerName, cycle, route, area, targetTimeStr, targetFullTime) {
            document.getElementById('daId').value = id;
            daTargetFullTime = targetFullTime;

            document.getElementById('daModalSubtitle').textContent = `${customerName} — Cycle ${cycle} (${area})`;
            document.getElementById('daInfoCustomer').textContent = customerName;
            document.getElementById('daInfoCycleRoute').textContent = `Cycle ${cycle} | ${route} | ${area}`;
            document.getElementById('daInfoTargetPickup').textContent = targetTimeStr ? targetTimeStr : 'Tidak ada target';

            const btnTarget = document.getElementById('daBtnSetTarget');
            if (targetTimeStr) {
                btnTarget.style.display = 'inline-block';
                btnTarget.innerHTML = `<i class="bi bi-bullseye me-1"></i> Set On-Time (${targetTimeStr})`;
            } else {
                btnTarget.style.display = 'none';
            }

            const inputEl = document.getElementById('daInputDateTime');
            if (targetFullTime) {
                inputEl.value = targetFullTime;
            } else {
                daSetCurrentTime();
            }

            document.getElementById('daInputNotes').value = '';
            document.getElementById('daFeedback').innerHTML = '';
            const btnSubmit = document.getElementById('daBtnSubmit');
            btnSubmit.disabled = false;

            const modal = new bootstrap.Modal(document.getElementById('modalDriverArrival'));
            modal.show();
        }

        function daSetTargetTime() {
            if (daTargetFullTime) {
                document.getElementById('daInputDateTime').value = daTargetFullTime;
                document.getElementById('daFeedback').innerHTML = '<span class="text-success"><i class="bi bi-check2-circle me-1"></i> Waktu disetel ke target (On-Time)</span>';
            }
        }

        function daSetCurrentTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('daInputDateTime').value = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.getElementById('daFeedback').innerHTML = '<span class="text-info"><i class="bi bi-clock me-1"></i> Waktu disetel ke jam sekarang</span>';
        }

        function daAdjustMinutes(mins) {
            const inputEl = document.getElementById('daInputDateTime');
            if (!inputEl.value) { daSetCurrentTime(); return; }
            const dt = new Date(inputEl.value);
            if (isNaN(dt.getTime())) return;
            dt.setMinutes(dt.getMinutes() + mins);
            const year = dt.getFullYear();
            const month = String(dt.getMonth() + 1).padStart(2, '0');
            const day = String(dt.getDate()).padStart(2, '0');
            const hours = String(dt.getHours()).padStart(2, '0');
            const minutes = String(dt.getMinutes()).padStart(2, '0');
            inputEl.value = `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        function submitDriverArrival() {
            const inputEl = document.getElementById('daInputDateTime');
            if (!inputEl.value) {
                document.getElementById('daFeedback').innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Waktu kedatangan wajib diisi.</span>';
                return;
            }

            const btnSubmit = document.getElementById('daBtnSubmit');
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...';

            const form = document.getElementById('formDriverArrival');
            const formData = new FormData(form);

            fetch('/Driver/Arrival', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('daFeedback').innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> ${data.message}</span>`;
                    setTimeout(() => {
                        const modalEl = document.getElementById('modalDriverArrival');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                        location.reload();
                    }, 500);
                } else {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Simpan Konfirmasi Kedatangan';
                    document.getElementById('daFeedback').innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i> ${data.message || 'Gagal menyimpan'}</span>`;
                }
            })
            .catch(err => {
                console.error(err);
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Simpan Konfirmasi Kedatangan';
                document.getElementById('daFeedback').innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Terjadi kesalahan sistem.</span>';
            });
        }

        function openDriverDepartureModal(id, customerName, cycle, route, area, targetTimeStr, targetFullTime, actualArrivalStr) {
            document.getElementById('ddId').value = id;
            ddTargetFullTime = targetFullTime;

            document.getElementById('ddModalSubtitle').textContent = `${customerName} — Cycle ${cycle} (${area})`;
            document.getElementById('ddInfoCustomer').textContent = customerName;
            document.getElementById('ddInfoCycleRoute').textContent = `Cycle ${cycle} | ${route} | ${area}`;
            document.getElementById('ddInfoActualArrival').textContent = actualArrivalStr ? actualArrivalStr : '-';
            document.getElementById('ddInfoTargetPickup').textContent = targetTimeStr ? targetTimeStr : 'Tidak ada target';

            const btnTarget = document.getElementById('ddBtnSetTarget');
            if (targetTimeStr) {
                btnTarget.style.display = 'inline-block';
                btnTarget.innerHTML = `<i class="bi bi-bullseye me-1"></i> Set On-Time (${targetTimeStr})`;
            } else {
                btnTarget.style.display = 'none';
            }

            const inputEl = document.getElementById('ddInputDateTime');
            if (targetFullTime) {
                inputEl.value = targetFullTime;
            } else {
                ddSetCurrentTime();
            }

            document.getElementById('ddInputNotes').value = '';
            document.getElementById('ddFeedback').innerHTML = '';
            const btnSubmit = document.getElementById('ddBtnSubmit');
            btnSubmit.disabled = false;

            const modal = new bootstrap.Modal(document.getElementById('modalDriverDeparture'));
            modal.show();
        }

        function ddSetTargetTime() {
            if (ddTargetFullTime) {
                document.getElementById('ddInputDateTime').value = ddTargetFullTime;
                document.getElementById('ddFeedback').innerHTML = '<span class="text-success"><i class="bi bi-check2-circle me-1"></i> Waktu disetel ke target (On-Time)</span>';
            }
        }

        function ddSetCurrentTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('ddInputDateTime').value = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.getElementById('ddFeedback').innerHTML = '<span class="text-info"><i class="bi bi-clock me-1"></i> Waktu disetel ke jam sekarang</span>';
        }

        function ddAdjustMinutes(mins) {
            const inputEl = document.getElementById('ddInputDateTime');
            if (!inputEl.value) { ddSetCurrentTime(); return; }
            const dt = new Date(inputEl.value);
            if (isNaN(dt.getTime())) return;
            dt.setMinutes(dt.getMinutes() + mins);
            const year = dt.getFullYear();
            const month = String(dt.getMonth() + 1).padStart(2, '0');
            const day = String(dt.getDate()).padStart(2, '0');
            const hours = String(dt.getHours()).padStart(2, '0');
            const minutes = String(dt.getMinutes()).padStart(2, '0');
            inputEl.value = `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        function submitDriverDeparture() {
            const inputEl = document.getElementById('ddInputDateTime');
            if (!inputEl.value) {
                document.getElementById('ddFeedback').innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Waktu keberangkatan wajib diisi.</span>';
                return;
            }

            const btnSubmit = document.getElementById('ddBtnSubmit');
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...';

            const form = document.getElementById('formDriverDeparture');
            const formData = new FormData(form);

            fetch('/Driver/Departure', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('ddFeedback').innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> ${data.message}</span>`;
                    setTimeout(() => {
                        const modalEl = document.getElementById('modalDriverDeparture');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                        location.reload();
                    }, 500);
                } else {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Simpan Konfirmasi Keberangkatan';
                    document.getElementById('ddFeedback').innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i> ${data.message || 'Gagal menyimpan'}</span>`;
                }
            })
            .catch(err => {
                console.error(err);
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Simpan Konfirmasi Keberangkatan';
                document.getElementById('ddFeedback').innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Terjadi kesalahan sistem.</span>';
            });
        }

        $(document).ready(function() {
            // SignalR Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/deliveryHub")
                .withAutomaticReconnect()
                .build();

            connection.on("deliveryUpdated", function (data) {
                console.log("Update received from SignalR:", data);
                var triggerActions = ["enterDock", "readyToDock", "arrival", "departure", "update", "leaderVerificationComplete"];
                if (!data || !data.action || triggerActions.indexOf(data.action) !== -1) {
                    location.reload();
                }
            });

            connection.start()
                .then(() => console.log("SignalR Connected to Delivery Hub"))
                .catch(err => console.error("SignalR Connection Error: ", err.toString()));

            setInterval(function() {
                var now = new Date();
                var timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                document.title = timeStr + ' - Portal Driver';
            }, 1000);
        });
    </script>
}
