                            </div>
                        </div>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-warning mb-1">
                            <i class="bi bi-lightning-charge-fill me-1"></i> PILIHAN CEPAT WAKTU:
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-warning fw-bold flex-grow-1 text-dark" id="daBtnSetTarget" onclick="daSetTargetTime()">
                                <i class="bi bi-bullseye me-1"></i> Set On-Time (Sesuai Rencana)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info fw-bold" onclick="daSetCurrentTime()">
                                <i class="bi bi-clock me-1"></i> Jam Sekarang
                            </button>
                        </div>
                        <div class="d-flex gap-1 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 flex-fill" style="font-size:0.75rem;" onclick="daAdjustMinutes(-5)">-5m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 flex-fill" style="font-size:0.75rem;" onclick="daAdjustMinutes(-10)">-10m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 flex-fill" style="font-size:0.75rem;" onclick="daAdjustMinutes(-15)">-15m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 flex-fill" style="font-size:0.75rem;" onclick="daAdjustMinutes(5)">+5m</button>
                        </div>
                    </div>

                    <!-- Input Datetime -->
                    <div class="mb-3">
                        <label for="daInputDateTime" class="form-label small fw-bold text-light">
                            <i class="bi bi-calendar-event me-1"></i> WAKTU KEDATANGAN:
                        </label>
                        <input type="datetime-local" class="form-control form-control-lg fw-bold" id="daInputDateTime" name="arrivalTime" 
                               style="background:#0f172a;border:2px solid #f59e0b;color:#fff;font-size:1.15rem;" required />
                    </div>

                    <!-- Catatan -->
                    <div class="mb-2">
                        <label for="daInputNotes" class="form-label small text-white-50">Catatan (Opsional):</label>
                        <input type="text" class="form-control form-control-sm" id="daInputNotes" name="notes" placeholder="Contoh: Macet, antrian panjang, dll" style="background:#0f172a;border:1px solid rgba(255,255,255,0.2);color:#fff;" />
                    </div>

                    <div id="daFeedback" class="mt-2" style="font-size:0.85rem;min-height:24px;"></div>
                </form>
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(245,158,11,0.25);">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-warning fw-bold px-4 text-dark" id="daBtnSubmit" onclick="submitDriverArrival()">
                    <i class="bi bi-check-circle-fill me-1"></i> Simpan Konfirmasi Kedatangan
                </button>
            </div>
        </div>
    </div>
</div>

