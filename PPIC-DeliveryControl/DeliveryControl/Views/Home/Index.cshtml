<!-- ===== DELAY PREPARE WARNING POPUP ===== -->
<div id="delayPreparePopup">
    <div class="popup-header">
        <span class="popup-title">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            DELAY PREPARE TERDETEKSI!
        </span>
        <button type="button" class="btn-close btn-close-white btn-sm" id="closeDelayPrepPopup" aria-label="Close"></button>
    </div>
    <div class="popup-body" id="delayPrepPopupBody">
        <!-- filled by JS -->
    </div>
    <div class="popup-footer">
        <button class="btn btn-danger btn-sm w-100" onclick="filterSchedules('delayprepare'); document.getElementById('delayPreparePopup').style.display='none';">
            <i class="bi bi-funnel-fill me-1"></i> Lihat Detail Delay
        </button>
        <button class="btn btn-outline-secondary btn-sm" id="dismissDelayPrepPopup" style="white-space:nowrap;">
            <i class="bi bi-x-lg"></i> Tutup
        </button>
    </div>
</div>

<script>
    let currentFilter = 'all';

    // ===== DELAY PREPARE POPUP STATE =====
    const knownDelayPrepKeys = new Set(); // tracks customer+cycle combos already shown
    let delayPopupSnoozed = false;        // true while popup is manually dismissed

    function checkDelayPrepareAlerts() {
        const allDelayRows = document.querySelectorAll('.schedule-row[data-delayprepare="true"][data-prepared="false"]');
        const newItems = [];
        allDelayRows.forEach(function(row) {
            const customer = row.getAttribute('data-customer') || '-';
            const cycle    = row.getAttribute('data-cycle')    || '-';
            const startP   = row.getAttribute('data-startprep') || '-';
            const endP     = row.getAttribute('data-endprep')   || '-';
            const key = customer + '|' + cycle;
            if (!knownDelayPrepKeys.has(key)) {
                knownDelayPrepKeys.add(key);
                newItems.push({ customer, cycle, startP, endP });
            }
        });

        if (newItems.length > 0) {
            // Build popup item list
            const body = document.getElementById('delayPrepPopupBody');
            if (body) {
                newItems.forEach(function(it) {
                    const div = document.createElement('div');
                    div.className = 'delay-item';
                    div.innerHTML =
                        '<span class="popup-blink-icon text-danger"><i class="bi bi-exclamation-triangle-fill"></i></span>' +
                        '<div>' +
                            '<div class="delay-customer">' + it.customer + ' &mdash; ' + it.cycle + '</div>' +
                            '<div class="delay-meta"><i class="bi bi-clock-fill me-1 text-warning"></i>Prepare: ' + it.startP + ' – ' + it.endP + ' (Terlambat)</div>' +
                        '</div>';
                    body.appendChild(div);
                });
            }
            // Show popup (reset snooze because new item appeared)
            delayPopupSnoozed = false;
            const popup = document.getElementById('delayPreparePopup');
            if (popup) {
                popup.style.display = 'block';
                popup.style.animation = 'none';
                popup.offsetHeight; // reflow
                popup.style.animation = 'slideInRight 0.35s ease';
            }
        }
    }

    // ── Hide Completed State (persisted in localStorage) ───────────────────
    var storedHide = localStorage.getItem('dashHideCompleted');
    var _hideCompleted = storedHide === null ? true : storedHide === 'true'; // default: true (sembunyikan closed delivery)

    function _updateToggleCompletedBtn() {
        var btn  = document.getElementById('toggleCompletedBtn');
        var icon = document.getElementById('toggleCompletedIcon');
        var txt  = document.getElementById('toggleCompletedText');
        if (!btn) return;
        if (_hideCompleted) {
            btn.className  = 'btn btn-sm btn-outline-secondary';
            icon.className = 'bi bi-eye';
            txt.textContent = 'Tampilkan Selesai';
            btn.title = 'Tampilkan jadwal yang sudah Completed (mode Audit)';
        } else {
            btn.className  = 'btn btn-sm btn-outline-success';
            icon.className = 'bi bi-eye-slash';
            txt.textContent = 'Sembunyikan Selesai';
            btn.title = 'Sembunyikan jadwal yang sudah Completed';
        }
    }

    window.toggleCompleted = function() {
        _hideCompleted = !_hideCompleted;
        localStorage.setItem('dashHideCompleted', _hideCompleted ? 'true' : 'false');
        _updateToggleCompletedBtn();
        filterSchedules(currentFilter);
    };

    function filterSchedules(filter) {
        currentFilter = filter;

        // Update active card
        document.querySelectorAll('.filter-card').forEach(card => {
            card.classList.remove('active');
        });
        const activeCard = document.querySelector(`[data-filter="${filter}"]`);
        if (activeCard) {
            activeCard.classList.add('active');
        }

        // Show/hide reset button
        const resetBtn = document.getElementById('resetFilterBtn');
        if (resetBtn) {
            resetBtn.style.display = filter === 'all' ? 'none' : 'inline-block';
        }

        // Filter table rows
        const rows = document.querySelectorAll('.schedule-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const status = row.getAttribute('data-status');
            const hasArrived = row.getAttribute('data-arrived') === 'true';
            const isDelayPickup = row.getAttribute('data-delaypickup') === 'true';
            const isDelayPrepare = row.getAttribute('data-delayprepare') === 'true';
            const isCompleted = row.getAttribute('data-completed') === 'true' || status === 'completed' || status === 'closeddelivery';
            let shouldShow = false;

            if (filter === 'all') {
                shouldShow = true;
            } else if (filter === 'shortage') {
                shouldShow = row.getAttribute('data-shortage') === 'true' || status === 'shortagedelivery';
            } else if (filter === 'completed') {
                shouldShow = isCompleted;
            } else if (filter === 'in_progress') {
                shouldShow = row.getAttribute('data-sudahproses') === 'true';
            } else if (filter === 'waiting') {
                shouldShow = row.getAttribute('data-waitingproses') === 'true';
            } else if (filter === 'inprogress') {
                shouldShow = status === 'progrespreparation' || status === 'inprogress';
            } else if (filter === 'delaydelivery') {
                shouldShow = row.getAttribute('data-delaydelivery') === 'true' || status === 'delaydelivery';
            } else if (filter === 'delaypickup') {
                shouldShow = isDelayPickup || row.getAttribute('data-delaypickup') === 'true' || status === 'waitingpickup';
            } else if (filter === 'delayprepare') {
                shouldShow = isDelayPrepare === true || row.getAttribute('data-delayprepare') === 'true';
            } else if (filter === 'notarrived') {
                shouldShow = row.getAttribute('data-notarrived') === 'true' || status === 'waitingdockin';
            } else if (filter === 'prepared') {
                shouldShow = row.getAttribute('data-prepared') === 'true';
            } else if (filter === 'ontimeprepare') {
                shouldShow = row.getAttribute('data-ontimeprepare') === 'true';
            } else if (filter === 'ontimedock') {
                shouldShow = row.getAttribute('data-ontimedock') === 'true';
            } else if (filter === 'ontimeloading') {
                shouldShow = row.getAttribute('data-ontimeloading') === 'true';
            } else if (filter === 'ontimedelivery') {
                shouldShow = row.getAttribute('data-ontimedelivery') === 'true';
            }

            // Sembunyikan completed jika mode hide aktif (hanya saat filter === 'all')
            if (shouldShow && _hideCompleted && isCompleted && filter === 'all') {
                shouldShow = false;
            }

            if (shouldShow) {
                row.classList.remove('hidden');
                visibleCount++;
            } else {
                row.classList.add('hidden');
            }
        });

        // Update row numbers
        let rowNumber = 1;
        rows.forEach(row => {
            const badge = row.querySelector('.row-number-text');
            if (!badge) return;
            if (!row.classList.contains('hidden')) {
                badge.textContent = rowNumber++;
            } else {
                badge.textContent = '';
            }
        });

        // Update section headers visibility: sembunyikan header section jika tidak ada child schedule-row yang terlihat
        document.querySelectorAll('.schedule-section-header').forEach(hdr => {
            let nextEl = hdr.nextElementSibling;
            let hasVisibleChild = false;
            while (nextEl && !nextEl.classList.contains('schedule-section-header')) {
                if (nextEl.classList.contains('schedule-row') && !nextEl.classList.contains('hidden')) {
                    hasVisibleChild = true;
                    break;
                }
                nextEl = nextEl.nextElementSibling;
            }
            hdr.style.display = hasVisibleChild ? '' : 'none';
        });

        // ─── Penanganan UI Table vs Empty State ───
        const tableWrapper = document.getElementById('table-wrapper');
        const emptyContainer = document.getElementById('empty-state-container');
        
        // Hapus empty state wrapper dan info row lama
        document.querySelectorAll('.empty-state-filter-wrapper').forEach(el => el.remove());
        document.querySelectorAll('.empty-filter-row').forEach(el => el.remove());

        if (rows.length === 0) {
            // Memang 0 data sama sekali dari server untuk tanggal ini
            if (tableWrapper) tableWrapper.style.display = 'none';
            if (emptyContainer) emptyContainer.style.display = 'block';
        } else {
            // Ada data jadwal di DOM — tabel UTAMA HARUS SELALU TETAP TAMPIL
            if (tableWrapper) tableWrapper.style.display = 'block';
            if (emptyContainer) emptyContainer.style.display = 'none';

            if (visibleCount === 0) {
                // Ada data, tapi filter saat ini tidak memiliki baris yang cocok
                const tbody = document.querySelector('#table-container tbody');
                if (tbody) {
                    const emptyRow = document.createElement('tr');
                    emptyRow.className = 'empty-filter-row';
                    const colCount = document.querySelectorAll('#table-container thead th').length || 12;
                    emptyRow.innerHTML = `
                        <td colspan="${colCount}" class="text-center py-4" style="background: rgba(30,41,59,0.3); color: #94a3b8; font-size: 0.95rem;">
                            <i class="bi bi-funnel me-2 text-info"></i>Tidak ada jadwal yang sesuai dengan filter ini.
                            <button class="btn btn-sm btn-outline-info ms-3 px-3" onclick="filterSchedules('all')">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Tampilkan Semua Jadwal
                            </button>
                        </td>
                    `;
                    tbody.appendChild(emptyRow);
                }
            }
        }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        _updateToggleCompletedBtn();

        // Default: tampilkan semua & aktifkan card Total Order
        filterSchedules('all');

        // Pastikan card Total Order aktif secara visual saat pertama load
        const totalOrderCard = document.querySelector('[data-filter="all"]');
        if (totalOrderCard) totalOrderCard.classList.add('active');

        if (window.currentForceOnTimeMode === true) {
            applyForceOnTimeVisuals(true);
        } else {
            // Check for pre-existing delay prepare on initial load
            safeSetTimeout(checkDelayPrepareAlerts, 500);
        }

        // Close/dismiss buttons for delay prepare popup
        document.getElementById('closeDelayPrepPopup')?.addEventListener('click', function() {
            delayPopupSnoozed = true;
            document.getElementById('delayPreparePopup').style.display = 'none';
        });
        document.getElementById('dismissDelayPrepPopup')?.addEventListener('click', function() {
            delayPopupSnoozed = true;
            document.getElementById('delayPreparePopup').style.display = 'none';
        });
    });
</script>

