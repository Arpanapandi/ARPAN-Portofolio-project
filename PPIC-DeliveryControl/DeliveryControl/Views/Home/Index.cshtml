<style>
    /* CSS Kustom untuk Panel Indikator Dashboard */
    .indicator-panel-card {
        background: rgba(18, 24, 38, 0.95);
        border: 1.5px solid rgba(255, 255, 255, 0.35);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 140px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .indicator-panel-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
        border-color: #ffffff !important;
    }
    .indicator-panel-header {
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        text-align: center;
        padding: 9px 6px;
        letter-spacing: 0.8px;
        border-bottom: 2px solid #ffffff !important;
        color: #ffffff !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
    }
    .indicator-panel-body {
        display: flex;
        flex: 1;
        width: 100%;
    }
    .indicator-subcol {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 14px 6px 12px 6px;
        border-right: 2px solid rgba(255, 255, 255, 0.35);
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
    }
    .indicator-subcol:last-child {
        border-right: none !important;
    }
    .indicator-subcol:hover {
        filter: brightness(1.2);
    }
    .indicator-qty {
        font-size: 2.8rem;
        font-weight: 800;
        text-align: center;
        line-height: 1.1;
        margin-top: 4px;
        margin-bottom: 8px;
    }
    .indicator-label {
        font-size: 0.9rem;
        font-weight: 800;
        text-align: center;
        text-transform: uppercase;
        line-height: 1.2;
        letter-spacing: 0.4px;
        padding: 6px 2px 2px 2px;
        border-top: 1.5px dashed rgba(255, 255, 255, 0.4);
        width: 100%;
    }

    /* Subcol Fill Background Colors (Spesifik Hex Color Sesuai Instruksi User) */
    /* 🔴 DELAY (#FF0000) - Dinamis > 0 */
    .subcol-delay {
        background: #FF0000 !important;
    }
    /* 🟢 ON TIME / CLOSED (#16A34A) */
    .subcol-ontime {
        background: #16A34A !important;
    }
    /* 🟡 WAITING PROSES / TOTAL (#FFCC00) */
    .subcol-yellow {
        background: #FFCC00 !important;
    }
    /* 🔵 SUDAH PROSES (Cyan/Blue) */
    .subcol-blue {
        background: #0284C7 !important;
    }
    /* ⬛ Theme Dark Container saat data = 0 */
    .subcol-theme {
        background: rgba(30, 41, 59, 0.65) !important;
    }
    .subcol-theme .indicator-qty {
        color: #e2e8f0 !important;
        text-shadow: none;
    }
    .subcol-theme .indicator-label {
        color: #e2e8f0 !important;
        opacity: 0.9;
        text-shadow: none;
        border-top: 1.5px dashed rgba(255, 255, 255, 0.4) !important;
    }

    /* Warna Qty & Label Text (Teks Putih dengan Shadow Kontras Tinggi) */
    .qty-white { color: #ffffff !important; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6); }
    .label-white { color: #ffffff !important; opacity: 1; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6); font-weight: 800; }

    /* Khusus Teks di atas Container Kuning #FFCC00 agar Keterbacaan Sangat Jelas */
    .subcol-yellow .indicator-qty { color: #000000 !important; text-shadow: none; }
    .subcol-yellow .indicator-label { color: #000000 !important; opacity: 1; font-weight: 800; border-top: 1.5px dashed rgba(0, 0, 0, 0.35) !important; }

    /* Warna Header per Panel - Konsisten dengan Tema Dark Dashboard (Elegant Deep Tones + Garis Pembatas Putih Jelas) */
    .header-order { background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%) !important; color: #ffffff !important; border-bottom: 2px solid #ffffff !important; }
    .header-prepare { background: linear-gradient(135deg, #78350f 0%, #b45309 100%) !important; color: #ffffff !important; border-bottom: 2px solid #ffffff !important; }
    .header-dock { background: linear-gradient(135deg, #0c4a6e 0%, #0369a1 100%) !important; color: #ffffff !important; border-bottom: 2px solid #ffffff !important; }
    .header-pickup { background: linear-gradient(135deg, #4c1d95 0%, #6d28d9 100%) !important; color: #ffffff !important; border-bottom: 2px solid #ffffff !important; }
    .header-delivery { background: linear-gradient(135deg, #064e3b 0%, #047857 100%) !important; color: #ffffff !important; border-bottom: 2px solid #ffffff !important; }
    .header-order-del { background: linear-gradient(135deg, #14532d 0%, #15803d 100%) !important; color: #ffffff !important; border-bottom: 2px solid #ffffff !important; }

    /* Animation pulse untuk delay yang > 0 */
    .delay-pulse-subcol {
        animation: pulse-red 2s infinite ease-in-out;
    }
    @@keyframes pulse-red {
        0%, 100% { background: #FF0000 !important; }
        50% { background: #B91C1C !important; }
    }
</style>

<!-- Statistics Cards (6 Panel Layout dengan Warna Container Red, Green, Yellow) -->
@{
    var totalToday = (int?)ViewBag.TodaySchedules ?? 0;
    var sudahProses = (int?)ViewBag.SudahProsesCount ?? 0;
    var waitingProses = (int?)ViewBag.WaitingProsesCount ?? 0;

    var onTimePrepare = (int?)ViewBag.OnTimePrepareCount ?? 0;
    var delayPrepare = (int?)ViewBag.DelayPrepareCount ?? 0;

    var onTimeDockIn = (int?)ViewBag.OnTimeDockInCount ?? 0;
    var delayDockIn = (int?)ViewBag.NotArrivedCount ?? 0;

    var onTimeLoading = (int?)ViewBag.OnTimeLoadingCount ?? 0;
    var delayPickup = (int?)ViewBag.DelayPickupCount ?? 0;

    var onTimeDelivery = (int?)ViewBag.OnTimeDeliveryCount ?? 0;
    var delayDelivery = (int?)ViewBag.DelayDeliveryCount ?? 0;

    var completed = (int?)ViewBag.CompletedCount ?? 0;
    var shortage = (int?)ViewBag.ShortageCount ?? 0;
}

<div class="row g-2 mb-4">
    <!-- 1. ORDER HARI INI -->
    <div class="col-xl-2 col-lg-4 col-md-4 col-6">
        <div class="indicator-panel-card">
            <div class="indicator-panel-header header-order">
                ORDER HARI INI
            </div>
            <div class="indicator-panel-body">
                <!-- TOTAL ORDER: Gray -->
                <div class="indicator-subcol filter-card" style="background-color: #6B7280 !important;" data-filter="all" onclick="filterSchedules('all')" title="Total Order">
                    <div class="indicator-qty qty-white" id="statTotalOrder">@totalToday</div>
                    <div class="indicator-label label-white">TOTAL<br>ORDER</div>
                </div>
                <!-- SUDAH PROSES: Biru -->
                <div class="indicator-subcol subcol-blue filter-card" data-filter="in_progress" onclick="filterSchedules('in_progress')" title="Sudah Proses">
                    <div class="indicator-qty qty-white" id="statSudahProses">@sudahProses</div>
                    <div class="indicator-label label-white">SUDAH<br>PROSES</div>
                </div>
                <!-- WAITING PROSES: Kuning -->
                <div class="indicator-subcol subcol-yellow filter-card" data-filter="waiting" onclick="filterSchedules('waiting')" title="Waiting Proses">
                    <div class="indicator-qty qty-white" id="statWaitingProses">@waitingProses</div>
                    <div class="indicator-label label-white">WAITING<br>PROSES</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. STATUS PREPARE -->
    <div class="col-xl-2 col-lg-4 col-md-4 col-6">
        <div class="indicator-panel-card">
            <div class="indicator-panel-header header-prepare">
                STATUS PREPARE
            </div>
            <div class="indicator-panel-body">
                <!-- ON TIME: Hijau Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(onTimePrepare > 0 ? "subcol-ontime" : "subcol-theme")" id="subcolOnTimePrepare" data-filter="ontimeprepare" onclick="filterSchedules('ontimeprepare')" title="On Time Prepare">
                    <div class="indicator-qty @(onTimePrepare > 0 ? "qty-white" : "")" id="statOnTimePrepare">@onTimePrepare</div>
                    <div class="indicator-label @(onTimePrepare > 0 ? "label-white" : "")">ON TIME<br>PREPARE</div>
                </div>
                <!-- DELAY: Merah Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(delayPrepare > 0 ? "subcol-delay delay-pulse-subcol" : "subcol-theme")" id="subcolDelayPrepare" data-filter="delayprepare" onclick="filterSchedules('delayprepare')" title="Delay Prepare">
                    <div class="indicator-qty @(delayPrepare > 0 ? "qty-white" : "")" id="delayPrepareStatValue">@delayPrepare</div>
                    <div class="indicator-label @(delayPrepare > 0 ? "label-white" : "")">DELAY<br>PREPARE</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. STATUS DOCK IN -->
    <div class="col-xl-2 col-lg-4 col-md-4 col-6">
        <div class="indicator-panel-card">
            <div class="indicator-panel-header header-dock">
                STATUS DOCK IN
            </div>
            <div class="indicator-panel-body">
                <!-- ON TIME: Hijau Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(onTimeDockIn > 0 ? "subcol-ontime" : "subcol-theme")" id="subcolOnTimeDockIn" data-filter="ontimedock" onclick="filterSchedules('ontimedock')" title="On Time Dock In">
                    <div class="indicator-qty @(onTimeDockIn > 0 ? "qty-white" : "")" id="statOnTimeDockIn">@onTimeDockIn</div>
                    <div class="indicator-label @(onTimeDockIn > 0 ? "label-white" : "")">ON TIME<br>DOCK IN</div>
                </div>
                <!-- DELAY: Merah Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(delayDockIn > 0 ? "subcol-delay delay-pulse-subcol" : "subcol-theme")" id="subcolDelayDockIn" data-filter="notarrived" onclick="filterSchedules('notarrived')" title="Delay Dock In">
                    <div class="indicator-qty @(delayDockIn > 0 ? "qty-white" : "")" id="delayDockInStatValue">@delayDockIn</div>
                    <div class="indicator-label @(delayDockIn > 0 ? "label-white" : "")">DELAY<br>DOCK IN</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. PICK UP TIME -->
    <div class="col-xl-2 col-lg-4 col-md-4 col-6">
        <div class="indicator-panel-card">
            <div class="indicator-panel-header header-pickup">
                PICK UP TIME
            </div>
            <div class="indicator-panel-body">
                <!-- ON TIME: Hijau Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(onTimeLoading > 0 ? "subcol-ontime" : "subcol-theme")" id="subcolOnTimeLoading" data-filter="ontimeloading" onclick="filterSchedules('ontimeloading')" title="On Time Loading">
                    <div class="indicator-qty @(onTimeLoading > 0 ? "qty-white" : "")" id="statOnTimeLoading">@onTimeLoading</div>
                    <div class="indicator-label @(onTimeLoading > 0 ? "label-white" : "")">ON TIME<br>LOADING</div>
                </div>
                <!-- DELAY: Merah Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(delayPickup > 0 ? "subcol-delay delay-pulse-subcol" : "subcol-theme")" id="subcolDelayPickup" data-filter="delaypickup" onclick="filterSchedules('delaypickup')" title="Delay Loading">
                    <div class="indicator-qty @(delayPickup > 0 ? "qty-white" : "")" id="delayPickupStatValue">@delayPickup</div>
                    <div class="indicator-label @(delayPickup > 0 ? "label-white" : "")">DELAY<br>LOADING</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. DELIVERY TIME -->
    <div class="col-xl-2 col-lg-4 col-md-4 col-6">
        <div class="indicator-panel-card">
            <div class="indicator-panel-header header-delivery">
                DELIVERY TIME
            </div>
            <div class="indicator-panel-body">
                <!-- ON TIME: Hijau Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(onTimeDelivery > 0 ? "subcol-ontime" : "subcol-theme")" id="subcolOnTimeDelivery" data-filter="ontimedelivery" onclick="filterSchedules('ontimedelivery')" title="On Time Delivery">
                    <div class="indicator-qty @(onTimeDelivery > 0 ? "qty-white" : "")" id="statOnTimeDelivery">@onTimeDelivery</div>
                    <div class="indicator-label @(onTimeDelivery > 0 ? "label-white" : "")">ON TIME<br>DELIVERY</div>
                </div>
                <!-- DELAY: Merah Dinamis (> 0) -->
                <div class="indicator-subcol filter-card @(delayDelivery > 0 ? "subcol-delay delay-pulse-subcol" : "subcol-theme")" id="subcolDelayDelivery" data-filter="delaydelivery" onclick="filterSchedules('delaydelivery')" title="Delay Delivery">
                    <div class="indicator-qty @(delayDelivery > 0 ? "qty-white" : "")" id="statDelayDelivery">@delayDelivery</div>
                    <div class="indicator-label @(delayDelivery > 0 ? "label-white" : "")">DELAY<br>DELIVERY</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. DELIVERY ORDER -->
    <div class="col-xl-2 col-lg-4 col-md-4 col-6">
        <div class="indicator-panel-card">
            <div class="indicator-panel-header header-order-del">
                DELIVERY ORDER
            </div>
            <div class="indicator-panel-body">
                <!-- CLOSED: Hijau Dinamis (> 0) / Theme Gelap (= 0) -->
                <div class="indicator-subcol filter-card @(completed > 0 ? "subcol-ontime" : "subcol-theme")" id="subcolCompleted" data-filter="completed" onclick="filterSchedules('completed')" title="Closed Delivery">
                    <div class="indicator-qty @(completed > 0 ? "qty-white" : "")" id="completedStatValue">@completed</div>
                    <div class="indicator-label @(completed > 0 ? "label-white" : "")">CLOSED<br>DELIVERY</div>
                </div>
                <!-- SHORTAGE: Merah Dinamis (> 0) / Theme Gelap (= 0) -->
                <div class="indicator-subcol filter-card @(shortage > 0 ? "subcol-delay delay-pulse-subcol" : "subcol-theme")" id="subcolShortage" data-filter="shortage" onclick="filterSchedules('shortage')" title="Shortage Delivery">
                    <div class="indicator-qty @(shortage > 0 ? "qty-white" : "")" id="shortageStatValue">@shortage</div>
                    <div class="indicator-label @(shortage > 0 ? "label-white" : "")">SHORTAGE<br>DELIVERY</div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var currentUserRole = Context.Session?.GetString("Role") ?? string.Empty;
    var isAdminOrSuperAdmin = currentUserRole == "Admin" || currentUserRole == "Super Admin";
}

<!-- Today's Schedule -->
<div class="row">
    <div class="col-12">
        <div class="cyber-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-calendar-day me-2" style="color: var(--primary-blue);"></i>
                        Jadwal Delivery Hari Ini
                    </h5>
                    @* H-1 info removed *@
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (isAdminOrSuperAdmin)
                    {
                        <button type="button" class="btn btn-sm btn-danger" id="bulkDeleteBtn" style="display:none;" onclick="confirmBulkDelete()">
                            <i class="bi bi-trash"></i> Hapus Terpilih (<span id="selectedCount">0</span>)
                        </button>
                        @if (currentUserRole == "Super Admin")
                        {
                            <button type="button" class="btn btn-sm @(ViewBag.ForceOnTimeMode == true ? "btn-success" : "btn-outline-success")" id="toggleForceOnTimeBtn" onclick="toggleForceOnTime()" title="Manipulasi Status Delay Menjadi On Time">
                                <i class="bi bi-magic" id="forceOnTimeIcon"></i> <span id="forceOnTimeText">Manipulasi: @(ViewBag.ForceOnTimeMode == true ? "ON" : "OFF")</span>
                            </button>
                            <button type="button" class="btn btn-sm @(ViewBag.IsRangeFilterActive == true ? "btn-primary" : "btn-outline-primary")" id="dateRangeFilterBtn" onclick="openDateRangeModal()" title="Filter Range Tanggal Delivery (Super Admin)">
                                <i class="bi bi-calendar-range" id="dateRangeFilterIcon"></i> <span id="dateRangeFilterText">Filter Tanggal: @(ViewBag.IsRangeFilterActive == true ? $"{ViewBag.ActiveStartDate} s/d {ViewBag.ActiveEndDate}" : "Default")</span>
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-outline-info" id="minusKbnBtn" onclick="showMinusKanban()" title="Lihat summary kanban yang belum scan">
                            <i class="bi bi-bar-chart-steps" id="minusKbnIcon"></i> Tarik Data Minus
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning" id="recalcKbnBtn" onclick="recalculateKanban()" title="Hitung ulang KBN PREP dari data scan sesungguhnya">
                            <i class="bi bi-calculator" id="recalcKbnIcon"></i> Recalc KBN
                        </button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-light" id="refreshBtn" title="Refresh Data" onclick="manualRefresh()">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleCompletedBtn"
                            title="Tampilkan jadwal yang sudah Completed (mode Audit)"
                            onclick="toggleCompleted()">
                        <i class="bi bi-eye" id="toggleCompletedIcon"></i>
                        <span id="toggleCompletedText">Tampilkan Selesai</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="autoScrollToggle" title="Toggle Auto Scroll">
                        <i class="bi bi-arrow-down-up" id="autoScrollIcon"></i>
                        <span id="autoScrollText">Auto Scroll: ON</span>
                    </button>
                    <span class="badge bg-primary" style="font-size: 0.9rem;">
                        <i class="bi bi-clock-history"></i> Live
                    </span>
                </div>
            </div>
            <div class="card-body p-0" id="main-card-body">
                @{
                    bool hasData = Model != null && Model.Any();
                }
                <div id="table-wrapper" style="@(hasData ? "" : "display: none;")">
                    <!-- Reset Filter Button -->
                    <div class="d-flex justify-content-end p-3 pb-0">
                        <button id="resetFilterBtn" class="btn btn-outline-secondary btn-sm" onclick="filterSchedules('all')" style="display: none;">
                            <i class="bi bi-arrow-clockwise"></i> Reset All Filters
                        </button>
                    </div>
                    <div id="table-container" style="max-height: 600px; overflow-y: auto; overflow-x: auto;">
                        <table class="table table-hover table-bordered mb-0 align-middle">
                        <thead class="table-dark" style="position: sticky; top: 0; z-index: 100; background-color: #212529;">
                            <tr style="font-size: 0.9rem;">
                                @if (isAdminOrSuperAdmin)
                                {
                                    <th class="text-center align-middle" style="width: 35px; background-color: #212529;">
                                        <input type="checkbox" id="selectAll" class="form-check-input" title="Pilih Semua" style="cursor: pointer;">
                                    </th>
                                }
                                <th class="text-center" style="width: 90px; background-color: #212529;"><i class="bi bi-building"></i> CUSTOMER</th>
                                <th class="text-center" style="width: 95px; background-color: #212529;"><i class="bi bi-pin-map-fill"></i> DOCK</th>
                                <th class="text-center" style="width: 65px; background-color: #212529;"><i class="bi bi-arrow-repeat"></i> CYCLE</th>
                                <th class="text-center" style="width: 75px; background-color: #212529;"><i class="bi bi-signpost-split"></i> ROUTE</th>
