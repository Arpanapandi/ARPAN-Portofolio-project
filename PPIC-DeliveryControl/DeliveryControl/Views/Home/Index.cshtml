    let isToggleDebouncing = false;
    
    function applyForceOnTimeVisuals(isON) {
        if (isON) {
            // 1. Force delay cards to 0 with correct element IDs
            $('#delayPickupStatValue, #delayDockInStatValue, #delayPrepareStatValue')
                .text('0')
                .removeClass('text-danger blink-text');

            // Pastikan indikator kartu delay tetap berwarna merah (red gradient)
            $('[data-filter="delaypickup"], [data-filter="notarrived"], [data-filter="delayprepare"]')
                .css('background', 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)');

            // 2. Force table badges instantly for optimistic UI response
            $('#table-container tbody tr').each(function() {
                // Sembunyikan badge KBN Kurang
                $(this).find('.badge.bg-warning.text-dark:contains("KBN Kurang")').remove();

                $(this).find('.badge.bg-danger').each(function() {
                    const txt = $(this).text().toLowerCase();
                    if (txt.includes('delay') || txt.includes('terlambat') || txt.includes('belum tiba') || txt.includes('dock in') || txt.includes('delivery')) {
                        $(this).removeClass('bg-danger').addClass('bg-success text-white');
                        $(this).html('<i class="bi bi-check-circle-fill"></i> Completed');
                    }
                });
                // Hide red blink texts (+ X m)
                $(this).find('.text-danger.blink-text').hide();
                
                // Ubah status kuning Delayed/DelayPickup/DelayDelivery ke Completed
                $(this).find('.badge.bg-warning.text-dark').each(function() {
                    const txt = $(this).text().toLowerCase();
                    if (txt.includes('delay')) {
                        $(this).removeClass('bg-warning text-dark').addClass('bg-success text-white');
                        $(this).html('<i class="bi bi-check-circle-fill"></i> Completed');
                    }
                });
            });

            // Dismiss delay prepare alert popup if visible
            const popup = document.getElementById('delayPreparePopup');
            if (popup) popup.style.display = 'none';
        } else {
            // Mode OFF tetap pertahankan warna merah
            $('[data-filter="delaypickup"], [data-filter="notarrived"], [data-filter="delayprepare"]')
                .css('background', 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)');
        }
    }

    function toggleForceOnTime() {
        if (isToggleDebouncing) return;
        isToggleDebouncing = true;
        
        const btn = $('#toggleForceOnTimeBtn');
        const text = $('#forceOnTimeText');
        const isCurrentlyOn = btn.hasClass('btn-success');
        const targetMode = !isCurrentlyOn;
        
        // Update local state instantly
        window.currentForceOnTimeMode = targetMode;
        
        // 1. OPTIMISTIC UI UPDATE: Seketika rubah tombol agar terasa instan (< 0ms)
        if (targetMode) {
            text.text('Manipulasi: ON');
            btn.removeClass('btn-outline-success').addClass('btn-success');
            applyForceOnTimeVisuals(true);
        } else {
            text.text('Manipulasi: OFF');
            btn.removeClass('btn-success').addClass('btn-outline-success');
            applyForceOnTimeVisuals(false);
        }
        
        btn.prop('disabled', true);
        if (isConnected) updateStatusBadge('live', 'Applying...');

        // 2. BACKGROUND SYNC: Kirim POST ke server
        $.post('@Url.Action("ToggleForceOnTime", "Home")', function (res) {
            isToggleDebouncing = false;
            btn.prop('disabled', false);
            if (isConnected) updateStatusBadge('live', 'Live');

            if (res.success) {
                // Update local state secara pasti dari response server
                window.currentForceOnTimeMode = res.isActive;
                applyForceOnTimeVisuals(res.isActive);
                // LANGSUNG eksekusi update tabel dan angka statistik tanpa menunggu SignalR!
                Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
                showToast(res.isActive ? '✨ Mode manipulasi aktif (On Time).' : 'Mode manipulasi dinonaktifkan.', 'info');
            } else {
                // Revert jika respon bukan success
                window.currentForceOnTimeMode = isCurrentlyOn;
                if (isCurrentlyOn) {
                    text.text('Manipulasi: ON');
                    btn.removeClass('btn-outline-success').addClass('btn-success');
                } else {
                    text.text('Manipulasi: OFF');
                    btn.removeClass('btn-success').addClass('btn-outline-success');
                }
                applyForceOnTimeVisuals(isCurrentlyOn);
            }
        }).fail(() => {
            isToggleDebouncing = false;
            window.currentForceOnTimeMode = isCurrentlyOn;
            if (isCurrentlyOn) {
                text.text('Manipulasi: ON');
                btn.removeClass('btn-outline-success').addClass('btn-success');
            } else {
                text.text('Manipulasi: OFF');
                btn.removeClass('btn-success').addClass('btn-outline-success');
            }
            applyForceOnTimeVisuals(isCurrentlyOn);
            btn.prop('disabled', false);
            if (isConnected) updateStatusBadge('live', 'Live');
            showToast('Gagal mengganti mode manipulasi. Coba lagi.', 'danger');
            
            // Re-fetch untuk mengembalikan UI ke state asli
            updateTableData();
            updateStatistics();
        });
    }

    // SignalR listener for global date range filter
    connection.on("globalDateRangeFilterToggled", function(data) {
        console.log("⚡ SignalR globalDateRangeFilterToggled:", data);
        if (data.startDate && data.endDate) {
            $('#dateRangeFilterText').text('Filter Tanggal: ' + data.startDate + ' s/d ' + data.endDate);
            $('#dateRangeFilterBtn').removeClass('btn-outline-primary').addClass('btn-primary');
            $('#rangeStartDateSelect').val(data.startDate);
            $('#rangeEndDateSelect').val(data.endDate);
        } else {
            $('#dateRangeFilterText').text('Filter Tanggal: Default');
            $('#dateRangeFilterBtn').removeClass('btn-primary').addClass('btn-outline-primary');
            $('#rangeStartDateSelect').val('');
            $('#rangeEndDateSelect').val('');
        }
        Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
    });

    function openDateRangeModal() {
        var modal = new bootstrap.Modal(document.getElementById('dateRangeFilterModal'));
        modal.show();
    }

    function applyDateRangeFilter() {
        const start = $('#rangeStartDateSelect').val();
        const end = $('#rangeEndDateSelect').val();
        
        if (!start || !end) {
            showToast('Silakan pilih Tanggal Mulai dan Tanggal Selesai terlebih dahulu.', 'warning');
            return;
        }

        if (start > end) {
            showToast('Tanggal Mulai tidak boleh lebih besar dari Tanggal Selesai.', 'warning');
            return;
        }

        $.ajax({
            url: '@Url.Action("SetGlobalDateRangeFilter", "Home")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ startDate: start, endDate: end }),
            success: function(res) {
                if (res.success) {
                    var modalEl = document.getElementById('dateRangeFilterModal');
                    var modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                    showToast('✨ Filter range tanggal aktif: ' + start + ' s/d ' + end, 'info');
                    $('#dateRangeFilterText').text('Filter Tanggal: ' + start + ' s/d ' + end);
                    $('#dateRangeFilterBtn').removeClass('btn-outline-primary').addClass('btn-primary');
                    Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
                } else {
                    showToast(res.message || 'Gagal menerapkan filter.', 'danger');
                }
            },
            error: function() {
                showToast('Gagal terhubung ke server.', 'danger');
            }
        });
    }

    function resetDateRangeFilter() {
        $.ajax({
            url: '@Url.Action("ResetGlobalDateRangeFilter", "Home")',
            type: 'POST',
            success: function(res) {
                if (res.success) {
                    var modalEl = document.getElementById('dateRangeFilterModal');
                    var modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                    $('#rangeStartDateSelect').val('');
                    $('#rangeEndDateSelect').val('');
                    showToast('Filter range tanggal di-reset ke Default.', 'info');
                    $('#dateRangeFilterText').text('Filter Tanggal: Default');
                    $('#dateRangeFilterBtn').removeClass('btn-primary').addClass('btn-outline-primary');
                    Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
                } else {
                    showToast('Gagal mereset filter.', 'danger');
                }
            },
            error: function() {
                showToast('Gagal terhubung ke server.', 'danger');
            }
        });
    }
</script>
}

<!-- Modal Filter Range Tanggal (Super Admin) -->
<div class="modal fade" id="dateRangeFilterModal" tabindex="-1" aria-labelledby="dateRangeFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-primary shadow-lg">
            <div class="modal-header border-secondary py-3">
                <h5 class="modal-title text-primary font-weight-bold" id="dateRangeFilterModalLabel">
                    <i class="bi bi-calendar-range me-2"></i>Filter Range Tanggal Delivery (Super Admin)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert bg-primary bg-opacity-10 border-primary text-info small mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>Filter ini bersifat <strong>global</strong> dan dinamis sesuai jadwal pengiriman yang ada pada database.
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="rangeStartDateSelect" class="form-label small fw-bold text-light">
                            <i class="bi bi-calendar-event me-1"></i>Tanggal Mulai (Start)
                        </label>
                        <select class="form-select bg-secondary text-white border-secondary" id="rangeStartDateSelect">
                            <option value="">-- Pilih Tanggal Mulai --</option>
                            @if (ViewBag.AvailableDates != null)
                            {
                                foreach (var d in (List<string>)ViewBag.AvailableDates)
                                {
                                    var isSel = (string)ViewBag.ActiveStartDate == d ? "selected" : "";
                                    @:<option value="@d" @isSel>@d</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="rangeEndDateSelect" class="form-label small fw-bold text-light">
                            <i class="bi bi-calendar-event-fill me-1"></i>Tanggal Selesai (End)
                        </label>
                        <select class="form-select bg-secondary text-white border-secondary" id="rangeEndDateSelect">
                            <option value="">-- Pilih Tanggal Selesai --</option>
                            @if (ViewBag.AvailableDates != null)
                            {
                                foreach (var d in (List<string>)ViewBag.AvailableDates)
                                {
                                    var isSel = (string)ViewBag.ActiveEndDate == d ? "selected" : "";
                                    @:<option value="@d" @isSel>@d</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary py-2 justify-content-between">
                <button type="button" class="btn btn-sm btn-outline-warning" onclick="resetDateRangeFilter()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filter (Default)
                </button>
                <div>
                    <button type="button" class="btn btn-sm btn-secondary me-2" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-sm btn-primary" onclick="applyDateRangeFilter()">
                        <i class="bi bi-check-circle-fill me-1"></i>Terapkan Filter
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Hidden form for anti-forgery token *@
<form id="hiddenTokenForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>
