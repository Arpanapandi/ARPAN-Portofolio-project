@section Scripts {
<script>
    // ============================================
    // INITIALIZATION - HARUS DI AWAL
    // ============================================
    
    // Initialize timeout tracking array - HARUS di awal sebelum fungsi apapun
    if (typeof window.dashboardTimeouts === 'undefined') {
        window.dashboardTimeouts = [];
    }
    
    // Helper untuk track timeout dengan safety check - HARUS didefinisikan di awal
    function safeSetTimeout(callback, delay) {
        // Pastikan array selalu terinisialisasi (double-check untuk safety)
        if (!window.dashboardTimeouts || !Array.isArray(window.dashboardTimeouts)) {
            window.dashboardTimeouts = [];
        }
        
        const timeoutId = setTimeout(() => {
            try {
                callback();
            } catch (error) {
                console.error("Error in safeSetTimeout callback:", error);
            }
            
            // Remove dari array setelah execute (dengan safety check)
            if (window.dashboardTimeouts && Array.isArray(window.dashboardTimeouts)) {
                const index = window.dashboardTimeouts.indexOf(timeoutId);
                if (index > -1) {
                    window.dashboardTimeouts.splice(index, 1);
                }
            }
        }, delay);
        
        // Add ke tracking array (dengan safety check)
        if (window.dashboardTimeouts && Array.isArray(window.dashboardTimeouts)) {
            window.dashboardTimeouts.push(timeoutId);
        }
        
        return timeoutId;
    }
    
    // ============================================
    // SIGNALR REAL-TIME UPDATE CONFIGURATION
    // ============================================
    
    console.log("Initializing SignalR connection...");
    
    // Build SignalR connection
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/deliveryHub")
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000]) // Reconnect intervals
        .configureLogging(signalR.LogLevel.Information)
        .build();

    // Connection state management
    let isConnected = false;
    let reconnectAttempts = 0;
    const maxReconnectAttempts = 10;
    let pollingInterval = null;
    let usePollingFallback = false;
    
    // Global state for force on time mode
    window.currentForceOnTimeMode = @(ViewBag.ForceOnTimeMode == true ? "true" : "false");
    // Flag ini dihapus karena mekanisme abort dari request AJAX sudah menangani tumpang tindih.
    
    // Track pending AJAX requests to prevent stale responses from overwriting fresh data
    let pendingTableRequest = null;
    let pendingStatsRequest = null;

    // Toast notification function
    function showToast(message, type = 'info') {
        if (window.showUpdateNotification) {
            const notifType = type === 'success' ? 'delivery' : type === 'danger' ? 'danger' : 'info';
            window.showUpdateNotification(message, notifType, 5000);
            return;
        }
        // Fallback: Bootstrap toast
        const toastHtml = `
            <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999;">
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : type === 'danger' ? 'danger' : 'info'} border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle-fill' : type === 'danger' ? 'exclamation-triangle-fill' : 'info-circle-fill'}"></i> ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        `;
        $('body').append(toastHtml);
        safeSetTimeout(() => {
            $('.toast').fadeOut(300, function() { $(this).parent().remove(); });
        }, 5000);
    }

    // Update statistics cards dengan error handling dan retry
    let statisticsRetryCount = 0;
    const maxStatisticsRetries = 3;
    
    function updateStatistics() {
        // Batalkan request sebelumnya yang masih in-flight agar response lama tidak menimpa
        if (pendingStatsRequest && pendingStatsRequest.readyState !== 4) {
            pendingStatsRequest.abort();
            console.log("[updateStatistics] Aborted stale request");
        }
        
        var timestamp = new Date().getTime();
        var date = $('#dashboardDateFilter').val();
        
        var requestData = { _: timestamp, date: date };
        if (window.currentForceOnTimeMode !== null) {
            requestData.forceOnTime = window.currentForceOnTimeMode;
        }
        
        pendingStatsRequest = $.ajax({
            url: '@Url.Action("GetDashboardStatistics", "Home")',
            type: 'GET',
            cache: false,
            timeout: 15000, 
            headers: { 'Cache-Control': 'no-cache, no-store', 'Pragma': 'no-cache' },
            data: requestData,
            success: function(data) {
                console.log("📊 Statistics updated:", data);
                statisticsRetryCount = 0; // Reset retry count on success
                
                // Hitung display text untuk card completed (X / Y)
                var completedDisplay = data.completedCount;
                if (data.todaySchedules && data.todaySchedules > 0) {
                    completedDisplay = data.completedCount + ' / ' + data.todaySchedules;
                }

                // Update card values immediately for speed (13 sub-poin)
                if ($('#statTotalOrder').length) $('#statTotalOrder').text(data.todaySchedules || 0);
                if ($('#statSudahProses').length) $('#statSudahProses').text(data.sudahProsesCount || 0);
                if ($('#statWaitingProses').length) $('#statWaitingProses').text(data.waitingProsesCount || 0);

                if ($('#statOnTimePrepare').length) $('#statOnTimePrepare').text(data.onTimePrepareCount || 0);
                if ($('#delayPrepareStatValue').length) $('#delayPrepareStatValue').text(data.delayPrepareCount || 0);

                if ($('#statOnTimeDockIn').length) $('#statOnTimeDockIn').text(data.onTimeDockInCount || 0);
                if ($('#delayDockInStatValue').length) $('#delayDockInStatValue').text(data.notArrivedCount || 0);

                if ($('#statOnTimeLoading').length) $('#statOnTimeLoading').text(data.onTimeLoadingCount || 0);
                if ($('#delayPickupStatValue').length) $('#delayPickupStatValue').text(data.delayPickupCount || 0);

                if ($('#statOnTimeDelivery').length) $('#statOnTimeDelivery').text(data.onTimeDeliveryCount || 0);
                if ($('#statDelayDelivery').length) $('#statDelayDelivery').text(data.delayDeliveryCount || 0);

                if ($('#completedStatValue').length) $('#completedStatValue').text(data.completedCount || 0);
                if ($('#shortageStatValue').length) $('#shortageStatValue').text(data.shortageCount || 0);

                // Helper to update dynamic subcol theme vs red background based on count
                function updateSubcolState(subcolId, count) {
                    const $el = $('#' + subcolId);
                    if (!$el.length) return;
                    if (count > 0) {
                        $el.removeClass('subcol-theme subcol-yellow').addClass('subcol-delay delay-pulse-subcol');
                        $el.find('.indicator-qty').addClass('qty-white');
                        $el.find('.indicator-label').addClass('label-white');
                    } else {
                        $el.removeClass('subcol-delay delay-pulse-subcol subcol-yellow').addClass('subcol-theme');
                        $el.find('.indicator-qty').removeClass('qty-white');
                        $el.find('.indicator-label').removeClass('label-white');
                    }
                }

                function updateSubcolOnTimeState(subcolId, count) {
                    const $el = $('#' + subcolId);
                    if (!$el.length) return;
                    if (count > 0) {
                        $el.removeClass('subcol-theme').addClass('subcol-ontime');
                        $el.find('.indicator-qty').addClass('qty-white');
                        $el.find('.indicator-label').addClass('label-white');
                    } else {
                        $el.removeClass('subcol-ontime').addClass('subcol-theme');
                        $el.find('.indicator-qty').removeClass('qty-white');
                        $el.find('.indicator-label').removeClass('label-white');
                    }
                }

                updateSubcolState('subcolDelayPrepare', data.delayPrepareCount || 0);
                updateSubcolState('subcolDelayDockIn', data.notArrivedCount || 0);
                updateSubcolState('subcolDelayPickup', data.delayPickupCount || 0);
                updateSubcolState('subcolDelayDelivery', data.delayDeliveryCount || 0);
                updateSubcolState('subcolShortage', data.shortageCount || 0);
                
                updateSubcolOnTimeState('subcolOnTimePrepare', data.onTimePrepareCount || 0);
                updateSubcolOnTimeState('subcolOnTimeDockIn', data.onTimeDockInCount || 0);
                updateSubcolOnTimeState('subcolOnTimeLoading', data.onTimeLoadingCount || 0);
                updateSubcolOnTimeState('subcolOnTimeDelivery', data.onTimeDeliveryCount || 0);
                updateSubcolOnTimeState('subcolCompleted', data.completedCount || 0);

                // Global synchronization check across all devices (even when SignalR is disconnected)
                if (typeof data.forceOnTimeMode !== 'undefined' && window.currentForceOnTimeMode !== data.forceOnTimeMode) {
                    console.log("⚡ Auto-sync forceOnTimeMode from server state:", data.forceOnTimeMode);
                    window.currentForceOnTimeMode = data.forceOnTimeMode;
                    const btn = $('#toggleForceOnTimeBtn');
                    const text = $('#forceOnTimeText');
                    if (btn.length) {
                        if (data.forceOnTimeMode) {
                            text.text('Manipulasi: ON');
                            btn.removeClass('btn-outline-success').addClass('btn-success');
                        } else {
                            text.text('Manipulasi: OFF');
                            btn.removeClass('btn-success').addClass('btn-outline-success');
                        }
                    }
                    applyForceOnTimeVisuals(data.forceOnTimeMode);
                    updateTableData();
                } else if (window.currentForceOnTimeMode === true) {
                    applyForceOnTimeVisuals(true);
                }
            },
            error: function(err) {
                // Jangan retry jika request dibatalkan (abort/canceled) atau tidak sempat terkirim (readyState 0)
                if (err.statusText === 'abort' || err.statusText === 'canceled' || err.readyState === 0) {
                    return;
                }
                
                console.error("Failed to update statistics:", err);
                statisticsRetryCount++;
                
                // Retry dengan exponential backoff
                if (statisticsRetryCount < maxStatisticsRetries) {
                    const retryDelay = Math.min(1000 * Math.pow(2, statisticsRetryCount), 10000);
                    console.log(`🔄 Retrying statistics update in ${retryDelay}ms (attempt ${statisticsRetryCount}/${maxStatisticsRetries})`);
                    safeSetTimeout(updateStatistics, retryDelay);
                } else {
                    console.error("Max retries reached for statistics update");
                    statisticsRetryCount = 0; // Reset untuk next cycle
                }
            }
        });
        return pendingStatsRequest;
    }

    // Update table data dengan error handling dan retry
    let tableRetryCount = 0;
    const maxTableRetries = 3;
    
    function updateTableData() {
        // Batalkan request sebelumnya yang masih in-flight agar response lama tidak menimpa
        if (pendingTableRequest && pendingTableRequest.readyState !== 4) {
            pendingTableRequest.abort();
            console.log("[updateTableData] Aborted stale request");
        }
        
        var timestamp = new Date().getTime();
        var date = $('#dashboardDateFilter').val();
        
        var requestData = { _: timestamp, date: date };
        if (window.currentForceOnTimeMode !== null) {
            requestData.forceOnTime = window.currentForceOnTimeMode;
        }
        
        pendingTableRequest = $.ajax({
            url: '@Url.Action("GetScheduleTableData", "Home")',
            type: 'GET',
            cache: false,
            timeout: 15000, 
            headers: { 'Cache-Control': 'no-cache, no-store', 'Pragma': 'no-cache' },
            data: requestData,
            success: function(html) {
                // Update tbody safely if HTML returned
                if (html && typeof html === 'string') {
                    $('#table-container tbody').html(html);
                }
                
                // Re-apply visual after load
                if (window.currentForceOnTimeMode !== null) applyForceOnTimeVisuals(window.currentForceOnTimeMode);

                // Jalankan filterSchedules untuk update visibility dan sinkronisasi
                filterSchedules(currentFilter || 'all');

                // Check for any new delay prepare rows only if not in manipulation mode
                if (!window.currentForceOnTimeMode) {
                    checkDelayPrepareAlerts();
                }
                console.log("[updateTableData] Table update complete.");
            },
            error: function(err) {
                // Jangan retry jika request dibatalkan (abort/canceled) atau tidak sempat terkirim (readyState 0)
                if (err.statusText === 'abort' || err.statusText === 'canceled' || err.readyState === 0) {
                    return;
                }
                
                console.error("Failed to update table:", err);
                console.error("Error details:", err.responseText);
                tableRetryCount++;
                
                // Retry dengan exponential backoff
                if (tableRetryCount < maxTableRetries) {
                    const retryDelay = Math.min(1000 * Math.pow(2, tableRetryCount), 15000);
                    console.log(`🔄 Retrying table update in ${retryDelay}ms (attempt ${tableRetryCount}/${maxTableRetries})`);
                    safeSetTimeout(updateTableData, retryDelay);
                } else {
                    console.error("Max retries reached for table update");
                    tableRetryCount = 0; // Reset untuk next cycle
                }
            }
        });
        return pendingTableRequest;
    }

    // Helper function to update status badge
    function updateStatusBadge(status, text) {
        const badge = $('#signalr-status');
        badge.removeClass('status-connecting status-live status-reconnecting status-disconnected');
        badge.addClass(`status-${status}`);
        badge.find('.status-text').text(text);
    }

    // SignalR event handlers
    connection.on("connected", function(connectionId) {
        console.log("SignalR Connected! Connection ID:", connectionId);
        isConnected = true;
        reconnectAttempts = 0;
        
        // Update connection indicator
        updateStatusBadge('live', 'Live');
    });

    // Debounce timer for SignalR updates
    let signalRUpdateTimer = null;
    function debouncedSignalRUpdate() {
        if (signalRUpdateTimer) {
            clearTimeout(signalRUpdateTimer);
        }
        signalRUpdateTimer = safeSetTimeout(() => {
            Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
            signalRUpdateTimer = null;
        }, 500); // 500ms debounce
    }

    // Listen for Stock updates (often related to preparation)
    connection.on("updateStock", function() {
        console.log("Stock update received! Refreshing dashboard...");
        if (window.showUpdateNotification) {
            window.showUpdateNotification('Stock diperbarui — data baru masuk.', 'pulling', 4000);
        }
        debouncedSignalRUpdate();
    });

    connection.on("deliveryUpdated", function(data) {
        const timestamp = new Date().toLocaleTimeString();
        console.log(`[${timestamp}] Delivery Update Received:`, data);
        
        // Use camelCase for data properties (SignalR default)
        const action = data.action || data.Action || '';
        const message = data.message || data.Message || 'Data delivery diperbarui.';
        
        // Show notification
        const icon = action === 'arrival' ? '🚚' : (action === 'departure' ? '✅' : '🔄');
        showToast(`${icon} ${message}`, 'success');
        
        // Update dashboard data in parallel silently (debounced)
        debouncedSignalRUpdate();
    });

    // Global listener for ForceOnTime mode toggling
    connection.on("forceOnTimeToggled", function(data) {
        console.log("⚡ SignalR ForceOnTimeToggled Received:", data);
        
        // Sinkronkan state lokal dengan nilai dari server
        window.currentForceOnTimeMode = !!data.isActive;
        
        const btn = $('#toggleForceOnTimeBtn');
        const text = $('#forceOnTimeText');
        if (btn.length) {
            if (data.isActive) {
                text.text('Manipulasi: ON');
                btn.removeClass('btn-outline-success').addClass('btn-success');
            } else {
                text.text('Manipulasi: OFF');
                btn.removeClass('btn-success').addClass('btn-outline-success');
            }
            btn.prop('disabled', false);
            if (isConnected) updateStatusBadge('live', 'Live');
        }
        
        applyForceOnTimeVisuals(data.isActive);
        
        // Fetch real data dari server (dengan mode terbaru dari DB)
        Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
    });

    // Connection lifecycle events
    connection.onreconnecting((error) => {
        console.warn("SignalR reconnecting...", error);
        isConnected = false;
        updateStatusBadge('reconnecting', 'Reconnecting...');
    });

    connection.onreconnected((connectionId) => {
        console.log("SignalR reconnected! Connection ID:", connectionId);
        isConnected = true;
        reconnectAttempts = 0;
        updateStatusBadge('live', 'Live');
        
        // Refresh data after reconnection
        Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
    });

    connection.onclose((error) => {
        console.error("SignalR connection closed:", error);
        isConnected = false;
        updateStatusBadge('disconnected', 'Disconnected');
        
        // Auto reconnect
        if (reconnectAttempts < maxReconnectAttempts) {
            reconnectAttempts++;
            console.log(`🔄 Attempting to reconnect... (${reconnectAttempts}/${maxReconnectAttempts})`);
            safeSetTimeout(() => startConnection(), 5000);
        } else {
            console.error("❌ Max reconnect attempts reached. Switching to polling fallback.");
            showToast('SignalR tidak tersedia. Menggunakan polling sebagai fallback.', 'warning');
            startPollingFallback();
        }
    });

    // Start connection function
    async function startConnection() {
        try {
            await connection.start();
            console.log("✅ SignalR connection started successfully!");
            isConnected = true;
            reconnectAttempts = 0;
            usePollingFallback = false;
            stopPollingFallback(); // Stop polling if SignalR is working
            updateStatusBadge('live', 'Live'); // Update badge langsung saat connect berhasil
        } catch (err) {
            console.error("❌ SignalR connection failed:", err);
            isConnected = false;
            
            // After max attempts, switch to polling
            if (reconnectAttempts >= maxReconnectAttempts) {
                console.warn("⚠️ SignalR failed after max attempts. Using polling fallback.");
                startPollingFallback();
            } else {
                reconnectAttempts++;
                safeSetTimeout(() => startConnection(), 5000);
            }
        }
    }

    // Polling fallback function (jika SignalR tidak tersedia)
    function startPollingFallback() {
        if (usePollingFallback) {
            console.log("⚠️ Polling fallback already started, skipping...");
            return; // Already started
        }
        
        // Pastikan SignalR benar-benar stopped sebelum mulai polling
        if (connection && isConnected) {
            try {
                connection.stop().catch(err => console.error("Error stopping SignalR before polling:", err));
                isConnected = false;
            } catch (err) {
                console.error("Error in SignalR stop:", err);
            }
        }
        
        usePollingFallback = true;
        console.log("🔄 Starting polling fallback (every 5 seconds)...");
        updateStatusBadge('reconnecting', 'Polling Mode');
        
        // Clear existing interval if any (double-check)
        if (pollingInterval) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }
        
        // Immediate update
        Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
        
        // Then poll every 5 seconds
        pollingInterval = setInterval(function() {
            // Double-check: jika SignalR sudah connect, stop polling
            if (isConnected) {
                console.log("✅ SignalR reconnected, stopping polling fallback");
                stopPollingFallback();
                return;
            }
            
            // Pastikan polling masih aktif
            if (!usePollingFallback) {
                console.log("⚠️ Polling fallback disabled, stopping interval");
                if (pollingInterval) {
                    clearInterval(pollingInterval);
                    pollingInterval = null;
                }
                return;
            }
            
            console.log("🔄 Polling update...");
            Promise.all([updateStatistics(), updateTableData()]).catch(e => console.log('Update aborted', e));
        }, 5000);
    }

    function stopPollingFallback() {
        console.log("🛑 Stopping polling fallback...");
        if (pollingInterval) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }
        usePollingFallback = false;
        console.log("✅ Polling fallback stopped");
    }

