    let _minusKanbanData = [];

    async function showMinusKanban() {
        const btn = document.getElementById('minusKbnBtn');
        const icon = document.getElementById('minusKbnIcon');
        const dateVal = document.getElementById('dashboardDateFilter')?.value || '@DateTime.Today.ToString("yyyy-MM-dd")';

        btn.disabled = true;
        icon.className = 'bi bi-arrow-repeat spin-icon';

        try {
            const resp = await fetch(`/Home/GetMinusKanbanSummary?date=${encodeURIComponent(dateVal)}`);
            const result = await resp.json();
            _minusKanbanData = result.data || [];

            const body = document.getElementById('minusKbnModalBody');
            const waSection = document.getElementById('minusKbnWaSection');

            if (_minusKanbanData.length === 0) {
                body.innerHTML = '<div class="text-center py-4" style="color:#10b981;"><i class="bi bi-check-circle-fill fs-2"></i><p class="mt-2 mb-0">Semua kanban sudah terpenuhi!</p></div>';
                waSection.style.display = 'none';
            } else {
                // Group by customer+dock+cycle untuk rowspan
                const groups = [];
                const keyMap = {};
                for (const row of _minusKanbanData) {
                    const key = `${row.customer}||${row.dock}||${row.cycle}`;
                    if (!keyMap[key]) { keyMap[key] = []; groups.push({ customer: row.customer, dock: row.dock, cycle: row.cycle, rows: keyMap[key] }); }
                    keyMap[key].push(row);
                }

                const totalUnits = _minusKanbanData.reduce((s, r) => s + r.minusKanban, 0);
                let html = `<p class="text-muted small mb-2">Tanggal: <strong>${escHtml(result.date)}</strong> &nbsp;\u2014&nbsp; <strong class="text-warning">${_minusKanbanData.length}</strong> item &nbsp;|&nbsp; Total kurang: <strong class="text-danger">${totalUnits} kanban unit</strong></p>`;
                html += `<div class="table-responsive" style="max-height:calc(78vh - 160px); overflow-y:auto;">`;
                html += `<table class="table table-sm table-hover align-middle mb-0" style="color:#e2e8f0; font-size:0.85rem; border-collapse:collapse;">`;
                html += `<thead style="background:#1e2638; position:sticky; top:0; z-index:2;"><tr><th style="padding:6px 10px;">Customer</th><th style="padding:6px 10px;">Dock</th><th style="padding:6px 10px;">Cycle</th><th style="padding:6px 10px;">VIN</th><th class="text-center" style="padding:6px 10px;">Minus KBN</th></tr></thead><tbody>`;
                for (const grp of groups) {
                    const n = grp.rows.length;
                    for (let i = 0; i < n; i++) {
                        const row = grp.rows[i];
                        html += `<tr>`;
                        if (i === 0) {
                            html += `<td rowspan="${n}" style="vertical-align:middle; font-weight:600; border-right:1px solid rgba(255,255,255,0.1); padding:5px 10px;">${escHtml(grp.customer)}</td>`;
                            html += `<td rowspan="${n}" style="vertical-align:middle; border-right:1px solid rgba(255,255,255,0.1); padding:5px 10px;">${escHtml(grp.dock)}</td>`;
                            html += `<td rowspan="${n}" style="vertical-align:middle; border-right:1px solid rgba(255,255,255,0.1); padding:5px 10px;">${escHtml(grp.cycle)}</td>`;
                        }
                        html += `<td style="padding:5px 10px;"><code style="color:#67e8f9;">${escHtml(row.vin)}</code></td>`;
                        html += `<td class="text-center" style="padding:5px 10px;"><span class="badge bg-danger">-${row.minusKanban}</span></td>`;
                        html += `</tr>`;
                    }
                }
                html += `</tbody></table></div>`;
                body.innerHTML = html;
                waSection.style.display = '';
            }

            const modal = new bootstrap.Modal(document.getElementById('minusKanbanModal'));
            modal.show();
        } catch (e) {
            alert('\u274C Error: ' + e.message);
        } finally {
            btn.disabled = false;
            icon.className = 'bi bi-bar-chart-steps';
        }
    }

    function buildWaMessage() {
        const dateVal = document.getElementById('dashboardDateFilter')?.value || '@DateTime.Today.ToString("yyyy-MM-dd")';
        let msg = `*Summary Kanban Minus - ${dateVal}*\n\n`;
        // Group by customer+dock+cycle
        const keyMap = {};
        const order = [];
        for (const row of _minusKanbanData) {
            const key = `${row.customer}||${row.dock}||${row.cycle}`;
            if (!keyMap[key]) { keyMap[key] = []; order.push(key); }
            keyMap[key].push(row);
        }
        for (const key of order) {
            const [cust, dock, cycle] = key.split('||');
            msg += `- ${cust} ${dock} [${cycle}]\n`;
            for (const row of keyMap[key])
                msg += `  VIN: ${row.vin} | -${row.minusKanban} Kanban\n`;
            msg += `\n`;
        }
        msg += `Total: *${_minusKanbanData.length} item* belum lengkap`;
        return msg;
    }

