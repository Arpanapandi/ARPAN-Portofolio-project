<script>
(function () {
    var _clearMode = 'date'; // 'date' atau 'all'
    var _clearModalInstance = null;

    function getModal() {
        if (!_clearModalInstance)
            _clearModalInstance = new bootstrap.Modal(document.getElementById('clearScheduleModal'));
        return _clearModalInstance;
    }

    window.showClearScheduleModal = function (currentFilterDate) {
        // Reset state
        _clearMode = 'date';
        document.getElementById('clearScheduleConfirmInput').value = '';
        document.getElementById('btnDoClearSchedule').disabled = true;
        document.getElementById('btnDoClearSchedule').style.opacity = '0.5';

        // Set tanggal default = filter date yang sedang aktif
        var dateInput = document.getElementById('clearDateInput');
        dateInput.value = currentFilterDate || new Date().toISOString().split('T')[0];
        updateDateInfo();
        updateModeUI();
        getModal().show();
        setTimeout(function () { document.getElementById('clearScheduleConfirmInput').focus(); }, 400);
    };

    window.setClearMode = function (mode) {
        _clearMode = mode;
        document.getElementById('clearScheduleConfirmInput').value = '';
        document.getElementById('btnDoClearSchedule').disabled = true;
        document.getElementById('btnDoClearSchedule').style.opacity = '0.5';
        updateModeUI();
    };

    function updateModeUI() {
        var isDate = _clearMode === 'date';
        // Toggle date section visibility
        document.getElementById('clearDateSection').style.display = isDate ? 'block' : 'none';

        // Button Per Tanggal - active style
        var btnDate = document.getElementById('btnModeDate');
        btnDate.style.background    = isDate ? '#1e3a8a' : '#1e3a5f';
        btnDate.style.borderColor   = isDate ? '#60a5fa' : '#3b82f6';
        btnDate.style.color         = isDate ? '#fff'    : '#93c5fd';

        // Button Semua Data - active style
        var btnAll = document.getElementById('btnModeAll');
        btnAll.style.background   = !isDate ? '#450a0a' : '#1c1010';
        btnAll.style.borderColor  = !isDate ? '#f44336' : '#4b2020';
        btnAll.style.color        = !isDate ? '#fff'    : '#fca5a5';
    }

    function updateDateInfo() {
        var val = document.getElementById('clearDateInput').value;
        var info = document.getElementById('clearDateInfo');
        if (val) {
            var d = new Date(val + 'T00:00:00');
            var opts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            info.textContent = 'ðŸ“… ' + d.toLocaleDateString('id-ID', opts);
        } else {
            info.textContent = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var input   = document.getElementById('clearScheduleConfirmInput');
        var btn     = document.getElementById('btnDoClearSchedule');
        var dateInp = document.getElementById('clearDateInput');

        if (!input || !btn) return;

        dateInp.addEventListener('change', updateDateInfo);

        input.addEventListener('input', function () {
            var ok = this.value.trim().toUpperCase() === 'HAPUS';
            btn.disabled = !ok;
            btn.style.opacity = ok ? '1' : '0.5';
        });
        input.addEventListener('focus', function () { this.style.border = '1px solid #f44336'; });
        input.addEventListener('blur',  function () { this.style.border = '1px solid #2a3a5a'; });

        btn.addEventListener('click', function () {
            var self = this;
            self.disabled = true;
            self.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Menghapus...';

            var token = '';
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) token = tokenInput.value;

            var body = { mode: _clearMode };
            if (_clearMode === 'date') {
                body.date = document.getElementById('clearDateInput').value;
            }

            fetch('/PreparationSchedule/ClearPreparationData', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(body)
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                getModal().hide();
                if (res.success) {
                    if (window.showUpdateNotification)
                        window.showUpdateNotification(res.message || 'Data berhasil dihapus.', 'success', 5000);
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    if (window.showUpdateNotification)
                        window.showUpdateNotification(res.message || 'Gagal menghapus data.', 'danger', 6000);
                    self.disabled = false;
                    self.style.opacity = '1';
                    self.innerHTML = '<i class="bi bi-trash3-fill me-1"></i> Hapus Sekarang';
                }
            })
            .catch(function () {
                getModal().hide();
                if (window.showUpdateNotification)
                    window.showUpdateNotification('Terjadi kesalahan koneksi.', 'danger', 6000);
                self.disabled = false;
                self.style.opacity = '1';
                self.innerHTML = '<i class="bi bi-trash3-fill me-1"></i> Hapus Sekarang';
            });
        });
    });
})();
</script>

<!-- Repair / Pisah Jadwal JavaScript -->
<script>
(function() {
    var _repairDryRunData = null;
    var _resolvedSourceScheduleId = 0;   // integer ScheduleId hasil lookup
    var _resolvedTargetCustomerId = 0;   // integer CustomerId hasil lookup

    window.repairLookupSchedule = function() {
        var q = (document.getElementById('repairSourceScheduleId').value || '').trim();
        if (!q) { alert('Ketik nomor jadwal atau ID angka terlebih dahulu.'); return; }
        var el = document.getElementById('repairScheduleInfo');
        el.textContent = 'Mencari...';
        el.className = 'mt-1 text-muted';
        el.style.display = '';
        _resolvedSourceScheduleId = 0;
        document.getElementById('repairExecBtn').disabled = true;
        fetch('/PreparationSchedule/GetScheduleInfo?query=' + encodeURIComponent(q))
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d && d.success) {
                    _resolvedSourceScheduleId = d.scheduleId;
                    el.innerHTML = '\u2713 <b>' + (d.scheduleNumber || 'ID ' + d.scheduleId) + '</b>'
                        + ' &mdash; ' + (d.customerName || '-')
                        + ' | Cycle: ' + (d.cycle || '-')
                        + ' | ' + (d.scheduledDate || '')
                        + ' | ' + (d.totalItems || 0) + ' item'
                        + ' | Status: ' + (d.status || '-');
                    el.className = 'mt-1 text-success';
                } else {
                    el.textContent = '\u2718 ' + (d.message || 'Jadwal tidak ditemukan.');
                    el.className = 'mt-1 text-danger';
                }
            })
            .catch(function() {
                el.textContent = 'Error mencari jadwal.';
                el.className = 'mt-1 text-danger';
            });
    };

    window.repairLookupCustomer = function() {
        var custId = parseInt(document.getElementById('repairTargetCustomerId').value) || 0;
        if (!custId) { alert('Masukkan Customer ID (angka) terlebih dahulu.'); return; }
        _resolvedTargetCustomerId = 0;
        fetch('/PreparationSchedule/GetCustomerInfo?customerId=' + custId)
            .then(function(r) { return r.json(); })
            .then(function(d) {
                var el = document.getElementById('repairCustomerInfo');
                if (d && d.customerName) {
                    _resolvedTargetCustomerId = custId;
                    el.textContent = '\u2713 ' + d.customerName + ' (Code: ' + (d.customerCode || '-') + ', Cycle: ' + (d.cycle || '-') + ')';
                    el.className = 'mt-1 text-success';
                    el.style.display = '';
                } else {
                    el.textContent = '\u2718 Customer tidak ditemukan';
                    el.className = 'mt-1 text-danger';
                    el.style.display = '';
                }
            })
            .catch(function() {
                var el = document.getElementById('repairCustomerInfo');
                el.textContent = 'Error mencari customer.';
                el.className = 'mt-1 text-danger';
                el.style.display = '';
            });
    };

    function repairCall(dryRun) {
        // Gunakan ID yang sudah di-resolve via tombol Cari, fallback ke input langsung jika angka
        var srcId = _resolvedSourceScheduleId || parseInt(document.getElementById('repairSourceScheduleId').value) || 0;
        var tgtId = _resolvedTargetCustomerId || parseInt(document.getElementById('repairTargetCustomerId').value) || 0;
        if (!srcId) { alert('Cari jadwal source terlebih dahulu dengan tombol Cari.'); return; }
        if (!tgtId) { alert('Isi Target Customer ID dan klik Cari.'); return; }

        var btnDry  = document.getElementById('repairDryRunBtn');
        var btnExec = document.getElementById('repairExecBtn');
        btnDry.disabled = true;
        if (!dryRun) btnExec.disabled = true;

        fetch('/PreparationSchedule/RepairSplitSchedule', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sourceScheduleId: srcId, targetCustomerId: tgtId, dryRun: dryRun })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            btnDry.disabled = false;
            if (dryRun) {
                _repairDryRunData = res;
                var el = document.getElementById('repairDryRunResult');
                el.classList.remove('d-none');
                var txt  = document.getElementById('repairDryRunText');
                var pts  = document.getElementById('repairDryRunParts');
                var cls  = (res.itemsToMove > 0) ? 'text-success' : 'text-warning';
                txt.innerHTML = '<span class="' + cls + '">'
                    + (res.message || '') + '</span>'
                    + '<br><small class="text-muted">Total item di source: ' + (res.totalItems || 0)
                    + ' &bull; Akan dipindah: <b class="text-info">' + (res.itemsToMove || 0) + '</b>'
                    + ' &bull; Tetap di source: ' + (res.itemsToKeep || 0) + '</small>';
                pts.textContent = (res.movedPartNos && res.movedPartNos.length)
                    ? 'Part Nos: ' + res.movedPartNos.join(', ')
                    : '';
                btnExec.disabled = !(res.success && res.itemsToMove > 0);
            } else {
                var el = document.getElementById('repairActionResult');
                el.className = (res.success ? 'alert alert-success' : 'alert alert-danger') + ' mt-2 p-2 rounded';
                el.textContent = res.message || (res.success ? 'Berhasil.' : 'Gagal.');
                el.classList.remove('d-none');
                btnExec.disabled = true;
                if (res.success) setTimeout(function() { location.reload(); }, 2500);
            }
        })
        .catch(function(err) {
            btnDry.disabled = false;
            alert('Error: ' + err.message);
        });
    }

    window.repairDryRun  = function() { repairCall(true);  };
    window.repairExecute = function() { repairCall(false); };

    document.addEventListener('DOMContentLoaded', function() {
        var modal = document.getElementById('repairSplitModal');
        if (modal) {
            modal.addEventListener('show.bs.modal', function() {
                _repairDryRunData = null;
                _resolvedSourceScheduleId = 0;
                _resolvedTargetCustomerId = 0;
                document.getElementById('repairDryRunResult').classList.add('d-none');
                document.getElementById('repairActionResult').classList.add('d-none');
                document.getElementById('repairExecBtn').disabled = true;
                document.getElementById('repairCustomerInfo').style.display = 'none';
                document.getElementById('repairScheduleInfo').style.display = 'none';
            });
        }
    });
})();
</script>

<!-- Smart Import JavaScript -->
<script>
(function() {
    var _smartData = null; // holds preview response
    var fileInput = document.getElementById('smartFile');
    var dropZone = document.getElementById('smartDropZone');

    if (dropZone && fileInput) {
        dropZone.addEventListener('click', function() { fileInput.click(); });
        dropZone.addEventListener('dragover', function(e) {
            e.preventDefault();
            dropZone.style.borderColor = '#ffc107';
            dropZone.style.background = 'rgba(255,193,7,0.05)';
        });
        dropZone.addEventListener('dragleave', function(e) {
            e.preventDefault();
            dropZone.style.borderColor = '';
            dropZone.style.background = '';
        });
        dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.style.borderColor = '';
            dropZone.style.background = '';
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                smartImportUpload(e.dataTransfer.files[0]);
            }
        });
        fileInput.addEventListener('change', function() {
            if (this.files.length > 0) smartImportUpload(this.files[0]);
        });
    }

    // === Upload & Preview ===
    window.smartImportUpload = function(file) {
        var maxSize = 10 * 1024 * 1024;
        if (file.size > maxSize) {
            alert('File terlalu besar! Maksimal 10MB.');
            return;
        }
        var allowed = ['.pdf','.xlsx','.xls','.csv','.txt'];
        var ext = '.' + file.name.split('.').pop().toLowerCase();
        if (allowed.indexOf(ext) < 0) {
            alert('Format tidak didukung! Gunakan PDF, Excel, CSV, atau TXT.');
            return;
        }

        // Show progress
        document.getElementById('smartStep1').querySelector('#smartDropZone').classList.add('d-none');
        document.getElementById('smartProgress').classList.remove('d-none');
        document.getElementById('smartProgressText').textContent = 'Menganalisa ' + file.name + '...';

        var formData = new FormData();
        formData.append('file', file);

        fetch('/PreparationSchedule/SmartImportPreview', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.success) {
                alert('Error: ' + (data.errorMessage || 'Gagal memproses file.'));
                smartImportReset();
                return;
            }
            _smartData = data;
            showSmartPreview(data);
        })
        .catch(function(err) {
            alert('Error koneksi: ' + err.message);
            smartImportReset();
        });
    };

    function showSmartPreview(data) {
        // Hide step 1, show step 2
        document.getElementById('smartStep1').classList.add('d-none');
        document.getElementById('smartStep2').classList.remove('d-none');

        // Detection info
        var custEl = document.getElementById('smartDetectedCustomer');
        if (data.customerId) {
            custEl.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>' + (data.detectedCustomerCode || data.detectedCustomer);
            custEl.className = 'fw-bold text-success small';
        } else {
            custEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>' + (data.detectedCustomer || 'UNKNOWN');
            custEl.className = 'fw-bold text-warning small';
        }

        document.getElementById('smartDetectedManifest').textContent = data.detectedManifest || '(tidak terdeteksi)';

        // Tampilkan tanggal jadwal yang terdeteksi dari file
        var dateInfoEl = document.getElementById('smartDetectedDate');
        if (dateInfoEl) {
            if (data.detectedScheduledDate) {
                dateInfoEl.innerHTML = '<i class="bi bi-calendar-check-fill me-1 text-success"></i><b class="text-success">' + escapeHtml(data.detectedScheduledDate) + '</b>';
            } else {
                dateInfoEl.innerHTML = '<i class="bi bi-calendar-x me-1 text-danger"></i><span class="text-danger">Tidak terdeteksi &mdash; akan pakai tanggal hari ini</span>';
            }
        }

        // Tampilkan route/cycle yang terdeteksi dari file
        var parserInfo = (data.fileFormat || '').toUpperCase() + ' / ' + (data.parserUsed || 'GENERIC');
        if (data.detectedRoute) parserInfo += '  |  Route: <b class="text-info">' + escapeHtml(data.detectedRoute) + '</b>';
        if (data.detectedCycle) parserInfo += '  Cycle: <b class="text-info">' + escapeHtml(data.detectedCycle) + '</b>';
        document.getElementById('smartParserInfo').innerHTML = parserInfo;

        // Simpan detected route/cycle untuk highlight dock
        window._smartDetectedRoute = (data.detectedRoute || '').trim().toUpperCase();
        window._smartDetectedCycle = (data.detectedCycle || '').trim().toUpperCase();

        // Warnings
        var warnDiv = document.getElementById('smartWarnings');
        if (data.warnings && data.warnings.length > 0) {
            var warnHtml = '<div class="alert alert-warning bg-opacity-10 border-warning text-warning rounded-3 p-2 small">';
            for (var i = 0; i < data.warnings.length; i++) {
                warnHtml += '<i class="bi bi-exclamation-triangle me-1"></i>' + data.warnings[i] + '<br>';
            }
            warnHtml += '</div>';
            warnDiv.innerHTML = warnHtml;
            warnDiv.classList.remove('d-none');
        } else {
            warnDiv.classList.add('d-none');
        }

        // Dock grid &mdash; single scrollable list
        var dockGrid = document.getElementById('smartDockGrid');
        var hiddenDockId = document.getElementById('smartSelectedDockId');
        dockGrid.innerHTML = '';
        hiddenDockId.value = '';
        window._smartDockItems = []; // store for search filtering

        // Build dock list from matchedDocks (priority) or customerList
        var dockList = (data.matchedDocks && data.matchedDocks.length > 0) ? data.matchedDocks : (data.customerList || []);
        var preselectedId = data.customerId || null;

        // TMMIN multi-dock: ubah label dock jadi opsional dan reset default pre-selection
        var dockLabel = document.getElementById('smartDockLabel');
        if (data.isTmminMultiDock) {
            preselectedId = null; // Reset pre-selection karena TMMIN otomatis detect per-baris
            if (dockLabel) {
                dockLabel.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i> Pilih Dock <span class="text-info fw-normal" style="font-size:0.7rem">(opsional &mdash; auto-detected)</span> ' +
                    '<button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 ms-2 d-none" id="smartDockClearBtn" style="font-size:0.65rem"><i class="bi bi-x-circle me-1"></i>Batal Pilih</button>';

                setTimeout(function() {
                    var clearBtn = document.getElementById('smartDockClearBtn');
                    if (clearBtn) {
                        clearBtn.addEventListener('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            dockGrid.querySelectorAll('.smart-dock-row').forEach(function(r) { r.style.background = ''; });
                            hiddenDockId.value = '';
                            this.classList.add('d-none');
                            updateSmartCounts();
                        });
                    }
                }, 50);
            }
        }

        for (var i = 0; i < dockList.length; i++) {
            (function(d, idx) {
                var row = document.createElement('div');
                row.className = 'smart-dock-row d-flex align-items-center px-2 py-1 border-bottom border-secondary';
                row.style.cssText = 'cursor:pointer; font-size:0.78rem; transition:background .15s;';
                row.setAttribute('data-dock-id', d.customerId);
                row.setAttribute('data-search', ((d.dockName||'') + ' ' + (d.customerCode||'') + ' ' + (d.route||'')).toLowerCase());

                // Cek apakah dock ini cocok dengan route yang terdeteksi dari file
                var detectedRoute = window._smartDetectedRoute || '';
                var dRoute = (d.route || '').trim().toUpperCase();
                var dDocking = (d.docking || '').trim().toUpperCase();
                var dName = (d.dockName || '').trim().toUpperCase();
                var isRouteMatch = detectedRoute && (
                    dRoute.indexOf(detectedRoute) > -1 ||
                    dDocking.indexOf(detectedRoute) > -1 ||
                    dName.indexOf(detectedRoute) > -1
                );

                var icon = isRouteMatch
                    ? '<i class="bi bi-geo-alt-fill text-warning me-1" style="font-size:0.7rem"></i>'
                    : '<i class="bi bi-geo-alt text-info me-1" style="font-size:0.7rem"></i>';

                var info = '<b>' + escapeHtml(d.dockName || d.customerName || '') + '</b>';
                info += ' <span class="text-muted">&mdash; ' + escapeHtml(d.customerCode || '') + '</span>';
                if (d.route) {
                    var rClass = isRouteMatch ? 'text-warning fw-bold' : 'text-secondary';
                    info += ' <span class="' + rClass + ' ms-1" style="font-size:0.7rem">R:' + escapeHtml(d.route) + '</span>';
                }
                if (d.cycle) info += ' <span class="text-secondary" style="font-size:0.7rem">C:' + escapeHtml(d.cycle) + '</span>';
                if (d.docking) info += ' <span class="text-secondary" style="font-size:0.7rem">D:' + escapeHtml(d.docking) + '</span>';

                // Badge "âœ“ Route Match" jika cocok
                if (isRouteMatch) {
                    info += ' <span class="badge bg-warning text-dark ms-1" style="font-size:0.6rem">Route Match</span>';
                }

                row.innerHTML = icon + '<span class="flex-grow-1">' + info + '</span>';

                // Pre-select
                if (preselectedId && d.customerId == preselectedId) {
                    row.style.background = '#1a5276';
                    hiddenDockId.value = d.customerId;
                }

                row.addEventListener('mouseenter', function() { if (hiddenDockId.value != d.customerId) this.style.background = '#1c2e3f'; });
                row.addEventListener('mouseleave', function() { if (hiddenDockId.value != d.customerId) this.style.background = ''; });
                row.addEventListener('click', function() {
                    dockGrid.querySelectorAll('.smart-dock-row').forEach(function(r) { r.style.background = ''; });
                    this.style.background = '#1a5276';
                    hiddenDockId.value = d.customerId;
                    var clearBtn = document.getElementById('smartDockClearBtn');
                    if (clearBtn) clearBtn.classList.remove('d-none');
                    updateSmartCounts();
                });

                dockGrid.appendChild(row);
                window._smartDockItems.push(row);
            })(dockList[i], i);
        }

        if (dockList.length === 0) {
            dockGrid.innerHTML = '<div class="text-muted text-center py-2 small">Tidak ada dock tersedia</div>';
        }

        // Dock search filter
        var dockSearch = document.getElementById('smartDockSearch');
        if (dockSearch) {
            dockSearch.value = '';
            dockSearch.oninput = function() {
                var q = this.value.toLowerCase();
                window._smartDockItems.forEach(function(row) {
                    row.style.display = row.getAttribute('data-search').indexOf(q) > -1 ? '' : 'none';
                });
            };
        }

        // Manifest override
        document.getElementById('smartManifestOverride').value = data.detectedManifest || '';

        // Items table
        var tbody = document.getElementById('smartItemsBody');
        tbody.innerHTML = '';
        var totalQty = 0;
        var items = data.items || [];
        // Set manifest yang sudah ada di DB (dari server)
        var existingManifestSet = new Set((data.existingManifests || []).map(function(m) { return m.toUpperCase(); }));
        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            totalQty += item.qty;
            var tr = document.createElement('tr');
            // Cek apakah manifest ini sudah ada di DB
            var manifestUpper = (item.manifesting || '').trim().toUpperCase();
            var isDuplicate = manifestUpper && (item.matchedCustomerId > 0 ? existingManifestSet.has(manifestUpper + '||' + item.matchedCustomerId) : Array.from(existingManifestSet).some(function(k) { return k.startsWith(manifestUpper + '||'); }));
            if (isDuplicate) tr.style.opacity = '0.6';
            var dupBadge = isDuplicate
                ? '<span class="badge bg-warning text-dark ms-1" style="font-size:0.58rem;vertical-align:middle" title="Manifest sudah ada di jadwal">SUDAH ADA</span>'
                : '';
            // Part No cell: show part no + VIN below (if resolved)
            var inactiveBadge = item.isInactive
                ? '<span class="badge bg-danger ms-1" style="font-size:0.6rem;vertical-align:middle;">NONAKTIF</span>'
                : '';
            var vinHtml = item.vin
                ? '<div class="' + (item.isInactive ? 'text-danger' : 'text-success') + '" style="font-size:0.68rem;line-height:1.2">/ ' + escapeHtml(item.vin) + inactiveBadge + '</div>'
                : '<div class="text-secondary" style="font-size:0.68rem;line-height:1.2">VIN not mapped</div>';
            // Tanggal jadwal dari file (format yyyy-MM-dd)
            var dateHtml = item.scheduledDate
                ? '<span class="text-warning" style="font-size:0.75rem">' + escapeHtml(item.scheduledDate) + '</span>'
                : '<span class="text-danger" style="font-size:0.72rem">&mdash;hari ini</span>';
            // Simpan vin dan scheduledDate di data-attribute agar bisa dibaca saat Confirm tanpa parsing DOM
            tr.setAttribute('data-vin', item.vin || '');
            tr.setAttribute('data-scheduled-date', item.scheduledDate || '');
            tr.setAttribute('data-dock-name', item.matchedDockName || '');
            tr.setAttribute('data-cycle', item.matchedCycle || '');
            tr.setAttribute('data-qty-lot', item.qtyLot || 1);
            tr.setAttribute('data-excel-kanban', item.excelKanban || 0);
            // TMMIN multi-dock: simpan matchedCustomerId
            if (item.matchedCustomerId > 0) {
                tr.setAttribute('data-matched-customer-id', item.matchedCustomerId);
            }
            // TMMIN dock badge
            var dockBadge = '';
            if (item.matchedDockName) {
                dockBadge = '<div style="font-size:0.62rem;line-height:1.2;margin-top:2px;">' +
                    '<span class="badge bg-info text-dark" style="font-size:0.58rem;padding:1px 4px;">' +
                    '<i class="bi bi-geo-alt-fill me-1"></i>' + escapeHtml(item.matchedDockName) +
                    (item.matchedRoute ? ' R:' + escapeHtml(item.matchedRoute) : '') +
                    (item.matchedCycle ? ' C:' + escapeHtml(item.matchedCycle) : '') +
                    '</span></div>';
            }
            
            var isUnmatched = data.isTmminMultiDock && (!item.matchedCustomerId || item.matchedCustomerId === 0);
            var checkboxHtml = isUnmatched 
                ? '<input type="checkbox" class="form-check-input smart-item-check" disabled title="Unmatched Dock cannot be imported">'
                : '<input type="checkbox" class="form-check-input smart-item-check" data-idx="' + i + '" checked>';

            tr.innerHTML =
                '<td>' + checkboxHtml + '</td>' +
                '<td class="text-muted small">' + (i + 1) + '</td>' +
                '<td><input type="text" class="form-control form-control-sm bg-dark text-white border-0 smart-manifest" value="' + escapeHtml(item.manifesting || '') + '" style="width:130px;font-size:0.75rem">' + dupBadge + '</td>' +
                '<td><code class="text-info" style="font-size:0.78rem">' + escapeHtml(item.partNo) + '</code>' + vinHtml + '</td>' +
                '<td class="small text-muted">' + escapeHtml(item.partName || '') + '</td>' +
                '<td class="text-center">' +
                '<input type="number" class="form-control form-control-sm bg-dark text-white border-0 text-center smart-qty" value="' + item.qty + '" min="1" style="width:70px;font-size:0.78rem; margin: 0 auto;">' +
                (item.excelKanban && item.excelKanban > 0 ? '<div class="mt-1 text-info fw-bold" style="font-size:0.68rem; line-height: 1;">Kanban Excel:<br/>' + item.excelKanban + ' KBN</div>' : '') +
                '</td>' +
                '<td class="text-center">' + dateHtml + dockBadge + '</td>' +
                '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger border-0 py-0" onclick="this.closest(\'tr\').remove();updateSmartCounts();"><i class="bi bi-x-lg" style="font-size:0.7rem"></i></button></td>';
            // Search data-search attribute
            var searchStr = ((item.manifesting||'') + ' ' + (item.partNo||'') + ' ' + (item.vin||'') + ' ' + (item.partName||'') + ' ' + (item.matchedDockName||'') + ' ' + (item.matchedRoute||'') + ' ' + (item.matchedCycle||'')).toLowerCase();
            tr.setAttribute('data-search', searchStr);
            tbody.appendChild(tr);
        }

        // Reset Item Search Filter value
        var itemSearch = document.getElementById('smartItemSearch');
        if (itemSearch) {
            itemSearch.value = '';
        }

        // Warn jika ada item tanpa tanggal jadwal
        var noDate = items.filter(function(i) { return !i.scheduledDate; });
        if (noDate.length > 0) {
            var warnDiv = document.getElementById('smartWarnings');
            var fallbackDateStr = (_smartData && _smartData.detectedScheduledDate)
                ? _smartData.detectedScheduledDate
                : 'hari ini';
            warnDiv.innerHTML = (warnDiv.innerHTML || '') +
                '<div class="alert alert-warning bg-opacity-10 border-warning text-warning rounded-2 p-2 small mt-1">' +
                '<i class="bi bi-calendar-x me-1"></i>' +
                '<b>' + noDate.length + ' item</b> tidak memiliki tanggal jadwal dari file &mdash; akan menggunakan <b>' + escapeHtml(fallbackDateStr) + '</b> sebagai fallback.' +
                '</div>';
            warnDiv.classList.remove('d-none');
        }

        // Warn if some Part Nos have no VIN mapping
        var unmapped = items.filter(function(i) { return !i.vin; });
        if (unmapped.length > 0) {
            var warnDiv = document.getElementById('smartWarnings');
            var existing = warnDiv.innerHTML;
            warnDiv.innerHTML = existing +
                '<div class="alert alert-warning bg-opacity-10 border-warning text-warning rounded-2 p-2 small mt-1">' +
                '<i class="bi bi-exclamation-triangle me-1"></i>' +
                '<b>' + unmapped.length + ' Part No</b> belum terpetakan ke VIN internal. ' +
                'Import tetap bisa dilanjutkan, tapi tambahkan mapping di <a href="/ItemMappings" target="_blank" class="text-warning">Item Mappings</a> agar sistem bisa mencocokkan part saat proses picking.' +
                '</div>';
            warnDiv.classList.remove('d-none');
        }

        // Warn jika ada item yang VIN-nya nonaktif di master data
        var inactiveItems = items.filter(function(i) { return i.isInactive; });
        if (inactiveItems.length > 0) {
            var warnDiv = document.getElementById('smartWarnings');
            var inactiveList = inactiveItems.map(function(i) { return escapeHtml(i.vin || i.partNo); }).join(', ');
            warnDiv.innerHTML = (warnDiv.innerHTML || '') +
                '<div class="alert alert-danger bg-opacity-10 border-danger text-danger rounded-2 p-2 small mt-1">' +
                '<i class="bi bi-slash-circle-fill me-1"></i>' +
                '<b>⛔ ' + inactiveItems.length + ' item dinonaktifkan di Master Data:</b> ' + inactiveList +
                '<br><span style="font-size:0.78rem">Item ini tetap akan di-import ke jadwal. Aktifkan kembali di Master Item agar bisa di-scan.</span>' +
                '</div>';
            warnDiv.classList.remove('d-none');
        }

        // Warn jika manifest sudah ada di database (akan di-skip saat confirm)
        if (existingManifestSet.size > 0) {
            var warnDiv = document.getElementById('smartWarnings');
            var dupList = Array.from(new Set(Array.from(existingManifestSet).map(function(m) { return m.split('||')[0]; }))).map(function(m) { return '<b>' + escapeHtml(m) + '</b>'; }).join(', ');
            warnDiv.innerHTML = '<div class="alert alert-warning bg-opacity-10 border-warning text-warning rounded-2 p-2 small mt-1">' +
                '<i class="bi bi-exclamation-octagon-fill me-1"></i>' +
                '<b>⚠ ' + existingManifestSet.size + ' manifest sudah ada di database dan akan di-SKIP saat import:</b> ' + dupList +
                '<br><span style="font-size:0.78rem">Hapus jadwal lama terlebih dahulu jika ingin import ulang.</span>' +
                '</div>' + (warnDiv.innerHTML || '');
            warnDiv.classList.remove('d-none');
        }

        updateSmartCounts();
    }

    window.updateSmartCounts = function() {
        var rows = document.querySelectorAll('#smartItemsBody tr');
        var count = 0, total = 0;
        var visibleCount = 0, visibleTotal = 0;
        var dateGroups = {};
        
        var q = '';
        var itemSearch = document.getElementById('smartItemSearch');
        if (itemSearch) {
            q = itemSearch.value.trim().toLowerCase();
        }

        var getRowDockAndCycle = function(tr) {
            var dName = tr.getAttribute('data-dock-name');
            var dCycle = tr.getAttribute('data-cycle');
            
            if (!dName) {
                var selectedDockId = parseInt(document.getElementById('smartSelectedDockId').value) || null;
                if (selectedDockId && _smartData) {
                    var list = (_smartData.matchedDocks && _smartData.matchedDocks.length > 0) ? _smartData.matchedDocks : (_smartData.customerList || []);
                    var d = list.find(function(item) { return item.customerId === selectedDockId; });
                    if (d) {
                        dName = d.dockName || d.customerName || '';
                        dCycle = d.cycle || '';
                    }
                }
            }
            return {
                name: dName || '',
                cycle: dCycle || ''
            };
        };

        rows.forEach(function(tr) {
            var isVisible = tr.style.display !== 'none';
            var chk = tr.querySelector('.smart-item-check');
            var qtyInput = tr.querySelector('.smart-qty');
            var qty = parseInt(qtyInput ? qtyInput.value : '0') || 0;

            if (chk && chk.checked) {
                count++;
                total += qty;
                if (isVisible) {
                    visibleCount++;
                    visibleTotal += qty;
                }

                var dockInfo = getRowDockAndCycle(tr);
                var schedDate = tr.getAttribute('data-scheduled-date') || 'Tanpa Tanggal';
                if (dockInfo.name) {
                    var rawName = dockInfo.name || "";
                    var key = rawName.trim().toUpperCase();
                    var rawCycle = dockInfo.cycle || "";
                    if (rawCycle && rawCycle !== '-' && key.indexOf(rawCycle.trim().toUpperCase()) === -1) {
                        key += ' ' + rawCycle.trim().toUpperCase();
                    }
                    
                    if (!dateGroups[schedDate]) {
                        dateGroups[schedDate] = { docks: {}, excels: {}, displayNames: {} };
                    }
                    
                    var displayKey = rawName;
                    if (rawCycle && rawCycle !== '-' && displayKey.indexOf(rawCycle) === -1) {
                        displayKey += ' ' + rawCycle;
                    }
                    dateGroups[schedDate].displayNames[key] = displayKey;
                    
                    if (!dateGroups[schedDate].docks[key]) {
                        dateGroups[schedDate].docks[key] = 0;
                        dateGroups[schedDate].excels[key] = 0;
                    }
                    
                    var qtyLot = parseInt(tr.getAttribute('data-qty-lot')) || 1;
                    if (qtyLot <= 0) qtyLot = 1;
                    var kbn = Math.ceil(qty / qtyLot);
                    
                    dateGroups[schedDate].docks[key] += kbn;
                    dateGroups[schedDate].excels[key] += (parseInt(tr.getAttribute('data-excel-kanban')) || 0);
                }
            }
        });

        if (q) {
            document.getElementById('smartItemCount').innerHTML = '<span class="text-warning fw-bold">' + visibleCount + '</span> (dari ' + count + ')';
            document.getElementById('smartTotalQty').innerHTML = '<span class="text-warning fw-bold">' + visibleTotal + '</span> (dari ' + total + ')';
        } else {
            document.getElementById('smartItemCount').textContent = count;
            document.getElementById('smartTotalQty').textContent = total;
        }

        var summaryHtml = '';
        var dates = Object.keys(dateGroups).sort();
        for (var i = 0; i < dates.length; i++) {
            var d = dates[i];
            var dateData = dateGroups[d];
            
            var groupStrings = [];
            var keys = Object.keys(dateData.docks).sort();
            for (var idx = 0; idx < keys.length; idx++) {
                var key = keys[idx];
                var displayKey = dateData.displayNames[key];
                
                var excelKbnText = '';
                if (dateData.excels[key] && dateData.excels[key] > 0) {
                    excelKbnText = ' | <span class="text-info">Exc: ' + dateData.excels[key] + '</span>';
                }
                
                groupStrings.push('<div class="d-flex align-items-center justify-content-between px-2.5 py-1.5 rounded" style="background: rgba(13, 27, 53, 0.75); border: 1px solid rgba(56, 189, 248, 0.18); font-size: 0.72rem; color: #cbd5e1; white-space: nowrap;">' +
                    '<div class="d-flex align-items-center">' +
                    '<i class="bi bi-geo-alt-fill me-2" style="color: #38bdf8; font-size: 0.72rem;"></i>' +
                    '<strong style="color: #f8fafc; font-family: monospace;">' + escapeHtml(displayKey) + '</strong>' +
                    '</div>' +
                    '<div class="ms-2">' +
                    '<span style="color: #fbbf24; font-weight: 700; font-family: monospace; font-size: 0.75rem;">' + dateData.docks[key] + ' KBN</span>' +
                    excelKbnText +
                    '</div>' +
                    '</div>');
            }
            
            summaryHtml += '<div class="mb-3 w-100">' +
                '<div class="text-info fw-bold mb-2 pb-1 border-bottom border-secondary d-flex align-items-center" style="font-size: 0.85rem;"><i class="bi bi-calendar-event me-2"></i>Jadwal ' + escapeHtml(d) + '</div>' +
                '<div class="d-flex flex-wrap gap-2">' + groupStrings.join('') + '</div>' +
                '</div>';
        }

        var summaryContainer = document.getElementById('smartDockSummary');
        if (summaryContainer) {
            if (dates.length > 0) {
                summaryContainer.innerHTML = summaryHtml;
                summaryContainer.style.display = 'flex';
                summaryContainer.style.flexDirection = 'column';
            } else {
                summaryContainer.innerHTML = '';
                summaryContainer.style.display = 'none';
            }
        }
    };

    // Select all checkbox
    var selectAll = document.getElementById('smartSelectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            var checked = this.checked;
            document.querySelectorAll('.smart-item-check').forEach(function(cb) {
                var tr = cb.closest('tr');
                if (tr && tr.style.display !== 'none' && !cb.disabled) {
                    cb.checked = checked;
                }
            });
            updateSmartCounts();
        });
    }

    // Delegate change on checkboxes and qty inputs
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('smart-item-check') || e.target.classList.contains('smart-qty'))
            updateSmartCounts();
    });

    // === Reset ===
    window.smartImportReset = function() {
        _smartData = null;
        document.getElementById('smartStep1').classList.remove('d-none');
        document.getElementById('smartStep1').querySelector('#smartDropZone').classList.remove('d-none');
        document.getElementById('smartProgress').classList.add('d-none');
        document.getElementById('smartStep2').classList.add('d-none');
        document.getElementById('smartStep3').classList.add('d-none');
        document.getElementById('smartFile').value = '';
        document.getElementById('smartDockGrid').innerHTML = '';
        document.getElementById('smartSelectedDockId').value = '';
        var dockSearch = document.getElementById('smartDockSearch');
        if (dockSearch) dockSearch.value = '';
        var itemSearch = document.getElementById('smartItemSearch');
        if (itemSearch) itemSearch.value = '';
        window._smartDockItems = [];
        var summaryContainer = document.getElementById('smartDockSummary');
        if (summaryContainer) {
            summaryContainer.innerHTML = '';
            summaryContainer.style.display = 'none';
        }
    };

    // === Confirm & Import ===
    window.smartImportConfirm = function() {
        var custId = parseInt(document.getElementById('smartSelectedDockId').value) || null;
        var isTmminMultiDock = _smartData && _smartData.isTmminMultiDock;

        // TMMIN multi-dock: dock tidak wajib dipilih karena sudah auto-matched per item
        if (!custId && !isTmminMultiDock) {
            // Highlight dock grid supaya user tahu harus pilih dock dulu
            var dockGrid = document.getElementById('smartDockGrid');
            dockGrid.style.outline = '2px solid #ef4444';
            dockGrid.style.borderRadius = '6px';
            setTimeout(function() {
                dockGrid.style.outline = '';
                dockGrid.style.borderRadius = '';
            }, 3000);
            // Scroll ke dock grid
            dockGrid.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // Tampilkan notif merah di atas dock grid
            var dockSection = dockGrid.closest('.mb-3') || dockGrid.parentElement;
            var existingAlert = dockSection.querySelector('.dock-required-alert');
            if (!existingAlert) {
                var alertEl = document.createElement('div');
                alertEl.className = 'dock-required-alert alert alert-danger py-1 px-2 small mt-1';
                alertEl.style.animationDuration = '0.3s';
                alertEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> <b>Wajib pilih Dock/Customer</b> dari daftar sebelum import!';
                dockGrid.parentElement.insertBefore(alertEl, dockGrid);
                setTimeout(function() { alertEl.remove(); }, 5000);
            }
            return;
        }

        var manifestOverride = document.getElementById('smartManifestOverride').value.trim();
        var rows = document.querySelectorAll('#smartItemsBody tr');
        var items = [];
        var parseErrors = 0;
        rows.forEach(function(tr) {
            try {
                var chk = tr.querySelector('.smart-item-check');
                if (!chk || !chk.checked) return;
                var codeEl = tr.querySelector('code');
                if (!codeEl) { parseErrors++; return; }
                var partNo = codeEl.textContent.trim();
                var vin = tr.getAttribute('data-vin') || '';
                var scheduledDate = tr.getAttribute('data-scheduled-date') || null;
                var manifestInput = tr.querySelector('.smart-manifest');
                var qtyInput = tr.querySelector('.smart-qty');
                var manifest = (manifestInput ? manifestInput.value.trim() : '') || manifestOverride || '';
                var qty = parseInt(qtyInput ? qtyInput.value : '0') || 0;
                var excelKanban = parseInt(tr.getAttribute('data-excel-kanban')) || 0;
                if (partNo && qty > 0) {
                    var itemObj = { manifesting: manifest, partNo: partNo, vin: vin, qty: qty, excelKanban: excelKanban, scheduledDate: scheduledDate || undefined };
                    // TMMIN multi-dock: ambil itemCustomerId dari data attribute
                    // Hapus kondisi if (isTmminMultiDock) agar SELALU mengambil ID jika tersedia!
                    var matchedCustId = parseInt(tr.getAttribute('data-matched-customer-id')) || 0;
                    if (matchedCustId > 0) itemObj.itemCustomerId = matchedCustId;
                    
                    items.push(itemObj);
                }
            } catch(rowErr) {
                console.error('[SmartImport] Row parse error:', rowErr);
                parseErrors++;
            }
        });

        console.log('[SmartImport] Confirm: customerId=' + custId + ', items=' + items.length + ', parseErrors=' + parseErrors);

        if (items.length === 0) {
            alert('Tidak ada item yang valid! Parse errors: ' + parseErrors);
            return;
        }

        // Langsung eksekusi import &mdash; tidak pakai window.confirm() karena sering
        // tersembunyi di balik Bootstrap modal dan tidak terlihat user

        // Show step 3 loading
        document.getElementById('smartStep2').classList.add('d-none');
        document.getElementById('smartStep3').classList.remove('d-none');
        document.getElementById('smartResultIcon').innerHTML = '<div class="spinner-border text-warning" style="width:3rem;height:3rem"></div>';
        document.getElementById('smartResultTitle').textContent = 'Menyimpan ' + items.length + ' items...';
        document.getElementById('smartResultMessage').textContent = 'Mohon tunggu...';

        // Gunakan detectedScheduledDate dari preview sebagai fallback untuk item yang tidak punya tanggal
        var detectedScheduledDate = (_smartData && _smartData.detectedScheduledDate) ? _smartData.detectedScheduledDate : null;

        // Untuk TMMIN multi-dock tanpa global dock selection, gunakan CustomerId=0 sebagai fallback
        var effectiveCustId = custId || (_smartData && _smartData.customerId ? _smartData.customerId : 0);

        // Paksa perItemDock = true jika ada minimal 1 item yang memiliki itemCustomerId > 0
        var hasAnyPerItemDock = items.some(function(i) { return i.itemCustomerId > 0; });
        var finalPerItemDock = isTmminMultiDock || hasAnyPerItemDock;

        fetch('/PreparationSchedule/SmartImportConfirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                customerId: effectiveCustId, 
                items: items, 
                detectedScheduledDate: detectedScheduledDate || undefined,
                perItemDock: finalPerItemDock
            })
        })
        .then(function(r) {
            if (!r.ok) {
                return r.text().then(function(t) {
                    throw new Error('Server error ' + r.status + ': ' + t.substring(0, 200));
                });
            }
            return r.json();
        })
        .then(function(res) {
            console.log('[SmartImport] Response:', res);
            if (res.success) {
                document.getElementById('smartResultIcon').innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>';
                document.getElementById('smartResultTitle').textContent = 'Import Berhasil!';
                document.getElementById('smartResultTitle').className = 'fw-bold text-success';
                document.getElementById('smartResultMessage').textContent = res.message || '';
                // Tampilkan warning item nonaktif (jika ada)
                var warnEl = document.getElementById('smartResultWarning');
                if (warnEl) {
                    if (res.warnings) {
                        warnEl.textContent = res.warnings;
                        warnEl.style.display = '';
                    } else {
                        warnEl.style.display = 'none';
                    }
                }
            } else {
                document.getElementById('smartResultIcon').innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size:3rem"></i>';
                document.getElementById('smartResultTitle').textContent = 'Import Gagal';
                document.getElementById('smartResultTitle').className = 'fw-bold text-danger';
                document.getElementById('smartResultMessage').textContent = res.message || 'Terjadi kesalahan tidak dikenal.';
            }
        })
        .catch(function(err) {
            console.error('[SmartImport] Fetch error:', err);
            document.getElementById('smartResultIcon').innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size:3rem"></i>';
            document.getElementById('smartResultTitle').textContent = 'Error Koneksi';
            document.getElementById('smartResultTitle').className = 'fw-bold text-danger';
        });
    };

    function filterItems() {
        var itemSearch = document.getElementById('smartItemSearch');
        if (!itemSearch) return;
        var queryText = itemSearch.value.toLowerCase().trim();
        var terms = queryText.split(/\s+/).filter(Boolean);
        var rows = document.querySelectorAll('#smartItemsBody tr');
        rows.forEach(function(tr) {
            var searchVal = tr.getAttribute('data-search') || '';
            var manifestInput = tr.querySelector('.smart-manifest');
            var liveManifestVal = (manifestInput ? manifestInput.value : '').toLowerCase();
            
            var isMatch = true;
            for (var i = 0; i < terms.length; i++) {
                var term = terms[i];
                if (searchVal.indexOf(term) === -1 && liveManifestVal.indexOf(term) === -1) {
                    isMatch = false;
                    break;
                }
            }
            tr.style.display = isMatch ? '' : 'none';
        });
        if (window.updateSmartCounts) {
            window.updateSmartCounts();
        }
    }

    var itemSearchInput = document.getElementById('smartItemSearch');
    if (itemSearchInput) {
        itemSearchInput.addEventListener('input', filterItems);
        itemSearchInput.addEventListener('keyup', filterItems);
        itemSearchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
            }
        });
    }

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str || ''));
        return div.innerHTML;
    }

    // Reset on modal close
    var smartModal = document.getElementById('smartImportModal');
    if (smartModal) {
        smartModal.addEventListener('hidden.bs.modal', function() {
            smartImportReset();
        });
    }

})();
</script>
