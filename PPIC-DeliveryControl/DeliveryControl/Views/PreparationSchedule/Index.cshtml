<!-- Bulk Delete JavaScript -->
<script>
(function() {
    var bulkBar = document.getElementById('bulkDeleteBar');
    var selectAllCb = document.getElementById('bulkSelectAll');
    if (!bulkBar) return; // Admin only

    // â”€â”€ localStorage key untuk menyimpan pilihan lintas halaman â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    var LS_KEY = 'bulkSelectedScheduleIds';

    function getSavedIds() {
        try {
            var raw = localStorage.getItem(LS_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch(e) { return []; }
    }

    function saveIds(ids) {
        try { localStorage.setItem(LS_KEY, JSON.stringify(ids)); } catch(e) {}
    }

    function clearSavedIds() {
        try { localStorage.removeItem(LS_KEY); } catch(e) {}
    }

    // â”€â”€ Restore centangan dari localStorage saat halaman dimuat â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    window.bulkRestoreChecks = function() {
        var saved = getSavedIds();
        if (saved.length === 0) return;
        document.querySelectorAll('.bulk-check').forEach(function(cb) {
            var sid = parseInt(cb.getAttribute('data-schedule-id'));
            if (sid > 0 && saved.indexOf(sid) !== -1) {
                cb.checked = true;
            }
        });
        updateBulkUI();
    };
    bulkRestoreChecks();

    function updateBulkUI() {
        var selectedOnPage = document.querySelectorAll('.bulk-check:checked');
        var countOnPage  = selectedOnPage.length;

        // Ambil semua id yang ada di halaman saat ini (baik diceklis maupun tidak)
        var allPageIds = [];
        document.querySelectorAll('.bulk-check').forEach(function(cb) {
            var sid = parseInt(cb.getAttribute('data-schedule-id'));
            if (sid > 0 && allPageIds.indexOf(sid) === -1) allPageIds.push(sid);
        });

        // Kumpulkan id yang diceklis di halaman saat ini
        var pageCheckedIds = [];
        selectedOnPage.forEach(function(cb) {
            var sid = parseInt(cb.getAttribute('data-schedule-id'));
            if (sid > 0) pageCheckedIds.push(sid);
        });

        var saved = getSavedIds();
        
        // SINKRONISASI:
        // 1. Hapus SEMUA id halaman ini dari daftar 'saved'
        saved = saved.filter(function(id) { return allPageIds.indexOf(id) === -1; });
        
        // 2. Tambahkan kembali yang SEDANG diceklis
        pageCheckedIds.forEach(function(id) {
            if (saved.indexOf(id) === -1) saved.push(id);
        });
        
        saveIds(saved);

        // Tampilkan jumlah total (termasuk halaman lain)
        var totalSelected = saved.length;
        var countEl = document.getElementById('bulkSelectedCount');
        if (countEl) {
            countEl.textContent = totalSelected + (totalSelected !== countOnPage && countOnPage > 0 ? ' (' + countOnPage + ' halaman ini)' : '');
        }

        // Badge di dropdown Export
        var badgeEl = document.getElementById('exportSelectedCount');
        if (badgeEl) {
            if (totalSelected > 0) {
                badgeEl.textContent = totalSelected + ' jadwal';
                badgeEl.style.display = '';
            } else {
                badgeEl.style.display = 'none';
            }
        }

        if (totalSelected > 0) {
            bulkBar.classList.remove('d-none');
            bulkBar.style.display = 'flex';
        } else {
            bulkBar.classList.add('d-none');
            bulkBar.style.display = 'none';
        }

        // Sync select-all checkbox (hanya untuk halaman ini)
        var totalOnPage = document.querySelectorAll('.bulk-check').length;
        if (selectAllCb) {
            selectAllCb.checked = totalOnPage > 0 && countOnPage === totalOnPage;
            selectAllCb.indeterminate = countOnPage > 0 && countOnPage < totalOnPage;
        }
    }
    window.bulkUpdateUI = updateBulkUI;

    // Jalankan updateBulkUI sekali saat load agar bulkBar muncul jika ada data tersimpan
    (function initUI() {
        var saved = getSavedIds();
        if (saved.length > 0) {
            var totalSelected = saved.length;
            var countEl = document.getElementById('bulkSelectedCount');
            if (countEl) countEl.textContent = totalSelected;
            var badgeEl = document.getElementById('exportSelectedCount');
            if (badgeEl) { badgeEl.textContent = totalSelected + ' jadwal'; badgeEl.style.display = ''; }
            bulkBar.classList.remove('d-none');
            bulkBar.style.display = 'flex';
        }
    })();

    // Select All toggle
    if (selectAllCb) {
        selectAllCb.addEventListener('change', function() {
            var checked = this.checked;
            document.querySelectorAll('.bulk-check').forEach(function(cb) { cb.checked = checked; });
            updateBulkUI();
        });
    }

    // Individual checkbox change
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('bulk-check')) updateBulkUI();
    });

    // Deselect all &mdash; hapus semua termasuk halaman lain
    window.bulkDeselectAll = function() {
        document.querySelectorAll('.bulk-check').forEach(function(cb) { cb.checked = false; });
        if (selectAllCb) selectAllCb.checked = false;
        clearSavedIds();
        updateBulkUI();
    };

    // Export selected ke Excel &mdash; ambil dari localStorage (lintas halaman)
    window.bulkExportSelected = function() {
        var saved = getSavedIds();
        if (saved.length === 0) {
            document.activeElement && document.activeElement.blur();
            if (window.showUpdateNotification)
                window.showUpdateNotification('Centang dulu baris yang ingin di-export, lalu klik "Data Terpilih".', 'warning', 4000);
            else
                alert('Centang dulu baris yang ingin di-export, kemudian klik tombol "Data Terpilih".');
            return;
        }

        // Submit form POST ke endpoint ExportExcel dengan selectedIds
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/PreparationSchedule/ExportExcelSelected';
        form.style.display = 'none';

        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenEl) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = tokenEl.value;
            form.appendChild(tokenInput);
        }

        var idsInput = document.createElement('input');
        idsInput.type = 'hidden';
        idsInput.name = 'selectedIds';
        idsInput.value = saved.join(',');
        form.appendChild(idsInput);

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);

        // Reset pilihan setelah download dimulai
        clearSavedIds();
        document.querySelectorAll('.bulk-check').forEach(function(cb) { cb.checked = false; });
        if (selectAllCb) selectAllCb.checked = false;
        updateBulkUI();

        if (window.showUpdateNotification)
            window.showUpdateNotification('Download dimulai. Pilihan telah direset.', 'success', 3000);
    };

    // Delete selected
    window.bulkDeleteSelected = function() {
        var checks = document.querySelectorAll('.bulk-check:checked');
        if (checks.length === 0) return;

        var ids = [];
        var ghostScheduleIds = [];
        checks.forEach(function(cb) {
            var id = parseInt(cb.getAttribute('data-id'));
            if (id > 0) ids.push(id);
            var ghostId = parseInt(cb.getAttribute('data-ghost-schedule-id'));
            if (ghostId > 0) ghostScheduleIds.push(ghostId);
        });

        if (ids.length === 0 && ghostScheduleIds.length === 0) return;

        var confirmMsg = '';
        if (ids.length > 0 && ghostScheduleIds.length > 0)
            confirmMsg = 'Yakin hapus ' + ids.length + ' item + ' + ghostScheduleIds.length + ' Ghost Schedule? Tidak bisa dibatalkan.';
        else if (ids.length > 0)
            confirmMsg = 'Yakin ingin menghapus ' + ids.length + ' item terpilih? Tindakan ini tidak bisa dibatalkan.';
        else
            confirmMsg = 'Yakin hapus ' + ghostScheduleIds.length + ' Ghost Schedule terpilih? Tidak bisa dibatalkan.';

        if (!confirm(confirmMsg)) return;

        var btnDelete = bulkBar.querySelector('.btn-danger');
        var originalHtml = btnDelete.innerHTML;
        btnDelete.disabled = true;
        btnDelete.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Menghapus...';

        // Step 1: hapus DeliveryItems (normal) jika ada
        var step1 = ids.length > 0
            ? fetch('/PreparationSchedule/BulkDeleteSelected', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids })
              }).then(function(r) { return r.json(); })
            : Promise.resolve({ success: true, message: '' });

        // Step 2: hapus ghost schedules jika ada
        var step2 = ghostScheduleIds.length > 0
            ? fetch('/PreparationSchedule/BulkDeleteGhostSchedules', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ghostScheduleIds })
              }).then(function(r) { return r.json(); })
            : Promise.resolve({ success: true, message: '' });

        Promise.all([step1, step2])
        .then(function(results) {
            btnDelete.disabled = false;
            btnDelete.innerHTML = originalHtml;
            var allOk = results.every(function(r) { return r.success; });
            var msg = results.map(function(r) { return r.message; }).filter(Boolean).join(' ');

            if (allOk) {
                if (window.showUpdateNotification)
                    window.showUpdateNotification(msg || 'Berhasil dihapus.', 'success', 4000);
                else
                    alert(msg || 'Berhasil dihapus.');
                clearSavedIds();
                setTimeout(function() { location.reload(); }, 1200);
            } else {
                if (window.showUpdateNotification)
                    window.showUpdateNotification(msg || 'Gagal menghapus.', 'danger', 5000);
                else
                    alert(msg || 'Gagal menghapus.');
            }
        })
        .catch(function(err) {
            btnDelete.disabled = false;
            btnDelete.innerHTML = originalHtml;
            alert('Error koneksi: ' + err.message);
        });
    };
})();
</script>

