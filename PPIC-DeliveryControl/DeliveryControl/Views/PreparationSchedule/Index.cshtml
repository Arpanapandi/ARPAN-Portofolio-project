                '<div class="spinner-border spinner-border-sm me-2"></div>Memuat data...</td></tr>';

            _pendingModal.show();
            fetchPendingPage(1);
        }

        // ================================================================
        // HAPUS DATA PENDING
        // ================================================================
        var _deletePendingMode = 'today';
        var _deletePendingModal = null;
        var _deletePendingSelectedIds = [];

        function openDeletePendingModal(mode) {
            _deletePendingMode = mode;
            var titleEl   = document.getElementById('deletePendingTitle');
            var descEl    = document.getElementById('deletePendingDesc');
            var inputEl   = document.getElementById('deletePendingConfirmInput');
            var btnEl     = document.getElementById('btnConfirmDeletePending');

            if (mode === 'selected') {
                var checkedNodes = document.querySelectorAll('.pending-item-check:checked');
                _deletePendingSelectedIds = [];
                for (var i = 0; i < checkedNodes.length; i++) {
                    _deletePendingSelectedIds.push(parseInt(checkedNodes[i].value));
                }
                if (_deletePendingSelectedIds.length === 0) {
                    showSyncToast(false, 'Pilih minimal satu item untuk dihapus.', 0, null);
                    return;
                }
                titleEl.textContent = 'Hapus Item Terpilih';
                descEl.innerHTML    = 'Anda akan menghapus <strong>' + _deletePendingSelectedIds.length + ' item</strong> yang dipilih. Data yang sudah terikat ke jadwal <u>tidak</u> akan terpengaruh.';
            } else if (mode === 'today') {
                _deletePendingSelectedIds = [];
                titleEl.textContent = 'Hapus Scan Pending Hari Ini';
                descEl.innerHTML    = 'Anda akan menghapus seluruh data scan preparation pending yang tercatat <strong>hari ini</strong>. Data yang sudah terikat ke jadwal <u>tidak</u> akan terpengaruh.';
            } else {
                _deletePendingSelectedIds = [];
                titleEl.textContent = 'Hapus Semua Data Pending';
                descEl.innerHTML    = 'Anda akan menghapus <strong>SEMUA</strong> data scan preparation yang belum terikat ke jadwal manapun, tanpa batasan tanggal.';
            }

            inputEl.value = '';
            btnEl.disabled = true;

            var modalEl = document.getElementById('deletePendingModal');
            if (!_deletePendingModal) {
                _deletePendingModal = new bootstrap.Modal(modalEl);
            }
            _deletePendingModal.show();
        }

        function checkDeletePendingInput() {
            var inputEl = document.getElementById('deletePendingConfirmInput');
            var btnEl   = document.getElementById('btnConfirmDeletePending');
            btnEl.disabled = (inputEl.value.trim().toUpperCase() !== 'HAPUS');
        }

        function doDeletePending() {
            var btnEl = document.getElementById('btnConfirmDeletePending');
            btnEl.disabled = true;
            btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menghapus...';

            var url, body;
            if (_deletePendingMode === 'selected') {
                url  = '/PreparationWorkflow/DeleteSelectedPendingPreparations';
                body = JSON.stringify({ ids: _deletePendingSelectedIds });
            } else {
                url  = '/PreparationWorkflow/DeletePendingPreparations';
                body = JSON.stringify({ mode: _deletePendingMode });
            }

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                // Tutup modal konfirmasi
                if (_deletePendingModal) _deletePendingModal.hide();

                // Reset tombol
                btnEl.disabled = false;
                btnEl.innerHTML = '<i class="bi bi-trash3-fill me-1"></i>Hapus Sekarang';

                // Tampilkan toast
                showSyncToast(data.success, data.message, null, data.remaining);

                // Update pending count & reload tabel modal
                if (typeof data.remaining === 'number') {
                    updatePendingUIGlobal(data.remaining);
                    var countBadge = document.getElementById('pendingModalCount');
                    if (countBadge) countBadge.textContent = data.remaining;
                }

                // Reload data di modal pending
                if (data.success) {
                    reloadPendingModalData();
                }
            })
            .catch(function(err) {
                btnEl.disabled = false;
                btnEl.innerHTML = '<i class="bi bi-trash3-fill me-1"></i>Hapus Sekarang';
                showSyncToast(false, 'Gagal menghapus: ' + err.message, null, null);
            });
        }
    </script>
}

