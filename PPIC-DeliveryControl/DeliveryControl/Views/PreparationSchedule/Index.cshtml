        // openPendingModal() harus di luar $(document).ready agar bisa dipanggil dari onclick HTML
        var _pendingModal = null;
        var _pendingTotal = 0; // total asli dari DB
        var _pendingPage = 1;
        var _pendingPageSize = 20;

        // ================================================================
        // SYNC PENDING &mdash; AJAX, tidak redirect, tidak hard refresh
        // ================================================================
        function doSyncSelectedPending(btnEl) {
            var checkedNodes = document.querySelectorAll('.pending-item-check:checked');
            var checkedIds = [];
            for (var i = 0; i < checkedNodes.length; i++) {
                checkedIds.push(parseInt(checkedNodes[i].value));
            }

            var manifestStr = (document.getElementById('schedPendingManifestInput').value || '').trim();

            if (checkedIds.length === 0) {
                showSyncToast(false, "Pilih minimal satu item pending untuk disync.", 0, null);
                return;
            }

            if (!manifestStr) {
                showSyncToast(false, "Silakan isi No Manifest terlebih dahulu.", 0, null);
                document.getElementById('schedPendingManifestInput').focus();
                return;
            }

            var originalHtml = btnEl ? btnEl.innerHTML : '';
            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing...';
            }

            fetch('/PreparationWorkflow/SyncSelectedPending', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ preparationIds: checkedIds, manifestNumber: manifestStr })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = originalHtml;
                }

                if (data.success) {
                    showSyncToast(true, 'Berhasil sync ' + data.synced + ' item ke manifest ' + manifestStr, data.synced, null);
                    document.getElementById('schedPendingManifestInput').value = '';
                    
                    var modalEl = document.getElementById('pendingPrepModal');
                    if (modalEl && modalEl.classList.contains('show')) {
                        reloadPendingModalData();
                    }
                    
                    // Juga update banner
                    fetch('/PreparationSchedule/GetPendingCount') // Or wherever this gets remaining count
                        .then(r => r.json())
                        .then(res => {
                            if (typeof res.total === 'number') updatePendingUIGlobal(res.total);
                        }).catch(e => {});

                    refreshScheduleTable();
                } else {
                    showSyncToast(false, data.message || "Gagal sinkronisasi.", 0, null);
                }
            })
            .catch(function(err) {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = originalHtml;
                }
                showSyncToast(false, 'Sync gagal: ' + err.message, 0, null);
            });
        }

        // doSyncPending (untuk keseluruhan fallback dr trigger alert bar atas)
        function doSyncPending(btnEl) {
            var originalHtml = btnEl ? btnEl.innerHTML : '';
            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing...';
            }

            fetch('/PreparationSchedule/SyncPendingNow', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = originalHtml;
                }

                // Tampilkan toast notifikasi (tidak berpindah halaman)
                showSyncToast(data.success, data.message, data.synced, data.remaining);

                // Update badge pending count di UI tanpa reload
                if (typeof data.remaining === 'number') {
                    updatePendingUIGlobal(data.remaining);
                }

                // Jika modal pending sedang terbuka â†’ refresh isinya
                var modalEl = document.getElementById('pendingPrepModal');
                if (modalEl && modalEl.classList.contains('show')) {
                    reloadPendingModalData();
                }

                // Refresh tabel jadwal agar KBN PREP langsung update tanpa reload halaman
                if (data.synced > 0) {
                    refreshScheduleTable();
                }
            })
            .catch(function(err) {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = originalHtml;
                }
                showSyncToast(false, 'Sync gagal: ' + err.message, 0, null);
            });
        }

        // Refresh tabel jadwal via AJAX (ambil HTML terbaru tanpa full page reload)
        function refreshScheduleTable() {
            // Ambil URL halaman saat ini (termasuk query string filter tanggal, search, dll)
            var currentUrl = window.location.href;
            fetch(currentUrl, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.text(); })
            .then(function(html) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');

                // Update Desktop Table
                var newDesktop = doc.getElementById('desktopTableContainer');
                var oldDesktop = document.getElementById('desktopTableContainer');
                if (newDesktop && oldDesktop) {
                    oldDesktop.innerHTML = newDesktop.innerHTML;
                }

                // Update Mobile Cards
                var newMobile = doc.getElementById('mobileCardContainer');
                var oldMobile = document.getElementById('mobileCardContainer');
                if (newMobile && oldMobile) {
                    oldMobile.innerHTML = newMobile.innerHTML;
                }

                // Update pagination jika ada
                var newPaging = doc.getElementById('paginationContainer');
                var oldPaging = document.getElementById('paginationContainer');
                if (newPaging && oldPaging) {
                    oldPaging.innerHTML = newPaging.innerHTML;
                }

                console.log('Schedule table refreshed (no reload).');

                // RESTORE BULK CHECKS after AJAX refresh
                if (window.bulkRestoreChecks) window.bulkRestoreChecks();
            })
            .catch(function(err) {
                console.warn('Gagal refresh tabel:', err);
            });
        }

        function showSyncToast(success, message, synced, remaining) {
            var toast = document.getElementById('syncResultToast');
            var toastBody = document.getElementById('syncResultToastBody');
            if (!toast || !toastBody) return;

            var icon = success ? 'âœ…' : 'â„¹ï¸';
            var remainingText = (remaining !== null && remaining !== undefined)
                ? '<br><small class="opacity-75">Sisa pending: ' + remaining + '</small>'
                : '';
            toastBody.innerHTML = icon + ' ' + message + remainingText;
            toast.className = 'toast align-items-center border-0 text-white ' + (success ? 'bg-success' : 'bg-secondary');

            var bsToast = bootstrap.Toast.getOrCreateInstance(toast, { delay: 5000 });
            bsToast.show();
        }

        function updatePendingUIGlobal(count) {
            // Badge di modal header
            var modalCountBadge = document.getElementById('pendingModalCount');
            if (modalCountBadge) modalCountBadge.textContent = count;

            // Alert bar + angka di dalamnya
            var pendingAlert = document.getElementById('pendingPrepAlert');
            if (pendingAlert) {
                if (count > 0) {
                    var strongEl = pendingAlert.querySelector('strong[style*="color:#f59e0b"]');
                    if (strongEl) strongEl.textContent = count;
                    pendingAlert.style.display = 'flex';
                } else {
                    pendingAlert.style.display = 'none';
                }
            }
        }

        function reloadPendingModalData() {
            // Simpan ID yang sudah dicentang agar tidak hilang saat refresh
            var checkedIds = Array.from(document.querySelectorAll('.pending-item-check:checked'))
                .map(function(el) { return el.value; });
            fetchPendingPage(_pendingPage, checkedIds);
        }

        var _pendingSearchTimer = null;
        function handlePendingSearchInput() {
            clearTimeout(_pendingSearchTimer);
            _pendingSearchTimer = setTimeout(function() {
                fetchPendingPage(1);
            }, 350);
        }

        function fetchPendingPage(page, restoreChecked) {
            _pendingPage = page;
            var tbody = document.getElementById('pendingPrepBody');
            var countBadge = document.getElementById('pendingModalCount');
            var pagination = document.getElementById('pendingPagination');
            var searchInput = document.getElementById('searchPendingInput');
            var kw = searchInput ? encodeURIComponent(searchInput.value.trim()) : '';

            if (!tbody) return;
            tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4">' +
                '<div class="spinner-border spinner-border-sm me-2"></div>Memuat halaman ' + page + '...</td></tr>';
            if (pagination) pagination.style.display = 'none';

            fetch('/PreparationWorkflow/GetPendingPreparations?page=' + page + '&pageSize=' + _pendingPageSize + '&keyword=' + kw
                + (document.getElementById('schedPendingDateFrom')?.value ? '&dateFrom=' + encodeURIComponent(document.getElementById('schedPendingDateFrom').value) : '')
                + (document.getElementById('schedPendingDateTo')?.value   ? '&dateTo='   + encodeURIComponent(document.getElementById('schedPendingDateTo').value)   : '')
            )
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    _pendingTotal = data.total || 0;
                    var totalPages = data.totalPages || 1;
                    var items = data.items || [];

                    if (countBadge) {
                         if (kw && _pendingTotal < parseInt(countBadge.getAttribute('data-real-total') || '0')) {
                             // Just update the visible text, don't overwrite the real total logic
                             countBadge.textContent = _pendingTotal + ' (filter)';
                         } else {
                             countBadge.textContent = _pendingTotal;
                             countBadge.setAttribute('data-real-total', _pendingTotal);
                         }
                    }

                    if (!items.length && page === 1) {
                        if (kw) {
                            tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4">' +
                                '<i class="bi bi-search text-secondary fs-3 d-block mb-2"></i>Tidak ada hasil pencarian!</td></tr>';
                        } else {
                            tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4">' +
                                '<i class="bi bi-check2-all text-success fs-3 d-block mb-2"></i>Semua scan sudah tersinkronisasi!</td></tr>';
                        }
                        return;
                    }

                    var start = (page - 1) * _pendingPageSize;
                    tbody.innerHTML = items.map(function(r, i) {
                        return '<tr>' +
                            '<td class="text-center align-middle"><input type="checkbox" class="form-check-input pending-item-check" value="' + r.preparationId + '"></td>' +
                            '<td class="px-3 py-2 text-muted" style="font-size:0.78rem;">' + (start + i + 1) + '</td>' +
                            '<td class="px-3 py-2 text-nowrap" style="font-size:0.82rem;">' + r.createdDate + '</td>' +
                            '<td class="px-3 py-2"><span class="badge bg-secondary opacity-75" style="font-size:0.72rem;">' + (r.dockName || '-') + '</span></td>' +
                            '<td class="px-3 py-2" style="font-size:0.78rem;color:#facc15;">' + (r.dockCycle || '-') + '</td>' +
                            '<td class="px-3 py-2"><span class="badge bg-primary" style="font-size:0.8rem;">' + r.tag + '</span></td>' +
                            '<td class="px-3 py-2" style="font-size:0.82rem;">' + r.label + '</td>' +
                            '<td class="px-3 py-2" style="font-size:0.82rem;">' + r.kanban + '</td>' +
                            '<td class="px-3 py-2" style="font-size:0.82rem;font-weight:600;color:#facc15;">' + (r.targetDate || '-') + '</td>' +
                            '<td class="px-3 py-2" style="font-size:0.82rem;">' + r.createdBy + '</td>' +
                            '</tr>';
                    }).join('');

                    // Restore checkbox state jika ada yang dicentang sebelum reload
                    if (restoreChecked && restoreChecked.length > 0) {
                        document.querySelectorAll('.pending-item-check').forEach(function(cb) {
                            if (restoreChecked.indexOf(cb.value) !== -1) cb.checked = true;
                        });
                    }

                    // Attach event listener for row checkboxes
                    var checkAll = document.getElementById('checkAllPendingSched');
                    var allChecksNow = document.querySelectorAll('.pending-item-check');
                    var checkedNow = document.querySelectorAll('.pending-item-check:checked');
                    if (checkAll) {
                        checkAll.checked = allChecksNow.length > 0 && checkedNow.length === allChecksNow.length;
                        checkAll.onchange = function() {
                            var isC = this.checked;
                            var rowCb = document.querySelectorAll('.pending-item-check');
                            for (var c = 0; c < rowCb.length; c++) {
                                rowCb[c].checked = isC;
                            }
                        };
                    }
                    var itemChecks = document.querySelectorAll('.pending-item-check');
                    for (var ic = 0; ic < itemChecks.length; ic++) {
                        itemChecks[ic].onchange = function() {
                            if (checkAll) {
                                var allCount = document.querySelectorAll('.pending-item-check').length;
                                var checkedCount = document.querySelectorAll('.pending-item-check:checked').length;
                                checkAll.checked = (allCount === checkedCount && allCount > 0);
                            }
                        };
                    }

                    // Render pagination
                    if (pagination && totalPages > 1) {
                        var pageInfo = document.getElementById('pendingPageInfo');
                        var pageBtns = document.getElementById('pendingPageBtns');
                        var end = Math.min(start + items.length, _pendingTotal);
                        if (pageInfo) pageInfo.textContent = 'Menampilkan ' + (start + 1) + 'â€“' + end + ' dari ' + _pendingTotal + ' data';

                        var btns = '';
                        btns += '<button onclick="fetchPendingPage(' + (page - 1) + ')" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75rem;"' + (page <= 1 ? ' disabled' : '') + '><i class="bi bi-chevron-left"></i></button>';
                        var pStart = Math.max(1, page - 2);
                        var pEnd = Math.min(totalPages, pStart + 4);
                        pStart = Math.max(1, pEnd - 4);
                        for (var p = pStart; p <= pEnd; p++) {
                            var active = (p === page) ? 'btn-warning text-dark' : 'btn-outline-warning';
                            btns += '<button onclick="fetchPendingPage(' + p + ')" class="btn btn-sm ' + active + ' py-0 px-2" style="font-size:0.75rem;">' + p + '</button>';
                        }
                        btns += '<button onclick="fetchPendingPage(' + (page + 1) + ')" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75rem;"' + (page >= totalPages ? ' disabled' : '') + '><i class="bi bi-chevron-right"></i></button>';
                        if (pageBtns) pageBtns.innerHTML = btns;
                        pagination.style.display = 'flex';
                    }
                })
                .catch(function() {
                    tbody.innerHTML = '<tr><td colspan="10" class="text-danger text-center py-3">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>Gagal memuat data.</td></tr>';
                });
        }

        function renderPendingPage(page) {
            // Wrapper &mdash; sekarang delegate ke server-side fetch
            fetchPendingPage(page);
        }

        function openPendingModal() {
            var modalEl = document.getElementById('pendingPrepModal');
            if (!modalEl) return;
            if (!_pendingModal) {
                _pendingModal = new bootstrap.Modal(modalEl);
            }
            // Reset state
            var tbody = document.getElementById('pendingPrepBody');
            var pagination = document.getElementById('pendingPagination');
            var searchInput = document.getElementById('searchPendingInput');
            if (searchInput) searchInput.value = '';

            if (pagination) pagination.style.display = 'none';
