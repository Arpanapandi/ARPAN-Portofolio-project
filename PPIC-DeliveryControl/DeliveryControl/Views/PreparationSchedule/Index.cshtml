@section Scripts {

    <script>
        // â”€â”€ STATUS FILTER: Waiting / Preparing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        (function() {
            var activeFilter = null; // null | 'waiting' | 'preparing'

            function applyStatusFilter(filter) {
                // null = reset semua
                activeFilter = (filter === null || activeFilter === filter) ? null : filter; // toggle
                var rows = document.querySelectorAll('#mainTableBody tr');
                rows.forEach(function(tr) {
                    if (!activeFilter) { tr.style.display = ''; return; }
                    // Baca status langsung dari data attribute (bukan badge &mdash; bisa salah karena DOCK juga pakai bg-secondary)
                    var statusText = (tr.dataset.itemStatus || '').toLowerCase();
                    if (activeFilter === 'waiting') {
                        tr.style.display = (statusText === 'waiting' || statusText === 'ghost') ? '' : 'none';
                    } else if (activeFilter === 'preparing') {
                        // "Belum Completed" = semua kecuali completed
                        tr.style.display = (statusText !== 'completed') ? '' : 'none';
                    }
                });
                // Update button active state
                document.querySelectorAll('[data-status-filter]').forEach(function(btn) {
                    var isActive = btn.dataset.statusFilter === activeFilter;
                    btn.classList.toggle('active', isActive);
                    btn.classList.toggle('fw-bold', isActive);
                });
                // Count visible rows & show badge/reset
                var visibleCount = Array.from(rows).filter(function(r) { return r.style.display !== 'none'; }).length;
                var countBadge = document.getElementById('statusFilterCount');
                var resetBtn = document.getElementById('statusFilterReset');
                if (countBadge) {
                    countBadge.textContent = activeFilter ? visibleCount + ' item' : '';
                    countBadge.style.display = activeFilter ? 'inline-block' : 'none';
                }
                if (resetBtn) resetBtn.classList.toggle('d-none', !activeFilter);
            }

            window.applyStatusFilter = applyStatusFilter;
        })();

        async function remapItems() {
            const filterDate = '@ViewBag.FilterDate';
            const dateLabel = filterDate ? ` tanggal ${filterDate}` : ' semua tanggal';
            if (!confirm(`Re-apply master item mapping ke jadwal${dateLabel}?\n\nItem yang belum cocok akan di-update sesuai mapping terbaru (QPC/kanban akan dikoreksi). Lanjutkan?`)) return;

            try {
                const res = await fetch('/PreparationSchedule/RemapItems', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ scheduleDate: filterDate || null })
                });
                const data = await res.json();
                alert(data.message || (data.success ? 'Selesai.' : 'Terjadi kesalahan.'));
                if (data.success && data.remapped > 0) window.location.reload();
            } catch (e) {
                alert('Gagal menghubungi server.');
            }
        }



        $(document).ready(function () {
            // Status Indicator Element
            const statusBadge = $('#connectionStatus');
            
            function updateStatus(status, color, icon) {
                if(statusBadge.length) {
                    statusBadge.removeClass('bg-secondary bg-success bg-danger bg-warning text-dark')
                              .addClass(color)
                              .html(`<i class="bi ${icon} me-1"></i> ${status}`);
                }
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/deliveryHub")
                .withAutomaticReconnect([0, 2000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Information)
                .build();

            connection.on("deliveryUpdated", function (data) {
                console.log("Prep update received", data);
                const action = (data && data.action) ? data.action.toLowerCase() : '';

                // Aksi yang membutuhkan refresh tabel jadwal (buat/hapus schedule)
                const needsFullReload = ['create', 'delete', 'deleteitem', 'bulk_create', 'importexcel', 'import', 'smartimport'].includes(action);

                // Aksi yang membutuhkan refresh tabel saja (KBN PREP berubah, tanpa full reload)
                const needsTableRefresh = ['sync', 'preparation', 'readytodock'].includes(action);

                if (needsFullReload) {
                    if (window.showUpdateNotification) {
                        window.showUpdateNotification('Jadwal preparation diperbarui.', 'prep', 2000);
                    }
                    setTimeout(() => window.location.reload(), 2000);
                } else if (needsTableRefresh) {
                    // Refresh tabel jadwal via AJAX agar KBN PREP langsung update
                    fetchAndUpdatePendingCount();
                    refreshScheduleTable();
                } else {
                    // Untuk aksi lain (pending, mismatch):
                    // Update angka pending tanpa reload halaman
                    fetchAndUpdatePendingCount();

                    // OTOMATIS refresh list di modal jika sedang terbuka
                    var modalEl = document.getElementById('pendingPrepModal');
                    if (modalEl && modalEl.classList.contains('show')) {
                        if (typeof reloadPendingModalData === 'function') {
                            reloadPendingModalData();
                        }
                    }

                    if (window.showUpdateNotification && action !== 'mismatch') {
                        window.showUpdateNotification('Data preparation diperbarui.', 'prep', 2500);
                    }
                }
            });

            // Handler khusus untuk event pendingCountUpdated (dari SyncPendingNow)
            connection.on("pendingCountUpdated", function (data) {
                console.log("Pending count updated:", data);
                if (data && typeof data.count === 'number') {
                    updatePendingUI(data.count);
                }
            });

            // Fungsi: Fetch jumlah pending terbaru dari server lalu update UI
            function fetchAndUpdatePendingCount() {
                fetch('/PreparationSchedule/GetPendingCount')
                    .then(r => r.ok ? r.json() : null)
                    .then(data => {
                        if (data && typeof data.count === 'number') {
                            updatePendingUI(data.count);
                        }
                    })
                    .catch(err => console.warn('Gagal fetch pending count:', err));
            }

            // Fungsi: Update semua elemen UI yang menampilkan pending count
            function updatePendingUI(count) {
                // 1. Badge di modal header
                const modalCountBadge = document.getElementById('pendingModalCount');
                if (modalCountBadge) modalCountBadge.textContent = count;

                // 2. Alert bar & angka di dalamnya
                const pendingAlert = document.getElementById('pendingPrepAlert');
                if (pendingAlert) {
                    if (count > 0) {
                        // Update angka di dalam alert
                        const strongEl = pendingAlert.querySelector('strong[style*="color:#f59e0b"]');
                        if (strongEl) strongEl.textContent = count;
                        pendingAlert.style.display = 'flex';
                    } else {
                        // Tidak ada pending &mdash; sembunyikan alert
                        pendingAlert.style.display = 'none';
                    }
                }

                console.log('[PendingCount] Updated to:', count);
            }



            connection.onreconnecting(error => {
                updateStatus("Reconnecting...", "bg-warning text-dark", "bi-wifi-off");
            });

            connection.onreconnected(connectionId => {
                updateStatus("Live", "bg-success", "bi-wifi");
            });

            connection.onclose(error => {
                updateStatus("Offline", "bg-danger", "bi-slash-circle");
                setTimeout(start, 5000);
            });

            async function start() {
                try {
                    await connection.start();
                    console.log("Prep SignalR Connected");
                    updateStatus("Live", "bg-success", "bi-wifi");
                } catch (err) {
                    console.error("SignalR Connection Error: ", err);
                    updateStatus("Error", "bg-danger", "bi-exclamation-triangle");
                    setTimeout(start, 5000);
                }
            };

            start();

            // ============================================
            // SERVER-SIDE SEARCH (lintas halaman) &mdash; render ke tabel utama
            // ============================================
            (function() {
                var searchTimer = null;
                var currentSearchPage = 1;
                var currentKeyword = '';
                var filterDate = '@ViewBag.FilterDate';
                var isSearchMode = false;

                // Simpan konten asli tbody agar bisa dikembalikan saat search ditutup
                var originalTbodyHtml = null;

                var $input        = $('#searchInput');
                var $clearBtn     = $('#searchClearBtn');
                var $mainTbody    = $('#mainTableBody');
                var $mainPager    = $('#mainPagerWrap');
                var $searchPager  = $('#searchPagerWrap');
                var $pagerInfo    = $('#searchPagerInfo');
                var $pagerBtns    = $('#searchPagerBtns');
                var $infoBar      = $('#searchInfoBar');
                var $infoCount    = $('#searchInfoCount');
                var $infoKeyword  = $('#searchInfoKeyword');
                var $infoLoading  = $('#searchInfoLoading');

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                function statusBadge(status, prepStatus, actual, target) {
                    if (actual >= target && target > 0) return '<span class="badge bg-success" style="font-size:0.7rem;">Completed</span>';
                    if (actual > 0) return '<span class="badge bg-warning text-dark" style="font-size:0.7rem;">In Progress</span>';
                    if (status === 'Completed')    return '<span class="badge bg-success" style="font-size:0.7rem;">Completed</span>';
                    if (prepStatus === 'Prepared') return '<span class="badge bg-info text-dark" style="font-size:0.7rem;">Prepared</span>';
                    if (status === 'In Progress')  return '<span class="badge bg-warning text-dark" style="font-size:0.7rem;">In Progress</span>';
                    return '<span class="badge bg-secondary" style="font-size:0.7rem;">Scheduled</span>';
                }

                function enterSearchMode() {
                    if (!isSearchMode) {
                        isSearchMode = true;
                        // Simpan isi tabel asli
                        originalTbodyHtml = $mainTbody.html();
                        // Sembunyikan pagination normal, tampilkan info bar
                        $mainPager.addClass('d-none');
                        $infoBar.removeClass('d-none');
                    }
                }

                function exitSearchMode() {
                    if (isSearchMode) {
                        isSearchMode = false;
                        // Kembalikan konten tabel asli
                        if (originalTbodyHtml !== null) {
                            $mainTbody.html(originalTbodyHtml);
                            originalTbodyHtml = null;
                        }
                        // Tampilkan kembali pagination normal
                        $mainPager.removeClass('d-none');
                        $searchPager.addClass('d-none');
                        $infoBar.addClass('d-none');
                        $infoCount.text('0');
                        $infoKeyword.text('');
                        currentKeyword = '';
                    }
                }

                function buildPagerBtns(data) {
                    if (data.totalPages > 1) {
                        $pagerInfo.text('Halaman ' + data.page + ' dari ' + data.totalPages + ' (' + data.total + ' hasil)');
                        var btns = '';
                        // Tombol prev
                        if (data.page > 1) btns += '<button class="btn btn-xs btn-outline-secondary py-0 px-2 search-pg-btn" data-pg="' + (data.page-1) + '" style="font-size:0.72rem;"><i class="bi bi-chevron-left"></i></button>';
                        var start = Math.max(1, data.page - 2);
                        var end   = Math.min(data.totalPages, data.page + 2);
                        if (start > 1) btns += '<button class="btn btn-xs btn-outline-secondary py-0 px-2 search-pg-btn" data-pg="1" style="font-size:0.72rem;">1</button>';
                        if (start > 2) btns += '<span class="text-secondary px-1" style="font-size:0.72rem;">â€¦</span>';
                        for (var i = start; i <= end; i++) {
                            btns += '<button class="btn btn-xs py-0 px-2 search-pg-btn '
                                + (i === data.page ? 'btn-info text-dark fw-bold' : 'btn-outline-secondary')
                                + '" data-pg="' + i + '" style="font-size:0.72rem;">' + i + '</button>';
                        }
                        if (end < data.totalPages - 1) btns += '<span class="text-secondary px-1" style="font-size:0.72rem;">â€¦</span>';
                        if (end < data.totalPages) btns += '<button class="btn btn-xs btn-outline-secondary py-0 px-2 search-pg-btn" data-pg="' + data.totalPages + '" style="font-size:0.72rem;">' + data.totalPages + '</button>';
                        // Tombol next
                        if (data.page < data.totalPages) btns += '<button class="btn btn-xs btn-outline-secondary py-0 px-2 search-pg-btn" data-pg="' + (data.page+1) + '" style="font-size:0.72rem;"><i class="bi bi-chevron-right"></i></button>';
                        $pagerBtns.html(btns);
                        $searchPager.removeClass('d-none');
                    } else {
                        $searchPager.addClass('d-none');
                        if (data.total > 0) $pagerInfo.text(data.total + ' hasil ditemukan');
                    }
                }

                function doSearch(page) {
                    page = page || 1;
                    currentSearchPage = page;
                    var q = $input.val().trim();
                    if (q.length < 2) { exitSearchMode(); return; }
                    currentKeyword = q;

                    enterSearchMode();

                    // Tampilkan loading di info bar
                    $infoLoading.removeClass('d-none');
                    $infoKeyword.text('untuk "' + escapeHtml(q) + '"');

                    fetch('/PreparationSchedule/Search?q=' + encodeURIComponent(q)
                        + '&filterDate=' + encodeURIComponent(filterDate)
                        + '&page=' + page + '&pageSize=20')
                    .then(function(r) {
                        if (!r.ok) {
                            return r.text().then(function(txt) {
                                throw new Error('HTTP ' + r.status + ': ' + txt.substring(0, 300));
                            });
                        }
                        return r.json();
                    })
                    .then(function(data) {
                        $infoLoading.addClass('d-none');

                        if (data.error) {
                            $mainTbody.html('<tr><td colspan="14" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-2"></i>Error: ' + escapeHtml(data.error) + '</td></tr>');
                            return;
                        }

                        $infoCount.text(data.total);
                        $infoKeyword.text('untuk "' + escapeHtml(q) + '"');

                        if (!data.items || data.items.length === 0) {
                            $mainTbody.html('<tr><td colspan="14" class="text-center text-secondary py-5"><i class="bi bi-search d-block mb-2" style="font-size:2rem;opacity:0.35;"></i>Tidak ada hasil untuk "' + escapeHtml(q) + '"</td></tr>');
                            $searchPager.addClass('d-none');
                            return;
                        }

                        // Deteksi apakah tabel memiliki kolom checkbox (ada #bulkSelectAll di thead)
                        var hasCbCol = $('#bulkSelectAll').length > 0;

                        // Render baris hasil pencarian ke tabel utama
                        var html = '';
                        data.items.forEach(function(row) {
                            var qtyHtml = row.qty > 0
                                ? '<span class="' + (row.actualQty >= row.qty ? 'text-success' : (row.actualQty > 0 ? 'text-warning' : 'text-secondary')) + '">'
                                  + row.actualQty + '/' + row.qty + '</span>'
                                : '<span class="text-secondary">-</span>';

                            // Kolom checkbox &mdash; tampilkan td kosong agar jumlah kolom tetap sama
                            var cbCol = hasCbCol
                                ? '<td class="text-center"><input type="checkbox" class="form-check-input bulk-check" data-id="' + (row.itemId || 0) + '" data-schedule-id="' + (row.scheduleId || 0) + '" style="cursor:pointer;" /></td>'
                                : '';

                            html += '<tr>'
                                + cbCol
                                + '<td class="text-center text-muted" style="font-size:0.75rem;font-weight:600;">' + row.rowNo + '</td>'
                                + '<td class="text-center"><div class="small fw-bold" style="font-size:0.75rem;">' + escapeHtml(row.scheduledDate) + '</div>'
