@model IEnumerable<DeliveryControl.Models.DeliverySchedule>

@{
    ViewData["Title"] = "Jadwal Preparation";
}

<div class="container-fluid pt-4">

    @* TempData Messages *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InactiveItemWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-slash-circle me-2"></i><strong>Item Nonaktif:</strong> @TempData["InactiveItemWarning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Modal Daftar Pending Preparation -->
    <div class="modal fade" id="pendingPrepModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="background:#0d1b35;border:1px solid #f59e0b;border-radius:12px;color:#fff;">
                <div class="modal-header" style="border-bottom:1px solid rgba(245,158,11,0.3);background:rgba(245,158,11,0.1);">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-warning"></i>
                        <span>Daftar Preparation <span class="text-warning">PENDING</span></span>
                        <span class="badge bg-warning text-dark ms-1" id="pendingModalCount">@ViewBag.PendingPrepCount</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="px-3 py-2" style="background:rgba(245,158,11,0.06);border-bottom:1px solid rgba(245,158,11,0.15);font-size:0.8rem;color:#fcd34d;">
                        <i class="bi bi-info-circle me-1"></i>
                        Data ini belum terikat ke jadwal manapun. Gunakan <strong>Sync Sekarang</strong> untuk menghubungkan ke jadwal yang sesuai.
                    </div>
                    <!-- SEARCH BAR PENDING -->
                    <div class="p-2 bg-dark border-bottom border-warning border-opacity-25 opacity-75">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                            <input type="text" id="searchPendingInput" class="form-control bg-dark text-white border-secondary" placeholder="Cari TAG / VIN / Label / Kanban..." oninput="handlePendingSearchInput()">
                        </div>
                    </div>
                    <!-- FILTER TANGGAL PENDING -->
                    <div class="px-3 py-2 border-bottom border-warning border-opacity-25 d-flex flex-wrap gap-2 align-items-center"
                         style="background:rgba(250,204,21,0.04);">
                        <i class="bi bi-funnel-fill text-warning" style="font-size:0.82rem;"></i>
                        <span class="text-warning-emphasis" style="font-size:0.76rem;font-weight:600;">FILTER TANGGAL:</span>
                        <div class="d-flex align-items-center gap-1">
                            <label class="text-white-50" style="font-size:0.74rem;white-space:nowrap;">Dari</label>
                            <input type="date" id="schedPendingDateFrom"
                                   class="form-control form-control-sm border-secondary text-white"
                                   style="background:#0a1628;max-width:140px;font-size:0.78rem;"
                                   title="Filter dari tanggal">
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <label class="text-white-50" style="font-size:0.74rem;white-space:nowrap;">Sampai</label>
                            <input type="date" id="schedPendingDateTo"
                                   class="form-control form-control-sm border-secondary text-white"
                                   style="background:#0a1628;max-width:140px;font-size:0.78rem;"
                                   title="Filter sampai tanggal">
                        </div>
                        <button type="button" class="btn btn-sm btn-warning text-dark fw-bold py-0 px-2"
                                style="font-size:0.76rem;"
                                onclick="fetchPendingPage(1)">
                            <i class="bi bi-search me-1"></i>Filter
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                style="font-size:0.76rem;"
                                onclick="document.getElementById('schedPendingDateFrom').value=''; document.getElementById('schedPendingDateTo').value=''; fetchPendingPage(1);">
                            <i class="bi bi-x-circle me-1"></i>Reset
                        </button>
                    </div>
                    <div style="max-height:420px;overflow-y:auto;">
                        <table class="table table-sm table-hover mb-0" style="color:#cbd5e1;">
                            <thead style="position:sticky;top:0;z-index:10;">
                                <tr style="background:#1a2a4a;border-bottom:2px solid #f59e0b;">
                                    <th class="px-3 py-2 text-center" style="width:40px;"><input type="checkbox" id="checkAllPendingSched" class="form-check-input"></th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">#</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Waktu Scan</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Dock</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Cycle</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">VIN / TAG</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Label</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Kanban</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Delivery Date</th>
                                    <th class="px-3 py-2" style="font-size:0.75rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Operator</th>
                                </tr>
                            </thead>
                            <tbody id="pendingPrepBody">
                                <tr><td colspan="10" class="text-center text-muted py-4">
                                    <div class="spinner-border spinner-border-sm me-2"></div>Memuat data...
                                </td></tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div id="pendingPagination" class="d-flex justify-content-between align-items-center px-3 py-2" style="border-top:1px solid rgba(245,158,11,0.2);display:none!important;">
                        <span id="pendingPageInfo" style="font-size:0.78rem;color:#94a3b8;"></span>
                        <div class="d-flex gap-1" id="pendingPageBtns"></div>
                    </div>
                </div>
                <div class="modal-footer px-3" style="border-top:1px solid rgba(245,158,11,0.3);">
                    <div class="d-flex w-100 align-items-center gap-3">
                        <div class="flex-grow-1">
                            <input type="text" id="schedPendingManifestInput" class="form-control border-warning text-warning fw-bold w-100" placeholder="Ketik/Scan No Manifest..." style="background: rgba(250, 204, 21, 0.1);">
                        </div>
                        <div class="d-flex gap-2 align-items-center flex-shrink-0">
                            <button type="button" id="btnSyncModalFooter" class="btn btn-warning fw-bold text-dark" onclick="doSyncSelectedPending(this)">
                                <i class="bi bi-arrow-repeat me-1"></i>Sync Sekarang
                            </button>
                            <div class="dropdown">
                                <button type="button" class="btn btn-danger fw-bold dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-trash3 me-1"></i>Hapus
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" style="background:#1a2a4a;border:1px solid rgba(220,38,38,0.4);">
                                    <li>
                                        <button class="dropdown-item text-info d-flex align-items-center gap-2"
                                                style="font-size:0.85rem;"
                                                onclick="openDeletePendingModal('selected')">
                                            <i class="bi bi-check2-square"></i>
                                            Hapus Item Terpilih
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" style="border-color:rgba(220,38,38,0.3);"></li>
                                    <li>
                                        <button class="dropdown-item text-warning d-flex align-items-center gap-2"
                                                style="font-size:0.85rem;"
                                                onclick="openDeletePendingModal('today')">
                                            <i class="bi bi-calendar-x"></i>
                                            Hapus Scan Hari Ini
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" style="border-color:rgba(220,38,38,0.3);"></li>
                                    <li>
                                        <button class="dropdown-item text-danger d-flex align-items-center gap-2"
                                                style="font-size:0.85rem;"
                                                onclick="openDeletePendingModal('all')">
                                            <i class="bi bi-trash3-fill"></i>
                                            Hapus Semua Pending
                                        </button>
                                    </li>
                                </ul>
                            </div>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Modal Konfirmasi Hapus Pending (ketik HAPUS) *@
    <div class="modal fade" id="deletePendingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
            <div class="modal-content" style="background:#0d1b35;border:1px solid rgba(220,38,38,0.5);border-radius:12px;color:#fff;">
                <div class="modal-header" style="border-bottom:1px solid rgba(220,38,38,0.3);background:rgba(220,38,38,0.08);">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                        <span id="deletePendingTitle">Hapus Data Pending</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="deletePendingDesc" class="mb-3" style="color:#fca5a5;font-size:0.88rem;line-height:1.5;"></p>
                    <div class="alert mb-3 p-2" style="background:rgba(220,38,38,0.12);border:1px solid rgba(220,38,38,0.35);border-radius:8px;font-size:0.82rem;color:#fca5a5;">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        Tindakan ini <strong>tidak dapat dibatalkan</strong>. Data yang dihapus tidak dapat dikembalikan.
                    </div>
                    <label class="form-label fw-semibold mb-1" style="font-size:0.82rem;color:#94a3b8;">
                        Ketik <strong style="color:#f87171;">HAPUS</strong> untuk konfirmasi:
                    </label>
                    <input type="text" id="deletePendingConfirmInput"
                           class="form-control bg-dark text-white border-danger"
                           placeholder="Ketik HAPUS di sini..."
                           autocomplete="off"
                           oninput="checkDeletePendingInput()" />
                </div>
                <div class="modal-footer" style="border-top:1px solid rgba(220,38,38,0.25);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="button" id="btnConfirmDeletePending"
                            class="btn btn-danger fw-bold" disabled
                            onclick="doDeletePending()">
                        <i class="bi bi-trash3-fill me-1"></i>Hapus Sekarang
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 align-items-center mb-4">
        <div class="col-12 col-xl-4">
             <h4 class="mb-1 text-white fw-bold d-flex align-items-center"><i class="bi bi-calendar-check me-2"></i> Jadwal
                <span class="d-xl-none ms-2 badge bg-primary">Mobile View</span>
                <span id="connectionStatus" class="badge bg-secondary ms-2" style="font-size: 0.6rem; vertical-align: middle;" title="Koneksi Realtime">
                   <i class="bi bi-broadcast"></i> Connecting...
                </span>
             </h4>
             @if (ViewBag.IsSuperAdmin == true)
             {
                 <div class="d-flex align-items-center gap-2 mt-1">
                     <span class="badge bg-purple text-white" style="background:#7c3aed!important;font-size:0.7rem;letter-spacing:0.5px;">
                         <i class="bi bi-shield-fill-check me-1"></i>SUPER ADMIN
                     </span>
                     @if (ViewBag.FilterCustomerId == 0)
                     {
                         <span class="text-info small" style="font-size:0.75rem;">
                             <i class="bi bi-eye-fill me-1"></i>Melihat <strong>semua dock</strong>
                             @if (ViewBag.ActiveDockCount > 0)
                             {
                                 <span class="badge bg-info text-dark ms-1">@ViewBag.ActiveDockCount dock aktif</span>
                             }
                         </span>
                     }
                     else
                     {
                         <span class="text-warning small" style="font-size:0.75rem;">
                             <i class="bi bi-funnel-fill me-1"></i>Filter: 1 dock
                             <a href="@Url.Action("Index", new { filterDate = ViewBag.FilterDate })" class="text-info ms-1" style="font-size:0.7rem;">
                                 (lihat semua)
                             </a>
                         </span>
                     }
                 </div>
             }
        </div>
        <div class="col-12 col-xl-8">
            <div class="d-flex flex-wrap gap-2 justify-content-start justify-content-xl-end align-items-center">
                <!-- Pending Alert Compact (full width, di atas search bar) -->
                @if (ViewBag.PendingPrepCount > 0)
                {
                    <div id="pendingPrepAlert" style="
                        width:100%;
                        background:rgba(245,158,11,0.1);
                        border:1px solid rgba(245,158,11,0.45);
                        border-radius:8px;
                        padding:7px 14px;
                        display:flex;
                        align-items:center;
                        gap:8px;
                        font-size:0.85rem;
                        color:#fcd34d;
                        box-sizing:border-box;
                    ">
                        <i class="bi bi-clock-history" style="font-size:1rem;flex-shrink:0;"></i>
                        <span style="flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            <strong style="color:#f59e0b;">@ViewBag.PendingPrepCount</strong>
                            preparation <strong>PENDING</strong> &mdash; belum terikat jadwal.
                        </span>
                        <button type="button" onclick="openPendingModal()"
                            style="background:none;border:none;padding:0 4px;color:#f59e0b;font-weight:700;font-size:0.82rem;cursor:pointer;text-decoration:underline;white-space:nowrap;flex-shrink:0;">
                            <i class="bi bi-table me-1"></i>Lihat daftar
                        </button>
                        <span style="flex:1;min-width:0;"></span>
                        <button type="button" id="btnSyncAlert" class="btn btn-warning btn-sm fw-bold py-1 px-3" style="font-size:0.82rem;flex-shrink:0;" onclick="doSyncPending(this)">
                            <i class="bi bi-arrow-repeat me-1"></i>Sync
                        </button>
                    </div>
                }

                <!-- Search Bar & Date Filter -->
                <form method="get" id="filterForm" class="d-flex align-items-center gap-2 me-md-2 flex-grow-1 flex-md-grow-0" style="min-width: 500px;">
                    <div class="input-group input-group-sm flex-grow-1" style="position:relative;">
                        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" name="q" class="form-control form-control-sm bg-dark text-white border-secondary"
                               value="@ViewBag.SearchKeyword"
                               placeholder="Cari Manifest / VIN / Part No / Customer / Dock..." autocomplete="off" />
                        <button type="button" id="searchClearBtn" class="btn btn-sm btn-outline-secondary border-0 d-none" style="padding:0 8px;" title="Hapus pencarian">
                            <i class="bi bi-x-lg" style="font-size:0.7rem;"></i>
                        </button>
                    </div>
                    <div class="input-group input-group-sm" style="width: 160px;">
                        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-calendar3"></i></span>
                        <input type="date" name="filterDate" class="form-control form-control-sm bg-dark text-white border-secondary" 
                               value="@ViewBag.FilterDate" onchange="this.form.submit()" />
                    </div>
                    @if (ViewBag.IsSuperAdmin == true)
                    {
                        <div class="input-group input-group-sm" style="min-width:180px;max-width:260px;">
                            <span class="input-group-text bg-dark border-secondary text-secondary" title="Filter Dock (Super Admin)">
                                <i class="bi bi-building"></i>
                            </span>
                            <select name="filterCustomerId" class="form-select form-select-sm bg-dark text-white border-secondary"
                                    onchange="this.form.submit()" style="min-width:130px;">
                                @if (ViewBag.FilterCustomerId == 0)
                                {
                                    <option value="0" selected="selected">Semua Dock (@(ViewBag.ActiveDockCount) aktif)</option>
                                }
                                else
                                {
                                    <option value="0">Semua Dock (@(ViewBag.ActiveDockCount) aktif)</option>
                                }
                                @if (ViewBag.DockFilterList != null)
                                {
                                    int fcid = (int)(ViewBag.FilterCustomerId ?? 0);
                                    foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.DockFilterList)
                                    {
                                        if (item.Value == fcid.ToString())
                                        {
                                            <option value="@item.Value" selected="selected">@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    }
                </form>

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-2 flex-grow-1 flex-xl-grow-0">
                    @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
                    {
                        <a asp-action="DownloadTemplate" class="btn btn-sm btn-secondary d-flex align-items-center flex-fill flex-xl-grow-0 justify-content-center">
                            <i class="bi bi-download me-2"></i> <span>Template</span>
                        </a>
                        <button type="button" class="btn btn-sm btn-warning text-dark d-flex align-items-center flex-fill flex-xl-grow-0 justify-content-center" data-bs-toggle="modal" data-bs-target="#smartImportModal">
                            <i class="bi bi-magic me-2"></i> <span>Smart Import</span>
                        </button>
                        <a asp-action="BulkCreate" class="btn btn-sm btn-info text-dark d-flex align-items-center flex-fill flex-xl-grow-0 justify-content-center">
                            <i class="bi bi-calendar-plus me-2"></i> <span>Bulk</span>
                        </a>
                        <a asp-action="Create" class="btn btn-sm btn-primary d-flex align-items-center flex-fill flex-xl-grow-0 justify-content-center">
                            <i class="bi bi-plus-lg me-2"></i> <span>New</span>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-info d-flex align-items-center flex-fill flex-xl-grow-0 justify-content-center"
                                onclick="remapItems()" title="Re-apply master item mapping ke jadwal hari ini (perbaiki QPC/kanban)">
                            <i class="bi bi-arrow-repeat me-2"></i> <span>Sinkron Mapping</span>
                        </button>

                        <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center flex-fill flex-xl-grow-0 justify-content-center"
                                data-bs-toggle="modal" data-bs-target="#repairSplitModal"
                                title="Pisahkan item C3/C2 yang salah masuk ke jadwal C1">
                            <i class="bi bi-scissors me-2"></i> <span>Pisah Jadwal</span>
                        </button>

                        <div class="dropdown flex-fill flex-xl-grow-0">
                            <button type="button" class="btn btn-sm btn-success d-flex align-items-center w-100 justify-content-center dropdown-toggle"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-file-earmark-excel me-2"></i> <span>Export Excel</span>
                            </button>
                            <ul class="dropdown-menu" style="background:#0d1b35;border:1px solid rgba(16,185,129,0.4);min-width:200px;">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       href="@Url.Action("ExportExcel", "PreparationSchedule", new { filterDate = ViewBag.FilterDate })"
                                       style="color:#6ee7b7;font-size:0.85rem;">
                                        <i class="bi bi-table"></i>
                                        <span>Semua (Hari Ini)</span>
                                    </a>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2"
                                            onclick="bulkExportSelected()"
                                            style="color:#fcd34d;font-size:0.85rem;">
                                        <i class="bi bi-check2-square"></i>
                                        <span>Data Terpilih</span>
                                        <span class="badge bg-warning text-dark ms-auto" id="exportSelectedCount" style="display:none;font-size:0.7rem;"></span>
                                    </button>
                                </li>
                            </ul>
                        </div>

                    }
                </div>
            </div>
        </div>
    </div>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <!-- FILTER STATUS BAR &mdash; Filter item belum selesai         -->
    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <div class="d-flex align-items-center gap-2 px-1 mb-1 flex-wrap" style="font-size:0.82rem;">
        <span class="text-secondary"><i class="bi bi-funnel me-1"></i>Filter Status:</span>
        <button type="button" data-status-filter="waiting"
                onclick="applyStatusFilter('waiting')"
                class="btn btn-sm btn-outline-secondary"
                style="font-size:0.78rem;padding:2px 10px;border-radius:20px;"
                title="Tampilkan hanya item yang belum mulai scan">
            <i class="bi bi-hourglass me-1"></i>Waiting
        </button>
        <button type="button" data-status-filter="preparing"
                onclick="applyStatusFilter('preparing')"
                class="btn btn-sm btn-outline-warning"
                style="font-size:0.78rem;padding:2px 10px;border-radius:20px;"
                title="Tampilkan item yang belum completed (Waiting + Preparing)">
            <i class="bi bi-box-seam me-1"></i>Belum Completed
        </button>
        <span id="statusFilterCount" class="badge bg-warning text-dark" style="display:none;font-size:0.75rem;"></span>
        <button type="button" onclick="applyStatusFilter(null)"
                class="btn btn-sm btn-link text-secondary p-0 ms-1 d-none" id="statusFilterReset"
                style="font-size:0.78rem;" title="Reset filter">
            <i class="bi bi-x-circle me-1"></i>Reset
        </button>
    </div>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <!-- SEARCH RESULTS PANEL &mdash; disembunyikan, hasil kini tampil di tabel utama -->
    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <div id="searchResultPanel" class="d-none" style="display:none!important;"></div>

    <!-- Bulk Delete Floating Toolbar -->
    @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
    {
        <div id="bulkDeleteBar" class="mb-3 d-none" style="
            background: linear-gradient(135deg, #1e1030 0%, #2d1b3e 100%);
            border: 1px solid rgba(168,85,247,0.4);
            border-radius: 10px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 4px 20px rgba(168,85,247,0.15);
            animation: fadeInDown 0.3s ease;
        ">
            <i class="bi bi-check2-square text-purple" style="font-size:1.2rem;color:#a855f7;"></i>
            <span style="color:#e0d0f0;font-size:0.88rem;">
                <strong id="bulkSelectedCount" style="color:#c084fc;">0</strong> item dipilih
            </span>
            <span style="flex:1;"></span>
            <button type="button" onclick="bulkDeselectAll()" class="btn btn-sm btn-outline-secondary" style="font-size:0.78rem;border-radius:6px;">
                <i class="bi bi-x-lg me-1"></i>Batal Pilih
            </button>
            <button type="button" onclick="bulkDeleteSelected()" class="btn btn-sm btn-danger fw-bold" style="font-size:0.82rem;border-radius:6px;padding:5px 16px;">
                <i class="bi bi-trash3-fill me-1"></i>Hapus Terpilih
            </button>
        </div>
    }


    <!-- Desktop Table View (Visible on XL Screens, OR ALWAYS if No Data) -->
    <div id="desktopTableContainer" class="@(Model.Any() ? "cyber-card d-none d-xl-block" : "cyber-card")">

        <!-- Search Info Bar &mdash; muncul saat search aktif -->
        <div id="searchInfoBar" class="d-none px-3 pt-3 pb-2 d-flex align-items-center gap-2 flex-wrap" style="border-bottom:1px solid rgba(56,189,248,0.25);">
            <i class="bi bi-search text-info"></i>
            <span class="fw-bold text-info" style="font-size:0.9rem;">Hasil Pencarian</span>
            <span id="searchInfoCount" class="badge bg-info text-dark">0</span>
            <span id="searchInfoKeyword" class="text-secondary" style="font-size:0.82rem;"></span>
            <span id="searchInfoLoading" class="d-none ms-1">
                <span class="spinner-border spinner-border-sm text-info" style="width:0.8rem;height:0.8rem;"></span>
                <span class="text-secondary small ms-1">Mencari...</span>
            </span>
            <span style="flex:1;"></span>
            <button type="button" id="searchInfoClose" class="btn btn-sm btn-outline-secondary border-0 py-0 px-2" title="Tutup pencarian">
                <i class="bi bi-x-lg" style="font-size:0.75rem;"></i> Tutup
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="text-uppercase text-secondary small">
                        @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
                        {
                            <th class="text-center" style="width:36px;">
                                <input type="checkbox" class="form-check-input" id="bulkSelectAll" title="Pilih Semua" style="cursor:pointer;" />
                            </th>
                        }
                        <th class="text-center" style="width:40px;">NO</th>
                        <th class="text-center">JADWAL</th>
                        <th>MANIFESTING</th>
                        <th>DOCK</th>
                        <th>NAMA CUSTOMER</th>
                        <th>ROUTE</th>
                        <th>CYCLE</th>
                        <th>PART NO / VIN</th>
                        <th class="text-center">QTY/LOT</th>
                        <th class="text-center">QTY (PCS)</th>
                        <th class="text-center">KBN PREP</th>
                        <th class="text-center">STATUS</th>
                        <th class="text-center">ACTION</th>
                    </tr>
                </thead>
                <tbody id="mainTableBody">
                    @{
                        int rowNo = ((ViewBag.CurrentPage ?? 1) - 1) * 20 + 1;
                        var tomorrowDate = DateTime.Parse(ViewBag.FilterDate.ToString()).AddDays(1);
                    }
                    @foreach (var schedule in Model)
                    {
                        var items = schedule.DeliveryItems != null && schedule.DeliveryItems.Any() 
                            ? schedule.DeliveryItems.Cast<DeliveryControl.Models.DeliveryItem?>().ToList() 
                            : new List<DeliveryControl.Models.DeliveryItem?> { null };

                        foreach (var item in items)
                        {
                            string rowStatus = "waiting";
                            if (item == null) { rowStatus = "ghost"; }
                            else if ((item.ActualQuantity ?? 0) >= item.Quantity) { rowStatus = "completed"; }
                            else if ((item.ActualQuantity ?? 0) > 0) { rowStatus = "preparing"; }
                            <tr data-item-status="@rowStatus">
                                @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
                                {
                                    <td class="text-center">
                                        @if (item != null)
                                        {
                                            <input type="checkbox" class="form-check-input bulk-check" data-id="@item.DeliveryItemId" data-schedule-id="@schedule.ScheduleId" style="cursor:pointer;" />
                                        }
                                        else
                                        {
                                            @* Ghost schedule row: pakai data-ghost-schedule-id agar bulk delete bisa hapus schedule-nya *@
                                            <input type="checkbox" class="form-check-input bulk-check" data-id="0" data-ghost-schedule-id="@schedule.ScheduleId" data-schedule-id="@schedule.ScheduleId" style="cursor:pointer;" />
                                        }
                                    </td>
                                }
                                <td class="text-center text-muted" style="font-size:0.75rem;font-weight:600;">@(rowNo++)</td>
                                <td class="text-center">
                                    <div class="small fw-bold" style="font-size: 0.75rem;">
                                        @schedule.ScheduledDate.ToString("dd/MM/yyyy")
                                        @if (schedule.ScheduledDate.Date == tomorrowDate) {
                                            <span class="badge bg-warning text-dark ms-1" style="font-size:0.55rem;">H-1</span>
                                        }
                                        <div class="text-muted" style="font-size: 0.65rem; letter-spacing:0.5px;">Upload: @schedule.CreatedDate.ToString("dd/MM HH:mm")</div>
                                    </div>
                                </td>
                                <td class="fw-bold text-info">
                                    <div class="small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">MANIFEST</div>
                                    @schedule.ScheduleNumber
                                </td>
                                <td>
                                    <div class="small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">DOCK</div>
                                    <span class="badge bg-secondary">
                                        @(schedule.Customer?.CustomerName ?? "-")
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">CUSTOMER</div>
                                    <span class="fw-bold">@(schedule.Customer?.CustomerCode ?? "-")</span>
                                </td>
                                <td>
                                    <div class="small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">ROUTE</div>
                                    @(schedule.Route ?? "-")
                                </td>
                                <td>
                                    <div class="small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">CYCLE</div>
                                    @(schedule.Cycle ?? "-")
                                </td>
                                
                                @if (item != null)
                                {
                                    <td style="background: rgba(13, 110, 253, 0.05); border-left: 2px solid #0d6efd;">
                                        <div class="d-flex flex-column">
                                            @{
                                                // Prioritas tampilan Part No:
                                                // 1. ExternalPartNo (Part No asli dari manifest, tidak hilang meski di-remap)
                                                // 2. CustomerPartNumber dari master item
                                                // 3. VIN dari master item
                                                var displayPartNo = !string.IsNullOrWhiteSpace(item.ExternalPartNo)
                                                    ? item.ExternalPartNo
                                                    : (!string.IsNullOrWhiteSpace(item.Item?.CustomerPartNumber)
                                                        ? item.Item.CustomerPartNumber
                                                        : item.Item?.VIN ?? "-");
                                                var displayVin = item.Item?.VIN;
                                                bool showVin = !string.IsNullOrWhiteSpace(displayVin) && displayVin != displayPartNo;
                                            }
                                            <div class="d-flex align-items-center flex-wrap">
                                                <span class="text-white fw-bold fs-6">@displayPartNo</span>
                                                @if (showVin)
                                                {
                                                    <span class="text-success fw-bold ms-1" style="font-size: 0.8rem;">/ @displayVin</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="small text-muted mb-1" style="font-size: 0.65rem;">QPC</div>
                                        <span class="badge bg-dark border">@item.Item?.QtyLot</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">
                                            @item.Quantity.ToString("N0") Pcs
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold">
                                        <span class="badge bg-info text-dark" style="font-size: 1.1rem; padding: 0.5rem 0.8rem;">
                                            <div class="fw-bold">@item.CalculatedKanbanActual / @item.CalculatedKanbanTarget</div>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            string statusBadgeClass = "bg-secondary";
                                            string statusText = "Waiting";

                                            if (item.ActualQuantity >= item.Quantity)
                                            {
                                                statusBadgeClass = "bg-success";
                                                statusText = "Completed";
                                            }
                                            else if (item.ActualQuantity > 0)
                                            {
                                                statusBadgeClass = "bg-warning text-dark";
                                                statusText = "Preparing";
                                            }
                                        }
                                        <span class="badge @statusBadgeClass">@statusText</span>
                                    </td>
                                }
                                else 
                                {
                                    <td colspan="5" class="text-center text-muted fst-italic py-3">
                                        <i class="bi bi-exclamation-circle me-1"></i> No Items found (Ghost Schedule)
                                    </td>
                                }

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (item != null)
                                        {
                                            <a asp-controller="PreparationWorkflow" asp-action="Index" class="btn btn-sm btn-primary" title="Process Scan">
                                                <i class="bi bi-box-seam"></i> 
                                            </a>
                                            
                                            @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
                                            {
                                                <form asp-action="DeleteDeliveryItem" asp-route-id="@item.DeliveryItemId" asp-route-pageNumber="@ViewBag.CurrentPage" asp-route-filterDate="@ViewBag.FilterDate" method="post" onsubmit="return confirm('Hapus item ini (Part No: @(item.Item?.VIN ?? item.Item?.CustomerPartNumber ?? item.DeliveryItemId.ToString()))? Schedule lain tidak terpengaruh.');" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Hapus Item Ini">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
                                        {
                                            @* Ghost schedule: tampilkan tombol hapus schedule agar bisa dibersihkan *@
                                            <form asp-action="Delete" asp-route-id="@schedule.ScheduleId" asp-route-pageNumber="@ViewBag.CurrentPage" asp-route-filterDate="@ViewBag.FilterDate" method="post" onsubmit="return confirm('Hapus Ghost Schedule @schedule.ScheduleNumber? Schedule ini tidak memiliki item dan akan dihapus permanen.');" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus Ghost Schedule">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Model.Any())
                    {
                         <tr>
                            <td colspan="14" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Belum ada jadwal preparation.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Pagination Desktop *@
        <div id="mainPagerWrap" class="px-3 pb-3 pt-2 border-top border-secondary d-none d-xl-block">
            <partial name="_Pager" model='new { CurrentPage = ViewBag.CurrentPage, TotalPages = ViewBag.TotalPages, TotalItems = ViewBag.TotalItems, RouteData = ViewBag.RouteData }' />
        </div>
        <!-- Search pagination (tampil saat search aktif, menggantikan mainPagerWrap) -->
        <div id="searchPagerWrap" class="d-none px-3 pb-3 pt-2 border-top border-secondary d-flex align-items-center gap-2 flex-wrap">
            <span id="searchPagerInfo" class="text-secondary small me-auto"></span>
            <div id="searchPagerBtns" class="d-flex gap-1 flex-wrap"></div>
        </div>
    </div>

    <!-- Mobile/Tablet Card View -->
    <div id="mobileCardContainer" class="@(Model.Any() ? "d-xl-none" : "d-none")">
        @{
            int mobileNo = ((ViewBag.CurrentPage ?? 1) - 1) * 20 + 1;
        }
        @foreach (var schedule in Model)
        {
            foreach (var item in schedule.DeliveryItems)
            {
                <div class="cyber-mobile-card mb-3">
                    <div class="cyber-mobile-card-header d-flex justify-content-between align-items-center p-3 border-bottom border-secondary bg-dark bg-opacity-50">
                        <div>
                            <span class="badge bg-secondary me-1" style="font-size:0.7rem;">No. @(mobileNo++)</span>
                            <span class="text-info fw-bold"><i class="bi bi-hash"></i> @schedule.ScheduleNumber</span>
                            <span class="badge bg-secondary ms-1">
                                <i class="bi bi-geo-alt"></i> @(schedule.Customer?.CustomerName ?? "-")
                            </span>
                            <div class="small text-muted mt-1" style="font-size: 0.65rem;">
                                <i class="bi bi-calendar me-1"></i> @schedule.ScheduledDate.ToString("dd/MM/yyyy")
                                @if (schedule.ScheduledDate.Date == tomorrowDate) {
                                    <span class="badge bg-warning text-dark ms-1" style="font-size:0.55rem;">H-1</span>
                                }
                            </div>
                        </div>
                        @{
                            var pctMobile = (item.Quantity > 0) ? ((double)(item.ActualQuantity ?? 0) / (double)item.Quantity * 100) : 0;
                            string statusClassMobile = "bg-secondary";
                            string statusIconMobile = "bi-hourglass";
                            
                            if (item.ActualQuantity >= item.Quantity)
                            {
                                statusClassMobile = "bg-success";
                                statusIconMobile = "bi-check-circle";
                            }
                            else if (item.ActualQuantity > 0)
                            {
                                statusClassMobile = "bg-warning text-dark";
                                statusIconMobile = "bi-arrow-repeat";
                            }
                        }
                        <span class="badge @statusClassMobile"><i class="bi @statusIconMobile"></i></span>
                    </div>
                    <div class="cyber-mobile-card-body p-3">
                         <div class="row g-2 mb-2">
                            <div class="col-6">
                                <span class="text-white fw-bold">@(schedule.Customer?.CustomerName ?? "-")</span>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-secondary d-block">Route / Cycle</small>
                                <span class="text-white">@(schedule.Route ?? "-") / @(schedule.Cycle ?? "-")</span>
                            </div>
                        </div>
                        
                     <div class="mb-3 p-2 bg-primary bg-opacity-10 rounded border-start border-primary border-4">
                            <small class="text-primary fw-bold d-block mb-1" style="letter-spacing: 1px;">DATA ITEM / PESANAN</small>
                            @if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber) && !string.IsNullOrEmpty(item.Item?.VIN))
                            {
                                <span class="text-white fw-bold d-block fs-5">@item.Item.CustomerPartNumber</span>
                                <span class="text-info small">@item.Item.VIN</span>
                            }
                            else if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber))
                            {
                                <span class="text-white fw-bold d-block fs-5">@item.Item.CustomerPartNumber</span>
                            }
                            else
                            {
                                <span class="text-white fw-bold d-block fs-5">@(item.Item?.VIN ?? "-")</span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-end p-2 bg-dark bg-opacity-25 rounded border border-secondary mb-3">
                            <div class="text-center flex-grow-1">
                                <small class="text-secondary d-block">Schedule Quantity</small>
                                <span class="badge bg-info text-dark" style="font-size: 1.3rem;">@item.CalculatedKanbanActual / @item.CalculatedKanbanTarget <small>KBN</small></span>
                                <div class="mt-1">
                                    <span class="badge bg-secondary">@item.Quantity.ToString("N0") <small>Pcs</small></span>
                                </div>
                            </div>
                             <div class="text-center">
                                <small class="text-secondary d-block">Progress</small>
                                <span class="@(item.ActualQuantity >= item.Quantity ? "text-success" : "text-light") fw-bold fs-5">@((int)pctMobile)%</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-flex">
                            <a asp-controller="PreparationWorkflow" asp-action="Index" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-box-seam me-2"></i> Process Scan
                            </a>
                            @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
                            {
                                <form asp-action="DeleteDeliveryItem" asp-route-id="@item.DeliveryItemId" asp-route-pageNumber="@ViewBag.CurrentPage" asp-route-filterDate="@ViewBag.FilterDate" method="post" onsubmit="return confirm('Hapus item ini saja? Item lain dalam manifest tidak terpengaruh.');">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="row mt-2 mb-4 d-xl-none">
        <div class="col-12">
            <partial name="_Pager" model='new { CurrentPage = ViewBag.CurrentPage, TotalPages = ViewBag.TotalPages, TotalItems = ViewBag.TotalItems, RouteData = ViewBag.RouteData }' />
        </div>
    </div>
</div>


<!-- Repair / Pisah Jadwal Modal -->
<div class="modal fade" id="repairSplitModal" tabindex="-1" aria-labelledby="repairSplitModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content" style="background:#0d1b35;border:1px solid rgba(239,68,68,0.5);border-radius:12px;color:#fff;">
            <div class="modal-header py-2" style="border-bottom:1px solid rgba(239,68,68,0.3);background:rgba(239,68,68,0.08);">
                <h6 class="modal-title fw-bold d-flex align-items-center gap-2 text-danger mb-0" id="repairSplitModalLabel">
                    <i class="bi bi-scissors"></i> Pisah Jadwal (Repair C1 &harr; C3)
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="font-size:0.85rem;">
                <p class="text-warning mb-3" style="font-size:0.78rem;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Tool ini memisahkan item yang <b>salah masuk ke jadwal C1</b> ke jadwal baru untuk customer target (mis. C3).
                    Identifikasi berdasarkan <b>ItemMapping.Customer</b> dan <b>Item.Customer</b>.
                    Gunakan <b>Dry Run</b> dulu sebelum eksekusi.
                </p>
                <div class="mb-3">
                    <label class="form-label text-info fw-semibold">Schedule ID (Source &mdash; jadwal C1 yang berisi item C3)</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="repairSourceScheduleId" class="form-control form-control-sm bg-dark text-white border-secondary"
                               placeholder="Nomor jadwal atau ID angka">
                        <button type="button" class="btn btn-sm btn-outline-info text-nowrap" onclick="repairLookupSchedule()">
                            <i class="bi bi-search me-1"></i>Cari
                        </button>
                    </div>
                    <div id="repairScheduleInfo" class="mt-1" style="font-size:0.75rem;display:none;"></div>
                    <div class="form-text text-muted">Ketik nomor manifest atau ID angka lalu klik Cari</div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-info fw-semibold">Target Customer ID (mis. Customer C3)</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="repairTargetCustomerId" class="form-control form-control-sm bg-dark text-white border-secondary"
                               placeholder="ID angka Customer C2/C3">
                        <button type="button" class="btn btn-sm btn-outline-info text-nowrap" onclick="repairLookupCustomer()">
                            <i class="bi bi-search me-1"></i>Cari
                        </button>
                    </div>
                    <div id="repairCustomerInfo" class="mt-1 text-success" style="font-size:0.75rem;display:none;"></div>
                </div>
                <div id="repairDryRunResult" class="d-none p-2 rounded mb-2" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);">
                    <div id="repairDryRunText" class="mb-2" style="font-size:0.78rem;"></div>
                    <div id="repairDryRunParts" style="font-size:0.72rem;max-height:120px;overflow-y:auto;color:#94a3b8;"></div>
                </div>
                <div id="repairActionResult" class="d-none mt-2 p-2 rounded" style="font-size:0.82rem;"></div>
            </div>
            <div class="modal-footer gap-2" style="border-top:1px solid rgba(239,68,68,0.25);">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="button" class="btn btn-sm btn-outline-warning fw-semibold" onclick="repairDryRun()" id="repairDryRunBtn">
                    <i class="bi bi-eye me-1"></i> Dry Run (Preview)
                </button>
