                    <label class="form-label" style="font-size:0.75rem;color:#94a3b8;margin-bottom:4px;">Min ROP</label>
                    <input type="number" id="editMasMin" class="form-control form-control-sm" style="background:#1e293b;color:#fff;border-color:#334155;" />
                </div>
