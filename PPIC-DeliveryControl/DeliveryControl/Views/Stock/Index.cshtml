                    <label class="form-label" style="font-size:0.75rem;color:#94a3b8;margin-bottom:4px;">Max</label>
                    <input type="number" id="editMasMax" class="form-control form-control-sm" style="background:#1e293b;color:#fff;border-color:#334155;" />
                </div>
            </div>
        </div>

        <!-- Lokasi RAK (Dropdown) -->
        <div id="adjRackSection" style="display:none;margin-bottom:16px;padding:15px;background:#0f172a;border-radius:12px;border:1px solid #334155;">
            <label style="font-size:0.82rem;color:#94a3b8;margin-bottom:10px;display:block;font-weight:600;">
                <i class="bi bi-geo-alt-fill text-primary"></i> LOKASI RACK
            </label>
            <div style="display:flex;gap:15px;align-items:center;">
                <div style="flex:1;">
                    <select id="adjRackDropdown" style="width:100%;padding:10px 14px;border-radius:10px;border:1px solid #1e293b;background:#1e293b;color:#e2e8f0;font-size:0.95rem;cursor:pointer;outline:none;transition:border-color 0.2s;">
                        <option value="">-- Pilih Rack --</option>
                    </select>
                    <div style="font-size:0.7rem;color:#64748b;margin-top:5px;"><i class="bi bi-info-circle"></i> Pilih rak yang ada atau "Tambah Rak Baru"</div>
                </div>
                <div id="rackStockIndicator" style="background:rgba(59, 130, 246, 0.08);padding:8px 15px;border-radius:12px;border:1px solid rgba(59, 130, 246, 0.15);min-width:110px;text-align:center;box-shadow:inset 0 0 10px rgba(0,0,0,0.2);">
                    <div style="font-size:0.65rem;color:#64748b;text-transform:uppercase;font-weight:800;letter-spacing:0.5px;margin-bottom:2px;">Stok Saat Ini</div>
                    <div id="currentRackStockText" style="font-size:1.4rem;font-weight:800;color:#0dcaf0;line-height:1;">0</div>
                </div>
            </div>
        </div>

        <!-- Input Rak Baru (Manual) -->
        <div id="newRackSection" style="display:none;margin-bottom:16px;padding:15px;background:rgba(59, 130, 246, 0.05);border-radius:12px;border:1px dashed #0dcaf0;">
             <label style="font-size:0.82rem;color:#0dcaf0;margin-bottom:10px;display:block;font-weight:700;">
                <i class="bi bi-plus-circle-fill"></i> INPUT RACK BARU
             </label>
             <div id="dynamicRackContainer">
                 <div class="d-flex gap-2 align-items-center mb-2 rack-input-row">
                    <div style="flex:1;">
                        <span style="font-size:0.7rem;color:#64748b;text-transform:uppercase;font-weight:700;">Rack</span>
                        <input type="text" class="newRackCode" maxlength="10" placeholder="Contoh: A, L, M" 
                               style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.95rem;text-transform:uppercase;">
                    </div>
                    <div style="flex:1;">
                        <span style="font-size:0.7rem;color:#64748b;text-transform:uppercase;font-weight:700;">No Rack</span>
                        <input type="number" class="newNoRack" min="0" max="999" placeholder="0-99" 
                               style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.95rem;">
                    </div>
                    <div style="width: 32px; padding-top: 18px;" class="text-end rack-del-btn-container">
                        <!-- Space for delete button for additional rows -->
                    </div>
                 </div>
             </div>
             @if (Context.Session.GetString("Role") == "Super Admin")
             {
                 <button type="button" id="btnAddRackRow" class="btn btn-sm btn-outline-info mt-1" style="font-size:0.75rem; border-radius:6px; background: rgba(13, 202, 240, 0.1);">
                    <i class="bi bi-plus"></i> Tambah Baris Rak
                 </button>
                 <div style="font-size:0.7rem;color:#64748b;margin-top:8px;"><i class="bi bi-info-circle"></i> Masukkan beberapa lokasi fisik rak sekaligus</div>
             }
             else
             {
                 <div style="font-size:0.7rem;color:#64748b;margin-top:8px;"><i class="bi bi-info-circle"></i> Masukkan lokasi fisik rak untuk mendaftarkan stok di lokasi baru</div>
             }
        </div>

        <div id="adjQtySection" style="margin-bottom:16px;">
            <label id="adjQtyLabel" style="font-size:0.82rem;color:#94a3b8;margin-bottom:6px;display:block;">Stok Baru di Rak Terpilih <span style="color:#dc3545;">*</span></label>
            <div style="display:flex;gap:12px;align-items:center;">
                <div style="flex:1;position:relative;">
                    <input type="number" id="adjQty" placeholder="Berapa qty total baru?" step="1"
                           style="width:100%;padding:12px;border-radius:10px;border:2px solid #334155;background:#0f172a;color:#fff;font-size:1.1rem;font-weight:700;outline:none;transition:border-color 0.2s;">
                    <div id="adjQtyDeltaBadge" style="display:none;position:absolute;right:45px;top:50%;transform:translateY(-50%);padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:800;"></div>
                </div>
            </div>
            <div id="adjQtyWarning" style="display:none;margin-top:10px;padding:10px 14px;background:rgba(245, 158, 11, 0.08);border:1px solid rgba(245, 158, 11, 0.2);border-radius:10px;font-size:0.78rem;">
                <div id="adjQtyWarningText" style="line-height:1.4;"></div>
            </div>
        </div>

        <!-- Relocation Target Section -->
        <div id="relocateSection" style="display:none;margin-bottom:16px;padding:12px;background:rgba(59, 130, 246, 0.05);border-radius:10px;border:1px dashed #0dcaf0;">
             <label style="font-size:0.82rem;color:#0dcaf0;margin-bottom:8px;display:block;font-weight:700;"><i class="bi bi-arrow-right-circle-fill"></i> Lokasi TUJUAN (RELOKASI)</label>
             <div style="display:flex;gap:10px;align-items:center;">
                <div style="flex:1;">
                    <span style="font-size:0.7rem;color:#64748b;text-transform:uppercase;font-weight:700;">Target Rack</span>
                    <input type="text" id="targetRack" maxlength="5" placeholder="A-K" 
                           style="width:100%;padding:7px 10px;border-radius:6px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.9rem;text-transform:uppercase;">
                </div>
                <div style="flex:1;">
                    <span style="font-size:0.7rem;color:#64748b;text-transform:uppercase;font-weight:700;">Target No. Rak</span>
                    <input type="number" id="targetNoRack" min="1" max="99" placeholder="1-20" 
                           style="width:100%;padding:7px 10px;border-radius:6px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.9rem;">
                </div>
             </div>
             <div style="margin-top:12px;">
                  <label style="font-size:0.8rem;color:#94a3b8;margin-bottom:4px;display:block;">Qty yang akan dipindahkan</label>
                  <input type="number" id="relocateQty" placeholder="Berapa qty?" 
                         style="width:100%;padding:7px 10px;border-radius:6px;border:1px solid #334155;background:#0f172a;color:#7dd3fc;font-size:0.9rem;font-weight:600;">
                  <span style="font-size:0.75rem;color:#64748b;">(Kosongkan untuk pindah semua qty di rak ini)</span>
             </div>
        </div>

        <div style="margin-bottom:20px;">
            <label style="font-size:0.82rem;color:#94a3b8;margin-bottom:6px;display:block;">Catatan / Alasan <span style="color:#94a3b8;font-size:0.75rem;">(opsional)</span></label>
            <textarea id="adjNote" rows="3" placeholder="Manual Stock Adjustment"
                      style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.88rem;resize:vertical;"></textarea>
        </div>

        <div id="adjResultMsg" style="display:none;padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:0.85rem;"></div>

        <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button id="btnCancelAdjust" style="padding:8px 18px;border-radius:8px;border:1px solid #334155;background:transparent;color:#94a3b8;cursor:pointer;font-size:0.85rem;">Batal</button>
            <button id="btnSubmitAdjust" style="padding:8px 18px;border-radius:8px;border:none;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;font-weight:600;cursor:pointer;font-size:0.85rem;">
                <i class="bi bi-check2-circle"></i> Simpan
            </button>
        </div>
    </div>
</div>

<script>
    // Global functions for breakdown modal
    window.showItemDetail = function(record) {
        $('#detailItemName').text(record.itemName);
        $('#detailVin').text(record.vin);
        $('#detailPlantCust').text(record.plant + ' / ' + record.customer);
        $('#detailTotalStock').text(record.currentStock);
        $('#detailMin').text(record.min);
        $('#detailRop').text(record.rop);
        $('#detailMax').text(record.max);
        
        // Level Stock badge
        const badge = $('#detailLevelStock');
        badge.text(record.levelStock.toFixed(1) + ' D');
        badge.removeClass('stock-level-red stock-level-yellow stock-level-green stock-level-blue');
        if (record.levelStock < 1.0) badge.addClass('stock-level-red');
        else if (record.levelStock <= 2.0) badge.addClass('stock-level-yellow');
        else badge.addClass('stock-level-blue');

        // Rack Breakdown
        const tbody = $('#detailRackTable');
        tbody.empty();
        selectedItemId = record.itemId; // Simpan untuk aksi di modal rincian
        
        if (record.rackBreakdown && record.rackBreakdown.length > 0) {
            record.rackBreakdown.forEach(rb => {
                tbody.append(`
                    <tr>
                        <td class="ps-3 py-2">
                             <div class="d-flex align-items-center">
                                <i class="bi bi-geo-alt-fill text-primary opacity-50 me-2" style="font-size: 0.8rem;"></i>
                                <span class="fw-bold text-light">${rb.rack}.${rb.column}</span>
                             </div>
                        </td>
                        <td class="text-center py-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2" style="font-size: 0.85rem; min-width: 40px;">
                                ${rb.stock}
                            </span>
                        </td>
                        <td class="text-center py-2 text-muted" style="font-size: 0.8rem;">${rb.lastActivity}</td>
                        <td class="text-center py-1">
                            <button class="btn btn-sm btn-link text-danger p-0" 
                                    onclick="removeRack('${rb.rack}', ${rb.column})" 
                                    title="Hapus riwayat rak ini">
                                <i class="bi bi-trash3" style="font-size: 0.9rem;"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });
        } else {
            tbody.append('<tr><td colspan="4" class="text-center py-3 text-muted italic">Tidak ada rincian lokasi</td></tr>');
        }
        
        $('#modalItemDetail').css('display', 'flex');
    };

    window.removeRack = function(rack, noRack) {
        if (!confirm(`Hapus riwayat rak ${rack}.${noRack}?\n(Tindakan ini menyembunyikan lokasi dari rincian tanpa menghapus data transaksi asli)`)) return;
        
        const url = `/Pulling/HideRack?itemId=${selectedItemId}&rack=${encodeURIComponent(rack)}&noRack=${noRack}`;
        fetch(url, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload(); // Refresh page to update all counts
                } else {
                    alert(data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Gagal menghubungi server.');
            });
    };

    window.closeItemDetail = function() {
        $('#modalItemDetail').hide();
    };

    // Global action functions
    window.editStockItem = function(btn, itemId, itemName, currentRack) {
        if (window.openAdjustmentModal) {
            window.openAdjustmentModal(btn, itemId, itemName, currentRack);
        }
    };

    window.deleteStockItem = function(itemId, itemName) {
        if (confirm(`Hapus semua data pulling hari ini untuk item "${itemName}"? Tindakan ini tidak dapat dibatalkan.`)) {
            fetch('/Stock/BulkDeletePulling', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify([itemId])
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    if (window.showUpdateNotification) window.showUpdateNotification(data.message, 'pulling', 3000);
                    // refresh via signalR or manual
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    alert(data.message);
                }
            });
        }
    };

    // Adjustment Modal Logic (Exposed to Global)
    (function () {
        var allItems = [];
        var selectedItemId = 0;
        var currentMode = 'adjust'; // adjust or relocate

        window.openAdjustmentModal = function(btn, prefillId, prefillName, prefillRack) {
            document.getElementById('modalAdjustStock').style.display = 'flex';
            resetForm();
            if (allItems.length === 0) loadAllItems();
            
            if (prefillId) {
                selectedItemId = prefillId;
                document.getElementById('adjItemId').value = prefillId;
                let vinTitle = btn && btn.getAttribute ? btn.getAttribute('data-vin') : '';
                document.getElementById('adjModalTitle').textContent = 'Edit Item: ' + (vinTitle ? vinTitle + ' - ' : '') + (prefillName || '');
                document.getElementById('adjModalIcon').className = 'bi bi-pencil-square';
                document.getElementById('adjModalIcon').style.color = '#0dcaf0';

                // PREFILL MASTER DATA
                if (btn && btn.getAttribute) {
                    document.getElementById('editMasVin').value = btn.getAttribute('data-vin') || '';
                    document.getElementById('editMasPlant').value = btn.getAttribute('data-plant') || '';
                    document.getElementById('editMasLokasiRak').value = prefillName || '';
                    document.getElementById('editMasCust').value = btn.getAttribute('data-cust') || '';
                    document.getElementById('editMasStatus').value = btn.getAttribute('data-status') || '';
                    document.getElementById('editMasProd').value = btn.getAttribute('data-prod') || '';
                    document.getElementById('editMasQpc').value = btn.getAttribute('data-qpc') || '';
                    document.getElementById('editMasMin').value = btn.getAttribute('data-min') || '';
                    document.getElementById('editMasMax').value = btn.getAttribute('data-max') || '';
                }
                
                // HIDE Search box, show result directly
                const searchGroup = document.getElementById('adjItemSearch').parentElement;
                if (searchGroup) searchGroup.style.display = 'none';

                // Gunakan GetRackDetail agar perhitungan stok sesuai dengan FIFO (sama dengan dashboard)
                fetch(`/Stock/GetRackDetail?itemId=${prefillId}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            var selArea = document.getElementById('adjItemSelected');
                            document.getElementById('adjItemDetailText').textContent = data.itemName + ' - ' + data.vin;
                            selArea.style.display = 'block';

                            var breakdown = (data.breakdown || []).map(r => ({
                                rack:   r.rack,
                                column: r.column,
                                stock:  r.stock
                            }));
                            renderRackOptions(breakdown, prefillRack);
                        }
                    });
            }
        };

        function populateRackDropdown(itemId, prefillRack) {
            // Loading state
            const dropdown = document.getElementById('adjRackDropdown');
            dropdown.innerHTML = '<option value="">-- Meload data rak... --</option>';
            document.getElementById('adjRackSection').style.display = 'block';

            const filterDate = document.getElementById('filterDate')?.value || '';
            fetch(`/Stock/GetRackDetail?itemId=${itemId}&date=${filterDate}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.breakdown) {
                        renderRackOptions(data.breakdown, prefillRack);
                    } else {
                        dropdown.innerHTML = '<option value="">Gagal memuat rak</option>';
                    }
                });
        }

        function renderRackOptions(breakdown, prefillRack) {
            const dropdown = document.getElementById('adjRackDropdown');
            const indicator = document.getElementById('currentRackStockText');
            const qtyInput = document.getElementById('adjQty');
            
            document.getElementById('adjRackSection').style.display = 'block';

            // Sinkronkan dengan UI Tabel FG (fallback lookup)
            // Jika prefillRack ada di tabel, pastikan masuk ke pilihan dropdown
            if (prefillRack && prefillRack !== '-' && !prefillRack.includes('lok.')) {
                var parts = prefillRack.split('.');
                var rName = parts[0].trim().toUpperCase();
                var rCol = parts.length > 1 ? parts[1].trim() : '';
                
                if (!breakdown) breakdown = [];
                var exists = breakdown.find(b => (b.rack || '').toString().trim().toUpperCase() === rName && (b.column || '').toString().trim() === rCol);
                
                if (!exists) {
                    breakdown.push({ rack: rName, column: rCol, stock: 0 });
                }
            }

            let optionsHtml = '';
            
            if (!breakdown || breakdown.length === 0) {
                optionsHtml = '<option value="">-- Tidak ada riwayat rak --</option>';
            } else {
                optionsHtml = breakdown.map(b => {
                    let r = (b.rack || '').toString().trim().toUpperCase();
                    let c = (b.column || '').toString().trim();
                    let display = c ? `${r}.${c}` : r;
                    return `<option value="${r}|${c}" data-stock="${b.stock}">${display} (Stok: ${b.stock})</option>`;
                }).join('');
            }
            
            // Selalu tambahkan opsi Tambah Rak Baru
            optionsHtml += '<option value="NEW_RACK" style="color:#10b981;font-weight:700;">+ TAMBAH RACK BARU</option>';
            dropdown.innerHTML = optionsHtml;
            
            // Reset indicator
            indicator.textContent = '0';
            qtyInput.value = '';
            qtyInput.dataset.baseStock = 0;
            document.getElementById('newRackSection').style.display = 'none';

            // Jika ada prefill rack (format: "H.5"), coba select
            if (prefillRack && prefillRack !== '-' && !prefillRack.includes('lok.')) {
                const parts = prefillRack.split('.');
                const rName = parts[0].trim().toUpperCase();
                const rCol = parts.length > 1 ? parts[1].trim() : '';
                const val = `${rName}|${rCol}`;
                const exists = Array.from(dropdown.options).some(o => o.value === val);
                if (exists) dropdown.value = val;
            }
            
            dropdown.dispatchEvent(new Event('change'));
        }

        window.setAdjMode = function(mode) {
            currentMode = mode;
            const b1 = document.getElementById('btnModeAdjust');
            const b2 = document.getElementById('btnModeRelocate');
            const b3 = document.getElementById('btnModeMaster');
            const s1 = document.getElementById('adjQtySection');
            const s2 = document.getElementById('relocateSection');
            const s3 = document.getElementById('adjMasterSection');
            const r1 = document.getElementById('adjRackSection');
            
            if(b1) { b1.style.background = 'transparent'; b1.style.color = '#94a3b8'; }
            if(b2) { b2.style.background = 'transparent'; b2.style.color = '#94a3b8'; }
            if(b3) { b3.style.background = 'transparent'; b3.style.color = '#94a3b8'; }
            
            if (mode === 'adjust') {
                if(b1) { b1.style.background = '#0dcaf0'; b1.style.color = '#fff'; }
                if(s1) s1.style.display = 'block';
                if(s2) s2.style.display = 'none';
                if(s3) s3.style.display = 'none';
                if(r1) r1.style.display = 'block';
            } else if (mode === 'relocate') {
                if(b2) { b2.style.background = '#0dcaf0'; b2.style.color = '#fff'; }
                if(s2) s2.style.display = 'block';
                if(s1) s1.style.display = 'none';
                if(s3) s3.style.display = 'none';
                if(r1) r1.style.display = 'block';
            } else {
                if(b3) { b3.style.background = '#0dcaf0'; b3.style.color = '#fff'; }
                if(s3) s3.style.display = 'block';
                if(s1) s1.style.display = 'none';
                if(s2) s2.style.display = 'none';
                if(r1) r1.style.display = 'none';
            }
        };

        function closeModal() {
            document.getElementById('modalAdjustStock').style.display = 'none';
        }

        function resetForm() {
            document.getElementById('adjModalTitle').textContent = 'Manual Adjust Stock';
            document.getElementById('adjModalIcon').className = 'bi bi-sliders';
            document.getElementById('adjModalIcon').style.color = '#f59e0b';
            
            const searchGroup = document.getElementById('adjItemSearch').parentElement;
            if (searchGroup) searchGroup.style.display = 'block';
            
            document.getElementById('adjItemSearch').value = '';
            document.getElementById('adjItemId').value = '';
            document.getElementById('adjItemSelected').style.display = 'none';
            document.getElementById('adjItemDropdown').style.display = 'none';
            document.getElementById('adjRackSection').style.display = 'none';
            
            // Clear dropdown
            const rackDropdown = document.getElementById('adjRackDropdown');
            if (rackDropdown) {
                rackDropdown.innerHTML = '<option value="">-- Pilih Rak --</option>';
            }
            document.getElementById('currentRackStockText').textContent = '0';

            document.getElementById('adjQty').value = '';
            document.getElementById('adjQtyWarning').style.display = 'none';
            document.getElementById('adjNote').value = '';
            document.getElementById('adjResultMsg').style.display = 'none';
            document.getElementById('targetRack').value = '';
            document.getElementById('targetNoRack').value = '';
            document.getElementById('relocateQty').value = '';
            
            // Clear dynamic racks except the first one, and reset the first one
            const dynamicContainer = document.getElementById('dynamicRackContainer');
            if (dynamicContainer) {
                const rows = dynamicContainer.querySelectorAll('.rack-input-row');
                rows.forEach((r, idx) => {
                    if (idx > 0) r.remove();
                    else {
                        r.querySelector('.newRackCode').value = '';
                        r.querySelector('.newNoRack').value = '';
                    }
                });
            }
            document.getElementById('newRackSection').style.display = 'none';
            
            selectedItemId = 0;
            setAdjMode('adjust');
        }

        function loadAllItems() {
            $.ajax({
                url: '/Pulling/GetAllItemsForAdjust',
                type: 'GET',
                success: function (data) {
                    if (data.success) {
                        allItems = data.items;
                        // Jika user sudah mengetik sebelum data selesai dimuat, tampilkan dropdown-nya
                        var currentSearch = document.getElementById('adjItemSearch').value.trim();
                        if (currentSearch) {
                            showDropdown(currentSearch);
                        }
                    }
                }
            });
        }

        function showDropdown(query) {
            var dd = document.getElementById('adjItemDropdown');
            if (!query) { dd.style.display = 'none'; return; }
            var q = query.toLowerCase();
            var filtered = allItems.filter(i =>
                (i.itemCode && i.itemCode.toLowerCase().includes(q)) ||
                (i.itemName && i.itemName.toLowerCase().includes(q)) ||
                (i.vin && i.vin.toLowerCase().includes(q))
            ).slice(0, 20);

            if (filtered.length === 0) { dd.style.display = 'none'; return; }

            dd.innerHTML = filtered.map(i =>
                '<div data-id="' + i.itemId + '" data-code="' + (i.itemCode||'') + '" data-name="' + (i.itemName||'') + '" data-vin="' + (i.vin||'') + '" data-plant="' + (i.plant||'') + '" data-rack="' + (i.rack||'') + '" data-norack="' + (i.noRack||'') + '"' +
                ' style="padding:9px 12px;cursor:pointer;font-size:0.83rem;border-bottom:1px solid #0f172a;" ' +
                ' onmouseover="this.style.background=\'#334155\'" onmouseout="this.style.background=\'\'">' +
                '<span style="color:#7dd3fc;font-weight:600;">' + (i.itemCode||'-') + '</span>' +
                ' &mdash; ' + (i.itemName||'-') +
                '<br><span style="color:#94a3b8;font-size:0.75rem;">' + (i.vin||'') + ' | ' + (i.plant||'') + ' | RACK: ' + (i.rack||'-') + '.' + (i.noRack||'-') + '</span>' +
                '</div>'
            ).join('');

            dd.querySelectorAll('div[data-id]').forEach(function (el) {
                el.addEventListener('click', function () {
                    selectedItemId = parseInt(el.getAttribute('data-id'));
                    document.getElementById('adjItemId').value = selectedItemId;
                    document.getElementById('adjItemSearch').value = el.getAttribute('data-code') + ' - ' + el.getAttribute('data-name');
                    var selArea = document.getElementById('adjItemSelected');
                    document.getElementById('adjItemDetailText').textContent = el.getAttribute('data-code') + ' - ' + el.getAttribute('data-name');
                    selArea.style.display = 'block';
                    populateRackDropdown(selectedItemId);
                    dd.style.display = 'none';
                });
            });
            dd.style.display = 'block';
        }

        var btnOpen = document.getElementById('btnAdjustStock');
        if (btnOpen) btnOpen.addEventListener('click', () => window.openAdjustmentModal());

        document.getElementById('btnCloseAdjust').addEventListener('click', closeModal);
        document.getElementById('btnCancelAdjust').addEventListener('click', closeModal);

        document.getElementById('adjItemSearch').addEventListener('input', function () {
            showDropdown(this.value.trim());
            selectedItemId = 0;
            document.getElementById('adjItemId').value = '';
            document.getElementById('adjItemSelected').style.display = 'none';
            document.getElementById('adjRackSection').style.display = 'none';
        });

        document.getElementById('adjRackDropdown').addEventListener('change', function() {
            const opt = this.options[this.selectedIndex];
            
            // Toggle new rack section if "NEW_RACK" selected
            const qtyInput = document.getElementById('adjQty');
            const newRackSec = document.getElementById('newRackSection');
            
            if (this.value === 'NEW_RACK') {
                newRackSec.style.display = 'block';
                document.getElementById('currentRackStockText').textContent = '0';
                qtyInput.value = '0';
                qtyInput.dataset.baseStock = 0;
                document.getElementById('adjQtyLabel').innerHTML = `Stok Terdaftar di <b>Rak Baru</b> <span style="color:#dc3545;">*</span>`;
                qtyInput.dispatchEvent(new Event('input'));
                return;
            } else {
                newRackSec.style.display = 'none';
            }

            if (opt && opt.dataset && opt.dataset.stock !== undefined) {
                const stock = parseInt(opt.dataset.stock);
                document.getElementById('currentRackStockText').textContent = stock;
                
                qtyInput.value = stock;
                qtyInput.dataset.baseStock = stock;
                
                // Update label to show selected rack
                document.getElementById('adjQtyLabel').innerHTML = `Stok Baru di Rak <b>${opt.text.split(' ')[0]}</b> <span style="color:#dc3545;">*</span>`;
                
                // Trigger input event to update badges/warnings
                qtyInput.dispatchEvent(new Event('input'));
            }
        });

        document.getElementById('adjQty').addEventListener('input', function () {
            const newVal = parseInt(this.value);
            const baseVal = parseInt(this.dataset.baseStock || 0);
            
            var warningEl = document.getElementById('adjQtyWarning');
            var warningText = document.getElementById('adjQtyWarningText');
            var deltaBadge = document.getElementById('adjQtyDeltaBadge');
            
            if (isNaN(newVal)) {
                warningEl.style.display = 'none';
                deltaBadge.style.display = 'none';
                return;
            }

            const delta = newVal - baseVal;
            
            if (newVal === 0) {
                 warningText.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> <b>STO (Stock To Zero)</b><br>Seluruh stok di rak ini akan dihapus dari sistem.';
                 warningEl.style.display = 'block'; warningEl.style.background = 'rgba(239, 68, 68, 0.1)'; warningEl.style.color = '#dc3545'; warningEl.style.borderColor = 'rgba(239, 68, 68, 0.2)';
                 deltaBadge.innerHTML = 'STO'; deltaBadge.style.display = 'block'; deltaBadge.style.background = '#dc3545'; deltaBadge.style.color = '#fff';
            } else if (delta < 0) {
                 warningText.innerHTML = `Stok di rak ini akan <b>berkurang ${Math.abs(delta)} pcs</b> (menjadi ${newVal})`;
                 warningEl.style.display = 'block'; warningEl.style.background = 'rgba(245, 158, 11, 0.1)'; warningEl.style.color = '#f59e0b'; warningEl.style.borderColor = 'rgba(245, 158, 11, 0.2)';
                 deltaBadge.innerHTML = `${delta}`; deltaBadge.style.display = 'block'; deltaBadge.style.background = '#f59e0b'; deltaBadge.style.color = '#1e293b';
            } else if (delta > 0) {
                 warningText.innerHTML = `Stok di rak ini akan <b>bertambah +${delta} pcs</b> (menjadi ${newVal})`;
                 warningEl.style.display = 'block'; warningEl.style.background = 'rgba(16, 185, 129, 0.1)'; warningEl.style.color = '#10b981'; warningEl.style.borderColor = 'rgba(16, 185, 129, 0.2)';
                 deltaBadge.innerHTML = `+${delta}`; deltaBadge.style.display = 'block'; deltaBadge.style.background = '#10b981'; deltaBadge.style.color = '#1e293b';
            } else {
                 warningEl.style.display = 'none';
                 deltaBadge.style.display = 'none';
            }
        });

        document.addEventListener('click', function (e) {
            var dd = document.getElementById('adjItemDropdown');
            if (dd && !dd.contains(e.target) && e.target.id !== 'adjItemSearch') dd.style.display = 'none';
            if (e.target.id === 'modalAdjustStock') closeModal();
            if (e.target.id === 'modalItemDetail') closeItemDetail();
        });

        document.getElementById('btnSubmitAdjust').addEventListener('click', function () {
            var itemId = parseInt(document.getElementById('adjItemId').value) || 0;
            var note = document.getElementById('adjNote').value.trim();
            var msgEl = document.getElementById('adjResultMsg');

            if (itemId <= 0) { showMsg(msgEl, 'error', 'Pilih item terlebih dahulu.'); return; }

            var btn = document.getElementById('btnSubmitAdjust');
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Memproses...';

            // Get selected rack from dropdown
            const rackSelect = document.getElementById('adjRackDropdown');
            let rack = '';
            let noRack = 0;
            let rackList = [];
            
            if (currentMode === 'adjust' || currentMode === 'relocate') {
                if (rackSelect.value === 'NEW_RACK') {
                    const rows = document.querySelectorAll('.rack-input-row');
                    rows.forEach(r => {
                        const rc = r.querySelector('.newRackCode').value.trim().toUpperCase();
                        const rn = parseInt(r.querySelector('.newNoRack').value) || 0;
                        if (rc) rackList.push({ rack: rc, noRack: rn });
                    });
                    
                    if (rackList.length === 0) { showMsg(msgEl, 'error', 'Setidaknya satu Rack Baru harus diisi.'); btn.disabled = false; btn.innerHTML = 'Simpan'; return; }
                    
                    rack = rackList[0].rack;
                    noRack = rackList[0].noRack;
                } else {
                    [rack, noRack] = rackSelect.value.split('|');
                    rackList.push({ rack, noRack });
                }
            }

            let endpoint = '/Pulling/ManualAdjust';
            let payload = { 
                itemId: selectedItemId, 
                targetQty: parseInt(document.getElementById('adjQty').value), 
                rack: rack, 
                noRack: noRack, 
                note: note,
                plant: $('#plantFilter').val() || 'Overall'
            };

            if (currentMode === 'adjust') {
                const newQty = parseInt(document.getElementById('adjQty').value);
                if (isNaN(newQty)) { showMsg(msgEl, 'error', 'Qty harus valid.'); btn.disabled = false; btn.innerHTML = 'Simpan'; return; }
                
                payload.targetQty = newQty;
                
                // MULTIPLE RACK LOGIC (if added more than 1 new rack)
                if (rackSelect.value === 'NEW_RACK' && rackList.length > 1) {
                    let promises = rackList.map(r => {
                        let p = Object.assign({}, payload);
                        p.rack = r.rack;
                        p.noRack = r.noRack;
                        return $.ajax({
                            url: endpoint,
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(p)
                        });
                    });
                    
                    Promise.all(promises).then(results => {
                        const failed = results.filter(r => !r.success);
                        if (failed.length > 0) {
                            showMsg(msgEl, 'error', `Ada ${failed.length} rak gagal disimpan.`);
                        } else {
                            showMsg(msgEl, 'success', `Berhasil menyimpan ${rackList.length} rak baru.`);
                            
                            // Instant DOM Update
                            let totalDiff = payload.targetQty * rackList.length;
                            const row = document.querySelector(`tr.stock-row[data-item-id="${selectedItemId}"]`);
                            if (row) {
                                const tdAct = row.querySelector('td.text-center.fw-bold.fs-5');
                                if (tdAct) {
                                    const currentTotal = parseInt(tdAct.textContent) || 0;
                                    tdAct.textContent = currentTotal + totalDiff;
                                    tdAct.style.transition = "background-color 0.5s ease";
                                    tdAct.style.backgroundColor = "rgba(16, 185, 129, 0.3)";
                                    setTimeout(() => tdAct.style.backgroundColor = "", 1500);
                                }
                            }
                            
                            resetForm();
                            window.refreshDashboard(); 
                            if (selectedItemId) populateRackDropdown(selectedItemId);
                        }
                    }).catch(err => {
                        showMsg(msgEl, 'error', 'Terjadi kesalahan sistem.');
                    }).finally(() => {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check2-circle"></i> Simpan';
                    });
                    return; // Stop the standard single ajax
                }
            } else if (currentMode === 'relocate') {
                endpoint = '/Pulling/RelocateStock';
                payload.sourceRack = rack;
                payload.sourceNoRack = parseInt(noRack);
                payload.targetRack = document.getElementById('targetRack').value.trim().toUpperCase();
                payload.targetNoRack = parseInt(document.getElementById('targetNoRack').value) || 0;
                var moveQty = parseInt(document.getElementById('relocateQty').value);
                if (!isNaN(moveQty) && moveQty > 0) payload.qty = moveQty;
                
                if (!payload.targetRack) { showMsg(msgEl, 'error', 'Pilih lokasi tujuan.'); btn.disabled = false; btn.innerHTML = 'Simpan'; return; }
            } else if (currentMode === 'master') {
                endpoint = '/Items/EditMasterAjax';
                payload = {
                    itemId: selectedItemId,
                    plant: document.getElementById('editMasPlant').value || null,
                    customer: document.getElementById('editMasCust').value || null,
                    statusItem: document.getElementById('editMasStatus').value || null,
                    category: document.getElementById('editMasProd').value || null,
                    vin: document.getElementById('editMasVin').value || null,
                    itemName: document.getElementById('editMasLokasiRak').value || null,
                    qtyLot: parseInt(document.getElementById('editMasQpc').value) || null,
                    rackMin: parseInt(document.getElementById('editMasMin').value) || null,
                    rackMax: parseInt(document.getElementById('editMasMax').value) || null
                };
            }

            // Revert back to $.ajax for better Antiforgery Token handling
            $.ajax({
                url: endpoint,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (data) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check2-circle"></i> Simpan';
                    if (data.success) {
                        showMsg(msgEl, 'success', data.message);
                        
                        if (currentMode === 'master') {
                            // --- INSTANT DOM UPDATE: langsung ubah cell di tabel tanpa reload ---
                            const row = document.querySelector(`tr.stock-row[data-item-id="${selectedItemId}"]`);
                            if (row) {
                                // Plant badge (selalu kolom ke-3)
                                if (payload.plant) {
                                    const plantBadge = row.querySelector('td:nth-child(3) .badge');
                                    if (plantBadge) {
                                        const p = payload.plant;
                                        plantBadge.textContent = p;
                                        plantBadge.className = 'badge smaller ' + (p === 'Molded' ? 'bg-primary' : p === 'Hose' ? 'bg-info text-dark' : 'bg-warning text-dark');
                                    }
                                }
                                // Status badge (cari td dengan badge bg-success/warning/danger opacity-75)
                                if (payload.statusItem) {
                                    const allTds = row.querySelectorAll('td');
                                    for (const td of allTds) {
                                        const b = td.querySelector('.badge.opacity-75');
                                        if (b) {
                                            const s = payload.statusItem;
                                            let cls, label = s;
                                            if (s === 'Reguler') {
                                                cls = 'badge bg-success opacity-75 smaller';
                                            } else if (s === 'PMSP FM') {
                                                cls = 'badge bg-primary opacity-75 smaller';
                                            } else if (s === 'PMSP SM') {
                                                cls = 'badge bg-warning text-dark opacity-75 smaller';
                                            } else if (s === 'PMSP') {
                                                cls = 'badge bg-warning text-dark opacity-75 smaller';
                                            } else if (s === 'After Market') {
                                                cls = 'badge opacity-75 smaller'; label = 'After Mkt';
                                            } else {
                                                cls = 'badge bg-danger opacity-75 smaller';
                                            }
                                            td.innerHTML = `<span class="${cls}" style="width: 75px; display: inline-block;">${label}</span>`;
                                            break;
                                        }
                                    }
                                }
                                // PROD/Category (td dengan class 'small')
                                if (payload.category) {
                                    const prodTd = row.querySelector('td.small');
                                    if (prodTd) prodTd.textContent = payload.category;
                                }
                                // VIN (td dengan style font-size 0.8rem)
                                if (payload.vin) {
                                    const vinTd = row.querySelector('td[style*="0.8rem"]');
                                    if (vinTd) vinTd.textContent = payload.vin;
                                }
                                // QPC (td.fw-bold.text-info)
                                if (payload.qtyLot) {
                                    const qpcTd = row.querySelector('td.fw-bold.text-info');
                                    if (qpcTd) qpcTd.textContent = payload.qtyLot;
                                }
                                // MIN, ROP, MAX Instant Update (td.fw-bold.text-danger/warning/success)
                                // isNoOrder JS: exclude No Order, PMSP SM, After Market dari indikator
                                let isNoOrder = payload.statusItem === 'No Order' || payload.statusItem === 'NO ORDER'
                                    || payload.statusItem === 'PMSP SM' || payload.statusItem === 'After Market';
                                
                                if (payload.rackMin !== undefined) {
                                    const minTd = row.querySelector('td.fw-bold.text-danger');
                                    if (minTd) minTd.textContent = isNoOrder ? 0 : payload.rackMin;
                                    
                                    const ropTd = row.querySelector('td.fw-bold.text-warning');
                                    if (ropTd) ropTd.textContent = isNoOrder ? 0 : (payload.rop || Math.ceil(payload.rackMin * 1.5));
                                }
                                
                                if (payload.rackMax !== undefined) {
                                    const maxTd = row.querySelector('td.fw-bold.text-success');
                                    if (maxTd) maxTd.textContent = isNoOrder ? 0 : payload.rackMax;
                                }
                                // Customer: posisi kolom ke-4 (Admin) atau ke-5 (Super Admin, ada kolom LABEL)
                                if (payload.customer) {
                                    const hasLabel = !!row.querySelector('td span.text-primary.fw-bold');
                                    const custIdx = hasLabel ? 6 : 5; // 0-indexed after NO, PLANT, LOKASI RACK, RACK, NO RACK
                                    const tds = row.querySelectorAll('td');
                                    if (tds[custIdx]) tds[custIdx].textContent = payload.customer;
                                }
                                // Update data-* attribute tombol edit agar prefill benar saat buka lagi
                                const editBtn = row.querySelector('button.btn-link.text-info');
                                if (editBtn) {
                                    if (payload.plant) editBtn.setAttribute('data-plant', payload.plant);
                                    if (payload.customer) editBtn.setAttribute('data-cust', payload.customer);
                                    if (payload.statusItem) editBtn.setAttribute('data-status', payload.statusItem);
                                    if (payload.category) editBtn.setAttribute('data-prod', payload.category);
                                    if (payload.vin) editBtn.setAttribute('data-vin', payload.vin);
                                    if (payload.qtyLot) editBtn.setAttribute('data-qpc', payload.qtyLot);
                                    if (payload.rackMin) editBtn.setAttribute('data-min', payload.rackMin);
                                    if (payload.rackMax) editBtn.setAttribute('data-max', payload.rackMax);
                                }
                            }
                            // Tutup modal segera
                            resetForm();
                            setTimeout(() => { window.refreshDashboard(); }, 100);
                        } else {
                            // --- INSTANT DOM UPDATE for Adjust/Relocate ---
                            const row = document.querySelector(`tr.stock-row[data-item-id="${selectedItemId}"]`);
                            if (row && currentMode === 'adjust') {
                                const tdAct = row.querySelector('td.text-center.fw-bold.fs-5');
                                if (tdAct) {
                                    const rackSelect = document.getElementById('adjRackDropdown');
                                    const selectedOpt = rackSelect.options[rackSelect.selectedIndex];
                                    const oldStock = selectedOpt ? parseInt(selectedOpt.getAttribute('data-stock')) || 0 : 0;
                                    const newStock = payload.targetQty;
                                    const diff = newStock - oldStock;
                                    
                                    const currentTotal = parseInt(tdAct.textContent) || 0;
                                    tdAct.textContent = currentTotal + diff;
                                    
                                    // Visual cue for instant update
                                    tdAct.style.transition = "background-color 0.5s ease";
                                    tdAct.style.backgroundColor = "rgba(16, 185, 129, 0.3)";
                                    setTimeout(() => tdAct.style.backgroundColor = "", 1500);
                                }
                            }
                            
                            // Tutup modal instan (tidak perlu tunggu 2 detik)
                            resetForm();
                            
                            // Refresh background (mungkin butuh waktu karena FIFO)
                            window.refreshDashboard(); 
                            if (selectedItemId) {
                                populateRackDropdown(selectedItemId);
                            }
                        }
                    } else {
                        showMsg(msgEl, 'error', data.message || 'Gagal.');
                    }
                },
                error: function (xhr) {
                    btn.disabled = false;
                    btn.innerHTML = 'Simpan';
                    const errorMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Terjadi kesalahan koneksi.';
                    showMsg(msgEl, 'error', errorMsg);
                }
            });
        });

        function showMsg(el, type, msg) {
            el.style.display = 'block';
            el.style.background = type === 'success' ? '#064e3b' : '#450a0a';
            el.style.color = type === 'success' ? '#6ee7b7' : '#fca5a5';
            el.style.border = '1px solid ' + (type === 'success' ? '#059669' : '#dc2626');
            el.innerHTML = (type === 'success' ? '<i class="bi bi-check-circle"></i> ' : '<i class="bi bi-x-circle"></i> ') + msg;
        }

        // Handle Add Rack Row Button (Hanya jika tombol ada - Super Admin)
        var btnAddRackRow = document.getElementById('btnAddRackRow');
        if (btnAddRackRow) {
            btnAddRackRow.addEventListener('click', function() {
                var container = document.getElementById('dynamicRackContainer');
                var rowHtml = `
                     <div class="d-flex gap-2 align-items-center mb-2 rack-input-row">
                        <div style="flex:1;">
                            <input type="text" class="newRackCode" maxlength="10" placeholder="Contoh: A, L, M" 
                                   style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.95rem;text-transform:uppercase;">
                        </div>
                        <div style="flex:1;">
                            <input type="number" class="newNoRack" min="0" max="999" placeholder="0-99" 
                                   style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:#e2e8f0;font-size:0.95rem;">
                        </div>
                        <div style="width: 32px; padding-top: 0;" class="text-end rack-del-btn-container">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-del-rack" style="border:none; padding:4px 8px; border-radius:6px;"><i class="bi bi-trash"></i></button>
                        </div>
                     </div>`;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });
        }

        // Handle Delete Rack Row
        document.getElementById('dynamicRackContainer').addEventListener('click', function(e) {
            var delBtn = e.target.closest('.btn-del-rack');
            if (delBtn) {
                var row = delBtn.closest('.rack-input-row');
                if (row && document.querySelectorAll('.rack-input-row').length > 1) {
                    row.remove();
                }
            }
        });

        // Prefetch data in background after page loads for instant autocomplete
        setTimeout(function() {
            if (allItems.length === 0) loadAllItems();
        }, 1500);
    })();

    async function repairPlantData() {
        if (!confirm('Perbaiki Plant pada data Pulling & Preparation yang kosong/salah?\n\nProses ini akan mengisi Plant berdasarkan master item. Data yang sudah benar tidak akan berubah.')) return;
        const btn = document.getElementById('btnRepairPlant');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Memproses...'; }
        try {
            const resp = await fetch('/Stock/RepairPlantData', { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
            const data = await resp.json();
            alert(data.message + (data.skippedPulling || data.skippedPrep ? `\n(Tidak dapat di-repair: Pulling=${data.skippedPulling}, Prep=${data.skippedPrep} — item tidak ditemukan di master)` : ''));
            if (data.success) location.reload();
        } catch(e) {
            alert('Error: ' + e.message);
        } finally {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-wrench-adjustable-circle"></i> Repair Plant'; }
        }
    }
    
    function openEditTargetModal() {
        const modal = new bootstrap.Modal(document.getElementById('editTargetModal'));
        modal.show();
    }
    
    function saveTarget() {
        const dateStr = document.getElementById('editTargetDate').value;
        const qty = document.getElementById('editTargetQty').value;
        if (!dateStr || qty === '') return;
        
        // Find the cell based on date
        const id = 'target-cell-' + dateStr.replace(/\//g, "-");
        const cell = document.getElementById(id);
        if (cell) {
            cell.innerText = qty;
        }
        
        // Close modal
        const modalEl = document.getElementById('editTargetModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) {
            modal.hide();
        }
    }
    
    function openDeleteTargetModal() {
        const modal = new bootstrap.Modal(document.getElementById('deleteTargetModal'));
        modal.show();
    }
    
    function deleteTarget() {
        const dateStr = document.getElementById('deleteTargetDate').value;
        if (!dateStr) return;
        
        if (dateStr === "ALL") {
            const cells = document.querySelectorAll('[id^="target-cell-"]');
            cells.forEach(c => c.innerText = "0");
        } else {
            const id = 'target-cell-' + dateStr.replace(/\//g, "-");
            const cell = document.getElementById(id);
            if (cell) cell.innerText = "0";
        }
        
        const modalEl = document.getElementById('deleteTargetModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
    }
</script>

