@section Scripts {
<script src="~/lib/chart.js/chart.umd.min.js"></script>
<script>
    window.initTrendChart = function() {
        const container = document.getElementById('chartDataContainer');
        if (!container) return;

        let trendData = [];
        let fullDates = [];
        try {
            trendData = JSON.parse(container.getAttribute('data-trend') || "[]");
            fullDates = JSON.parse(container.getAttribute('data-dates') || "[]");
        } catch(e) {
            console.error("Error parsing chart data", e);
        }

        const canvas = document.getElementById('trendChart');
        if (!canvas) return;

        if (window.trendChartInstance) {
            window.trendChartInstance.destroy();
        }

        const ctx = canvas.getContext('2d');
        const shortColor = '#dc3545';
        const normColor = '#ffc107';
        const overColor = '#0dcaf0';

        const hexRgba = (hex, alpha) => {
            let c;
            if (/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)) {
                c = hex.substring(1).split('');
                if (c.length == 3) {
                    c = [c[0], c[0], c[1], c[1], c[2], c[2]];
                }
                c = '0x' + c.join('');
                return 'rgba(' + [(c >> 16) & 255, (c >> 8) & 255, c & 255].join(',') + ',' + alpha + ')';
            }
            return hex;
        };

        const createGradient = (ctx, color) => {
            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, hexRgba(color, 0.35));
            gradient.addColorStop(1, hexRgba(color, 0.01));
            return gradient;
        };

        const statusFilter = typeof window.currentStatusFilter !== 'undefined' ? window.currentStatusFilter : 'All';
        const showShortage = statusFilter === 'All' || statusFilter === 'Shortage';
        const showNormal = statusFilter === 'All' || statusFilter === 'Normal';
        const showOver = statusFilter === 'All' || statusFilter === 'Over';

        const verticalLinePlugin = {
            id: 'verticalLine',
            afterDraw: chart => {
                if (chart.tooltip?._active?.length) {
                    const x = chart.tooltip._active[0].element.x;
                    const yAxis = chart.scales.y;
                    const ctx = chart.ctx;
                    ctx.save();
                    ctx.beginPath();
                    ctx.moveTo(x, yAxis.top);
                    ctx.lineTo(x, yAxis.bottom);
                    ctx.lineWidth = 1;
                    ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
                    ctx.stroke();
                    ctx.restore();
                }
            }
        };

        window.trendChartInstance = new Chart(ctx, {
            type: 'line',
            plugins: [verticalLinePlugin],
            data: {
                labels: fullDates.map(d => {
                    const dt = new Date(d);
                    return String(dt.getDate()).padStart(2, '0') + '/' + String(dt.getMonth() + 1).padStart(2, '0');
                }),
                datasets: [
                    {
                        label: 'Shortage',
                        data: trendData.find(x => x.name === 'Shortage')?.data || [],
                        borderColor: shortColor,
                        backgroundColor: createGradient(ctx, shortColor),
                        tension: 0.4, fill: true, pointRadius: 3, pointBackgroundColor: shortColor, pointHoverRadius: 6, borderWidth: 3,
                        hidden: !showShortage
                    },
                    {
                        label: 'Normal',
                        data: trendData.find(x => x.name === 'Normal')?.data || [],
                        borderColor: normColor, backgroundColor: createGradient(ctx, normColor), tension: 0.4, fill: true, pointRadius: 3, pointBackgroundColor: normColor, pointHoverRadius: 6, borderWidth: 3,
                        hidden: !showNormal
                    },
                    {
                        label: 'Over',
                        data: trendData.find(x => x.name === 'Over')?.data || [],
                        borderColor: overColor, backgroundColor: createGradient(ctx, overColor), tension: 0.4, fill: true, pointRadius: 3, pointBackgroundColor: overColor, pointHoverRadius: 6, borderWidth: 3,
                        hidden: !showOver
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#94a3b8', usePointStyle: true, boxWidth: 8, padding: 20 }
                    },
                    tooltip: {
                        backgroundColor: '#0a1628',
                        titleColor: '#94a3b8',
                        titleFont: { size: 13, weight: '600' },
                        bodyFont: { size: 14, weight: 'bold' },
                        padding: 12,
                        cornerRadius: 8,
                        borderColor: 'rgba(255,255,255,0.1)',
                        borderWidth: 1,
                        displayColors: true,
                        boxPadding: 6,
                        callbacks: {
                            title: (ctx) => 'Tanggal ' + ctx[0].label,
                            label: (ctx) => ' ' + ctx.dataset.label + ': ' + ctx.raw + ' items'
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: { size: 11 } }
                    },
                    y: {
                        grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false },
                        ticks: { color: '#cbd5e1', font: { size: 11, weight: 'bold' }, display: true },
                        title: { display: true, text: 'Jumlah Item', color: '#cbd5e1', font: { size: 12, weight: 'bold' } },
                        border: { display: false }
                    }
                }
            }
        });
    };

    document.addEventListener("DOMContentLoaded", function() {
        window.initTrendChart();
    });
</script>
    <script>
        $(document).ready(function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/stockHub")
                .withAutomaticReconnect()
                .build();

            // Import Excel Handler
            $('#importExcelFile').on('change', function (e) {
                const file = e.target.files[0];
                if (!file) return;
                
                const btn = $('#btnImportExcel');
                const originalHtml = btn.html();
                btn.html('<i class="bi bi-hourglass-split"></i> <span>Uploading...</span>');
                btn.prop('disabled', true);

                const formData = new FormData();
                formData.append('importExcelFile', file);
                
                // Optional: append anti-forgery token if needed, using generic approach
                const token = $('input[name="__RequestVerificationToken"]').val();
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }

                $.ajax({
                    url: '/Stock/ImportStockExcel',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function (xhr) {
                        alert('Error importing Excel: ' + (xhr.responseJSON?.message || xhr.statusText));
                    },
                    complete: function () {
                        btn.html(originalHtml);
                        btn.prop('disabled', false);
                        $('#importExcelFile').val('');
                    }
                });
            });

            connection.on("updateStock", function () {
                if (window.showUpdateNotification) {
                    window.showUpdateNotification('Data stock baru masuk — memperbarui dashboard...', 'pulling', 4000);
                }
                window.quickUpdateDashboard();
            });

            connection.start().catch(err => console.error(err.toString()));

            window.quickUpdateDashboard = function() {
                const plant = $('#plantFilter').val() || 'Overall';
                const search = $('#tagLabelSearch').val() || '';
                const timestamp = new Date().getTime();
                const url = `@Url.Action("GetStockQuickJson", "Stock")?plant=${plant}&search=${encodeURIComponent(search)}&_t=${timestamp}`;

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (res) {
                        if (res && res.success && res.data) {
                            // Update summary counters
                            if (res.summary) {
                                $('#totalAct').text(res.summary.totalAct);
                                $('#totalSafe').text(res.summary.totalItemSafe);
                                $('#totalOver').text(res.summary.totalItemOver);
                                $('#totalShortage').text(res.summary.totalItemShortage);
                            }

                            // Update rows dynamically without replacing full HTML
                            res.data.forEach(function(item) {
                                const row = $(`tr[data-item-id="${item.itemId}"]`);
                                if (row.length > 0) {
                                    row.find('.act-fg').text(item.act);
                                    
                                    const tdLevel = row.find('.td-stock-level');
                                    let badgeHtml = '';
                                    if (item.ratio < 1) {
                                        badgeHtml = `<span class="stock-badge stock-level-red px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> <span class="stock-ratio">${item.ratio.toFixed(1)}</span> D</span>`;
                                    } else if (item.ratio <= 2) {
                                        badgeHtml = `<span class="stock-badge stock-level-yellow px-2 py-1"><i class="bi bi-info-circle-fill"></i> <span class="stock-ratio">${item.ratio.toFixed(1)}</span> D</span>`;
                                    } else {
                                        badgeHtml = `<span class="stock-badge stock-level-blue px-2 py-1"><i class="bi bi-star-fill"></i> <span class="stock-ratio">${item.ratio.toFixed(1)}</span> D</span>`;
                                    }
                                    
                                    tdLevel.html(badgeHtml);
                                }
                            });
                            console.log("Quick dashboard update completed.");
                        }
                    },
                    error: function(err) {
                        console.error("Failed to quick update dashboard:", err);
                        // Fallback to full refresh
                        window.refreshDashboard();
                    }
                });
            };

            window.refreshDashboard = function(resetPage) {
                const plant = $('#plantFilter').val() || 'Overall';
                const date = $('#dateFilter').val() || '';
                const period = $('#periodFilter').val() || 'Day';
                const customer = $('#customerFilter').val() || 'All';
                const category = $('#categoryFilter').val() || 'All';
                const itemStatus = $('#itemStatusFilter').val() || 'All';
                const statusParam = window.currentStatusFilter || 'All';
                
                const search = $('#tagLabelSearch').val() || '';
                
                // Fix: Sering terjadi ReferenceError karena pageNumber tidak didefinisikan
                const pageNumber = resetPage || parseInt($('.pagination .page-item.active .page-link').text()) || 1;
                
                // Fix: Tambahkan Timestamp agar browser tidak melakukan caching (Cache-Buster)
                const timestamp = new Date().getTime();
                const url = `/Stock/Index?plant=${plant}&date=${date}&period=${period}&customer=${encodeURIComponent(customer)}&category=${encodeURIComponent(category)}&itemStatus=${encodeURIComponent(itemStatus)}&pageNumber=${pageNumber}&status=${statusParam}&search=${encodeURIComponent(search)}&_t=${timestamp}`;

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (html) {
                        const newContent = $(html).find('#dashboardContent').html();
                        $('#dashboardContent').html(newContent);
                        
                        // UPDATE DROPDOWNS DYNAMICALLY
                        const filterScript = $('#dashboardContent').find('#filterDataScript');
                        if (filterScript.length) {
                            try {
                                const filterData = JSON.parse(filterScript.html());
                                function updateSelect(id, list, selected, isPlant) {
                                    const sel = $(id);
                                    sel.empty();
                                    if (isPlant) sel.append('<option value="Overall">Overall</option>');
                                    else sel.append('<option value="All">All</option>');
                                    
                                    list.forEach(item => {
                                        sel.append('<option value="' + item + '">' + item + '</option>');
                                    });
                                    sel.val(selected);
                                    if (!sel.val()) sel.val(isPlant ? 'Overall' : 'All');
                                }
                                
                                updateSelect('#plantFilter', filterData.plants, plant, true);
                                updateSelect('#customerFilter', filterData.customers, customer, false);
                                updateSelect('#categoryFilter', filterData.categories, category, false);
                                updateSelect('#itemStatusFilter', filterData.statuses, itemStatus, false);
                            } catch(e) { console.error("Error updating filters", e); }
                        }

                        bindFilterEvents();
                        applyAllFilters(); // Re-apply local filters (Search & Status UI)
                        
                        // Re-initialize chart because the canvas was replaced
                        if (window.initTrendChart) {
                            window.initTrendChart();
                        }
                        
                        // Re-apply auto scroll state if it was active
                        if (isAutoScrollActive) {
                            syncAutoScrollUI();
                            startScrolling();
                        }
                    }
                });
            }

            window.currentStatusFilter = '@(ViewBag.CurrentStatus ?? "All")';

            // ── Toggle show/hide inactive items ──────────────────────────────────────────
            window.toggleInactiveItems = function() {
                $.ajax({
                    url: '@Url.Action("ToggleNoOrderVisibility", "Stock")',
                    type: 'POST',
                    success: function(res) {
                        if (res.success) {
                            window.location.reload();
                        }
                    }
                });
            };

            function applyInactiveFilter() {
                // Not used anymore since filtering is done in the backend
            }

            // Terapkan filter inactive saat DOM selesai load dan setelah setiap AJAX refresh
            function applyAllFilters() {
                syncFilterCardUI();
                applySearchFilter();
                applyInactiveFilter();
            }
            let searchTimer;

            function bindFilterEvents() {
                $('.indicator-card.clickable').off('click').on('click', function() {
                    const clickedFilter = $(this).data('filter');
                    if (clickedFilter === 'All') {
                        // Total card: selalu reset ke All
                        window.currentStatusFilter = 'All';
                    } else {
                        // Toggle: klik yang sama → kembali ke All
                        window.currentStatusFilter = (window.currentStatusFilter === clickedFilter) ? 'All' : clickedFilter;
                    }
                    window.refreshDashboard(1); // Server-side filter, reset ke page 1
                });

                $('#plantFilter, #dateFilter, #periodFilter, #customerFilter, #categoryFilter, #itemStatusFilter').off('change').on('change', function() {
                    window.currentStatusFilter = 'All'; // reset status filter saat filter utama berubah
                    window.refreshDashboard(1);
                });

                $('#tagLabelSearch').off('input').on('input', function() {
                    const searchBox = $(this);
                    applySearchFilter(); // Filter lokal instan untuk baris yang kelihatan
                    
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(() => {
                        // Jika panjang karakter > 2 atau kosong, lakukan pencarian global ke server
                        const val = searchBox.val().trim();
                        if (val.length >= 2 || val.length === 0) {
                            window.refreshDashboard(1);
                        }
                    }, 600);
                });

                $('#tagLabelSearch').off('keypress').on('keypress', function(e) {
                    if (e.which == 13) {
                        window.refreshDashboard(1);
                    }
                });

                $('#btnToggleAutoScroll').off('click').on('click', toggleAutoScroll);
                
                $('#btnExportDashboard').off('click').on('click', function() {
                    const plant = $('#plantFilter').val() || 'Overall';
                    const date = $('#dateFilter').val() || '';
                    const period = $('#periodFilter').val() || 'Day';
                    const customer = $('#customerFilter').val() || 'All';
                    const category = $('#categoryFilter').val() || 'All';
                    const itemStatus = $('#itemStatusFilter').val() || 'All';
                    window.location.href = `/Stock/ExportToExcel?plant=${plant}&date=${date}&period=${period}&customer=${encodeURIComponent(customer)}&category=${encodeURIComponent(category)}&itemStatus=${encodeURIComponent(itemStatus)}`;
                });

                $('#btnDownloadExcel').off('click').on('click', function() {
                    // Logic for template download if different from export
                    window.location.href = '/Stock/ExportToExcel?template=true'; 
                });

                // ── Rack filter (re-bind setiap kali DOM di-refresh)
                $('#rackFilter').off('change.rack').on('change.rack', function() {
                    const rack  = $(this).val();
                    const plant = $('#plantFilter').val() || 'Overall';
                    if (!rack) {
                        $('#normalTableContainer').show();
                        $('#pagerContainer').show();
                        $('#rackTableContainer').hide();
                        $('#tableTitle').html(defaultTableTitle);
                    } else {
                        loadRackTable(plant, rack);
                    }
                });
                // Populate daftar rak sesuai plant aktif
                loadRackList();

                // Highlight active filter card on load
                syncFilterCardUI();
            }

            function syncFilterCardUI() {
                $('.indicator-card').css('opacity', '1').removeClass('active-filter');
                if (window.currentStatusFilter !== 'All') {
                    $('.indicator-card').css('opacity', '0.5');
                    $(`.indicator-card[data-filter="${window.currentStatusFilter}"]`).addClass('active-filter').css('opacity', '1');
                    // Total (All) card stays visible
                    $(`.indicator-card[data-filter="All"]`).css('opacity', '0.7');
                    let badgeClass = 'bg-secondary';
                    if (window.currentStatusFilter === 'Shortage') badgeClass = 'bg-danger';
                    if (window.currentStatusFilter === 'Normal') badgeClass = 'bg-warning text-dark';
                    if (window.currentStatusFilter === 'Over') badgeClass = 'bg-info text-dark';
                    $('#activeFilterLabel').text('Status: ' + window.currentStatusFilter).removeClass().addClass('badge ' + badgeClass);
                } else {
                    $(`.indicator-card[data-filter="All"]`).addClass('active-filter');
                    $('#activeFilterLabel').text('All Items').removeClass().addClass('badge bg-primary');
                }
            }

            function applySearchFilter() {
                const searchText = $('#tagLabelSearch').val().toLowerCase();
                // Ambil NO dari row pertama yg di-render server (selalu benar setelah AJAX)
                const firstRowNo = parseInt($('.stock-row:first td:first-child').text()) || 1;
                let visibleCounter = firstRowNo;

                $('.stock-row').each(function() {
                    const searchContent = $(this).attr('data-search-content');
                    const normalizedContent = searchContent ? searchContent.toLowerCase() : '';
                    
                    const matchesSearch = (!searchText || normalizedContent.includes(searchText));
                    
                    if (matchesSearch) {
                        $(this).show();
                        $(this).find('td:first-child').text(visibleCounter++);
                    } else {
                        $(this).hide();
                    }
                });
            }

            // Auto Scroll Logic
            let isAutoScrollActive = localStorage.getItem('autoScrollActive') === 'true';
            let scrollInterval;
            let scrollDirection = 1; // 1: Down, -1: Up
            const scrollSpeed = 1; 
            const scrollDelay = 40; // ms

            function toggleAutoScroll() {
                isAutoScrollActive = !isAutoScrollActive;
                localStorage.setItem('autoScrollActive', isAutoScrollActive);
                syncAutoScrollUI();
                
                if (isAutoScrollActive) {
                    scrollDirection = 1;
                    startScrolling();
                } else {
                    stopScrolling();
                }
            }

            function syncAutoScrollUI() {
                const btn = $('#btnToggleAutoScroll');
                const indicator = $('#autoScrollStatus');
                const icon = btn.find('i');

                if (isAutoScrollActive) {
                    btn.removeClass('btn-outline-secondary').addClass('btn-success active');
                    indicator.text('Auto Scroll: ON').removeClass('text-muted').addClass('text-success');
                    icon.removeClass('bi-play-circle').addClass('bi-pause-circle');
                } else {
                    btn.removeClass('btn-success active').addClass('btn-outline-secondary');
                    indicator.text('Auto Scroll: OFF').removeClass('text-success').addClass('text-muted');
                    icon.removeClass('bi-pause-circle').addClass('bi-play-circle');
                }
            }

            function startScrolling() {
                const container = $('.main-stock-container');
                if (container.length === 0) return;
                const el = container[0];
                
                if (scrollInterval) clearInterval(scrollInterval);
                
                scrollInterval = setInterval(function() {
                    if (!isAutoScrollActive) return;

                    const prevPos = el.scrollTop;
                    el.scrollTop += (scrollDirection * scrollSpeed);
                    
                    // If position didn't change, we hit a boundary
                    if (el.scrollTop === prevPos && el.scrollHeight > el.clientHeight) {
                        clearInterval(scrollInterval);
                        setTimeout(function() {
                            if (isAutoScrollActive) {
                                scrollDirection *= -1;
                                startScrolling();
                            }
                        }, 2000); // Wait 2 seconds at edges
                    }
                }, scrollDelay);
            }

            function stopScrolling() {
                clearInterval(scrollInterval);
                scrollDirection = 1;
            }

            // ── FILTER RAK ───────────────────────────────────────────────
            const defaultTableTitle = $('#tableTitle').html();

            function loadRackList() {
                const plant = $('#plantFilter').val() || 'Overall';
                $('#rackFilter').html('<option value="">-- Semua Rak --</option>');
                $.getJSON(`/Stock/GetRackList?plant=${plant}`, function(racks) {
                    racks.forEach(function(r) {
                        $('#rackFilter').append(`<option value="${r}">Rak ${r}</option>`);
                    });
                });
            }

            const RAK_PAGE_SIZE = 20;
            let rakAllItems = [];
            let rakCurrentPage = 1;

            function buildRakRow(d) {
                const statusBadge = d.status === 'Shortage'
                    ? '<span class="badge bg-danger">Shortage</span>'
                    : d.status === 'Over'
                    ? '<span class="badge bg-info text-dark">Over</span>'
                    : '<span class="badge bg-warning text-dark">Normal</span>';

                const levelBadge = d.level < 1
                    ? `<span class="stock-badge stock-level-red px-2 py-1"><i class="bi bi-exclamation-triangle-fill"></i> ${d.level}D</span>`
                    : d.level <= 2
                    ? `<span class="stock-badge stock-level-yellow px-2 py-1"><i class="bi bi-info-circle-fill"></i> ${d.level}D</span>`
                    : `<span class="stock-badge stock-level-blue px-2 py-1"><i class="bi bi-star-fill"></i> ${d.level}D</span>`;

                const partNosHtml = d.partNos && d.partNos.length > 0
                    ? d.partNos.map(p => `<span class="badge bg-secondary me-1" style="font-size:0.7rem;">${p}</span>`).join('')
                    : '<span class="text-muted">-</span>';

                const actColor = d.act <= 0 ? 'color:#dc3545;' : d.act < d.min ? 'color:#f59e0b;' : 'color:#10b981;';

                return `<tr>
                    <td class="text-center" style="font-size:0.82rem;">${d.no}</td>
                    <td style="font-size:0.8rem;"><div class="fw-bold text-primary">${d.itemName}</div><small class="text-muted">${d.lokasi}</small></td>
                    <td style="font-size:0.8rem; color:#67e8f9;">${d.vin}</td>
                    <td style="font-size:0.78rem;">${partNosHtml}</td>
                    <td class="text-center fw-bold text-info">${d.qpc}</td>
                    <td class="text-center fw-bold text-danger">${d.min}</td>
                    <td class="text-center fw-bold text-warning">${d.rop}</td>
                    <td class="text-center fw-bold text-success">${d.max}</td>
                    <td class="text-center fw-bold" style="${actColor} font-size:1rem;">${d.act}</td>
                    <td class="text-center">${levelBadge}</td>
                    <td class="text-center">${statusBadge}</td>
                    @if (Context.Session.GetString("Role") == "Super Admin")
                    {
                        <text><td style="font-size:0.78rem; color:#a78bfa;">${d.remark || '-'}</td></text>
                    }
                </tr>`;
            }

            function renderRakPage(page) {
                rakCurrentPage = page;
                const total = rakAllItems.length;
                const totalPages = Math.ceil(total / RAK_PAGE_SIZE);
                const start = (page - 1) * RAK_PAGE_SIZE;
                const pageItems = rakAllItems.slice(start, start + RAK_PAGE_SIZE);

                let rows = pageItems.map(buildRakRow).join('');
                $('#rakDetailBody').html(rows);

                // Info text
                const from = start + 1;
                const to = Math.min(start + RAK_PAGE_SIZE, total);
                $('#rakPagerInfo').text(`Halaman ${page} dari ${totalPages} (Total ${total} Data)`);

                // Build page buttons
                let pagHtml = '';
                pagHtml += `<li class="page-item ${page === 1 ? 'disabled' : ''}"><a class="page-link" href="#" data-p="${page - 1}">&laquo;</a></li>`;

                // Sliding window: max 5 page buttons
                let startP = Math.max(1, page - 2);
                let endP   = Math.min(totalPages, startP + 4);
                if (endP - startP < 4) startP = Math.max(1, endP - 4);

                for (let p = startP; p <= endP; p++) {
                    pagHtml += `<li class="page-item ${p === page ? 'active' : ''}"><a class="page-link" href="#" data-p="${p}">${p}</a></li>`;
                }

                pagHtml += `<li class="page-item ${page === totalPages ? 'disabled' : ''}"><a class="page-link" href="#" data-p="${page + 1}">&raquo;</a></li>`;
                $('#rakPagerList').html(pagHtml);

                if (totalPages > 1) {
                    $('#rakPagerContainer').show();
                } else {
                    $('#rakPagerContainer').hide();
                }
            }

            // Delegated click for rack pager
            $(document).on('click', '#rakPagerList a.page-link', function(e) {
                e.preventDefault();
                const p = parseInt($(this).data('p'));
                const totalPages = Math.ceil(rakAllItems.length / RAK_PAGE_SIZE);
                if (isNaN(p) || p < 1 || p > totalPages) return;
                renderRakPage(p);
            });

            function loadRackTable(plant, rack) {
                const title = plant === 'Overall' ? `Rak ${rack}` : `${plant} / Rak ${rack}`;
                $('#tableTitle').html(`<i class="bi bi-grid-3x3-gap-fill me-2"></i> Detail Rak — ${title}`);
                $('#rakDetailBody').html('<tr><td colspan="12" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>');
                $('#rakPagerContainer').hide();
                $('#rakStatShortage').text('Shortage: -');
                $('#rakStatNormal').text('Normal: -');
                $('#rakStatOver').text('Over: -');
                $('#rakStatTotal').text('Total: -');
                $('#normalTableContainer').hide();
                $('#pagerContainer').hide();
                $('#rackTableContainer').show();

                $.getJSON(`/Stock/GetRackItems?plant=${encodeURIComponent(plant)}&rack=${encodeURIComponent(rack)}`, function(items) {
                    if (!items || items.length === 0) {
                        rakAllItems = [];
                        $('#rakDetailBody').html('<tr><td colspan="12" class="text-center py-4 text-muted">Tidak ada item di rak ini.</td></tr>');
                        $('#rakStatShortage').text('Shortage: 0');
                        $('#rakStatNormal').text('Normal: 0');
                        $('#rakStatOver').text('Over: 0');
                        $('#rakStatTotal').text('Total: 0');
                        return;
                    }

                    let shortage = 0, normal = 0, over = 0;
                    items.forEach(function(d) {
                        if (d.status === 'Shortage') shortage++;
                        else if (d.status === 'Over') over++;
                        else normal++;
                    });

                    rakAllItems = items;
                    renderRakPage(1);

                    $('#rakStatShortage').text(`Shortage: ${shortage}`);
                    $('#rakStatNormal').text(`Normal: ${normal}`);
                    $('#rakStatOver').text(`Over: ${over}`);
                    $('#rakStatTotal').text(`Total: ${items.length}`);
                }).fail(function() {
                    $('#rakDetailBody').html('<tr><td colspan="12" class="text-center py-4 text-danger">Gagal memuat data rak.</td></tr>');
                });
            }

            bindFilterEvents();
            applyAllFilters(); // Apply inactive filter on initial load
            
            // Initial load check
            if (isAutoScrollActive) {
                syncAutoScrollUI();
                startScrolling();
            }
        });
    </script>
}

