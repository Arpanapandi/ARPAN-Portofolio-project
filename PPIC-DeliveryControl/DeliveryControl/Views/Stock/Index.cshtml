@model DeliveryControl.Models.StockDashboardViewModel
@{
    ViewData["Title"] = "Dashboard FG";
}

<div class="header-container mb-3">
    <div class="header-main-row">
        <!-- Title Section -->
        <div class="header-title-section">
            <i class="bi bi-columns-gap fs-4 text-primary"></i>

            <h1 class="h5 fw-bold mb-0 text-white text-nowrap">Dashboard Finished Goods</h1>
        </div>

        <!-- Filter Bar Section -->
        <div class="custom-filter-bar">
            <!-- Search Box -->
            <div class="search-box-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="tagLabelSearch" class="custom-search-input" placeholder="Cari Tag atau Kanban...">
            </div>

            <!-- Plant Filter -->
            <div class="filter-group">
                <span class="filter-label">Plant:</span>
                <select id="plantFilter" class="custom-select-input">
                    <option value="Overall" selected="@(Model.PlantName == "Overall")">Overall</option>
                    @foreach (var p in Model.AvailablePlants)
                    {
                        <option value="@p" selected="@(Model.PlantName == p)">@p</option>
                    }
                </select>
            </div>

            <!-- Customer Filter -->
            <div class="filter-group">
                <span class="filter-label">Cust:</span>
                <select id="customerFilter" class="custom-select-input">
                    <option value="All" selected="@(Model.SelectedCustomer == "All")">All</option>
                    @foreach (var c in Model.AvailableCustomers)
                    {
                        <option value="@c" selected="@(Model.SelectedCustomer == c)">@c</option>
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div class="filter-group">
                <span class="filter-label">Status:</span>
                <select id="itemStatusFilter" class="custom-select-input">
                    <option value="All" selected="@(Model.SelectedItemStatus == "All")">All</option>
                    @foreach (var s in Model.AvailableStatuses)
                    {
                        <option value="@s" selected="@(Model.SelectedItemStatus == s)">@s</option>
                    }
                </select>
            </div>

            <!-- Category (PROD) Filter -->
            <div class="filter-group">
                <span class="filter-label">PROD:</span>
                <select id="categoryFilter" class="custom-select-input">
                    <option value="All" selected="@(Model.SelectedCategory == "All")">All</option>
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                    }
                </select>
            </div>

            <!-- Date Filter -->
            <div class="filter-group">
                <span class="filter-label">Tanggal:</span>
                <input type="date" id="dateFilter" class="custom-date-input" value="@(Model.SearchDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))">
            </div>

            <!-- Period Filter -->
            <div class="filter-group">
                <span class="filter-label">Periode:</span>
                <select id="periodFilter" class="custom-select-input">
                    <option value="Day" selected="@(Model.Period == "Day")">Day</option>
                    <option value="Week" selected="@(Model.Period == "Week")">Week</option>
                    <option value="Month" selected="@(Model.Period == "Month")">Month</option>
                    <option value="Year" selected="@(Model.Period == "Year")">Year</option>
                </select>
            </div>

            <!-- Reset Button -->
            <button style="background:transparent;color:#f43f5e;border:1px solid #f43f5e;padding:4px 10px;border-radius:6px;font-size:0.75rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:4px;height:30px;margin-left:5px;transition:all 0.2s;" 
                    onmouseover="this.style.background='#f43f5e';this.style.color='#fff';" 
                    onmouseout="this.style.background='transparent';this.style.color='#f43f5e';" 
                    onclick="resetAllDashboardFilters()" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
            <script>
                function resetAllDashboardFilters() {
                    if (document.getElementById('plantFilter')) document.getElementById('plantFilter').value = 'Overall';
                    if (document.getElementById('customerFilter')) document.getElementById('customerFilter').value = 'All';
                    if (document.getElementById('itemStatusFilter')) document.getElementById('itemStatusFilter').value = 'All';
                    if (document.getElementById('categoryFilter')) document.getElementById('categoryFilter').value = 'All';
                    if (document.getElementById('periodFilter')) document.getElementById('periodFilter').value = 'Day';
                    if (document.getElementById('dateFilter')) {
                        const tzoffset = (new Date()).getTimezoneOffset() * 60000;
                        document.getElementById('dateFilter').value = new Date(Date.now() - tzoffset).toISOString().split('T')[0];
                    }
                    if (document.getElementById('tagLabelSearch')) document.getElementById('tagLabelSearch').value = '';
                    if (typeof window.refreshDashboard === 'function') {
                        window.currentStatusFilter = 'All';
                        window.refreshDashboard(1);
                    }
                }
            </script>
        </div>
    </div>

    <!-- Dashboard Sub-Menu Navigation -->
    <div class="dashboard-nav-wrapper" style="display: flex; justify-content: space-between; align-items: center; padding-right: 15px;">
        <partial name="_DashboardNav" />
        
        <div class="action-buttons-container" style="display: flex; align-items: center; gap: 10px; margin-bottom: 5px;">
            @if (!string.IsNullOrEmpty(Context.Session.GetString("Role")))
            {
                <button id="btnExportDashboard" class="btn-custom-excel" style="background:#047857;color:#fff;border:none;padding:6px 14px;border-radius:8px;font-size:0.82rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-file-earmark-arrow-down"></i>
                    <span>Export Excel</span>
                </button>
                <button id="btnImportExcel" class="btn-custom-excel" style="background:#047857;color:#fff;border:none;padding:6px 14px;border-radius:8px;font-size:0.82rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;" onclick="document.getElementById('importExcelFile').click()">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                    <span>Import Excel</span>
                </button>
                <input type="file" id="importExcelFile" style="display:none;" accept=".xlsx, .xls" />
                <button id="btnDownloadExcel" class="btn-custom-excel" style="background:transparent;color:#10b981;border:1px solid #10b981;padding:6px 14px;border-radius:8px;font-size:0.82rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-file-earmark-excel"></i>
                    <span>Template Excel</span>
                </button>

            }

            @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin" || Context.Session.GetString("Role") == "STO")
            {
                <button id="btnAdjustStock" class="btn-custom-orange" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;padding:6px 14px;border-radius:8px;font-size:0.82rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                    <i class="bi bi-sliders"></i>
                    <span>Adjust Stock</span>
                </button>
            }
            @if (Context.Session.GetString("Role") == "Admin" || Context.Session.GetString("Role") == "Super Admin")
            {
                <button id="btnRepairPlant" onclick="repairPlantData()" style="background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;border:none;padding:6px 14px;border-radius:8px;font-size:0.82rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;" title="Perbaiki Plant pada data historis Pulling & Preparation yang Plant-nya kosong/salah">
                    <i class="bi bi-wrench-adjustable-circle"></i>
                    <span>Repair Plant</span>
                </button>
            }
        </div>
    </div>
</div>

<div id="dashboardContent">
    <!-- CHART DATA CARRIER UNTUK AJAX -->
    <div id="chartDataContainer" style="display:none;" data-trend='@Html.Raw(Model.TrendHistoryJson)' data-dates='@Html.Raw(Model.FullDatesJson)'></div>
    <!-- FILTER DATA CARRIER UNTUK AJAX -->
    <script id="filterDataScript" type="application/json">
        {
            "plants": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailablePlants)),
            "customers": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableCustomers)),
            "categories": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableCategories)),
            "statuses": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableStatuses))
        }
    </script>
    <div class="row">
        <!-- Status Indicator Cards -->
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-danger indicator-card clickable position-relative" data-filter="Shortage" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Shortage</small>
                <h2 class="fw-bold mb-0 text-danger">@Model.ShortageCount</h2>
                <small class="text-white-50 d-block mb-1">Low Stock Items</small>
                <span class="badge rounded-pill position-absolute" style="bottom: 12px; right: 12px; background-color:rgba(220,53,69,0.15); color:#f87171; border: 1px solid rgba(220,53,69,0.3); font-size:0.7rem;">&lt; 1 Day</span>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center indicator-card clickable position-relative" data-filter="Normal" style="cursor: pointer; border-color: #f59e0b !important; border: 1px solid #f59e0b;">
                <small class="text-muted d-block text-uppercase">Normal</small>
                <h2 class="fw-bold mb-0" style="color:#f59e0b;">@Model.NormalCount</h2>
                <small class="text-white-50 d-block mb-1">Safe Stock Items</small>
                <span class="badge rounded-pill position-absolute" style="bottom: 12px; right: 12px; background-color:rgba(245,158,11,0.15); color:#fbbf24; border: 1px solid rgba(245,158,11,0.3); font-size:0.7rem;">1 - 2 Day</span>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-info indicator-card clickable position-relative" data-filter="Over" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Over</small>
                <h2 class="fw-bold mb-0 text-info">@Model.OverCount</h2>
                <small class="text-white-50 d-block mb-1">Excessive Stock</small>
                <span class="badge rounded-pill position-absolute" style="bottom: 12px; right: 12px; background-color:rgba(13,202,240,0.15); color:#38bdf8; border: 1px solid rgba(13,202,240,0.3); font-size:0.7rem;">&gt; 2 Day</span>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center indicator-card clickable" data-filter="All" style="cursor: pointer;">
                <div class="status-indicator-live active"></div>
                <small class="text-muted d-block text-uppercase">Total item</small>
                <h2 class="fw-bold mb-0 text-white fs-4">@Model.TotalItemCount</h2>
                <small class="text-white-50">IN STORAGE</small>
                @if (Model.ShowNoOrder && Model.NoOrderCount > 0)
                {
                    <small class="d-block mt-2 text-warning" style="font-size: 0.75rem;" title="Item lama ini tampil di tabel tapi tidak dihitung di indikator Total Item">
                        <i class="bi bi-info-circle me-1"></i>+ @Model.NoOrderCount item lama (tidak dihitung)
                    </small>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Trend Status Stock Graph -->
        <div class="col-12 mb-4" id="trendChartContainer">
            <div class="cyber-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <h1 class="text-white mb-0 fw-bold" style="font-size: 1.35rem; display:flex; align-items:center; gap:8px;">
                        <i class="bi bi-graph-up-arrow text-primary"></i>
                        Trend Status Stock (Keseluruhan)
                    </h1>
                </div>

                <div class="row gx-4">
                    <!-- Column Chart -->
                    <div class="col-md-8 mb-3 mb-md-0">
                        <div style="height: 350px; position: relative;">
                            <canvas id="trendChart"></canvas>
                        </div>
                    </div>

                    <!-- Column Summary & Table -->
                    <div class="col-md-4">
                        <div style="background:rgba(15,23,42,0.6);border:1px solid rgba(13,202,240,0.18);border-radius:12px;padding:20px;height:350px;display:flex;flex-direction:column;">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-table text-primary" style="font-size: 1rem;"></i>
                                <span class="text-white fw-semibold" style="font-size: 1.2rem;">Informasi Status Item</span>
                            </div>
                            <div class="table-responsive" style="flex-grow: 1; display: flex; align-items: stretch;">
                                <table class="table table-sm mb-0 text-center" style="width:100%; height:100%;">
                                    <colgroup>
                                        <col style="width:30%;">
                                        <col style="width:20%;">
                                        <col style="width:20%;">
                                        <col style="width:30%;">
                                    </colgroup>
                                    <thead>
                                        <tr style="border-bottom:3px solid rgba(255,255,255,0.1);">
                                            <th rowspan="2" style="color:#ffffff;background:rgba(0,0,0,0.3);vertical-align:middle;font-size:1rem;border-radius:6px 0 0 0;">Status</th>
                                            <th colspan="2" style="color:#ffffff;background:rgba(0,0,0,0.3);font-size:1rem;border-left:1px solid rgba(255,255,255,0.06);">Qty Item</th>
                                            <th rowspan="2" style="color:#ffffff;background:rgba(0,0,0,0.3);vertical-align:middle;font-size:1rem;border-left:1px solid rgba(255,255,255,0.06);border-radius:0 6px 0 0;">Trend</th>
                                        </tr>
                                        <tr style="border-bottom:1.5px solid rgba(255,255,255,0.12);">
                                            <th style="color:#eeeff1;background:rgba(0,0,0,0.2);font-size:1rem;border-left:1px solid rgba(255,255,255,0.06);">Kemarin</th>
                                            <th style="color:#e2e8f0;background:rgba(0,0,0,0.2);font-size:1rem;border-left:1px solid rgba(255,255,255,0.06);">Hari Ini</th>
                                        </tr>
                                    </thead>
                                    <tbody id="statusSummaryBody">
                                        <tr>
                                            <td style="color:#dc3545;font-weight:bold;font-size:1rem;">Shortage</td>
                                            <td style="color:#e2e8f0;font-size:1rem;">@Model.YesterdaySummary.Shortage</td>
                                            <td style="color:#e2e8f0;font-size:1rem;font-weight:bold;">@Model.TodaySummary.Shortage</td>
                                            <td style="font-size:1rem;">
                                                @if(Model.TodaySummary.Shortage > Model.YesterdaySummary.Shortage) { <span class="text-danger"><i class="bi bi-arrow-up-right"></i> +@(Model.TodaySummary.Shortage - Model.YesterdaySummary.Shortage)</span> }
                                                else if(Model.TodaySummary.Shortage < Model.YesterdaySummary.Shortage) { <span class="text-success"><i class="bi bi-arrow-down-right"></i> -@(Model.YesterdaySummary.Shortage - Model.TodaySummary.Shortage)</span> }
                                                else { <span class="text-secondary">-</span> }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color:#ffc107;font-weight:bold;font-size:1rem;">Normal</td>
                                            <td style="color:#e2e8f0;font-size:1rem;">@Model.YesterdaySummary.Normal</td>
                                            <td style="color:#e2e8f0;font-size:1rem;font-weight:bold;">@Model.TodaySummary.Normal</td>
                                            <td style="font-size:1rem;">
                                                @if(Model.TodaySummary.Normal > Model.YesterdaySummary.Normal) { <span class="text-danger"><i class="bi bi-arrow-up-right"></i> +@(Model.TodaySummary.Normal - Model.YesterdaySummary.Normal)</span> }
                                                else if(Model.TodaySummary.Normal < Model.YesterdaySummary.Normal) { <span class="text-success"><i class="bi bi-arrow-down-right"></i> -@(Model.YesterdaySummary.Normal - Model.TodaySummary.Normal)</span> }
                                                else { <span class="text-secondary">-</span> }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color:#0dcaf0;font-weight:bold;font-size:1rem;">Over</td>
                                            <td style="color:#e2e8f0;font-size:1rem;">@Model.YesterdaySummary.Over</td>
                                            <td style="color:#e2e8f0;font-size:1rem;font-weight:bold;">@Model.TodaySummary.Over</td>
                                            <td style="font-size:1rem;">
                                                @if(Model.TodaySummary.Over > Model.YesterdaySummary.Over) { <span class="text-danger"><i class="bi bi-arrow-up-right"></i> +@(Model.TodaySummary.Over - Model.YesterdaySummary.Over)</span> }
                                                else if(Model.TodaySummary.Over < Model.YesterdaySummary.Over) { <span class="text-success"><i class="bi bi-arrow-down-right"></i> -@(Model.YesterdaySummary.Over - Model.TodaySummary.Over)</span> }
                                                else { <span class="text-secondary">-</span> }
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- History Table (Full Width) -->
                <div class="mt-4 pt-4" style="border-top: 1px solid rgba(255,255,255,0.08);">
                    <h1 class="text-white mb-3 fw-semibold" style="font-size: 1.2rem;">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        History Status Stock
                    </h1>
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0 text-center" style="border-collapse: separate; border-spacing: 0;">
                            <thead>
                                <tr>
                                    <th style="position:sticky;top:0;background:#1e293b;color:#94a3b8;border-bottom:2px solid #334155;z-index:3;text-align:left;min-width:120px;padding-left:15px;left:0;">Status</th>
                                    @foreach(var day in Model.DailyHistory) {
                                        <th style="position:sticky;top:0;background:#1e293b;color:#94a3b8;border-bottom:2px solid #334155;z-index:1;min-width:60px;">@day.DateLabel</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background:rgba(220,53,69,0.15);border-bottom:1px solid rgba(255,255,255,0.05);">
                                    <td style="text-align:left;font-weight:bold;color:#e2e8f0;position:sticky;left:0;background:linear-gradient(rgba(220,53,69,0.15), rgba(220,53,69,0.15)), #0f1929;z-index:2;padding-left:15px;border-right:1px solid rgba(255,255,255,0.05);">
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#dc3545;margin-right:6px;"></span>Shortage
                                    </td>
                                    @foreach(var day in Model.DailyHistory) {
                                        <td style="color:#e2e8f0;font-weight:500;">@day.Shortage</td>
                                    }
                                </tr>
                                <tr style="background:rgba(255,193,7,0.15);border-bottom:1px solid rgba(255,255,255,0.05);">
                                    <td style="text-align:left;font-weight:bold;color:#e2e8f0;position:sticky;left:0;background:linear-gradient(rgba(255,193,7,0.15), rgba(255,193,7,0.15)), #0f1929;z-index:2;padding-left:15px;border-right:1px solid rgba(255,255,255,0.05);">
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#ffc107;margin-right:6px;"></span>Normal
                                    </td>
                                    @foreach(var day in Model.DailyHistory) {
                                        <td style="color:#e2e8f0;font-weight:500;">@day.Normal</td>
                                    }
                                </tr>
                                <tr style="background:rgba(13,202,240,0.15);border-bottom:1px solid rgba(255,255,255,0.05);">
                                    <td style="text-align:left;font-weight:bold;color:#e2e8f0;position:sticky;left:0;background:linear-gradient(rgba(13,202,240,0.15), rgba(13,202,240,0.15)), #0f1929;z-index:2;padding-left:15px;border-right:1px solid rgba(255,255,255,0.05);">
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#0dcaf0;margin-right:6px;"></span>Over
                                    </td>
                                    @foreach(var day in Model.DailyHistory) {
                                        <td style="color:#e2e8f0;font-weight:500;">@day.Over</td>
                                    }
                                </tr>
                                <tr style="background:rgba(255,255,255,0.05);border-bottom:1px solid rgba(255,255,255,0.05);">
                                    <td style="text-align:left;font-weight:bold;color:#e2e8f0;position:sticky;left:0;background:linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), #0f1929;z-index:2;padding-left:15px;border-right:1px solid rgba(255,255,255,0.05);">
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#e2e8f0;margin-right:6px;"></span>Total
                                    </td>
                                    @foreach(var day in Model.DailyHistory) {
                                        <td style="color:#e2e8f0;font-weight:bold;">@(day.Shortage + day.Normal + day.Over)</td>
                                    }
                                </tr>
                                <tr style="background:rgba(255,255,255,0.02);border-bottom:1px solid rgba(255,255,255,0.05);">
                                    <td style="text-align:left;font-weight:bold;color:#e2e8f0;position:sticky;left:0;background:linear-gradient(rgba(255,255,255,0.02), rgba(255,255,255,0.02)), #0f1929;z-index:2;padding-left:15px;border-right:1px solid rgba(255,255,255,0.05);">
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#94a3b8;margin-right:6px;"></span>Target
                                        <i class="bi bi-pencil-square ms-2 text-warning" style="cursor:pointer; font-size:0.8rem;" title="Edit Target" onclick="openEditTargetModal()"></i>
                                        <i class="bi bi-trash text-danger ms-1" style="cursor:pointer; font-size:0.8rem;" title="Hapus Target" onclick="openDeleteTargetModal()"></i>
                                    </td>
                                    @foreach(var day in Model.DailyHistory) {
                                        <td style="color:#94a3b8;font-weight:500;" id="target-cell-@day.DateLabel.Replace("/", "-")">0</td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
            </div>
        </div>

        <!-- Detailed Data Table -->
        <div class="col-12 mb-4">
            <div class="cyber-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="tableTitle" class="fw-bold text-primary"><i class="bi bi-list-ul me-2"></i> Detail Data Barang (@Model.PlantName)</span>
                    
                    <div class="d-flex align-items-center gap-2">
                         <span id="autoScrollStatus" class="small text-muted fw-bold me-1" style="font-size: 0.75rem;">Auto Scroll: OFF</span>
                         <button id="btnToggleAutoScroll" class="btn btn-outline-secondary btn-xs d-flex align-items-center gap-1">
                             <i class="bi bi-play-circle"></i> Toggle
                         </button>
                         @if (Context.Session.GetString("Role") == "Super Admin")
                        {
                            <div class="dash-v-divider" style="height:20px;width:1px;background:rgba(255,255,255,0.15);"></div>
                            <!-- Toggle item tidak aktif -->
                            <button id="btnToggleInactive" class="btn btn-xs @(Model.ShowNoOrder ? "btn-outline-warning" : "btn-outline-secondary") d-flex align-items-center gap-1"
                                    onclick="toggleInactiveItems()" title="Sembunyikan/tampilkan item No Order">
                                <i class="@(Model.ShowNoOrder ? "bi bi-eye" : "bi bi-eye-slash")" id="iconToggleInactive"></i>
                                <span id="labelToggleInactive" style="font-size:0.72rem;">@(Model.ShowNoOrder ? "Sembunyikan No Order" : "Tampilkan No Order")</span>
                            </button>
                        }
                         <div class="dash-v-divider" style="height:20px;width:1px;background:rgba(255,255,255,0.15);"></div>
                         <!-- Filter Rak -->
                         <select id="rackFilter" class="custom-select-input" style="min-width:110px;" title="Filter per Rak">
                             <option value="">-- Semua Rak --</option>
                         </select>
                    </div>
                </div>
