                <div class="col-6">
                    <label class="form-label" style="font-size:0.75rem;color:#94a3b8;margin-bottom:4px;">Status</label>
                    <select id="editMasStatus" class="form-select form-select-sm" style="background:#1e293b;color:#fff;border-color:#334155;">
                        <option value="Reguler">Reguler</option>
                        <option value="PMSP FM">PMSP FM (Fast Moving)</option>
                        <option value="PMSP SM">PMSP SM (Slow Moving)</option>
                        <option value="After Market">After Market</option>
                        <option value="PMSP">PMSP (Legacy)</option>
