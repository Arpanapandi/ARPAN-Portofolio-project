                <div class="col-6">
                    <label class="form-label" style="font-size:0.75rem;color:#94a3b8;margin-bottom:4px;">PROD Kategori</label>
                    <select id="editMasProd" class="form-select form-select-sm" style="background:#1e293b;color:#fff;border-color:#334155;">
                        <option value="Internal">Internal</option>
                        <option value="Subcon">Subcon</option>
