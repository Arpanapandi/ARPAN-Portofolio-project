@model IEnumerable<DeliveryControl.Models.PremiumFreight>

@{
    ViewData["Title"] = "Dashboard Premium Freight";
}

<!-- Custom Dark Theme Styles for Dashboard Premium Freight -->
<style>
    /* Global & Container overrides to guarantee Dark Theme */
    .dashboard-container {
        background-color: #0f172a;
        color: #f1f5f9;
    }

    .kpi-card {
        border: 2px solid transparent;
        border-radius: 16px;
        transition: all 0.25s ease;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        user-select: none;
    }
    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4) !important;
    }
    .kpi-card.active-kpi {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.4) !important;
        transform: translateY(-2px);
    }
    .kpi-icon-bg {
        position: absolute;
        right: -10px;
        bottom: -10px;
        font-size: 5rem;
        opacity: 0.15;
    }
    .bg-gradient-primary-dark {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;
    }
    .bg-gradient-warning-dark {
        background: linear-gradient(135deg, #f857a6 0%, #ff5858 100%) !important;
    }
    .bg-gradient-success-dark {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%) !important;
    }
    .bg-gradient-info-dark {
        background: linear-gradient(135deg, #4776E6 0%, #8E54E9 100%) !important;
    }
    .bg-gradient-indigo {
        background: linear-gradient(135deg, #654ea3 0%, #eaafc8 100%) !important;
    }
    .bg-gradient-teal {
        background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%) !important;
    }

    /* Dark Mode Filter Card & Input Styling */
    .filter-card {
        border-radius: 16px;
        background: #1e293b !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f1f5f9 !important;
    }
    .filter-card .card-body {
        background: #1e293b !important;
        border-radius: 16px;
    }
    .filter-card .form-label {
        color: #cbd5e1 !important;
    }
    .filter-card .form-control,
    .filter-card .form-select {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
        border-radius: 8px;
    }
    .filter-card .form-control:focus,
    .filter-card .form-select:focus {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25) !important;
    }
    .filter-card select option {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
    }

    /* Dark Mode Trend Card Styling */
    .trend-card {
        border-radius: 16px;
        background: #1e293b !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f1f5f9 !important;
    }
    .trend-card .card-header,
    .trend-card .card-body {
        background: #1e293b !important;
    }

    /* Dark Mode Table Card Styling */
    .table-card {
        border-radius: 16px;
        background: #1e293b !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f1f5f9 !important;
    }
    .table-card .card-header,
    .table-card .card-body {
        background: #1e293b !important;
    }
    .table-modern {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
    }
    .table-modern thead th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8 !important;
        background-color: #0f172a !important;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
    }
    .table-modern tbody td {
        color: #ffffff !important;
        background-color: #1e293b !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
    }
    .table-hover tbody tr:hover td {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }
    .text-secondary {
        color: #94a3b8 !important;
    }
</style>

<div class="dashboard-container">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 d-flex align-items-center gap-2 text-white">
                <i class="bi bi-speedometer2 text-primary fs-2"></i> Dashboard Premium Freight
            </h3>
            <p class="text-secondary mb-0">Integrasi Jadwal Shipping & Monitoring Kategori Pengiriman serta Jenis Truck Armada</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-3 d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill"></i> Buat Premium Freight
            </a>
            <a asp-action="Index" class="btn btn-outline-light btn-lg shadow-sm rounded-3 d-flex align-items-center gap-2">
                <i class="bi bi-table"></i> View Table
            </a>
        </div>
    </div>

    <!-- Filter Bar (Warna Tema Dark) -->
    <div class="card filter-card shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Dashboard" id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Dari Tanggal Input</label>
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control shadow-none">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Sampai Tanggal Input</label>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control shadow-none">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Kategori Pengiriman</label>
                    <select name="kategori" id="selectKategori" class="form-select shadow-none">
                        <option value="">-- Semua --</option>
                        <option value="Shortage Delivery" selected="@(ViewBag.Kategori == "Shortage Delivery")">Shortage Delivery</option>
                        <option value="Pickup Material" selected="@(ViewBag.Kategori == "Pickup Material")">Pickup Material</option>
                        <option value="Pickup Subcon" selected="@(ViewBag.Kategori == "Pickup Subcon")">Pickup Subcon</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Jenis Armada</label>
                    <select name="armada" id="selectArmada" class="form-select shadow-none">
                        <option value="">-- Semua --</option>
                        <option value="Reguler truck" selected="@(ViewBag.Armada == "Reguler truck")">Reguler truck</option>
                        <option value="Ritase truck" selected="@(ViewBag.Armada == "Ritase truck")">Ritase truck</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-filter me-1"></i> Filter
                    </button>
                    <a asp-action="Dashboard" class="btn btn-outline-light border text-white" title="Reset Filter">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI Cards Row (Interactive Filters) -->
    <div class="row g-3 mb-4">
        <!-- Total Premium Freight -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card kpi-card bg-gradient-primary-dark text-white shadow-sm h-100 p-3 active-kpi" id="kpi-total" data-filter-type="all" data-filter-val="">
                <i class="bi bi-truck-flatbed kpi-icon-bg"></i>
                <span class="text-white-50 text-uppercase fs-7 fw-semibold">TOTAL FREIGHT</span>
                <h2 class="display-6 fw-bold mb-0 mt-2">@ViewBag.TotalCount</h2>
                <div class="mt-2 text-white-50 small"><i class="bi bi-activity me-1"></i> Semua Aktivitas</div>
            </div>
        </div>

        <!-- Shortage Delivery -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card kpi-card bg-gradient-warning-dark text-white shadow-sm h-100 p-3" id="kpi-shortage" data-filter-type="kategori" data-filter-val="Shortage Delivery">
                <i class="bi bi-exclamation-triangle-fill kpi-icon-bg"></i>
                <span class="text-white-50 text-uppercase fs-7 fw-semibold">SHORTAGE DELIVERY</span>
                <h2 class="display-6 fw-bold mb-0 mt-2">@ViewBag.ShortageCount</h2>
                <div class="mt-2 text-white-50 small"><i class="bi bi-box-seam me-1"></i> Pengiriman Darurat</div>
            </div>
        </div>

        <!-- Pickup Material -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card kpi-card bg-gradient-info-dark text-white shadow-sm h-100 p-3" id="kpi-pickup-mat" data-filter-type="kategori" data-filter-val="Pickup Material">
                <i class="bi bi-arrow-down-left-square-fill kpi-icon-bg"></i>
                <span class="text-white-50 text-uppercase fs-7 fw-semibold">PICKUP MATERIAL</span>
                <h2 class="display-6 fw-bold mb-0 mt-2">@ViewBag.PickupMaterialCount</h2>
                <div class="mt-2 text-white-50 small"><i class="bi bi-building me-1"></i> Dari Supplier</div>
            </div>
        </div>

        <!-- Pickup Subcon -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card kpi-card bg-gradient-indigo text-white shadow-sm h-100 p-3" id="kpi-pickup-sub" data-filter-type="kategori" data-filter-val="Pickup Subcon">
                <i class="bi bi-gear-wide-connected kpi-icon-bg"></i>
                <span class="text-white-50 text-uppercase fs-7 fw-semibold">PICKUP SUBCON</span>
                <h2 class="display-6 fw-bold mb-0 mt-2">@ViewBag.PickupSubconCount</h2>
                <div class="mt-2 text-white-50 small"><i class="bi bi-tools me-1"></i> Dari Subkontraktor</div>
            </div>
        </div>

        <!-- Reguler Truck -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card kpi-card bg-gradient-success-dark text-white shadow-sm h-100 p-3" id="kpi-reguler" data-filter-type="armada" data-filter-val="Reguler truck">
                <i class="bi bi-truck kpi-icon-bg"></i>
                <span class="text-white-50 text-uppercase fs-7 fw-semibold">REGULER TRUCK</span>
                <h2 class="display-6 fw-bold mb-0 mt-2">@ViewBag.RegulerTruckCount</h2>
                <div class="mt-2 text-white-50 small"><i class="bi bi-check-circle me-1"></i> Single Route</div>
            </div>
        </div>

        <!-- Ritase Truck -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card kpi-card bg-gradient-teal text-white shadow-sm h-100 p-3" id="kpi-ritase" data-filter-type="armada" data-filter-val="Ritase truck">
                <i class="bi bi-arrow-repeat kpi-icon-bg"></i>
                <span class="text-white-50 text-uppercase fs-7 fw-semibold">RITASE TRUCK</span>
                <h2 class="display-6 fw-bold mb-0 mt-2">@ViewBag.RitaseTruckCount</h2>
                <div class="mt-2 text-white-50 small"><i class="bi bi-arrow-left-right me-1"></i> Bolak-balik</div>
            </div>
        </div>
    </div>

    <!-- 3 LINES TREND CHART SECTION (Warna Tema Dark) -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card trend-card shadow-sm">
                <div class="card-header border-0 pt-4 px-4 pb-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                    <div>
                        <h5 class="fw-bold mb-1 text-white d-flex align-items-center gap-2">
                            <i class="bi bi-graph-up-arrow text-primary"></i> Trend Premium Freight per Tanggal Input
                        </h5>
                        <p class="text-secondary small mb-0">Tren harian berdasarkan tanggal penginputan Premium Freight (Shortage, Pickup Material, Pickup Subcon)</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-secondary small fw-medium">
                            <i class="bi bi-calendar3 me-1"></i> @ViewBag.StartDate s/d @ViewBag.EndDate
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div style="position: relative; height: 360px; width: 100%;">
                        <canvas id="singleTrendLineChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Integrated Table Section (Ringkas - Detail Selengkapnya di View Tabel) -->
    <div class="card table-card shadow-sm mb-4">
        <div class="card-header border-0 pt-4 px-4 pb-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-1 text-white">
                    <i class="bi bi-journal-text text-primary me-2"></i> Data Ringkasan Premium Freight
                </h5>
                <p class="text-secondary small mb-0" id="tableSubtitle">Detail selengkapnya dapat dilihat di halaman View Tabel</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-right-circle me-1"></i> Buka View Tabel
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-modern align-middle mb-0" id="premiumFreightTable">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">No. Referensi</th>
                            <th class="py-3">Jadwal Shipping (Cust & Route)</th>
                            <th class="py-3">No. Truck & Driver</th>
                            <th class="py-3">Kategori Pengiriman</th>
                            <th class="py-3">Jenis Armada</th>
                            <th class="px-4 py-3 text-end">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr id="emptyRow">
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    Belum ada data Premium Freight yang terdaftar pada rentang filter ini.
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr id="emptyRow" style="display: none;">
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    Tidak ada data Premium Freight yang sesuai dengan filter indikator terpilih.
                                </td>
                            </tr>
                            foreach (var item in Model)
                            {
                                var customerName = item.CustomerName ?? item.DeliverySchedule?.Customer?.CustomerName;
                                var route = item.Route ?? item.DeliverySchedule?.Route;
                                var cycle = item.Cycle ?? item.DeliverySchedule?.Cycle;
                                var vehicle = item.VehicleNumber ?? item.DeliverySchedule?.VehicleNumber;
                                var driver = item.DriverName ?? item.DeliverySchedule?.DriverName;

                                <tr class="data-row" data-kategori="@(item.KategoriPengiriman ?? "")" data-armada="@(item.JenisArmada ?? "")">
                                    <!-- No Referensi -->
                                    <td class="px-4 py-3 fw-bold text-white">
                                        @(string.IsNullOrEmpty(item.FreightNumber) ? "-" : item.FreightNumber)
                                    </td>

                                    <!-- Jadwal Shipping (Cust & Route) -->
                                    <td class="py-3">
                                        @if (string.IsNullOrEmpty(customerName) && string.IsNullOrEmpty(route))
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                        else
                                        {
                                            <div>
                                                <span class="fw-bold text-white">@(string.IsNullOrEmpty(customerName) ? "-" : customerName)</span>
                                                <div class="small text-secondary">
                                                    Route: @(string.IsNullOrEmpty(route) ? "-" : route)
                                                    @if (!string.IsNullOrEmpty(cycle))
                                                    {
                                                        <span> | Cycle @cycle</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </td>

                                    <!-- No. Truck & Driver -->
                                    <td class="py-3">
                                        @if (string.IsNullOrEmpty(vehicle) && string.IsNullOrEmpty(driver))
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                        else
                                        {
                                            <div>
                                                <div class="fw-bold text-white">@(string.IsNullOrEmpty(vehicle) ? "-" : vehicle)</div>
                                                <div class="small text-secondary">Driver: @(string.IsNullOrEmpty(driver) ? "-" : driver)</div>
                                            </div>
                                        }
                                    </td>

                                    <!-- Kategori Pengiriman -->
                                    <td class="py-3 text-white fw-bold">
                                        @(string.IsNullOrEmpty(item.KategoriPengiriman) ? "-" : item.KategoriPengiriman)
                                    </td>

                                    <!-- Jenis Armada -->
                                    <td class="py-3 text-white fw-bold">
                                        @(string.IsNullOrEmpty(item.JenisArmada) ? "-" : item.JenisArmada)
                                    </td>

                                    <!-- Aksi -->
                                    <td class="px-4 py-3 text-end">
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data Premium Freight ini?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Hapus Data">
                                                <i class="bi bi-trash"></i> Hapus
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Data JSON dari Controller
            const dates = @Html.Raw(ViewBag.TrendDatesJson ?? "[]");
            const shortageData = @Html.Raw(ViewBag.ShortageTrendJson ?? "[]");
            const pickupMatData = @Html.Raw(ViewBag.PickupMaterialTrendJson ?? "[]");
            const pickupSubData = @Html.Raw(ViewBag.PickupSubconTrendJson ?? "[]");
            const regulerData = @Html.Raw(ViewBag.RegulerTotalTrendJson ?? "[]");
            const ritaseData = @Html.Raw(ViewBag.RitaseTotalTrendJson ?? "[]");

            const ctx = document.getElementById('singleTrendLineChart').getContext('2d');

            // Helper function untuk gradient background
            function createGradient(colorStart, colorEnd) {
                const gradient = ctx.createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, colorStart);
                gradient.addColorStop(1, colorEnd);
                return gradient;
            }

            // Inisialisasi Chart.js dengan 5 Datasets (Shortage, Pickup Material, Pickup Subcon, Reguler truck, Ritase truck)
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dates,
                    datasets: [
                        {
                            label: 'Shortage Delivery',
                            data: shortageData,
                            borderColor: '#ff5858',
                            backgroundColor: createGradient('rgba(255, 88, 88, 0.45)', 'rgba(255, 88, 88, 0.0)'),
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#ff5858',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 7
                        },
                        {
                            label: 'Pickup Material',
                            data: pickupMatData,
                            borderColor: '#4776E6',
                            backgroundColor: createGradient('rgba(71, 118, 230, 0.40)', 'rgba(71, 118, 230, 0.0)'),
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#4776E6',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 7
                        },
                        {
                            label: 'Pickup Subcon',
                            data: pickupSubData,
                            borderColor: '#9d4edd',
                            backgroundColor: createGradient('rgba(157, 78, 221, 0.35)', 'rgba(157, 78, 221, 0.0)'),
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#9d4edd',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 7
                        },
                        {
                            label: 'Reguler truck',
                            data: regulerData,
                            borderColor: '#38ef7d',
                            backgroundColor: createGradient('rgba(56, 239, 125, 0.40)', 'rgba(56, 239, 125, 0.0)'),
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#38ef7d',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 7,
                            hidden: true
                        },
                        {
                            label: 'Ritase truck',
                            data: ritaseData,
                            borderColor: '#14b8a6',
                            backgroundColor: createGradient('rgba(20, 184, 166, 0.40)', 'rgba(20, 184, 166, 0.0)'),
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#14b8a6',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 7,
                            hidden: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                color: '#cbd5e1',
                                font: { size: 12, family: 'Inter, system-ui', weight: '500' }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            titleColor: '#f8fafc',
                            bodyColor: '#f1f5f9',
                            borderColor: 'rgba(255, 255, 255, 0.15)',
                            borderWidth: 1,
                            padding: 12,
                            cornerRadius: 8,
                            usePointStyle: true
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                stepSize: 1,
                                color: '#94a3b8',
                                font: { size: 11 }
                            },
                            grid: {
                                color: 'rgba(255, 255, 255, 0.08)'
                            }
                        },
                        x: {
                            ticks: {
                                color: '#94a3b8',
                                font: { size: 11 }
                            },
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });

            // Interaktivitas Klik KPI Card untuk Filter Grafik & Tabel Dinamis
            const kpiCards = document.querySelectorAll('.kpi-card');
            const dataRows = document.querySelectorAll('.data-row');
            const emptyRow = document.getElementById('emptyRow');
            const tableSubtitle = document.getElementById('tableSubtitle');

            kpiCards.forEach(card => {
                card.addEventListener('click', function () {
                    // Update visual active state pada KPI cards
                    kpiCards.forEach(c => c.classList.remove('active-kpi'));
                    this.classList.add('active-kpi');

                    const filterType = this.getAttribute('data-filter-type');
                    const filterVal = this.getAttribute('data-filter-val');

                    // Filter Garis Grafik berdasarkan KPI Card yang di-klik (Satu Garis Sesuai Indikator)
                    if (filterType === 'all') {
                        chart.setDatasetVisibility(0, true);
                        chart.setDatasetVisibility(1, true);
                        chart.setDatasetVisibility(2, true);
                        chart.setDatasetVisibility(3, false);
                        chart.setDatasetVisibility(4, false);
                        tableSubtitle.textContent = 'Menampilkan seluruh detail pengajuan Premium Freight';
                    } else if (filterType === 'kategori') {
                        chart.data.datasets.forEach((ds, idx) => {
                            const isMatch = ds.label.toLowerCase() === filterVal.toLowerCase();
                            chart.setDatasetVisibility(idx, isMatch);
                        });
                        tableSubtitle.textContent = `Filtered by Kategori: ${filterVal}`;
                    } else if (filterType === 'armada') {
                        chart.data.datasets.forEach((ds, idx) => {
                            const isMatch = ds.label.toLowerCase() === filterVal.toLowerCase();
                            chart.setDatasetVisibility(idx, isMatch);
                        });
                        tableSubtitle.textContent = `Filtered by Jenis Armada: ${filterVal}`;
                    }
                    chart.update();

                    // Filter Baris Tabel HTML
                    let visibleCount = 0;
                    dataRows.forEach(row => {
                        const rowKategori = row.getAttribute('data-kategori') || '';
                        const rowArmada = row.getAttribute('data-armada') || '';

                        let match = false;
                        if (filterType === 'all') {
                            match = true;
                        } else if (filterType === 'kategori') {
                            match = rowKategori.toLowerCase() === filterVal.toLowerCase();
                        } else if (filterType === 'armada') {
                            match = rowArmada.toLowerCase() === filterVal.toLowerCase();
                        }

                        if (match) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Update pesan jika tidak ada data yang cocok dengan filter indikator
                    if (emptyRow) {
                        emptyRow.style.display = (visibleCount === 0) ? '' : 'none';
                    }
                });
            });
        });
    </script>
}
