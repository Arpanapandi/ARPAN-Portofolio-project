@model DeliveryControl.Models.ScheduleTemplate

@{
    ViewData["Title"] = "Hapus Template";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <h4 class="mb-0 d-inline-block">Konfirmasi Hapus</h4>
            </div>
            <div class="card-body p-4 text-center">
                <h5 class="mb-3">Apakah Anda yakin ingin menghapus template ini?</h5>
                
                <div class="alert alert-light border mb-4">
                    <h4 class="text-danger">@Model.Name</h4>
                    <p class="mb-1 text-muted">Customer: <strong>@Model.CustomerName</strong></p>
                    <p class="mb-0 text-muted small">Tipe: @Model.FileType</p>
                </div>

                <p class="text-muted small mb-4">
                    <i class="bi bi-info-circle"></i> Menghapus template akan menghapus semua konfigurasi mapping yang terkait. Tindakan ini tidak dapat dibatalkan.
                </p>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Batal
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            Hapus Permanen
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
