@section Scripts {
    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>

    <script>
        // Global variables for Dock Mapping
        let selectedDock = null; // { customerId, dockName, cycle, startPrepTime }
        let lockedRackInfo = null; // { rack, noRack, plant } — lokasi multi-rack yang sedang dikerjakan

        $(document).ready(function () {
            // --- SignalR Realtime Updates ---
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/deliveryHub")
                .withAutomaticReconnect()
                .build();

            function updateSignalRStatus(status) {
                const badge = document.getElementById('signalr-status');
                if (!badge) return;
                const text = badge.querySelector('.status-text');
                badge.className = 'realtime-status-badge status-' + status;
                
                if (status === 'live') {
                    text.innerText = 'Live';
                } else if (status === 'connecting') {
                    text.innerText = 'Connecting...';
                } else if (status === 'reconnecting') {
                    text.innerText = 'Reconnecting...';
                } else {
                    text.innerText = 'Offline';
                }
            }

            // Sync indicators when data changes anywhere
            connection.on("deliveryUpdated", function (data) {
                console.log("Realtime update received:", data);
                loadScheduleList(); // Refreshes Modal & FAB counts
            });

            connection.onreconnecting(() => updateSignalRStatus('reconnecting'));
            connection.onreconnected(() => updateSignalRStatus('live'));
            connection.onclose(() => updateSignalRStatus('disconnected'));

            async function startSignalR() {
                try {
                    await connection.start();
                    console.log("SignalR: Connected to Delivery Hub");
                    updateSignalRStatus('live');
                } catch (err) {
                    console.error("SignalR Connection Error: ", err);
                    updateSignalRStatus('disconnected');
                    setTimeout(startSignalR, 5000); // Retry after 5s
                }
            }

            startSignalR();

            // ── RACK PICK MODAL (popup amber — muncul saat PERTAMA scan multi-rack) ────
            const $rackPickModalPrep = $(`
                <div class="modal fade" id="rackPickModalPrepDyn" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index:2100">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background:#1a2035;border:2px solid #f59e0b;border-radius:14px;box-shadow:0 0 40px rgba(245,158,11,0.3);">
                            <div class="modal-body text-center py-4 px-4">
                                <div style="font-size:2.5rem;color:#f59e0b;" class="mb-2">
                                    <i class="bi bi-grid-3x3-gap-fill"></i>
                                </div>
                                <h5 class="fw-bold text-white mb-1" style="letter-spacing:1px;text-transform:uppercase;">Pilih Lokasi Rak</h5>
                                <p class="mb-1" style="color:#94a3b8;font-size:0.82rem;" id="rackPickVinLabelPrep"></p>
                                <p class="mb-3" style="color:#f59e0b;font-size:0.78rem;">Item ini memiliki beberapa lokasi rak — pilih salah satu</p>
                                <div id="rackPickBtnsPrep" class="d-flex flex-wrap gap-2 justify-content-center"></div>
                            </div>
                        </div>
                    </div>
                </div>`);
            $('body').append($rackPickModalPrep);
            const rackPickModalPrep = new bootstrap.Modal(document.getElementById('rackPickModalPrepDyn'));

            // Setelah popup ditutup: fokus ke label jika sudah di-enable, atau clear focus
            document.getElementById('rackPickModalPrepDyn').addEventListener('hidden.bs.modal', function() {
                if (!$('#labelInput').prop('disabled')) {
                    $('#labelInput').focus();
                } else {
                    $(document.activeElement).blur();
                }
            });

            // ── LOCATION PANEL HELPERS (Multi-Rack) ─────────────────────────────
            function selectRackPrep(loc) {
                lockedRackInfo = loc;
                // Update tombol di panel inline — highlight yang dipilih
                $('#rackLocationGridPrep button').each(function() {
                    const btnRack = $(this).data('rack');
                    const btnNoRack = $(this).data('norack');
                    if (btnRack === loc.rack && String(btnNoRack) === String(loc.noRack)) {
                        $(this).addClass('rack-loc-active-prep').css({
                            background: 'rgba(59,130,246,0.25)',
                            borderColor: '#3b82f6',
                            color: '#fff',
                            boxShadow: '0 0 10px rgba(59,130,246,0.4)'
                        });
                    } else {
                        $(this).removeClass('rack-loc-active-prep').css({
                            background: 'rgba(30,41,59,0.7)',
                            borderColor: 'rgba(59,130,246,0.35)',
                            color: '#93c5fd',
                            boxShadow: 'none'
                        });
                    }
                });
                const display = loc.noRack ? `Rak ${loc.rack}.${loc.noRack} (${loc.plant || '-'})` : `Rak ${loc.rack} (${loc.plant || '-'})`;
                $('#selectedRackTextPrep').text(display);
                $('#selectedRackInfoPrep').fadeIn(200);
                $('#rackSelectionPanelPrep').slideDown(250);
                enableLabelForPrep();
            }

            function renderRackLocationGridPrep(locations) {
                const $grid = $('#rackLocationGridPrep');
                $grid.empty();
                locations.forEach(function(loc) {
                    const label = loc.noRack ? `${loc.rack}.${loc.noRack}` : `${loc.rack}`;
                    const $btn = $('<button type="button"></button>')
                        .text(label)
                        .attr('title', `${loc.plant || ''} — Rak ${loc.rack}`)
                        .data('rack', loc.rack)
                        .data('norack', loc.noRack)
                        .css({
                            background: 'rgba(30,41,59,0.7)',
                            border: '1.5px solid rgba(59,130,246,0.35)',
                            borderRadius: '8px',
                            color: '#93c5fd',
                            fontWeight: '700',
                            fontSize: '0.9rem',
                            padding: '8px 18px',
                            cursor: 'pointer',
                            transition: 'all 0.18s'
                        });
                    $btn.on('mouseenter', function() {
                        if (!$(this).hasClass('rack-loc-active-prep'))
                            $(this).css({ background: 'rgba(59,130,246,0.15)', borderColor: 'rgba(59,130,246,0.8)', color: '#fff' });
                    }).on('mouseleave', function() {
                        if (!$(this).hasClass('rack-loc-active-prep'))
                            $(this).css({ background: 'rgba(30,41,59,0.7)', borderColor: 'rgba(59,130,246,0.35)', color: '#93c5fd' });
                    });
                    $btn.on('click', function() { selectRackPrep(loc); });
                    $grid.append($btn);
                });
                // Panel TIDAK langsung slideDown — akan muncul setelah user pilih di popup (via selectRackPrep)
            }

            function showRackPickModalPrep(locations, vinTag) {
                // Tampilkan VIN di modal header
                const normVin = vinTag ? vinTag.replace(/X$/i, '').replace(/LB$/i, '').replace(/^LB/i, '') : $('#tagInput').val().replace(/X$/i, '').replace(/LB$/i, '').replace(/^LB/i, '');
                $('#rackPickVinLabelPrep').text('VIN: ' + normVin);

                const $btns = $('#rackPickBtnsPrep');
                $btns.empty();
                locations.forEach(function(loc) {
                    const label = loc.noRack ? `${loc.rack}.${loc.noRack}` : `${loc.rack}`;
                    const plantText = (loc.plant && loc.plant !== '-') ? `<div style="font-size:0.7rem;color:#94a3b8;margin-top:2px;">${loc.plant}</div>` : '';
                    const $btn = $(`<button type="button" style="
                        background:rgba(245,158,11,0.12);border:1.5px solid rgba(245,158,11,0.5);
                        border-radius:10px;color:#fbbf24;font-weight:700;font-size:0.95rem;
                        padding:10px 20px;cursor:pointer;transition:all 0.18s;min-width:80px;">
                        <div>${label}</div>${plantText}
                    </button>`);
                    $btn.on('mouseenter', function() {
                        $(this).css({ background: 'rgba(245,158,11,0.28)', borderColor: '#f59e0b', color: '#fff' });
                    }).on('mouseleave', function() {
                        $(this).css({ background: 'rgba(245,158,11,0.12)', borderColor: 'rgba(245,158,11,0.5)', color: '#fbbf24' });
                    });
                    $btn.on('click', function() {
                        $(document.activeElement).blur();
                        rackPickModalPrep.hide();
                        selectRackPrep(loc);
                    });
                    $btns.append($btn);
                });
                rackPickModalPrep.show();
            }

            function handleLocationCard(rackLocations) {
                if (!rackLocations || rackLocations.length === 0) return true;

                const isPanelVisible = $('#rackSelectionPanelPrep').is(':visible');
                if (!isPanelVisible) {
                    renderRackLocationGridPrep(rackLocations);
                    if (rackLocations.length === 1) {
                        // Single rack — auto select langsung tanpa popup modal
                        selectRackPrep(rackLocations[0]);
                        return false; // selectRackPrep sudah handle enable label & focus
                    }
                    // Multi rack — tampil popup pilih lokasi
                    showRackPickModalPrep(rackLocations, $('#tagInput').val());
                    return false; // label enabled SETELAH user pilih rak di popup
                } else {
                    // Panel sudah tampil: validasi rak terkunci cocok dengan rak item baru (cek rack.noRack)
                    if (lockedRackInfo) {
                        const lockedKey = `${(lockedRackInfo.rack||'').toUpperCase().trim()}.${lockedRackInfo.noRack||0}`;
                        const newKeys = rackLocations.map(r => `${(r.rack||'').toUpperCase().trim()}.${r.noRack||0}`);
                        if (!newKeys.some(k => k === lockedKey)) {
                            // Beda rak → auto switch ke rak baru
                            lockedRackInfo = null;
                            renderRackLocationGridPrep(rackLocations);
                            if (rackLocations.length === 1) {
                                selectRackPrep(rackLocations[0]);
                                return false;
                            }
                            showRackPickModalPrep(rackLocations, $('#tagInput').val());
                            return false;
                        }
                    }
                    return true;
                }
            }

            function enableLabelForPrep() {
                const isFastMode = $('#fastScanMode').is(':checked');
                $('#labelInput, .btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);
                setTimeout(() => $('#labelInput').focus(), isFastMode ? 50 : 300);
            }

            // SELESAI: reset semua termasuk panel rak
            function resetAll() {
                lockedRackInfo = null;
                $('#rackSelectionPanelPrep').slideUp(200);
                $('#selectedRackInfoPrep').hide();
                $('#rackLocationGridPrep').empty();
                resetInputs();
            }

            $('#btnSelesaiPrep').on('click', function() {
                resetAll();
            });

            let html5QrCode = null;
            const scannerModalEl = document.getElementById('scannerModal');
            const scannerModal = new bootstrap.Modal(scannerModalEl);
            let activeInputId = null;
            let currentScheduleId = null;
            let currentManifestNumber = null; // Manifest/ScheduleNumber yang ditemukan saat LookupSchedule
            let manualMode = false; // Admin only: Manual input tanpa scanner
            let skipStockMode = false; // Admin+Preparation: Skip stock habis validation
            let validateProdIntLabelMode = true; // Admin: Enable/disable Prod Internal duplicate label validation
            let isSubmitting = false; // Flag to prevent duplicate requests (legacy, masih dipakai untuk manual mode)
            let isReadOnly = @(isUserRolePrep ? "true" : "false"); // Role User: view only — no scan/save
            let isTwoPointCheck = false; // Flag: Customer No Kanban
            let selectedTargetDate = null; // null = hari ini, string "yyyy-MM-dd" = tanggal jadwal ke depan

            // ================================================================
            // SCAN QUEUE SYSTEM
            // Scan ke-2, 3, 4... langsung masuk antrian tanpa menunggu response
            // server dari scan sebelumnya. Form di-reset SEGERA agar operator
            // bisa scan item berikutnya tanpa delay.
            // 
            // NOTE: Tidak ada duplicate check karena:
            // - 1 item bisa butuh 10+ kanban = scan 3-point check yang SAMA 10x
            // - Semua scan identik VALID dan harus tersimpan sebagai qty
            // - Validasi kanban terhadap database dilakukan di server
            // ================================================================
            const ScanQueue = (() => {
                const _q = [];
                let _running = false;
                let _badgeEl = null;
                let _scanCount = 0; // Counter untuk tracking jumlah scan dalam session

                // Tambahkan 1 scan ke antrian (non-blocking, no duplicate check)
                function push(payload) {
                    _scanCount++;
                    payload._scanId = _scanCount; // Unique ID untuk tracking
                    _q.push(payload);
                    _refreshBadge();
                    if (!_running) _next();
                }

                async function _next() {
                    if (_q.length === 0) {
                        _running = false;
                        _refreshBadge();
                        return;
                    }
                    _running = true;
                    const item = _q.shift();
                    _refreshBadge();

                    try {
                        await _execute(item);
                    } catch (e) {
                        logNGScan('Preparation', item.Tag || '', item.Label || '', item.Kanban || '', "Koneksi Error (Queue): " + e.message);
                        _toast('danger', '🔌 Koneksi error: ' + e.message);
                    }

                    // Jeda 80ms antar request agar SQLite tidak konflik
                    await _sleep(80);
                    _next();
                }

                async function _execute(payload) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    let attempt = 0;
                    const maxAttempts = 3;

                    while (attempt < maxAttempts) {
                        attempt++;
                        try {
                            const res = await fetch('@Url.Action("Save", "PreparationWorkflow")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': token
                                },
                                body: JSON.stringify(payload)
                            });

                            const data = await res.json();

                            if (data.success) {
                                if (data.isPending) {
                                    // Tampilkan notifikasi PENDING (scan tersimpan tapi belum match schedule)
                                    const notif = document.getElementById('pendingSaveNotif');
                                    if (notif) {
                                        notif.style.display = 'block';
                                        clearTimeout(notif._t);
                                        notif._t = setTimeout(() => notif.style.display = 'none', 5000);
                                    }
                                } else {
                                    _toast('success', data.message || '✅ Berhasil tersimpan!');
                                    // Update progress detail
                                    if (data.scheduleDetails) {
                                        $('#progressTargetName').text(data.scheduleDetails.customerName);
                                        const pct = Math.round(data.scheduleDetails.totalPercent);
                                        $('#progressPercentTotal').text(pct + '%');
                                        $('#progressDetailArea').fadeIn();
                                        setTimeout(() => $('#progressDetailArea').fadeOut(), 3000);
                                    }
                                }
                            } else {
                                // Jika server retryable (SQLite busy) → coba lagi
                                if (data.retryable && attempt < maxAttempts) {
                                    await _sleep(150 * attempt);
                                    continue;
                                }
                                // Special case: kanban sudah penuh
                                const errMsg = data.message || '';
                                if (errMsg.includes('QTY sudah CUKUP') || errMsg.includes('sudah CUKUP')) {
                                    const notifEl = document.getElementById('kanbanFullNotif');
                                    if (notifEl) {
                                        const detailEl = document.getElementById('kanbanFullDetail');
                                        if (detailEl) detailEl.textContent = (payload.Tag ? `Tag: ${payload.Tag} — ` : '') + 'Target QTY sudah tercapai.';
                                        notifEl.style.display = 'block';
                                        clearTimeout(notifEl._t);
                                        notifEl._t = setTimeout(() => notifEl.style.display = 'none', 5000);
                                    }
                                } else {
                                    _toast('danger', errMsg || '❌ Scan gagal!');
                                }
                                // Catat ke NG Log — form sudah di-reset, gunakan data dari payload
                                logNGScan('Preparation', payload.Tag || '', payload.Label || '', payload.Kanban || '', errMsg || 'Scan gagal (queue)');
                                // CATATAN: Di mode queue, form sudah di-reset dan user mungkin sudah scan item berikutnya.
                                // JANGAN panggil resetKanbanOnly/resetInputs di sini karena akan mengganggu scan yang sedang berjalan.
                                // Cukup tampilkan error toast saja — user akan tahu item mana yang gagal.
                            }
                            break; // keluar dari retry loop

                        } catch (fetchErr) {
                            if (attempt >= maxAttempts) throw fetchErr;
                            await _sleep(200 * attempt);
                        }
                    }
                }

                function _refreshBadge() {
                    if (!_badgeEl) {
                        _badgeEl = document.createElement('div');
                        _badgeEl.id = '_sqBadge';
                        _badgeEl.style.cssText = [
                            'position:fixed', 'bottom:80px', 'right:20px', 'z-index:9999',
                            'background:#f59e0b', 'color:#1a1a2e', 'font-weight:700',
                            'font-size:13px', 'border-radius:20px', 'padding:7px 16px',
                            'box-shadow:0 4px 12px rgba(0,0,0,.5)', 'display:none',
                            'pointer-events:none'
                        ].join(';');
                        document.body.appendChild(_badgeEl);
                    }
                    if (_q.length > 0 || _running) {
                        _badgeEl.textContent = _running
                            ? '⚡ Menyimpan... (' + _q.length + ' antrian)'
                            : '⏳ Antrian: ' + _q.length + ' scan';
                        _badgeEl.style.display = 'block';
                    } else {
                        _badgeEl.style.display = 'none';
                    }
                }

                function _toast(type, msg) {
                    showScannerToast(msg, type);
                }

                function _sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

                return { push, get busy() { return _running; }, get size() { return _q.length; } };
            })();

            // helper: validasi apakah label mengandung VIN/Tag yang sesuai
            // Mendukung relaksasi untuk kode MS-series (sebagian label hanya ambil 3 digit angka)
            function isLabelMatch(tagNorm, scannedLabel) {
                if (!tagNorm || tagNorm.length < 4) return true;
                if (!scannedLabel) return false;
                
                const sLabel = scannedLabel.toUpperCase().trim();
                const tNorm = tagNorm.toUpperCase().trim();
                
                if (sLabel.includes(tNorm)) return true;
                
                // Relaksasi khusus MS-series: misal jika VIN MS0020, label cukup mengandung MS002
                if (tNorm.startsWith('MS') && tNorm.length >= 5) {
                    const shortTag = tNorm.substring(0, 5);
                    if (sLabel.includes(shortTag)) return true;
                }
                
                return false;
            }

            // --- TOGGLE PERSISTENCE: Simpan & restore state toggle via localStorage ---
            const LS_FAST   = 'prep_fastScanMode';
            const LS_MANUAL = 'prep_manualInputMode';
            const LS_SKIP   = 'prep_skipStockMode';
            const LS_VALIDATE_LBL = 'prep_validateProdIntLabel';

            // --- GLOBAL SCANNER HANDLER (ANTI-MANUAL & READONLY SUPPORT) ---
            let scanBuffer = "";
            let lastKeyTime = Date.now();
            const SCAN_INTERVAL = 100; 

            window.addEventListener('keydown', function (e) {
                const currentTime = Date.now();

                // In manual mode, let individual input fields handle their own key events
                if (manualMode) return;
                
                // Ignore keydown events if the target is not a cyber-field input, or is a textarea/select
                if (e.target.tagName === "INPUT" && !$(e.target).hasClass('cyber-field')) return;
                if (e.target.tagName === "TEXTAREA" || e.target.tagName === "SELECT") return;
                // Ignore keydown events if any modal is currently open
                if ($('.modal.show').length > 0) return;

                if (currentTime - lastKeyTime > SCAN_INTERVAL) {
                    scanBuffer = "";
                }
                lastKeyTime = currentTime;

                if (e.keyCode === 13) { // Enter key
                    if (scanBuffer.length > 0) {
                        processScanResult(scanBuffer);
                        scanBuffer = "";
                    }
                    e.preventDefault(); // Prevent form submission or other default behavior
                    return;
                }

                // Only append printable characters
                if (e.key.length === 1) {
                    scanBuffer += e.key;
                    // Prevent karakter scanner masuk langsung ke input field
                    // Semua field scan bersifat readonly — karakter hanya boleh masuk via processScanResult
                    e.preventDefault();
                }
            });

            function processScanResult(code) {
                code = code.trim();
                const codeUpper = code.toUpperCase();
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                // Target logic: VIN -> Label -> Kanban
                if (!tag) {
                    // --- VIN VALIDATION (Must have X) ---
                    if (!manualMode && !codeUpper.endsWith('X')) {
                        logNGScan('Preparation', code, '', '', 'KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)');
                        showScannerToast("KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)", "danger");
                        return;
                    }
                    $('#tagInput').val(code).addClass('active-scan');
                    setTimeout(() => $('#tagInput').removeClass('active-scan'), 500);
                    performLookup();
                } else if (!label) {
                    // --- LABEL VALIDATION (Must NOT have X) ---
                    if (!manualMode && codeUpper.endsWith('X')) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), code, '', 'KODE TIDAK VALID: Label tidak boleh mengandung suffix X');
                        showScannerToast("KODE TIDAK VALID: Label tidak boleh mengandung suffix X", "danger");
                        resetLabelOnly();
                        return;
                    }
                    // --- VALIDASI VIN-IN-LABEL: Label harus mengandung kode VIN ---
                    const currentTagRaw = $('#tagInput').val().trim().toUpperCase();
                    const vinNormalized = currentTagRaw.replace(/X$/, '').replace(/LB$/, '').replace(/^LB/, '');
                    if (vinNormalized && vinNormalized.length >= 4 && !codeUpper.includes(vinNormalized)) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), code, '', `Label tidak mengandung VIN: ${vinNormalized}`);
                        showScannerToast(`❌ LABEL TIDAK VALID! Label harus mengandung kode VIN: "${vinNormalized}". Scan ulang label yang benar.`, "danger");
                        resetLabelOnly();
                        return;
                    }
                    $('#labelInput').val(code).addClass('active-scan');
                    setTimeout(() => $('#labelInput').removeClass('active-scan'), 500);
                    performLookup();
                } else if (!kanban) {
                    $('#kanbanInput').val(code).addClass('active-scan');
                    setTimeout(() => $('#kanbanInput').removeClass('active-scan'), 500);
                    checkAndAdvance();
                }
            }

            // --- SCANNER HANDLERS ---
            $('.btn-scan-trigger').click(function() {
                if (isReadOnly) return; // Role User: tidak bisa scan
                activeInputId = $(this).data('target');
                $('#scannerModalLabel').text("MEMINDAI: " + (activeInputId || "ITEM").toUpperCase());
                scannerModal.show();
            });

            $(scannerModalEl).on('shown.bs.modal', function () {
                initScanner();
            });

            $(scannerModalEl).on('hidden.bs.modal', function () {
                stopScanner();
                // Ensure focus is definitely not on the modal trigger if possible, though we handled it in onDetected
            });

            async function initScanner() {
                try {
                    const config = { 
                        fps: 25, 
                        aspectRatio: 1.0, 
                        qrbox: { width: 250, height: 250 },
                        showTorchButtonIfSupported: true,
                        videoConstraints: {
                            facingMode: "environment",
                            focusMode: "continuous",
                            width: { min: 640, ideal: 1280, max: 1920 },
                            height: { min: 480, ideal: 720, max: 1080 }
                        }
                    };
                    
                    if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");
                    if (html5QrCode.isScanning) await html5QrCode.stop();

                    $('#scanner-status').text("Mengakses Kamera...");
                    await html5QrCode.start({ facingMode: "environment" }, config, onDetected);
                    $('#scanner-status').text("Scanner Aktif");
                } catch (err) {
                    $('#scanner-status').text("Gagal: " + err);
                    try {
                         if (html5QrCode) await html5QrCode.start({ facingMode: "user" }, { fps: 20, qrbox: { width: 250, height: 250 } }, onDetected);
                    } catch (e2) {
                         showScannerToast("Tidak dapat mengakses kamera: " + e2, "danger");
                    }
                }
            }

            function onDetected(decodedText) {
                // Validation for tagInput (VIN) must have 'X' suffix
                if (activeInputId === 'tagInput') {
                    if (!manualMode && !decodedText.trim().toUpperCase().endsWith('X')) {
                        showScannerToast("KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)", "danger");
                        $('#tagInput').val('');
                        scannerModal.hide();
                        return;
                    }
                    // Validation successful, keep X for visual
                    decodedText = decodedText.trim();
                }
                
                // Validation for Label: Must NOT end with 'X'
                if (activeInputId === 'labelInput') {
                    if (!manualMode && decodedText.trim().toUpperCase().endsWith('X')) {
                        showScannerToast("KODE TIDAK VALID: Label tidak boleh mengandung suffix X", "danger");
                        resetLabelOnly();
                        scannerModal.hide();
                        return;
                    }
                }
                
                // (Validation for Kanban suffix remains optional/flexible)

                // Validasi VIN-in-Label saat scan kamera pada field Label
                if (activeInputId === 'labelInput') {
                    const scannedLabel = decodedText.trim().toUpperCase();
                    const tagValForCam = $('#tagInput').val().trim().toUpperCase().replace(/X$/, '').replace(/LB$/, '').replace(/^LB/, '');
                    if (!isLabelMatch(tagValForCam, scannedLabel)) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), decodedText.trim(), '', `Label tidak mengandung VIN: ${tagValForCam}`);
                        showScannerToast(`❌ LABEL TIDAK VALID! Label harus mengandung kode VIN: "${tagValForCam}". Scan ulang label yang benar.`, "danger");
                        scannerModal.hide();
                        resetLabelOnly();
                        return;
                    }
                }

                // FIX ARIA HIDDEN: Focus OUT of the modal immediately.
                if (activeInputId) {
                    const $input = $(`#${activeInputId}`);
                    $input.val(decodedText).addClass('active-scan');
                    $input.prop('disabled', false).focus(); // Ensure it's enabled before focusing
                } else {
                    $('#tagInput').focus();
                }
                
                // Delay hiding to let the focus event propagate
                setTimeout(() => {
                    scannerModal.hide();
                    performLookup();
                }, 150);
            }

            async function stopScanner() {
                if (html5QrCode && html5QrCode.isScanning) await html5QrCode.stop();
            }

            // --- INPUT LOGIC ---

            function checkAndAdvance() {
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) { $('#tagInput').focus(); return; }
                if (!label && !$('#labelInput').prop('disabled')) { $('#labelInput').focus(); return; }
                if (!kanban && !$('#kanbanInput').prop('disabled')) { $('#kanbanInput').focus(); return; }

                if (tag && label && kanban) {
                    // Validasi kanban via server (performLookup) sebelum auto-save
                    // performLookup akan panggil triggerPrepAutoSave() jika kanban valid
                    // atau resetKanbanOnly() jika kanban tidak sesuai
                    performLookup();
                }
            }

            // ── CORE SAVE FUNCTION ──────────────────────────────────────────────────
            // Dipanggil langsung oleh performLookup/checkAndAdvance (mode scan)
            // atau oleh klik tombol (mode manual). Tidak bergantung pada state tombol.
            function doSave() {
                if (isReadOnly) return;

                // Baca langsung dari DOM saat save agar tidak bergantung pada state variable
                const _tdEl = document.getElementById('targetDateInput');
                const _tdVal = _tdEl ? _tdEl.value : '';
                const _todayStr = new Date().toISOString().split('T')[0];
                // Selalu kirim tanggal — default hari ini jika operator tidak pilih / lupa pilih tanggal
                const _effectiveTargetDate = _tdVal || _todayStr;

                const data = {
                    Tag: $('#tagInput').val().trim(),
                    Label: $('#labelInput').val().trim(),
                    Kanban: $('#kanbanInput').val().trim(),
                    SkipStockValidation: skipStockMode,
                    ManifestNumber: currentManifestNumber || null,
                    DockName: selectedDock ? selectedDock.dockName : null,
                    DockCycle: selectedDock ? selectedDock.cycle : null,
                    DockCustomerId: selectedDock ? selectedDock.customerId : null,
                    TargetDate: _effectiveTargetDate,
                    Rack: lockedRackInfo ? lockedRackInfo.rack : null,
                    Column: lockedRackInfo ? lockedRackInfo.noRack : null
                };

                if (isTwoPointCheck) {
                    data.Kanban = 'TWO-POINT-CHECK';
                }

                if (!data.Tag || !data.Label || !data.Kanban) return;

                // Validasi client-side label: label harus mengandung kode VIN (mendukung relaksasi MS-series)
                const tagNormDs = data.Tag.toUpperCase().replace(/X$/, '').replace(/LB$/, '').replace(/^LB/, '');
                if (!isLabelMatch(tagNormDs, data.Label)) {
                    logNGScan('Preparation', data.Tag, data.Label, data.Kanban, `Label tidak mengandung VIN: ${tagNormDs}`);
                    showScannerToast(`❌ LABEL TIDAK VALID! Label harus mengandung kode VIN: "${tagNormDs}". Scan ulang label yang benar.`, "danger");
                    resetLabelOnly();
                    return;
                }

                if (manualMode) {
                    // ── Mode manual: blocking ajax (user klik tombol manual) ──
                    if (isSubmitting) return;
                    isSubmitting = true;
                    const $btn = $('#btnSavePreparation');
                    $btn.prop('disabled', true);
                    $('#prepLoadingIndicator').show();

                    $.ajax({
                        url: '@Url.Action("Save", "PreparationWorkflow")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (res) {
                            isSubmitting = false;
                            $btn.prop('disabled', false);
                            $('#prepLoadingIndicator').hide();
                            if (res.success) {
                                if (res.isPending) {
                                    var notif = document.getElementById('pendingSaveNotif');
                                    notif.style.display = 'block';
                                    clearTimeout(notif._autoHide);
                                    notif._autoHide = setTimeout(function() { notif.style.display = 'none'; }, 5000);
                                } else {
                                    showScannerToast(res.message, res.isAlreadyComplete ? "warning" : "success");
                                    if (res.scheduleDetails) {
                                        $('#progressTargetName').text(res.scheduleDetails.customerName);
                                        $('#progressPercentTotal').text(Math.round(res.scheduleDetails.totalPercent) + '%');
                                        $('#progressDetailArea').fadeIn();
                                        setTimeout(() => $('#progressDetailArea').fadeOut(), 3000);
                                    }
                                }
                                resetInputs();
                            } else {
                                logNGScan('Preparation', data.Tag, data.Label, data.Kanban, res.message || 'Server error (Manual Mode)');
                                showScannerToast(res.message, "danger");
                                if (res.message) {
                                    if (res.message.includes('sudah pernah di-scan')) resetLabelAndKanban();
                                    else if (res.message.includes('KANBAN') || res.message.includes('Kanban')) resetKanbanOnly();
                                    else if (res.message.includes('LABEL') || res.message.includes('Label')) resetLabelOnly();
                                    else resetInputs();
                                } else resetInputs();
                            }
                        },
                        error: function() {
                            isSubmitting = false;
                            $btn.prop('disabled', false);
                            $('#prepLoadingIndicator').hide();
                            logNGScan('Preparation', data.Tag, data.Label, data.Kanban, "Connection Error (Manual Save)");
                            showScannerToast("Connection Error", "danger");
                        }
                    });
                } else {
                    // ── Mode scan: masukkan ke queue, RESET FORM LANGSUNG ──
                    // Operator bisa langsung scan item berikutnya tanpa menunggu response server
                    ScanQueue.push(data);
                    resetInputs(); // Reset segera → siap scan item berikutnya
                }
            }

            function triggerPrepAutoSave() {
                doSave();
            }

            $('#tagInput, #labelInput, #kanbanInput').on('change keypress', function(e) {
                // Prevent duplicate trigger if Enter is pressed (Internal Scanner)
                if(e.type === 'change' && $(this).data('last-event') === 'keypress') {
                    $(this).data('last-event', '');
                    return;
                }
                if(e.type === 'keypress') {
                    $(this).data('last-event', 'keypress');
                    if(e.which !== 13) return;
                }
                
                const id = $(this).attr('id');
                if (id === 'kanbanInput') {
                    checkAndAdvance();
                } else {
                    performLookup();
                }
            });

            function resetInputs() {
                const isFastMode = $('#fastScanMode').is(':checked');
                
                // Restore state base on selected dock
                isTwoPointCheck = (selectedDock && selectedDock.isTwoPointCheck) ? true : false;
                
                if (isTwoPointCheck) {
                    $('#kanbanInput').parent().parent().hide();
                    $('#kanbanInput').val('TWO-POINT-CHECK');
                } else {
                    $('#kanbanInput').parent().parent().show();
                    $('#kanbanInput').val('');
                }

                $('#idStatusSection').slideUp();
                $('#tagInput, #labelInput').val('').removeClass('active-scan');
                if (!isTwoPointCheck) $('#kanbanInput').removeClass('active-scan');

                if (manualMode) {
                    // Manual mode: semua field tetap editable & enabled
                    $('#tagInput, #labelInput, #kanbanInput').prop('readonly', false).prop('disabled', false);
                    $('.btn-scan-trigger').prop('disabled', false);
                    $('#btnSavePreparation').text('SIMPAN DATA').show();
                    currentScheduleId = null;
                    currentManifestNumber = null;
                    $('#tagInput').focus();
                    return;
                }

                // Mode scan: restore readonly & sembunyikan tombol save
                $('#tagInput, #labelInput, #kanbanInput').prop('readonly', true);
                $('#btnSavePreparation').hide().text('SIMPAN DATA');
                if (!isFastMode) {
                    $('#labelInput, #kanbanInput, .btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', true);
                } else {
                    $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                }
                
                currentScheduleId = null;
                currentManifestNumber = null;
                $('#tagInput').focus();
            }

            // Reset hanya kanban (untuk error kanban saja)
            // Berlaku untuk SEMUA mode: scan cepat, scan biasa, manual, semua role
            function resetKanbanOnly() {
                $('#kanbanInput').val('').removeClass('active-scan');
                // Enable field agar scanner bisa input, tapi TETAP readonly di scan mode (cegah ketik manual)
                $('#kanbanInput').prop('disabled', false);
                if (manualMode) {
                    $('#kanbanInput').prop('readonly', false);
                }
                // Focus kembali untuk scan kanban berikutnya
                setTimeout(() => $('#kanbanInput').focus(), 100);
            }

            // Reset hanya label (untuk error label — tag & kanban tetap)
            // Berlaku untuk SEMUA mode: scan cepat, scan biasa, manual, semua role
            function resetLabelOnly() {
                $('#labelInput').val('').removeClass('active-scan');
                // Enable field agar scanner bisa input, tapi TETAP readonly di scan mode (cegah ketik manual)
                $('#labelInput').prop('disabled', false);
                $('.btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);
                if (manualMode) {
                    $('#labelInput').prop('readonly', false);
                }
                setTimeout(() => $('#labelInput').focus(), 100);
            }

            // Reset Label dan Kanban (digunakan saat error label duplikat)
            function resetLabelAndKanban() {
                $('#labelInput').val('').removeClass('active-scan');
                $('#labelInput').prop('disabled', false);
                $('.btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);
                
                if (!isTwoPointCheck) {
                    $('#kanbanInput').val('').removeClass('active-scan');
                    $('#kanbanInput').prop('disabled', false);
                }
                
                if (manualMode) {
                    $('#labelInput').prop('readonly', false);
                    if (!isTwoPointCheck) $('#kanbanInput').prop('readonly', false);
                }
                setTimeout(() => $('#labelInput').focus(), 100);
            }

            function performLookup() {
                const isFastMode = $('#fastScanMode').is(':checked');
                let tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) return;

                // Validation for External Scanner: Must end with 'X' — dilewati di manual mode
                if (!manualMode && tag && !label && !kanban) {
                    if (!tag.toUpperCase().endsWith('X') && tag.length > 5) {
                         showScannerToast("KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)", "danger");
                         $('#tagInput').val('').focus();
                         return;
                    }
                }
                
                // Validation for Label: Must NOT end with 'X'
                if (!manualMode && label && label.toUpperCase().endsWith('X')) {
                    showScannerToast("KODE TIDAK VALID: Label tidak boleh mengandung suffix X", "danger");
                    resetLabelOnly();
                    return;
                }
                // (Validation for Kanban suffix remains optional/flexible)

                $.ajax({
                    url: '@Url.Action("LookupSchedule", "PreparationWorkflow")',
                    type: 'GET',
                    data: { 
                        tag: tag, label: label, kanban: kanban, 
                        skipStockValidation: skipStockMode, manifestNumber: null,
                        dockCustomerId: selectedDock ? selectedDock.customerId : null,
                        dockCycle: selectedDock ? selectedDock.cycle : null
                    },
                    success: function(res) {
                        if (res.success) {
                            if (res.found) {
                                currentScheduleId = res.schedule.scheduleId;
                                currentManifestNumber = res.schedule.scheduleNumber; // Simpan manifest untuk dikirim saat save
                                $('#idStatusSection').slideDown();
                                let foundHtml = `Ditemukan: ${res.schedule.customerName} <br><small class='text-warning fw-bold'>STOCK: ${res.item.currentStock || 0} BOX</small>`;
                                if (res.item.externalPartNos && res.item.externalPartNos.length > 0) {
                                    foundHtml += `<br><small class='text-info'>Kanban Ext: ${res.item.externalPartNos.map(p => `<span class='badge bg-info text-dark me-1'>${p}</span>`).join('')}</small>`;
                                }
                                $('#idStatusText').html(foundHtml);
                                $('#idTargetInfo').text(res.schedule.scheduleNumber);
                                
                                // ── HANDLING TWO POINT CHECK ──
                                isTwoPointCheck = res.isTwoPointCheck || false;
                                if (isTwoPointCheck) {
                                    $('#kanbanInput').parent().parent().hide(); // Sembunyikan field kanban
                                    $('#kanbanInput').val('TWO-POINT-CHECK'); // Marker khusus
                                } else {
                                    $('#kanbanInput').parent().parent().show();
                                }

                                // Enable All
                                $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);

                                // Auto Advance: Focus next field for External Scanner
                                const delay = isFastMode ? 50 : 300;
                                if (tag && label && (isTwoPointCheck || kanban)) {
                                    triggerPrepAutoSave();
                                } else if (tag && label) {
                                    if (!isTwoPointCheck) setTimeout(() => $('#kanbanInput').focus(), delay);
                                } else if (tag) {
                                    setTimeout(() => $('#labelInput').focus(), delay);
                                }

                            } else if (res.item) {
                                // Partial Match / Step
                                isTwoPointCheck = res.isTwoPointCheck || false;
                                if (isTwoPointCheck) {
                                    $('#kanbanInput').parent().parent().hide();
                                    $('#kanbanInput').val('TWO-POINT-CHECK');
                                } else {
                                    $('#kanbanInput').parent().parent().show();
                                }
                                
                                // Handle Specific Validation Failures (Kanban mismatch) — tetap blokir
                                if (res.message && (res.message.includes("tidak sesuai") || res.message.includes("tidak cocok") || res.message.includes("TIDAK VALID") || res.message.includes("KANBAN"))) {
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                    showScannerToast(res.message, "danger");
                                    if (res.step === 'kanban') {
                                        resetKanbanOnly(); // Smart reset: kanban only, keep tag & label
                                    }
                                    return; 
                                }

                                $('#idStatusSection').slideDown();
                                $('#idStatusText').html(`Item: ${res.item.itemName} <br><small class='text-warning fw-bold'>STOCK: ${res.item.currentStock || 0} BOX</small>`);
                                $('#idTargetInfo').text(res.item.vin);

                                // Tampilkan external PartNo dari ItemMappings (jika ada)
                                if (res.item.externalPartNos && res.item.externalPartNos.length > 0) {
                                    const extBadges = res.item.externalPartNos.map(p => `<span class='badge bg-warning text-dark me-1'>${p}</span>`).join('');
                                    $('#idStatusText').append(`<br><small class='text-warning'>Kanban expected: ${extBadges}</small>`);
                                    // Update placeholder kanban agar user tahu apa yang di-scan
                                    const hintCodes = res.item.externalPartNos.join(' / ');
                                    $('#kanbanInput').attr('placeholder', `Scan kanban (${hintCodes})`);
                                } else {
                                    $('#kanbanInput').attr('placeholder', 'Scan Kanban');
                                }

                                // --- STEP FINAL: semua field terisi tapi jadwal tidak ditemukan ---
                                // Auto-save sebagai PENDING langsung tanpa perlu klik tombol
                                if (res.step === 'final') {
                                    $('#idStatusText').append(`<br><span class='badge bg-warning text-dark mt-1'><i class='bi bi-clock-history me-1'></i>JADWAL BELUM ADA — menyimpan sebagai PENDING...</span>`);
                                    if (manualMode) {
                                        // Mode manual: tampilkan tombol, user klik sendiri
                                        $('#btnSavePreparation').text('💾 Simpan Sebagai PENDING').show();
                                    } else {
                                        // Mode scan: simpan otomatis ke queue, reset form langsung
                                        const delayPending = isFastMode ? 50 : 300;
                                        setTimeout(() => doSave(), delayPending);
                                    }
                                    return;
                                }

                                // ── CARD LOKASI: tampilkan/update berdasarkan rack info dari server ──
                                // Hanya saat VIN baru di-scan (label masih kosong)
                                if (!label && res.rackLocations && res.rackLocations.length > 0) {
                                    const proceed = handleLocationCard(res.rackLocations);
                                    if (!proceed) return; // multi-rack: label akan di-enable setelah user pilih rak dari modal
                                }

                                // Always enable Label if Tag is valid
                                $('#labelInput, .btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);

                                // Focus next field for External Scanner
                                const delay = isFastMode ? 50 : 300;
                                if (label) {
                                    if (isTwoPointCheck) {
                                        triggerPrepAutoSave();
                                    } else {
                                        $('#kanbanInput, .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', false);
                                        setTimeout(() => $('#kanbanInput').focus(), delay);
                                    }
                                } else {
                                    setTimeout(() => $('#labelInput').focus(), delay);
                                }
                            } else {
                                // Tidak found, tidak ada item — bisa jadi validasi error dari server
                                // (mis: label tidak mengandung VIN, step:"label")
                                if (res.message) {
                                    if (res.step === 'label') {
                                        logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), '', res.message);
                                        resetLabelOnly(); // Smart reset: keep tag & kanban
                                    } else if (res.step === 'kanban') {
                                        logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                        resetKanbanOnly(); // Smart reset: keep tag & label
                                    } else {
                                        // TAG tidak dikenal — reset semua
                                        logNGScan('Preparation', $('#tagInput').val().trim(), '', '', res.message);
                                        resetInputs();
                                        $('#tagInput').val('');
                                    }
                                    showScannerToast(res.message, "danger");
                                } else {
                                    resetInputs();
                                    $('#tagInput').val('');
                                }
                            }
                        } else {
                            // Server menolak (success: false) — Smart reset berdasarkan jenis error
                            if (res.message) {
                                showScannerToast(res.message, "danger");
                                if (res.message.includes('KANBAN') || res.message.includes('Kanban')) {
                                    // Error kanban → reset hanya kanban
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                    resetKanbanOnly();
                                } else if (res.message.includes('LABEL') || res.message.includes('Label')) {
                                    // Error label → reset label & kanban
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), '', res.message);
                                    resetLabelOnly();
                                } else {
                                    // Error kritis (TAG/VIN tidak dikenal, STOCK HABIS, dll) → reset semua
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                    resetInputs();
                                    $('#tagInput').val('');
                                }
                            } else {
                                resetInputs();
                                $('#tagInput').val('');
                            }
                        }
                    },
                    error: function() {
                         logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), "Gagal menghubungi server (Lookup Error)");
                         showScannerToast("Gagal menghubungi server.", "danger");
                         resetInputs();
                         $('#tagInput').val(''); // --- AUTO RESET ---
                    }
                });
            }

            $('#btnSavePreparation').click(function () {
                doSave();
            });

            // Error Modal (untuk danger) — MANUAL CLOSE ONLY (tidak auto-close)
            let scanBlocked = false;
            const $errModal = $('<div class="modal fade" id="scanErrorModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index:2100"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" style="background:#1e293b;border:2px solid #ef4444;border-radius:12px;"><div class="modal-body text-center py-4 px-4"><div style="font-size:3rem;color:#ef4444;" class="mb-3"><i class="bi bi-x-circle-fill"></i></div><h5 class="fw-bold text-white mb-3" id="scanErrorTitle">SCAN TIDAK VALID</h5><p class="text-white-50 mb-3" id="scanErrorMsg"></p><button type="button" class="btn btn-danger px-5 py-2 fw-bold" id="btnCloseScanError"><i class="bi bi-check-lg me-2"></i>Tutup</button></div></div></div></div>');
            $('body').append($errModal);
            const scanErrorModal = new bootstrap.Modal(document.getElementById('scanErrorModal'));
            $('#btnCloseScanError').on('click', function() {
                scanErrorModal.hide();
            });
            document.getElementById('scanErrorModal').addEventListener('hidden.bs.modal', function() {
                scanBlocked = false;
                
                const errMsg = $('#scanErrorMsg').text() || '';
                
                // Jika error adalah label duplikat/pernah discan: reset Label & Kanban, lalu fokus ke Label
                if (errMsg.includes('sudah pernah di-scan')) {
                    $('#labelInput').val('').removeClass('active-scan').prop('disabled', false);
                    if (!isTwoPointCheck) {
                        $('#kanbanInput').val('').removeClass('active-scan').prop('disabled', false);
                    }
                    if (manualMode) {
                        $('#labelInput').prop('readonly', false);
                        if (!isTwoPointCheck) $('#kanbanInput').prop('readonly', false);
                    }
                    setTimeout(() => $('#labelInput').focus(), 100);
                } 
                // Jika error spesifik Kanban: fokus kembali ke Kanban
                else if (errMsg.includes('KANBAN') || errMsg.includes('Kanban') || errMsg.includes('kanban')) {
                    setTimeout(() => $('#kanbanInput').focus(), 100);
                } 
                // Jika error spesifik Label: fokus kembali ke Label
                else if (errMsg.includes('LABEL') || errMsg.includes('Label') || errMsg.includes('label')) {
                    setTimeout(() => $('#labelInput').focus(), 100);
                } 
                // Default: kembali ke awal (Tag)
                else {
                    setTimeout(() => $('#tagInput').focus(), 100);
                }
            });

            // Notification Helper
            function showScannerToast(message, type = 'primary') {
                if (type === 'danger') {
                    // Tampilkan error modal — scan diblokir
                    scanBlocked = true;
                    $('#scanErrorMsg').text(message);
                    $(document.activeElement).blur(); // FIX aria-hidden warning
                    scanErrorModal.show();
                    return;
                }
                // Use high-contrast global toast for success/warning/info
                if (window.showScanToast) {
                    window.showScanToast(message, type, 3500);
                    return;
                }
                // Fallback ke Bootstrap toast
                const $toast = $('#scannerToast');
                $toast.removeClass('bg-primary bg-success bg-danger bg-warning');
                $toast.addClass('bg-' + type);
                $('#scannerToastBody').text(message);
                const toast = new bootstrap.Toast($toast[0], { delay: 3000, autohide: true });
                toast.show();
            }

            function logNGScan(module, tag, label, kanban, reason) {
                fetch('@Url.Action("LogNG", "PreparationWorkflow")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        Module: module, 
                        Tag: tag, 
                        Label: label, 
                        Kanban: kanban, 
                        Reason: reason 
                    })
                }).catch(() => {}); // silent — jangan block UI
            }

            // Global click to refocus for external scanners
            $(document).click(function(e) {
                if (!$(e.target).closest('input, button, select, textarea').length) {
                    // Cek jika dock sudah dipilih
                    if (typeof selectedDock !== 'undefined' && selectedDock) {
                        if ($('#kanbanInput').is(':visible') && !$('#kanbanInput').prop('disabled')) {
                            $('#kanbanInput').focus();
                        } else if ($('#labelInput').is(':visible') && !$('#labelInput').prop('disabled')) {
                            $('#labelInput').focus();
                        } else {
                            $('#tagInput').focus();
                        }
                    } else if ($('#dockSelect').is(':visible')) {
                        // Jika belum ada dock, fokus ke dropdown dock
                        $('#dockSelect').focus();
                    }
                }
            });

            // Visual feedback for focus
            $('input').on('focus', function() {
                $(this).closest('.custom-cyber-input-group').addClass('selected-glow');
            }).on('blur', function() {
                $(this).closest('.custom-cyber-input-group').removeClass('selected-glow');
            });

            // --- FLOATING BUTTON & SCHEDULE MODAL LOGIC ---
            const scheduleModal = new bootstrap.Modal(document.getElementById('scheduleModal'));
            
            $('#btnShowSchedule').click(function() {
                scheduleModal.show();
                loadScheduleList();
            });

            // Filter Event Listeners
            let filterTimeout;
            $('#filterSchedDate, #filterSchedVin').on('input change', function() {
                clearTimeout(filterTimeout);
                filterTimeout = setTimeout(loadScheduleList, 500);
            });

            function loadScheduleList() {
                const date = $('#filterSchedDate').val();
                const vin = $('#filterSchedVin').val();

                $('#scheduleListBody').html(`
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="spinner-border text-yellow" role="status"></div>
                            <div class="mt-2">Memuat data...</div>
                        </td>
                    </tr>
                `);

                $.ajax({
                    url: '@Url.Action("GetSchedulesJson", "PreparationWorkflow")',
                    type: 'GET',
                    data: { filterDate: date, vin: vin },
                    success: function(data) {
                        let html = '';
                        let countPrep = 0;
                        let countWait = 0;
                        let countComp = 0;

                        if (data && data.length > 0) {
                            data.forEach(item => {
                                let statusClass = 'bg-secondary';
                                let statusText = item.status || 'Waiting';
                                
                                if (statusText === 'Completed') {
                                    statusClass = 'bg-success';
                                    countComp++;
                                } else if (statusText === 'Preparing') {
                                    statusClass = 'bg-warning text-dark';
                                    countPrep++;
                                } else {
                                    statusClass = 'bg-secondary';
                                    countWait++;
                                }

                                // Kanban Fraction Display
                                let actual = item.totalKanbanActual || 0;
                                let target = item.totalKanbanTarget || 0;
                                let progressClass = 'bg-info text-dark';
                                if (actual >= target && target > 0) progressClass = 'bg-success text-white';

                                html += `
                                    <tr>
                                        <td class="p-2">
                                            <small class="fw-bold text-info">${item.scheduleNumber}</small>
                                        </td>
                                        <td class="p-2">
                                            <small class="fw-bold">${item.customerName}</small><br>
                                            <small class="text-muted"><i class="bi bi-geo-alt"></i> ${item.dock}</small>
                                        </td>
                                        <td class="p-2">
                                            <span class="text-warning fw-bold">${item.viNs || '-'}</span>
                                        </td>
                                        <td class="p-2 text-center">
                                            <small>${item.qtyPcs || 0} Pcs</small><br>
                                            <small class="text-muted">${item.qtyLot || '-'} /lot</small>
                                        </td>
                                        <td class="p-2 text-center">
                                            <span class="badge ${progressClass}" style="min-width:45px; font-size:0.75rem;">${actual.toFixed(0)} / ${target.toFixed(0)}</span>
                                        </td>
                                        <td class="p-2 text-center">
                                            <span class="badge ${statusClass}" style="font-size: 0.7rem;">${statusText}</span>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="6" class="text-center py-4 text-muted fst-italic">Tidak ada jadwal ditemukan.</td></tr>';
                        }
                        $('#scheduleListBody').html(html);

                        // Update Modal Indicators
                        $('#modal-prep-count').text(countPrep);
                        $('#modal-wait-count').text(countWait);
                        $('#modal-done-count').text(countComp);

                    },
                    error: function() {
                        $('#scheduleListBody').html('<tr><td colspan="6" class="text-center py-4 text-danger">Gagal memuat data.</td></tr>');
                    }
                });
            }
            // --- RESTORE TOGGLE STATE dari localStorage ---
            // fastScanMode: default ON (null = belum pernah disimpan → anggap ON)
            const savedFast = localStorage.getItem(LS_FAST);
            if (savedFast === null || savedFast === '1') {
                $('#fastScanMode').prop('checked', true);
                $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                setTimeout(() => $('#tagInput').focus(), 100);
            } else {
                $('#fastScanMode').prop('checked', false);
            }

            // skipStockMode: restore dari server Session (sumber kebenaran) — Admin aktifkan, semua role ikut
            // Nilai dari ViewData["SkipStockActive"] sudah di-render di indicator banner (show/hide oleh server)
            // Sync variable JS dan checkbox Admin agar konsisten
            const serverSkipActive = @(skipStockActive ? "true" : "false");
            if (serverSkipActive) {
                skipStockMode = true;
                localStorage.setItem(LS_SKIP, '1');
                $('#skipStockMode').prop('checked', true);
                // Indicator sudah tampil dari server-side render (style display:block)
            } else if (localStorage.getItem(LS_SKIP) === '1') {
                // localStorage bilang aktif tapi server bilang tidak → ikut server (reset localStorage)
                localStorage.setItem(LS_SKIP, '0');
            }

            // validateProdIntLabelMode: restore dari server Session
            const serverValidateProdIntActive = @(ViewData["ValidateProdIntLabelActive"] is bool va && va ? "true" : "false");
            validateProdIntLabelMode = serverValidateProdIntActive;
            if (serverValidateProdIntActive) {
                localStorage.setItem(LS_VALIDATE_LBL, '1');
                $('#validateProdIntLabelMode').prop('checked', true);
            } else {
                localStorage.setItem(LS_VALIDATE_LBL, '0');
                $('#validateProdIntLabelMode').prop('checked', false);
            }

            // manualInputMode: default OFF
            // SECURITY: Hanya restore manual mode jika user adalah Admin.
            // Jika bukan Admin, paksa clear localStorage agar tidak bisa aktif dari sisa sesi Admin sebelumnya.
            const isAdminUser = @(ViewData["IsAdmin"] is bool isAdminJs && isAdminJs ? "true" : "false");
            if (!isAdminUser) {
                // Non-admin: pastikan manual mode SELALU off & hapus dari localStorage
                localStorage.removeItem(LS_MANUAL);
                manualMode = false;
            } else if (localStorage.getItem(LS_MANUAL) === '1') {
                $('#manualInputMode').prop('checked', true);
                manualMode = true;
                $('#manualModeIndicator').show();
                $('#fastScanMode').prop('disabled', true).closest('.form-check').css('opacity', 0.4);
                $('#tagInput, #labelInput, #kanbanInput').prop('readonly', false).prop('disabled', false);
                $('.btn-scan-trigger').prop('disabled', false);
                $('#btnSavePreparation').show();
                $('#tagInput').attr('placeholder', 'Ketik Barcode Rak...');
                $('#labelInput').attr('placeholder', 'Ketik Barcode Label...');
                $('#kanbanInput').attr('placeholder', 'Ketik Barcode Kanban...');
                setTimeout(() => $('#tagInput').focus(), 100);
            }

            $('#fastScanMode').change(function() {
                const checked = $(this).is(':checked');
                localStorage.setItem(LS_FAST, checked ? '1' : '0');
                if (checked) {
                    $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                    // Fokus ke tagInput agar scanner langsung bisa scan
                    setTimeout(() => $('#tagInput').focus(), 50);
                } else {
                    // Reset if turned off and inputs are empty
                    if (!$('#tagInput').val()) resetInputs();
                }
            });

            // --- MANUAL INPUT MODE (Admin Only) ---
            $('#manualInputMode').change(function() {
                // SECURITY: Double-check server-side role (checkbox tidak muncul untuk non-Admin, tapi guard tetap diperlukan)
                if (!isAdminUser) {
                    $(this).prop('checked', false);
                    localStorage.removeItem(LS_MANUAL);
                    return;
                }
                manualMode = $(this).is(':checked');
                localStorage.setItem(LS_MANUAL, manualMode ? '1' : '0');
                if (manualMode) {
                    $('#manualModeIndicator').slideDown();
                    // Nonaktifkan fastScanMode saat manual mode aktif
                    $('#fastScanMode').prop('disabled', true).closest('.form-check').css('opacity', 0.4);
                    // Hapus readonly & enable semua field
                    $('#tagInput, #labelInput, #kanbanInput').prop('readonly', false).prop('disabled', false);
                    $('.btn-scan-trigger').prop('disabled', false);
                    // Tampilkan tombol simpan selalu
                    $('#btnSavePreparation').show();
                    // Update placeholder hint
                    $('#tagInput').attr('placeholder', 'Ketik Barcode Rak...');
                    $('#labelInput').attr('placeholder', 'Ketik Barcode Label...');
                    $('#kanbanInput').attr('placeholder', 'Ketik Barcode Kanban...');
                    $('#tagInput').focus();
                } else {
                    $('#manualModeIndicator').slideUp();
                    $('#fastScanMode').prop('disabled', false).closest('.form-check').css('opacity', 1);
                    // Kembalikan placeholder asli
                    $('#tagInput').attr('placeholder', 'Scan Barcode Rak...');
                    $('#labelInput').attr('placeholder', 'Scan Barcode Label...');
                    $('#kanbanInput').attr('placeholder', 'Scan Barcode Kanban...');
                    // Reset ke mode scan
                    resetInputs();
                }
            });

            // --- SKIP STOCK VALIDATION MODE (Admin Only toggle — berlaku untuk semua role via Session server) ---
            $('#skipStockMode').change(function() {
                skipStockMode = $(this).is(':checked');
                localStorage.setItem(LS_SKIP, skipStockMode ? '1' : '0');
                // Simpan ke server Session agar role Preparation pun ikut bypass
                $.ajax({
                    url: '@Url.Action("SetSkipStockMode", "PreparationWorkflow")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ active: skipStockMode })
                });
                if (skipStockMode) {
                    $('#skipStockIndicator').slideDown();
                } else {
                    $('#skipStockIndicator').slideUp();
                }
            });

            // --- VALIDASI LABEL PROD INT MODE (Admin Only toggle) ---
            $('#validateProdIntLabelMode').change(function() {
                validateProdIntLabelMode = $(this).is(':checked');
                localStorage.setItem(LS_VALIDATE_LBL, validateProdIntLabelMode ? '1' : '0');
                $.ajax({
                    url: '@Url.Action("SetValidateProdIntLabelMode", "PreparationWorkflow")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ active: validateProdIntLabelMode })
                });
            });

            // --- TANGGAL JADWAL SCAN KE DEPAN (TargetDate) ---
            (function initTargetDate() {
                const PREP_TARGET_DATE_KEY = 'prep_targetDate';
                function updateTargetDateUI(val) {
                    const todayVal = new Date().toISOString().split('T')[0];
                    const isFuture = val && val > todayVal;
                    const isPast   = val && val < todayVal;
                    selectedTargetDate = (val && val !== todayVal) ? val : null;
                    sessionStorage.setItem(PREP_TARGET_DATE_KEY, val || todayVal);
                    $('#badgeTodayDate').toggle(!isFuture && !isPast);
                    $('#badgePastDate').toggle(!!isPast);
                    $('#badgeFutureDate').toggle(!!isFuture);
                    $('#pastDateNote').toggle(!!isPast);
                    $('#futureDateNote').toggle(!!isFuture);
                }
                $('#targetDateInput').on('change', function() { updateTargetDateUI($(this).val()); });
                // Default ke hari ini; restore dari sessionStorage hanya jika nilainya >= hari ini
                // (past date di sessionStorage diabaikan agar default selalu Hari Ini)
                const todayVal = new Date().toISOString().split('T')[0];
                const h2 = new Date(); h2.setDate(h2.getDate() - 2);
                const h2Str = h2.toISOString().split('T')[0]; // dipakai oleh min attribute via Razor
                const saved = sessionStorage.getItem(PREP_TARGET_DATE_KEY);
                const initVal = (saved && saved >= todayVal) ? saved : todayVal;
                $('#targetDateInput').val(initVal);
                updateTargetDateUI(initVal);
            })();

            // --- FOCUS RECOVERY ---
            setInterval(function() {
                if (typeof manualMode !== 'undefined' && manualMode) return;
                if ($('.modal.show').length > 0) return;
                const $focused = $(document.activeElement);
                
                // Jangan tarik fokus jika user sedang klik dropdown atau tombol
                if ($focused.is('select') || $focused.is('button') || $focused.is('textarea')) return;

                if (!$focused.hasClass('cyber-field') && !$focused.is('input[type=text]')) {
                    // Jika dock sudah dipilih, fokus ke input scan
                    if (typeof selectedDock !== 'undefined' && selectedDock) {
                        $('#tagInput').focus();
                    } else if ($('#dockSelect').is(':visible')) {
                        // Jika dock belum dipilih, fokus ke dropdown dock
                        $('#dockSelect').focus();
                    }
                }
            }, 800);

            // ================================================================
            // PENDING SYNC SYSTEM
            // Badge + tombol Synchronize: cocokkan pending scan ke jadwal delay
            // berdasarkan Part No (VIN/CustomerPartNumber/ItemMappings).
            // ================================================================

            // Refresh badge & banner pending count
            async function refreshPendingBanner() {
                try {
                    const res = await fetch('/PreparationSchedule/GetPendingCount');
                    if (!res.ok) return;
                    const data = await res.json();
                    const total = data.total || 0;

                    const banner = document.getElementById('pendingBanner');
                    if (!banner) return;

                    if (total > 0) {
                        banner.style.display = 'block';
                        const elTotal = document.getElementById('pendingTotalCount');
                        if (elTotal) elTotal.textContent = total;
                        const elModalTotal = document.getElementById('modalPendingTotal');
                        if (elModalTotal) elModalTotal.textContent = total;
                    } else {
                        banner.style.display = 'none';
                    }
                } catch (e) {
                    console.warn('refreshPendingBanner error:', e);
                }
            }

            async function loadPendingList(page = 1) {
                document.getElementById('pendingListLoading').style.display = 'block';
                document.getElementById('pendingListEmpty').style.display = 'none';
                document.getElementById('pendingListTableWrap').style.display = 'none';

                // Refresh count juga
                await refreshPendingBanner();

                try {
                    const pageSize = 20;
                    // Baca filter tanggal dari input
                    const dateFrom = (document.getElementById('pendingDateFrom')?.value || '').trim();
                    const dateTo   = (document.getElementById('pendingDateTo')?.value   || '').trim();
                    let url = `@Url.Action("GetPendingPreparations", "PreparationWorkflow")?page=${page}&pageSize=${pageSize}`;
                    if (dateFrom) url += `&dateFrom=${encodeURIComponent(dateFrom)}`;
                    if (dateTo)   url += `&dateTo=${encodeURIComponent(dateTo)}`;
                    url += `&_t=${Date.now()}`;

                    // Ambil data pending records dengan server-side pagination
                    const res = await fetch(url);
                    const resData = await res.json();

                    const records = resData.items || [];
                    const realTotal = resData.total || 0;
                    const totalPages = resData.totalPages || 1;

                    // Ambil data preview (siapa yang bisa di-sync)
                    const countRes = await fetch('/PreparationSchedule/GetPendingCount');
                    const countData = await countRes.json();

                    document.getElementById('pendingListLoading').style.display = 'none';

                    if (!records || records.length === 0) {
                        document.getElementById('pendingListEmpty').style.display = 'block';
                        return;
                    }

                    const start = (page - 1) * pageSize;

                    // Build table rows
                    let html = '';
                    records.forEach((r, i) => {
                        // Remark from kanban: if "TWO-POINT-CHECK" then show 2PC badge
                        const kanbanDisplay = r.kanban === 'TWO-POINT-CHECK'
                            ? `<span class='badge bg-info text-dark'>2-Point</span>`
                            : `<code style='color:#a5f3fc;font-size:0.8rem;'>${escHtml(r.kanban)}</code>`;

                        html += `<tr>
                            <td class='text-center'><input type="checkbox" class="form-check-input pending-item-check" value="${r.preparationId}"></td>
                            <td class='text-white-50 small'>${start + i + 1}</td>
                            <td class='text-white-50 small'>${escHtml(r.createdDate)}</td>
                            <td><span class='badge bg-primary bg-opacity-25 text-primary' style='font-size:0.72rem;'>${escHtml(r.dockName || '-')}</span></td>
                            <td><span class='text-warning-emphasis small'>${escHtml(r.dockCycle || '-')}</span></td>
                            <td><code style='color:#86efac;'>${escHtml(r.tag)}</code></td>
                            <td><span class='text-white-50 small' style='font-size:0.78rem;'>${escHtml(r.label.substring(0, 30))}${r.label.length > 30 ? '\u2026' : ''}</span></td>
                            <td>${kanbanDisplay}</td>
                            <td class='small'>
                                <span style='color:#facc15;font-weight:600;'>${escHtml(r.deliveryDate)}</span>
                                ${r.targetDate ? `<br><span class='badge bg-warning text-dark' style='font-size:0.65rem;padding:2px 6px;'><i class='bi bi-clock-history me-1'></i>Pre-scan</span>` : ''}
                            </td>
                            <td class='text-white-50 small'>${escHtml(r.createdBy)}</td>
                        </tr>`;
                    });

                    document.getElementById('pendingListBody').innerHTML = html;
                    
                    // Attach check logic
                    $('#checkAllPending').prop('checked', false).off('change').on('change', function() {
                        $('.pending-item-check').prop('checked', $(this).is(':checked'));
                    });
                    
                    $('.pending-item-check').off('change').on('change', function() {
                        if ($('.pending-item-check:not(:checked)').length === 0) {
                            $('#checkAllPending').prop('checked', true);
                        } else {
                            $('#checkAllPending').prop('checked', false);
                        }
                    });
                    document.getElementById('pendingListTableWrap').style.display = 'block';

                    // Render pagination jika lebih dari 1 halaman
                    const paginationEl = document.getElementById('pendingListPagination');
                    const pageInfoEl   = document.getElementById('pendingListPageInfo');
                    if (paginationEl) {
                        if (totalPages > 1) {
                            const end = Math.min(start + records.length, realTotal);
                            if (pageInfoEl) pageInfoEl.textContent = `Menampilkan ${start + 1}–${end} dari ${realTotal} data`;

                            let btns = `<button onclick="loadPendingList(${page - 1})" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75rem;"${page <= 1 ? ' disabled' : ''}><i class="bi bi-chevron-left"></i></button>`;
                            let pStart = Math.max(1, page - 2);
                            let pEnd   = Math.min(totalPages, pStart + 4);
                            pStart = Math.max(1, pEnd - 4);
                            for (let p = pStart; p <= pEnd; p++) {
                                const active = p === page ? 'btn-warning text-dark' : 'btn-outline-warning';
                                btns += `<button onclick="loadPendingList(${p})" class="btn btn-sm ${active} py-0 px-2" style="font-size:0.75rem;">${p}</button>`;
                            }
                            btns += `<button onclick="loadPendingList(${page + 1})" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75rem;"${page >= totalPages ? ' disabled' : ''}><i class="bi bi-chevron-right"></i></button>`;
                            const pageBtnsEl = document.getElementById('pendingListPageBtns');
                            if (pageBtnsEl) pageBtnsEl.innerHTML = btns;
                            paginationEl.style.display = 'flex';
                        } else {
                            paginationEl.style.display = 'none';
                        }
                    }

                } catch (e) {
                    document.getElementById('pendingListLoading').style.display = 'none';
                    document.getElementById('pendingListBody').innerHTML =
                        '<tr><td colspan="6" class="text-center text-danger py-4">Gagal memuat data: ' + e.message + '</td></tr>';
                    document.getElementById('pendingListTableWrap').style.display = 'block';
                }
            }

            function escHtml(str) {
                if (!str) return '-';
                return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }

            // Jalankan Sync
            async function doSyncByPartNo(btnEl) {
                if (btnEl) {
                    btnEl.disabled = true;
                    btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing...';
                }
                try {
                    const res = await fetch('/PreparationSchedule/SyncPendingNow', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();

                    if (data.success) {
                        _toast('success', `✅ ${data.message}`);
                        // Reload pending list jika modal terbuka
                        if (document.getElementById('pendingModal').classList.contains('show')) {
                            await loadPendingList();
                        } else {
                            await refreshPendingBanner();
                        }
                        loadScheduleList(); // Refresh jadwal table
                    } else {
                        _toast('warning', `⚠️ ${data.message}`);
                        await refreshPendingBanner();
                    }
                } catch (e) {
                    _toast('danger', 'Sync gagal: ' + e.message);
                } finally {
                    if (btnEl) {
                        btnEl.disabled = false;
                        btnEl.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Synchronize ke Jadwal Delay';
                    }
                }
            }

            // Event: tombol Sync di banner
            const btnSyncBanner = document.getElementById('btnSyncByPartNo');
            if (btnSyncBanner) {
                btnSyncBanner.addEventListener('click', function() {
                    doSyncByPartNo(this);
                });
            }

            // Event: tombol Sync di modal (Selected)
            const btnSyncSelected = document.getElementById('btnSyncSelectedPending');
            if (btnSyncSelected) {
                btnSyncSelected.addEventListener('click', async function() {
                    const checkedIds = $('.pending-item-check:checked').map(function() {
                        return parseInt($(this).val());
                    }).get();

                    const manifest = $('#pendingManifestInput').val().trim();

                    if (checkedIds.length === 0) {
                        showScannerToast("Pilih minimal satu item pending untuk disync.", "warning");
                        return;
                    }

                    if (!manifest) {
                        showScannerToast("Silakan isi No Manifest terlebih dahulu.", "warning");
                        $('#pendingManifestInput').focus();
                        return;
                    }

                    const btnEl = this;
                    btnEl.disabled = true;
                    btnEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing...';

                    try {
                        const res = await fetch('@Url.Action("SyncSelectedPending", "PreparationWorkflow")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ preparationIds: checkedIds, manifestNumber: manifest })
                        });
                        const data = await res.json();

                        if (data.success) {
                            showScannerToast(`Berhasil sync ${data.synced} item ke manifest ${manifest}`, "success");
                            $('#pendingManifestInput').val(''); // Clear input
                            if (document.getElementById('pendingModal').classList.contains('show')) {
                                await loadPendingList(1);
                            } else {
                                await refreshPendingBanner();
                            }
                            loadScheduleList(); // Refresh jadwal table
                        } else {
                            showScannerToast(data.message || "Gagal sinkronisasi.", "danger");
                        }
                    } catch (e) {
                        showScannerToast('Sync gagal: ' + e.message, "danger");
                    } finally {
                        btnEl.disabled = false;
                        btnEl.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Sync Sekarang';
                    }
                });
            }

            // Event: link "Lihat detail" pending
            const linkShowPending = document.getElementById('linkShowPendingList');
            if (linkShowPending) {
                linkShowPending.addEventListener('click', function(e) {
                    e.preventDefault();
                    const modal = new bootstrap.Modal(document.getElementById('pendingModal'));
                    modal.show();
                });
            }

            // Load pending list saat modal dibuka
            document.getElementById('pendingModal').addEventListener('show.bs.modal', function() {
                loadPendingList();
            });

            // SignalR: refresh pending banner saat ada update
            connection.on("pendingCountUpdated", function(data) {
                refreshPendingBanner();
            });

            // Initial load pending banner
            refreshPendingBanner();

            // Initial load of indicators
            loadScheduleList();

            // =====================================================================
            // DOCK SELECTION LOGIC
            // =====================================================================
            async function initDockSelection() {
                try {
                    const res = await fetch('@Url.Action("GetAvailableDocks", "PreparationWorkflow")');
                    const docks = await res.json();
                    const $sel = $('#dockSelect');

                    if (!docks || docks.length === 0) {
                        $sel.html('<option value="">-- Tidak ada dock tersedia --</option>');
                        return;
                    }

                    let opts = '<option value="">-- Pilih Dock untuk Preparation --</option>';
                    docks.forEach(d => {
                        opts += `<option value="${d.customerId}" data-name="${escapeAttr(d.dockName)}" data-cycle="${escapeAttr(d.cycle)}" data-prep="${d.startPrepTime || 0}" data-tpc="${d.isTwoPointCheck ? '1' : '0'}">${d.dockDisplay}</option>`;
                    });
                    $sel.html(opts);

                    // Auto-select if only 1 dock
                    if (docks.length === 1) {
                        $sel.val(docks[0].customerId);
                        applyDockSelection($sel);
                    } else {
                        // Restore pilihan dock dari sesi sebelumnya (localStorage)
                        const savedDockId = localStorage.getItem('prep_selected_dock_id');
                        if (savedDockId) {
                            const $opt = $sel.find(`option[value="${savedDockId}"]`);
                            if ($opt.length > 0) {
                                $sel.val(savedDockId);
                                applyDockSelection($sel);
                            } else {
                                // Dock tidak ada lagi di daftar, hapus dari storage
                                localStorage.removeItem('prep_selected_dock_id');
                            }
                        }
                    }
                } catch(e) {
                    $('#dockSelect').html('<option value="">-- Gagal memuat dock --</option>');
                    console.warn('GetAvailableDocks error:', e);
                }
            }

            $('#dockSelect').on('change', function() {
                applyDockSelection($(this));
            });

            $('#btnChangeDock').on('click', function() {
                selectedDock = null;
                localStorage.removeItem('prep_selected_dock_id');
                $('#dockSelect').val('').show().trigger('focus');
                $('#dockSelectedBar').hide();
                disableScanInputs();
            });

            function applyDockSelection($sel) {
                const val = $sel.val();
                if (!val) {
                    selectedDock = null;
                    localStorage.removeItem('prep_selected_dock_id');
                    $('#dockSelectedBar').hide();
                    disableScanInputs();
                    return;
                }
                // Simpan pilihan dock agar bertahan saat refresh
                localStorage.setItem('prep_selected_dock_id', val);
                const $opt = $sel.find('option:selected');
                selectedDock = {
                    customerId: parseInt(val),
                    dockName: $opt.data('name'),
                    cycle: $opt.data('cycle'),
                    startPrepTime: parseInt($opt.data('prep') || 0),
                    isTwoPointCheck: String($opt.data('tpc')) === '1'
                };
                
                // --- IMMEDIATE UI SWAP FOR TWO POINT CHECK ---
                isTwoPointCheck = selectedDock.isTwoPointCheck;
                if (isTwoPointCheck) {
                    $('#kanbanInput').parent().parent().hide();
                    $('#kanbanInput').val('TWO-POINT-CHECK');
                } else {
                    $('#kanbanInput').parent().parent().show();
                    $('#kanbanInput').val('');
                }

                $('#dockConfirmName').text(selectedDock.dockName);
                const cycleText = (selectedDock.cycle && selectedDock.cycle !== '-') ? `Cycle: ${selectedDock.cycle}` : '';
                const prepText = selectedDock.startPrepTime > 0 ? ` | Start Prep: ${formatPrepMinutes(selectedDock.startPrepTime)}` : '';
                $('#dockConfirmCycle').text(cycleText + prepText);
                $('#dockSelectedBar').show();
                $sel.hide();
                enableScanInputs();
            }

            function enableScanInputs() {
                $('#scanInputsSection').css({ opacity: '1', 'pointer-events': 'auto' });
                resetInputs(); // Sekarang berada di scope yang sama
            }

            function disableScanInputs() {
                $('#scanInputsSection').css({ opacity: '0.4', 'pointer-events': 'none' });
            }

            function formatPrepMinutes(mins) {
                if (!mins || mins <= 0) return '';
                const h = Math.floor(mins / 60);
                const m = mins % 60;
                return h > 0 ? `${h}:${String(m).padStart(2,'0')}` : `${m}:00`;
            }

            function escapeAttr(str) {
                if (!str) return '';
                return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            }

            // Jalankan inisialisasi dock
            initDockSelection();
        });
    </script>
}
