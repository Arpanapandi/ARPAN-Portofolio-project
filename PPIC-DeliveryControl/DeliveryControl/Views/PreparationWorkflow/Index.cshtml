@model IEnumerable<DeliveryControl.Models.DeliverySchedule>
@{
    ViewData["Title"] = "Preparation Workflow Scanner";
    bool isUserRolePrep = ViewData["IsUser"] is bool uPrep && uPrep;
}

<!-- Custom Styles -->
<style>
    :root {
        --cyber-yellow: #facc15;
        --cyber-bg: #0f172a;
        --cyber-card-bg: #1e293b;
        --cyber-border: #334155;
        --cyber-text-muted: #94a3b8;
    }

    body {
        background-color: var(--cyber-bg);
        color: white;
    }

    .scanner-top-bar {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 2rem;
    }

    .custom-cyber-input-group {
        display: flex;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 10px;
        overflow: hidden;
        min-height: 54px; /* Touch-friendly height */
    }
    
    .input-icon-left {
        display: flex;
        align-items: center;
        padding: 0 16px;
        color: rgba(255, 255, 255, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 1.2rem;
    }
    
    .cyber-field {
        background: transparent !important;
        border: none !important;
        color: white !important;
        padding: 12px 16px !important;
        width: 100%;
        font-size: 1.1rem; /* Larger font */
    }
    
    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        padding: 0 16px;
        font-size: 1.2rem;
    }

    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
        padding: 14px !important;
        font-size: 1.1rem !important;
    }

    /* Progress Table Styles */
    .progress-table-container {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        overflow-x: auto; /* Tablet scroll fix */
        margin-top: 1.5rem;
    }

    .cyber-table {
        width: 100%;
        margin-bottom: 0;
        color: white;
        border-collapse: separate;
        border-spacing: 0;
    }

    .cyber-table th {
        background: rgba(0,0,0,0.3);
        color: var(--cyber-yellow);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.85rem; /* Larger font */
        padding: 16px 15px;
        border-bottom: 2px solid var(--cyber-border);
    }

    .cyber-table td {
        padding: 16px 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        vertical-align: middle;
        font-size: 0.95rem; /* Larger font */
    }

    .item-row.highlight-row {
        background: rgba(250, 204, 21, 0.1) !important;
        border-left: 4px solid var(--cyber-yellow);
        animation: row-glow 1s infinite alternate;
    }

    @@keyframes row-glow {
        from { background: rgba(250, 204, 21, 0.05); }
        to { background: rgba(250, 204, 21, 0.2); }
    }

    @@keyframes slideInRight {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    .progress-mini {
        height: 8px; /* Slightly thicker */
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        margin-top: 6px;
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 700;
    }

    /* Floating Progress Area (Success Dialog) */
    .progress-detail-container {
        display: none;
        background: #0f172a;
        border: 2px solid var(--cyber-yellow);
        border-radius: 8px;
        padding: 24px;
        margin-top: 20px;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
    }
    /* Scanner Video Fix */
    #reader video {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important; /* Fix alignment */
    }

    /* Scanner Overlay & Bounding Box */
    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 20;
    }

    .bounding-box {
        width: 250px;
        height: 250px;
        position: relative;
        box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.4);
        border: 2px solid var(--cyber-yellow);
        border-radius: 4px;
    }
    
    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ef4444;
        box-shadow: 0 0 10px #ef4444;
        animation: scan-line 2.5s ease-in-out infinite;
    }

    @@keyframes scan-line {
        0% { top: 0; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 100%; opacity: 0; }
    }

    .scanner-tip {
        color: white;
        font-size: 0.85rem;
        margin-top: 15px;
        background: rgba(0,0,0,0.6);
        padding: 6px 16px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .active-scan {
        background: rgba(250, 204, 21, 0.2) !important;
        border-color: var(--cyber-yellow) !important;
    }

    #scannerToast {
        backdrop-filter: blur(8px);
        background: rgba(15, 23, 42, 0.9);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .selected-glow {
        border-color: var(--cyber-yellow) !important;
        box-shadow: 0 0 15px rgba(250, 204, 21, 0.5) !important;
        background: rgba(30, 41, 59, 0.9) !important;
    }
    .modal-cyber {
        background: var(--cyber-bg) !important;
        border: 2px solid var(--cyber-border) !important;
        box-shadow: 0 0 30px rgba(250, 204, 21, 0.2);
    }
    
    .modal-cyber .modal-header {
        background: rgba(15, 23, 42, 0.95);
        border-bottom: 2px solid var(--cyber-yellow) !important;
        padding: 0.8rem 1.25rem !important;
        align-items: center;
    }

    .modal-cyber .modal-title {
        color: var(--cyber-yellow);
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-weight: 700 !important;
        font-size: 1.1rem !important;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .table-dark {
        background: transparent !important;
    }

    #tableScheduleList thead th {
        background: #1e293b !important;
        color: var(--cyber-yellow) !important;
        z-index: 1000;
        padding: 6px 8px !important;
        font-size: 0.7rem !important;
        border-bottom: 2px solid var(--cyber-border);
        position: sticky;
        top: 0;
    }
    
    #tableScheduleList tbody td {
        padding: 5px 8px !important;
        font-size: 0.75rem !important;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    #scheduleModal .modal-body {
        max-height: 420px;
        overflow-y: auto;
    }

    .floating-fab {
        position: fixed !important;
        bottom: 30px !important;
        right: 30px !important;
        z-index: 1050;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--cyber-yellow), #f59e0b);
        color: #000;
        border: none;
        box-shadow: 0 0 20px rgba(250, 204, 21, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .floating-fab:hover {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 0 30px rgba(250, 204, 21, 0.6);
    }

    /* SignalR Status Badge */
    .realtime-status-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .status-connecting { border-color: #adb5bd; color: #adb5bd; }
    .status-live { border-color: #34d399; color: #34d399; }
    .status-reconnecting { border-color: #fbbf24; color: #fbbf24; }
    .status-disconnected { border-color: #f87171; color: #f87171; }

    .status-pulse {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        animation: pulse-ring 2s infinite;
        opacity: 0;
        left: 0;
    }
    .status-live .status-pulse { background: rgba(16, 185, 129, 0.3); }

    @@keyframes pulse-ring {
        0% { transform: scale(1); opacity: 0.5; }
        100% { transform: scale(1.1); opacity: 0; }
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="text-white fw-bold mb-0"><i class="bi bi-upc-scan me-2 text-warning"></i> Input Progress Preparation</h2>
            <div id="signalr-status" class="realtime-status-badge status-connecting">
                <div class="status-pulse"></div>
                <i class="bi bi-circle-fill status-icon"></i>
                <span class="status-text">Connecting...</span>
            </div>
        </div>
    </div>

    <!-- Scanner Section (Refactored to match Pulling UI) -->
    <div class="row justify-content-center">
        <div class="col-12">
            @if (isUserRolePrep)
            {
                <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                    <i class="bi bi-eye me-2 fs-5"></i>
                    <span>Anda login sebagai <strong>User</strong> — halaman ini hanya dapat dilihat, tidak dapat melakukan input preparation.</span>
                </div>
            }
            <div class="cyber-card p-4" style="background: #1e293b; border-radius: 12px; border: 1px solid #334155;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
                    <h5 class="mb-0 fw-bold text-white"><i class="bi bi-pencil-square me-2"></i> Form Input Preparation</h5>
                    <div class="d-flex align-items-center gap-3 flex-wrap justify-content-end">
                        @{
                            var userRole = Context.Session.GetString("Role");
                            bool isSuperAdmin = userRole == "Super Admin";
                        }
                        @if (isSuperAdmin)
                        {
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input bg-warning border-warning" type="checkbox" id="fastScanMode" checked>
                                <label class="form-check-label text-warning small fw-bold" for="fastScanMode">MODE SCAN CEPAT (EXT)</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="manualInputMode" style="background-color:#ef4444;border-color:#ef4444;">
                                <label class="form-check-label small fw-bold" style="color:#ef4444;" for="manualInputMode"><i class="bi bi-keyboard me-1"></i>MODE KETIK MANUAL</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="skipStockMode" style="background-color:#f97316;border-color:#f97316;">
                                <label class="form-check-label small fw-bold" style="color:#f97316;" for="skipStockMode"><i class="bi bi-box-seam me-1"></i>SKIP VALIDASI STOCK</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="validateProdIntLabelMode" style="background-color:#3b82f6;border-color:#3b82f6;" checked>
                                <label class="form-check-label small fw-bold" style="color:#3b82f6;" for="validateProdIntLabelMode"><i class="bi bi-shield-check me-1"></i>VALIDASI LABEL PROD INT</label>
                            </div>
                        }
                    </div>
                </div>

                @if (ViewData["TargetVin"] != null && !string.IsNullOrEmpty(ViewData["TargetVin"].ToString()))
                {
                    <div class="alert bg-info bg-opacity-10 border-info border-opacity-50 text-info mb-4 d-flex align-items-center">
                        <i class="bi bi-bullseye fs-4 me-3"></i>
                        <div>
                            <div class="small text-uppercase opacity-75 fw-bold">Manifest Sedang Diproses:</div>
                            <div class="fs-5 fw-bold text-white">@ViewData["TargetVin"]</div>
                        </div>
                        <a asp-action="Index" class="btn btn-sm btn-outline-info ms-auto">
                            <i class="bi bi-x-circle me-1"></i> Batal Fokus
                        </a>
                    </div>
                }
                
                <div class="mx-auto">
                    <!-- Manual Mode Indicator (Admin Only) -->
                    @if (ViewData["IsAdmin"] is bool isAdminIndicator && isAdminIndicator)
                    {
                    <div id="manualModeIndicator" style="display:none;" class="mb-3 py-2 px-3 d-flex align-items-center gap-2" style="background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.5);border-radius:8px;">
                        <span style="background:rgba(239,68,68,0.2);border:1px solid rgba(239,68,68,0.5);border-radius:8px;padding:6px 14px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-keyboard" style="color:#ef4444;font-size:1.1rem;"></i>
                            <span style="color:#ef4444;font-weight:700;font-size:0.85rem;">MODE KETIK MANUAL AKTIF</span>
                            <span style="color:#94a3b8;font-size:0.8rem;">— Validasi suffix X dinonaktifkan (Admin Only)</span>
                        </span>
                    </div>
                    }

                    <!-- Skip Stock Validation Indicator (Admin only — Preparation tidak perlu tahu) -->
                    @{
                        bool skipStockActive = ViewData["SkipStockActive"] is bool ssa && ssa;
                        bool isAdminForIndicator = ViewData["IsAdmin"] is bool iai && iai;
                    }
                    @if (isAdminForIndicator)
                    {
                    <div id="skipStockIndicator" style="display:@(skipStockActive ? "block" : "none");" class="mb-3 py-2 px-3 d-flex align-items-center gap-2">
                        <span style="background:rgba(249,115,22,0.15);border:1px solid rgba(249,115,22,0.5);border-radius:8px;padding:6px 14px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-box-seam" style="color:#f97316;font-size:1.1rem;"></i>
                            <span style="color:#f97316;font-weight:700;font-size:0.85rem;">SKIP VALIDASI STOCK AKTIF</span>
                            <span style="color:#94a3b8;font-size:0.8rem;">— Preparation bisa scan meski stock habis/kosong.</span>
                        </span>
                    </div>
                    }

                    <!-- Status Identification (Moved here for better flow) -->
                    <div id="idStatusSection" style="display: none;" class="mb-4 p-3 border border-primary border-opacity-50 rounded bg-dark bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="spinner-grow spinner-grow-sm text-yellow me-2" role="status"></div>
                                <span id="idStatusText" class="text-white small fw-bold">Mencocokkan data...</span>
                            </div>
                            <span id="idTargetInfo" class="badge bg-primary px-3">---</span>
                        </div>
                    </div>



                    <!-- 0. Pilih Dock (WAJIB sebelum scan) -->
                    <div class="mb-4" id="dockSelectSection">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">
                            <i class="bi bi-geo-alt-fill me-1 text-warning"></i>PILIH DOCK <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-2 align-items-center">
                            <div style="flex:1;">
                                <select id="dockSelect" class="form-select" style="background:#0f172a;color:white;border:1px solid rgba(250,204,21,0.5);border-radius:10px;padding:12px 16px;font-size:1rem;">
                                    <option value="">-- Memuat dock... --</option>
                                </select>
                            </div>
                        </div>
                        <!-- Konfirmasi dock terpilih -->
                        <div id="dockSelectedBar" style="display:none;" class="mt-3 py-2 px-3 d-flex align-items-center justify-content-between"
                             style="background:rgba(250,204,21,0.1);border:1px solid rgba(250,204,21,0.4);border-radius:8px;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-warning fs-5"></i>
                                <div>
                                    <div id="dockConfirmName" class="text-white fw-bold" style="font-size:0.95rem;"></div>
                                    <div id="dockConfirmCycle" class="text-warning-emphasis" style="font-size:0.78rem;"></div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-warning" id="btnChangeDock">
                                <i class="bi bi-pencil me-1"></i>Ganti Dock
                            </button>
                        </div>

                        <!-- Card Lokasi Rak (muncul setelah scan VIN multi-rack, stays sampai SELESAI) -->
                        <div id="rackSelectionPanelPrep" style="display:none;" class="mt-3">
                            <div style="background:rgba(245,158,11,0.08);border:1.5px solid rgba(245,158,11,0.45);border-radius:12px;padding:16px 20px;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <i class="bi bi-grid-3x3-gap-fill me-2" style="color:#f59e0b;font-size:1.1rem;"></i>
                                        <span style="color:#f59e0b;font-weight:700;font-size:0.9rem;text-transform:uppercase;letter-spacing:1px;">Pilih Lokasi Rak</span>
                                        <span style="color:#94a3b8;font-size:0.78rem;margin-left:8px;">— Item ini memiliki beberapa lokasi rak</span>
                                    </div>
                                    <button type="button" id="btnSelesaiPrep" class="btn btn-sm"
                                        style="background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.5);color:#ef4444;font-weight:700;border-radius:8px;padding:5px 14px;">
                                        <i class="bi bi-check2-square me-1"></i>SELESAI
                                    </button>
                                </div>
                                <div id="rackLocationGridPrep" class="d-flex flex-wrap gap-2">
                                    <!-- Rack location buttons rendered by JS -->
                                </div>
                                <div class="mt-2" id="selectedRackInfoPrep" style="display:none;">
                                    <span style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.4);border-radius:6px;padding:4px 12px;color:#10b981;font-size:0.82rem;font-weight:600;">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        <span id="selectedRackTextPrep">-</span>
                                    </span>
                                    <span style="color:#94a3b8;font-size:0.78rem;margin-left:8px;">Silakan scan label produk</span>
                                </div>
                            </div>
                        </div>
                    </div><!-- end #dockSelectSection -->

                    <!-- TANGGAL JADWAL SCAN (Target Date for future-dated preparation) -->
                    <div class="mb-3" id="targetDateSection">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">
                            <i class="bi bi-calendar2-event me-1"></i> Tanggal Jadwal Scan
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="date" class="form-control cyber-field" id="targetDateInput"
                                   min="@DateTime.Today.AddDays(-2).ToString("yyyy-MM-dd")"
                                   style="max-width:180px; background:#0d1117; color:#e2e8f0; border:1px solid #334155;">
                            <span id="badgeTodayDate" class="badge bg-secondary small" style="font-size:0.72rem;">Hari Ini</span>
                            <span id="badgePastDate" class="badge bg-info text-dark small" style="display:none;font-size:0.72rem;"><i class="bi bi-arrow-counterclockwise me-1"></i>Susulan</span>
                            <span id="badgeFutureDate" class="badge bg-warning text-dark small" style="display:none;font-size:0.72rem;"><i class="bi bi-clock-history me-1"></i>Scan Ke Depan</span>
                        </div>
                        <div id="pastDateNote" class="mt-1" style="display:none;">
                            <small class="text-info"><i class="bi bi-info-circle me-1"></i>Mode <strong>Susulan</strong> — preparation akan dicatat pada tanggal yang dipilih (maks H-2).</small>
                        </div>
                        <div id="futureDateNote" class="mt-1" style="display:none;">
                            <small class="text-warning"><i class="bi bi-info-circle me-1"></i>Scan Ke Depan — item akan langsung masuk ke jadwal jika <strong>jadwal tanggal tersebut sudah ada</strong>. Jika belum ada, akan tersimpan sebagai PENDING dan sync otomatis saat jadwal di-upload.</small>
                        </div>
                    </div>

                    <!-- Scan inputs (disabled until dock selected) -->
                    <div id="scanInputsSection" style="opacity:0.4;pointer-events:none;transition:opacity 0.3s;">

                    <!-- 1. VIN (Tag) -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Scan Barcode Rak <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-tag-fill"></i></div>
                            <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Scan Barcode Rak..." readonly autofocus>
                            <button type="button" class="btn-scan-trigger" data-target="tagInput"><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- 2. Label Customer -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Scan Barcode Label <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-upc-scan"></i></div>
                            <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Scan Barcode Label..." disabled readonly>
                            <button type="button" class="btn-scan-trigger" data-target="labelInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- 3. Kanban Customer -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Scan Barcode Kanban <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-clipboard-check"></i></div>
                            <input type="text" class="form-control cyber-field" id="kanbanInput" placeholder="Scan Barcode Kanban..." disabled readonly>
                            <button type="button" class="btn-scan-trigger" data-target="kanbanInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    </div><!-- end #scanInputsSection -->


                                    <!-- Hidden Button & Indicator -->
                    <div class="mt-4 text-center">
                        <button type="button" class="btn btn-neon-success w-100 py-2 shadow-lg fs-5" id="btnSavePreparation" style="display:none;">
                            <i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA
                        </button>
                        <div id="prepLoadingIndicator" style="display:none;" class="text-info">
                            <span class="spinner-border spinner-border-sm me-2"></span>Menyimpan otomatis...
                        </div>
                    </div>

