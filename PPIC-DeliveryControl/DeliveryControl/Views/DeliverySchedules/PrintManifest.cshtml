@model DeliveryControl.Models.DeliverySchedule

@{
    Layout = null; 
    var printData = ViewBag.PrintModelList as IEnumerable<dynamic>;
    bool showPreview = ViewContext.HttpContext.Request.Query["preview"] == "true";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Print Manifest Receipt</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 0;
            color: #000;
            background-color: #e2e8f0;
        }

        .no-print {
            text-align: center;
            padding: 15px;
            background: #fff;
            margin-bottom: 20px;
            border-bottom: 1px solid #ccc;
            display: @(showPreview ? "block" : "none");
        }

        .btn-print {
            padding: 10px 20px;
            background-color: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        .btn-print:hover {
            background-color: #1d4ed8;
        }

        .receipt-page {
            width: 148mm; /* A5 width */
            min-height: 210mm; /* A5 height */
            margin: 20px auto;
            background: #fff;
            padding: 15mm 15mm; /* comfortable margins */
            box-sizing: border-box;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            page-break-after: always;
            position: relative;
        }

        .receipt-header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }

        .receipt-title {
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .receipt-subtitle {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .receipt-info {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
            font-size: 11px;
            line-height: 1.4;
        }

        .receipt-info strong {
            font-size: 12px;
        }

        .qrcode-container {
            width: 60px;
            height: 60px;
            padding: 2px;
            border: 1px solid #000;
            border-radius: 4px;
        }

        .qrcode-container img {
            width: 100%;
            height: 100%;
        }

        table.receipt-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 10px;
        }

        table.receipt-table th, table.receipt-table td {
            border: 1px solid #000;
            padding: 4px 3px;
            text-align: center;
            vertical-align: middle;
            word-wrap: break-word;
        }

        table.receipt-table th {
            font-weight: bold;
            background-color: #f8fafc;
            text-transform: uppercase;
            font-size: 10px;
        }

        table.stamp-table {
            width: 70%;
            border-collapse: collapse;
            font-size: 10px;
            margin-top: 15px;
        }

        table.stamp-table th, table.stamp-table td {
            border: 1px solid #000;
            text-align: center;
            width: 50%;
        }

        table.stamp-table th {
            padding: 4px;
            background-color: #f8fafc;
        }

        table.stamp-table td {
            height: 50px;
            vertical-align: bottom;
            padding-bottom: 5px;
            font-weight: bold;
        }

        .header-cell {
            border: none !important;
            padding: 0 !important;
            text-align: left !important;
            background-color: transparent !important;
        }
        
        @@media print {
            body {
                background-color: #fff;
                margin: 0;
            }
            .no-print {
                display: none !important;
            }
            .receipt-page {
                box-shadow: none;
                margin: 0 !important;
                padding: 0 !important;
                width: 100%;
                min-height: auto;
                border: none;
            }
            @Html.Raw("@page") {
                size: A5 portrait;
                margin: 5mm;
            }
        }
    </style>
    @if (!showPreview)
    {
        <script>
            window.onload = function() {
                setTimeout(function() {
                    window.print();
                    window.close();
                }, 500); 
            };
        </script>
    }
</head>
<body>
    <div class="no-print">
        <button class="btn-print" onclick="window.print()">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16" style="vertical-align: text-bottom; margin-right: 5px;">
                <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
                <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z"/>
            </svg>
            Print Document
        </button>
    </div>

    @if (printData != null)
    {
        var groupedData = printData.GroupBy(p => p.NoManifest).ToList();

        foreach (var group in groupedData)
        {
            var firstRow = group.FirstOrDefault();
            if (firstRow == null) continue;

            string manifestKey = firstRow.NoManifest;
            string custName = firstRow.Customer ?? "-";
            string dockName = firstRow.Dock ?? custName;
            string dateStr = firstRow.TanggalDelivery ?? "-";
            string cycleStr = firstRow.Cycle ?? "-";
            string operatorName = firstRow.Operator ?? "";

            <div class="receipt-page">
                <table class="receipt-table">
                    <thead>
                        <tr>
                            <td colspan="6" class="header-cell">
                                <div class="receipt-header" style="position: relative;">
                                    <div style="position: absolute; top: 0; right: 0; font-size: 10px; font-weight: normal; text-align: right;">Tanggal Print:<br>@DateTime.Now.ToString("dd/MM/yyyy")</div>
                                    <div class="receipt-title">Detail 3 point check</div>
                                    <div class="receipt-subtitle">@dockName</div>
                                </div>

                                <div class="receipt-info">
                                    <div>
                                        <div>Delivery Note: <br /><strong>@manifestKey</strong></div>
                                        <div>Delivery Date: @dateStr</div>
                                        <div>Delivery Cycle: @cycleStr</div>
                                    </div>
                                    <div>
                                        <div class="qrcode-container" data-text="@manifestKey"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th style="width: 10%">No.</th>
                            <th style="width: 25%">VIN</th>
                            <th style="width: 25%">Label</th>
                            <th style="width: 20%">Jobs No</th>
                            <th style="width: 10%">Target</th>
                            <th style="width: 10%">Actual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                            int totalTarget = 0;
                            int totalAct = 0;

                            foreach (var row in group)
                            {
                                totalTarget += (int)row.TargetKanban;
                                totalAct += (int)row.ActKanban;
                                
                                <tr>
                                    <td>@index</td>
                                    <td>@row.Vin</td>
                                    <td>@row.LabelSupplier</td>
                                    <td>@row.JobsNo</td>
                                    <td>@row.TargetKanban</td>
                                    <td>@row.ActKanban</td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" style="text-align: right; font-weight: bold; padding-right: 5px;">Total</td>
                            <td style="font-weight: bold;">@totalTarget</td>
                            <td style="font-weight: bold;">@totalAct</td>
                        </tr>
                        <tr>
                            <td colspan="4" style="text-align: right; font-weight: bold; padding-right: 5px;">Judgement</td>
                            <td colspan="2" style="font-weight: bold; text-align: center;">
                                @if (totalTarget == totalAct)
                                {
                                    <span>OK</span>
                                }
                                else
                                {
                                    int diff = totalAct - totalTarget;
                                    string diffText = diff > 0 ? $"+{diff}" : diff.ToString();
                                    <span style="color: red;">Selisih @diffText</span>
                                }
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <table class="stamp-table">
                    <tr>
                        <th>Prepare</th>
                        <th>Checker</th>
                    </tr>
                    <tr>
                        <td>
                            @{
                                var sessionUser = Context.Session.GetString("FullName") ?? Context.Session.GetString("Username") ?? Context.Session.GetString("Role");
                                var finalOperator = !string.IsNullOrWhiteSpace(sessionUser) ? sessionUser : (!string.IsNullOrWhiteSpace(operatorName) && operatorName != "-" ? operatorName : "-");
                            }
                            @finalOperator
                        </td>
                        <td></td>
                    </tr>
                </table>
            </div>
        }
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var qrContainers = document.querySelectorAll('.qrcode-container');
            qrContainers.forEach(function(container) {
                var text = container.getAttribute('data-text');
                if (text && text.trim() !== "" && text.trim() !== "-") {
                    new QRCode(container, {
                        text: text,
                        width: 50,
                        height: 50,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.L
                    });
                }
            });

            setTimeout(function() {
                window.print();
            }, 1000);
        });
    </script>
</body>
</html>
