@model dashboardKlinik.Models.KunjunganKlinik
@{
    ViewData["Title"] = "Input Rekam Medis & Riwayat Pasien";
    var riwayatList = ViewData["RiwayatKunjungan"] as IEnumerable<dashboardKlinik.Models.KunjunganKlinik>;
}

<div style="margin-bottom: 20px;">
    <a href="@Url.Action("Index", "Antrian")" class="btn-action btn-outline-custom">
        <i class="bi bi-arrow-left"></i> Kembali ke Antrian
    </a>
</div>

@if (ViewData["AntrianId"] != null)
{
    <div class="alert-toast success" style="position: static; margin-bottom: 20px; animation: none;">
        <i class="bi bi-qr-code-scan"></i>
        <span>Memproses Antrian Pasien <strong>@ViewData["NomorAntrian"]</strong> (@Model.NamaPasien). Data pasien telah diisi otomatis.</span>
    </div>
}

<div class="row g-4" style="margin: 0; width: 100%;">
    <!-- SISI KIRI: FORM INPUT REKAM MEDIS -->
    <div class="col-12 col-xl-7" style="padding-left: 0;">
        <div class="card-custom fade-in">
            <div class="card-header-custom d-flex align-items-center justify-content-between">
                <h6><i class="bi bi-clipboard-plus-fill" style="color: var(--primary)"></i> Input Rekam Medis Kunjungan</h6>
                <span class="badge bg-light text-dark" style="font-size: 11px; font-weight: 500;">Form Pasien</span>
            </div>
            <div class="card-body-custom">
                <form asp-action="Create" method="post" id="createKunjunganForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="antrianId" value="@ViewData["AntrianId"]" />
                    <div asp-validation-summary="ModelOnly" style="color: var(--danger); margin-bottom: 16px;"></div>

                    <div class="form-row">
                        <div class="form-group-custom">
                            <label asp-for="TanggalKunjungan">Tanggal Kunjungan *</label>
                            <input asp-for="TanggalKunjungan" type="date" class="form-control-custom" />
                            <span asp-validation-for="TanggalKunjungan" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                        <div class="form-group-custom">
                            <label asp-for="NamaPasien">Nama Pasien *</label>
                            <input asp-for="NamaPasien" id="inputNamaPasien" class="form-control-custom" placeholder="Nama lengkap pasien" />
                            <span asp-validation-for="NamaPasien" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group-custom">
                            <label asp-for="NPK">NPK *</label>
                            <input asp-for="NPK" id="inputNPK" class="form-control-custom" placeholder="Nomor Pokok Karyawan" />
                            <span asp-validation-for="NPK" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                        <div class="form-group-custom">
                            <label asp-for="JenisKelamin">Jenis Kelamin *</label>
                            <select asp-for="JenisKelamin" class="form-control-custom">
                                <option value="">Pilih Jenis Kelamin</option>
                                <option value="L">Laki-laki</option>
                                <option value="P">Perempuan</option>
                            </select>
                            <span asp-validation-for="JenisKelamin" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group-custom">
                            <label asp-for="Plant">Plant *</label>
                            <select asp-for="Plant" class="form-control-custom">
                                <option value="">Pilih Plant</option>
                                <option value="RVI">RVI</option>
                                <option value="MIXING">MIXING</option>
                                <option value="BTR">BTR</option>
                                <option value="MOLDED">MOLDED</option>
                                <option value="HOSE">HOSE</option>
                            </select>
                            <span asp-validation-for="Plant" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                        <div class="form-group-custom">
                            <label asp-for="Departemen">Departemen *</label>
                            <select asp-for="Departemen" class="form-control-custom">
                                <option value="">Pilih Departemen</option>
                                <option value="PRODUKSI">PRODUKSI</option>
                                <option value="MAINTENANCE">MAINTENANCE</option>
                                <option value="QC">QC</option>
                                <option value="HRD">HRD</option>
                                <option value="GENERAL">GENERAL</option>
                                <option value="DIGITALISASI">DIGITALISASI</option>
                                <option value="FINANCE">FINANCE</option>
                                <option value="MARKETING">MARKETING</option>
                                <option value="IT">IT</option>
                                <option value="R&D">R&D</option>
                                <option value="OTHER">OTHER</option>
                            </select>
                            <span asp-validation-for="Departemen" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Keluhan">Keluhan *</label>
                        <textarea asp-for="Keluhan" class="form-control-custom" rows="3" placeholder="Jelaskan keluhan pasien..."></textarea>
                        <span asp-validation-for="Keluhan" style="color: var(--danger); font-size: 12px;"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Diagnosa">Diagnosa *</label>
                        <textarea asp-for="Diagnosa" class="form-control-custom" rows="3" placeholder="Diagnosa medis..."></textarea>
                        <span asp-validation-for="Diagnosa" style="color: var(--danger); font-size: 12px;"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group-custom">
                            <label asp-for="Dokter">Dokter *</label>
                            <input asp-for="Dokter" class="form-control-custom" placeholder="Nama dokter" />
                            <span asp-validation-for="Dokter" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                        <div class="form-group-custom">
                            <label asp-for="Status">Status *</label>
                            <select asp-for="Status" class="form-control-custom">
                                <option value="">Pilih Status</option>
                                <option value="Rawat Jalan">Rawat Jalan</option>
                                <option value="Perawatan">Perawatan</option>
                                <option value="Dirujuk">Dirujuk</option>
                            </select>
                            <span asp-validation-for="Status" style="color: var(--danger); font-size: 12px;"></span>
                        </div>
                    </div>

                    <div style="display: flex; gap: 12px; margin-top: 24px;">
                        <button type="submit" class="btn-action btn-primary-custom" id="btn-submit-kunjungan">
                            <i class="bi bi-check-lg"></i> Simpan Kunjungan
                        </button>
                        <a href="@Url.Action("Index", "Antrian")" class="btn-action btn-outline-custom">Batal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SISI KANAN: DAFTAR RIWAYAT REKAM MEDIS PASIEN -->
    <div class="col-12 col-xl-5" style="padding-right: 0;">
        <div class="card-custom fade-in" style="height: 100%; display: flex; flex-direction: column;">
            <div class="card-header-custom d-flex align-items-center justify-content-between" style="border-bottom: 1px solid rgba(0,0,0,0.06); padding: 16px 20px;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-journal-medical" style="color: var(--primary); font-size: 1.2rem;"></i>
                    <h6 class="mb-0" style="font-weight: 700;">Riwayat Rekam Medis</h6>
                </div>
                <span class="badge bg-primary" id="riwayatBadgeCount" style="font-weight: 600; padding: 6px 12px; border-radius: 20px;">
                    @(riwayatList != null ? riwayatList.Count() : 0) Kunjungan
                </span>
            </div>
            
            <div class="card-body-custom" style="flex: 1; overflow-y: auto; max-height: 680px; padding: 16px;" id="riwayatListContainer">
                @if (riwayatList != null && riwayatList.Any())
                {
                    <div class="timeline-wrapper">
                        @foreach (var r in riwayatList)
                        {
                            <div class="riwayat-card mb-3 p-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; border-left: 4px solid var(--primary); transition: all 0.2s ease;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span style="font-weight: 700; font-size: 13px; color: #1e293b;">
                                        <i class="bi bi-calendar3 me-1" style="color: var(--primary);"></i> @r.TanggalKunjungan.ToString("dd MMMM yyyy")
                                    </span>
                                    <span class="badge @(r.Status == "Rawat Jalan" ? "bg-success" : (r.Status == "Perawatan" ? "bg-warning text-dark" : "bg-danger"))" style="font-size: 11px;">
                                        @r.Status
                                    </span>
                                </div>
                                <div class="text-muted mb-2" style="font-size: 12px;">
                                    <i class="bi bi-person-badge me-1"></i> Dokter: <strong>@(string.IsNullOrEmpty(r.Dokter) ? "-" : r.Dokter)</strong> | Plant: @r.Plant - @r.Departemen
                                </div>
                                <div class="mb-2" style="font-size: 13px; color: #334155;">
                                    <strong>Keluhan:</strong> @r.Keluhan
                                </div>
                                <div class="p-2" style="background: #ffffff; border-radius: 6px; border: 1px dashed #cbd5e1; font-size: 13px; color: #0f172a;">
                                    <strong style="color: var(--primary);"><i class="bi bi-file-earmark-medical me-1"></i>Diagnosa:</strong> @r.Diagnosa
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted" id="emptyRiwayatState">
                        <i class="bi bi-clipboard-x" style="font-size: 3rem; color: #cbd5e1;"></i>
                        <h6 class="mt-3 mb-1" style="font-weight: 600; color: #64748b;">Belum Ada Riwayat Kunjungan</h6>
                        <p style="font-size: 12px; color: #94a3b8;">Riwayat rekam medis pasien akan tampil di sini saat NPK / Nama terdeteksi.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputNPK = document.getElementById('inputNPK');
            const inputNama = document.getElementById('inputNamaPasien');
            const riwayatContainer = document.getElementById('riwayatListContainer');
            const badgeCount = document.getElementById('riwayatBadgeCount');

            let timer = null;

            function fetchRiwayat() {
                const npk = inputNPK ? inputNPK.value.trim() : '';
                const nama = inputNama ? inputNama.value.trim() : '';

                if (!npk && !nama) return;

                fetch(`@Url.Action("GetRiwayatJson", "Kunjungan")?npk=${encodeURIComponent(npk)}&namaPasien=${encodeURIComponent(nama)}`)
                    .then(res => res.json())
                    .then(data => {
                        renderRiwayatList(data);
                    })
                    .catch(err => console.error("Gagal load riwayat:", err));
            }

            function renderRiwayatList(data) {
                if (!badgeCount || !riwayatContainer) return;

                badgeCount.textContent = `${data.length} Kunjungan`;

                if (!data || data.length === 0) {
                    riwayatContainer.innerHTML = `
                        <div class="text-center py-5 text-muted" id="emptyRiwayatState">
                            <i class="bi bi-clipboard-x" style="font-size: 3rem; color: #cbd5e1;"></i>
                            <h6 class="mt-3 mb-1" style="font-weight: 600; color: #64748b;">Belum Ada Riwayat Kunjungan</h6>
                            <p style="font-size: 12px; color: #94a3b8;">Tidak ditemukan rekam medis terdahulu untuk pasien ini.</p>
                        </div>`;
                    return;
                }

                let html = '<div class="timeline-wrapper">';
                data.forEach(item => {
                    let badgeClass = item.status === 'Rawat Jalan' ? 'bg-success' : (item.status === 'Perawatan' ? 'bg-warning text-dark' : 'bg-danger');
                    html += `
                        <div class="riwayat-card mb-3 p-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; border-left: 4px solid var(--primary); transition: all 0.2s ease;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span style="font-weight: 700; font-size: 13px; color: #1e293b;">
                                    <i class="bi bi-calendar3 me-1" style="color: var(--primary);"></i> ${item.tanggal}
                                </span>
                                <span class="badge ${badgeClass}" style="font-size: 11px;">
                                    ${item.status || 'Rawat Jalan'}
                                </span>
                            </div>
                            <div class="text-muted mb-2" style="font-size: 12px;">
                                <i class="bi bi-person-badge me-1"></i> Dokter: <strong>${item.dokter || '-'}</strong> | Plant: ${item.plant || '-'} - ${item.departemen || '-'}
                            </div>
                            <div class="mb-2" style="font-size: 13px; color: #334155;">
                                <strong>Keluhan:</strong> ${item.keluhan || '-'}
                            </div>
                            <div class="p-2" style="background: #ffffff; border-radius: 6px; border: 1px dashed #cbd5e1; font-size: 13px; color: #0f172a;">
                                <strong style="color: var(--primary);"><i class="bi bi-file-earmark-medical me-1"></i>Diagnosa:</strong> ${item.diagnosa || '-'}
                            </div>
                        </div>`;
                });
                html += '</div>';

                riwayatContainer.innerHTML = html;
            }

            if (inputNPK) {
                inputNPK.addEventListener('input', function () {
                    clearTimeout(timer);
                    timer = setTimeout(fetchRiwayat, 400);
                });
            }

            if (inputNama) {
                inputNama.addEventListener('input', function () {
                    clearTimeout(timer);
                    timer = setTimeout(fetchRiwayat, 400);
                });
            }
        });
    </script>
}
