@model dashboardKlinik.Models.Pasien
@{
    ViewData["Title"] = "Detail Pasien";
}

<div style="margin-bottom: 24px;">
    <a href="@Url.Action("Index")" class="btn-action btn-outline-custom" id="btn-back">
        <i class="bi bi-arrow-left"></i> Kembali
    </a>
</div>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px;">
    <!-- Patient Info Card -->
    <div class="card-custom fade-in" id="patient-info">
        <div class="card-header-custom">
            <h6><i class="bi bi-person-fill" style="color: var(--primary)"></i> Informasi Pasien</h6>
        </div>
        <div class="card-body-custom" style="text-align: center;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), #6366f1); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 32px; color: white;">
                <i class="bi @(Model.JenisKelamin == "L" ? "bi-gender-male" : "bi-gender-female")"></i>
            </div>
            <h5 style="font-weight: 700; margin-bottom: 4px;">@Model.NamaPasien</h5>
            <p style="color: var(--text-muted); font-size: 14px;">NPK: @Model.NPK</p>

            <div class="detail-grid" style="margin-top: 20px; text-align: left;">
                <div class="detail-item">
                    <label>Plant</label>
                    <span>@Model.Plant</span>
                </div>
                <div class="detail-item">
                    <label>Departemen</label>
                    <span>@Model.Departemen</span>
                </div>
                <div class="detail-item">
                    <label>Jenis Kelamin</label>
                    <span>@(Model.JenisKelamin == "L" ? "Laki-laki" : "Perempuan")</span>
                </div>
                <div class="detail-item">
                    <label>Terdaftar</label>
                    <span>@Model.TanggalTerdaftar.ToString("dd MMM yyyy")</span>
                </div>
            </div>

            <div style="margin-top: 20px; display: flex; gap: 8px; justify-content: center;">
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn-action btn-warning-custom">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="@Url.Action("Riwayat", "Kunjungan", new { npk = Model.NPK })" class="btn-action btn-primary-custom">
                    <i class="bi bi-clock-history"></i> Riwayat
                </a>
            </div>
        </div>
    </div>

    <!-- Visit History -->
    <div class="card-custom fade-in" id="visit-history">
        <div class="card-header-custom">
            <h6><i class="bi bi-clipboard2-pulse-fill" style="color: var(--success)"></i> Riwayat Kunjungan (@Model.Kunjungan.Count())</h6>
        </div>
        <div class="card-body-custom">
            @if (Model.Kunjungan.Any())
            {
                <div class="timeline">
                    @foreach (var k in Model.Kunjungan)
                    {
                        <div class="timeline-item">
                            <div class="timeline-date">@k.TanggalKunjungan.ToString("dd MMMM yyyy")</div>
                            <div class="timeline-content">
                                <h6>@k.Keluhan</h6>
                                <p><strong>Diagnosa:</strong> @k.Diagnosa</p>
                                <p><strong>Dokter:</strong> @k.Dokter</p>
                                <div style="margin-top: 8px;">
                                    @{
                                        var badgeClass = k.Status switch
                                        {
                                            "Rawat Jalan" => "rawat-jalan",
                                            "Perawatan" => "perawatan",
                                            "Dirujuk" => "dirujuk",
                                            _ => "rawat-jalan"
                                        };
                                    }
                                    <span class="badge-status @badgeClass">@k.Status</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-clipboard"></i>
                    <h5>Belum ada riwayat kunjungan</h5>
                </div>
            }
        </div>
    </div>
</div>
