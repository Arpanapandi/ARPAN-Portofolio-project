@model dashboardKlinik.Models.Pasien
@{
    ViewData["Title"] = "Hapus Pasien";
}

<div style="margin-bottom: 24px;">
    <a href="@Url.Action("Index")" class="btn-action btn-outline-custom">
        <i class="bi bi-arrow-left"></i> Kembali
    </a>
</div>

<div style="max-width: 500px;">
    <div class="card-custom fade-in">
        <div class="card-header-custom">
            <h6><i class="bi bi-exclamation-triangle-fill" style="color: var(--danger)"></i> Konfirmasi Hapus</h6>
        </div>
        <div class="card-body-custom" style="text-align: center;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--danger-bg); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <i class="bi bi-trash" style="font-size: 28px; color: var(--danger);"></i>
            </div>
            <h5 style="margin-bottom: 8px;">Hapus Data Pasien?</h5>
            <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 20px;">
                Anda akan menghapus data pasien <strong>@Model.NamaPasien</strong> (NPK: @Model.NPK). Tindakan ini tidak dapat dibatalkan.
            </p>

            <div class="detail-grid" style="text-align: left; margin-bottom: 24px;">
                <div class="detail-item">
                    <label>Plant</label>
                    <span>@Model.Plant</span>
                </div>
                <div class="detail-item">
                    <label>Departemen</label>
                    <span>@Model.Departemen</span>
                </div>
            </div>

            <form asp-action="Delete" method="post" id="deleteForm">
                @Html.AntiForgeryToken()
                <div style="display: flex; gap: 12px; justify-content: center;">
                    <button type="submit" class="btn-action btn-danger-custom" id="btn-confirm-delete">
                        <i class="bi bi-trash"></i> Ya, Hapus
                    </button>
                    <a href="@Url.Action("Index")" class="btn-action btn-outline-custom">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>
